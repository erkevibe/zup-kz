        ensureStatutoryParameter('MIN_OVERTIME_COEF', 'Минимальный коэффициент сверхурочных', 'coefficient',
            'Статья 108 Трудового кодекса РК');
        ensureStatutoryParameter('MIN_HOLIDAY_COEF', 'Минимальный коэффициент выходных и праздничных', 'coefficient',
            'Статья 109 Трудового кодекса РК');
        ensureStatutoryParameter('MIN_NIGHT_COEF', 'Минимальный коэффициент ночных часов', 'coefficient',
