MODULE ZUPKZ;

REQUIRE KZOrganization, KZLegalFramework, HRDepartment, HRPosition,
        HREmployee, HRStaffSchedule, HREmployment, TimeProductionCalendar,
        TimeWorkSchedule, TimeTimesheet, PayrollCore, AverageEarnings,
        PayrollRecalculation, HRLeave, PayrollSickLeave, PayrollInterimPayment,
        PayrollAssessmentBase, TaxesKZSocialPayments, TaxesKZIncomeTax,
        PayrollCivilContract,
        PayrollEnforcement, PayrollSettlement, PayrollPayments,
        PayrollCivilContractPayments,
        TaxesKZSocialTransferRegisters, ReportsKZForm200, ReportsKZForm20005;
NAMESPACE ZUPKZ;

NAVIGATOR {
    NEW FOLDER masterData 'Справочники' WINDOW toolbar {
        NEW organizations;
        NEW departments;
        NEW positions;
        NEW employees;
        NEW staffPositions;
    }

    NEW FOLDER legislation 'Законодательство РК' WINDOW toolbar {
        NEW legalSources;
        NEW statutoryParameters;
        NEW statutoryParameterValues;
    }

    NEW FOLDER personnel 'Кадровый учёт' WINDOW toolbar {
        NEW employments;
        NEW employmentAssignments;
        NEW personnelEvents;
        NEW leaveEntitlements;
        NEW leaveDocuments;
        NEW sickLeaveDocuments;
    }

    NEW FOLDER workingTime 'Рабочее время' WINDOW toolbar {
        NEW productionCalendars;
        NEW calendarDays;
        NEW workTimeNorms;
        NEW workSchedules;
        NEW shiftTemplates;
        NEW scheduleCycleDays;
        NEW employeeScheduleAssignments;
        NEW timesheets;
        NEW timesheetLines;
    }

    NEW FOLDER payroll 'Расчёт зарплаты' WINDOW toolbar {
        NEW calculationTypes;
        NEW payrollRules;
        NEW payrollRuns;
        NEW payrollTimeSummaries;
        NEW payrollInputs;
        NEW payrollLines;
        NEW civilContracts;
        NEW civilContractActs;
        NEW calculationBaseRules;
        NEW averageEarningsDocuments;
        NEW averageEarningsBaseLines;
        NEW payrollRecalculations;
        NEW payrollRecalculationLines;
        NEW interimPayments;
        NEW sickLeaveBenefitLines;
        NEW payrollSettlements;
        NEW paymentStatements;
        NEW paymentStatementLines;
        NEW salaryBankRegisters;
        NEW salaryBankRegisterLines;
    }

    NEW FOLDER taxesKz 'Налоги и взносы РК' WINDOW toolbar {
        NEW socialPaymentProfiles;
        NEW socialPaymentDocuments;
        NEW socialPaymentLines;
        NEW employeeTaxProfiles;
        NEW organizationTaxProfiles;
        NEW taxCalculationDocuments;
        NEW taxCalculationLines;
        NEW enforcementOrders;
        NEW enforcementCalculationDocuments;
        NEW enforcementCalculationLines;
        NEW payrollLiabilityDocuments;
        NEW payrollLiabilityLines;
        NEW civilLiabilityDocuments;
        NEW civilLiabilityLines;
        NEW socialTransferRegisters;
        NEW socialTransferRegisterLines;
    }

    NEW FOLDER reportsKz 'Отчётность РК' WINDOW toolbar {
        NEW form200Declarations;
        NEW form200MonthLines;
        NEW form20005Lines;
    }
}
