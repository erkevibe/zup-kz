{
  "database": "/var/lib/zup-observer/observer.db",
  "alert_file": "/var/lib/zup-observer/alerts.ndjson",
  "poll_seconds": 15,
  "baseline_minutes": 30,
  "report_limit": 50,
  "files": [
    {
      "name": "lsfusion",
      "globs": ["/srv/zup-kz/logs/*.log"]
    },
    {
      "name": "tomcat",
      "globs": ["/opt/zup-web/tomcat/logs/*.log"]
    },
    {
      "name": "postgresql",
      "globs": ["/var/log/postgresql/postgresql-17-main.log"]
    }
  ],
  "journals": [
    {
      "name": "host-journal",
      "units": []
    }
  ],
  "commands": [],
  "processes": {
    "hr": {
      "starts": ["prepared"],
      "transitions": {
        "prepared": ["posted", "cancelled"],
        "posted": ["esutd-sent", "cancelled"],
        "esutd-sent": ["esutd-accepted", "esutd-rejected"],
        "esutd-rejected": ["esutd-sent", "cancelled"],
        "esutd-accepted": ["cancelled"],
        "cancelled": []
      }
    },
    "approval": {
      "starts": ["submitted"],
      "transitions": {
        "submitted": ["approved-step", "rejected", "cancelled"],
        "approved-step": ["approved-step", "completed", "rejected", "cancelled"],
        "completed": ["cancelled"],
        "rejected": [],
        "cancelled": []
      }
    },
    "payroll": {
      "starts": ["timesheet"],
      "transitions": {
        "timesheet": ["calculated"],
        "calculated": ["social-approved", "reset"],
        "social-approved": ["tax-approved", "reset"],
        "tax-approved": ["enforcement-approved", "reset"],
        "enforcement-approved": ["closed", "reset"],
        "closed": ["statement-approved", "reopened"],
        "statement-approved": ["paid"],
        "paid": [],
        "reopened": ["closed", "reset"],
        "reset": ["calculated"]
      },
      "max_age_seconds": {
        "timesheet": 259200,
        "calculated": 172800,
        "social-approved": 172800,
        "tax-approved": 172800,
        "enforcement-approved": 172800,
        "closed": 259200,
        "statement-approved": 259200,
        "reopened": 86400,
        "reset": 86400
      },
      "recommendations": {
        "timesheet": "Проверить ошибки расчёта зарплаты и обязательные реквизиты сотрудников",
        "calculated": "Рассчитать и утвердить социальные платежи",
        "social-approved": "Рассчитать и утвердить ИПН и социальный налог",
        "tax-approved": "Рассчитать и утвердить исполнительные удержания",
        "enforcement-approved": "Проверить дату выплаты и закрыть расчёт зарплаты",
        "closed": "Сформировать и утвердить платёжную ведомость",
        "statement-approved": "Подтвердить фактическую выплату ведомости",
        "reopened": "Закрыть исправленный расчёт либо сбросить его для пересчёта",
        "reset": "Повторно рассчитать зарплату после проверки исходных данных"
      }
    }
  }
}
