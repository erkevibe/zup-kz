legacyPaymentAccountMigrationTest() {
    IF NOT legacyMigrationEmployee() THEN NEW worker = Employee {
        iin(worker) <- '980808300008';
        lastName(worker) <- 'Миграция';
        firstName(worker) <- 'ОднаОрганизация';
        salaryBankName(worker) <- 'Старый банк';
        salaryBankBic(worker) <- 'BANKKZKA';
        salaryIban(worker) <- 'KZ000000000000000081';
        NEW contract = Employment {
            employee(contract) <- worker;
            organization(contract) <- accessAssignedOrganization();
            contractNumber(contract) <- 'LEGACY-MIGRATION-ONE';
            hireDate(contract) <- 2024_03_15;
        }
    }
    IF NOT legacyMigrationAmbiguousEmployee() THEN NEW ambiguous = Employee {
        iin(ambiguous) <- '990909300009';
        lastName(ambiguous) <- 'Миграция';
        firstName(ambiguous) <- 'ДвеОрганизации';
        salaryBankName(ambiguous) <- 'Неоднозначный банк';
        salaryBankBic(ambiguous) <- 'BANKKZKA';
        salaryIban(ambiguous) <- 'KZ000000000000000091';
        NEW contractA = Employment {
            employee(contractA) <- ambiguous;
            organization(contractA) <- accessAssignedOrganization();
            contractNumber(contractA) <- 'LEGACY-MIGRATION-A';
            hireDate(contractA) <- 2024_01_01;
        }
        NEW contractB = Employment {
            employee(contractB) <- ambiguous;
            organization(contractB) <- accessHiddenOrganization();
            contractNumber(contractB) <- 'LEGACY-MIGRATION-B';
            hireDate(contractB) <- 2024_02_01;
        }
    }
    APPLY;
    migrateLegacyPaymentAccounts();
    EXPORT JSON FROM
        singleOrganizationLegacyMigrated = paymentAccountIban(employeePaymentAccountOn(
            accessAssignedOrganization(), legacyMigrationEmployee(), 2024_03_15)) ==
            'KZ000000000000000081',
        migrationPreservedEffectiveDate = paymentAccountValidFrom(employeePaymentAccountOn(
            accessAssignedOrganization(), legacyMigrationEmployee(), 2024_03_15)) == 2024_03_15,
        ambiguousLegacyNotMigrated = NOT employeePaymentAccountCount(
            legacyMigrationAmbiguousEmployee()),
        ambiguousLegacyReported = legacyPaymentAccountMigrationConflict(
            legacyMigrationAmbiguousEmployee());
}

