MODULE TimeProductionCalendar;

REQUIRE SystemEvents;
NAMESPACE ZUPKZ;

CLASS CalendarDayKind 'Вид календарного дня' {
    workDay 'Рабочий день',
    weekend 'Выходной день',
    holiday 'Праздничный день',
    transferredWeekend 'Перенесённый выходной',
    transferredWorkDay 'Перенесённый рабочий день'
}

// Календарь хранится отдельной версией на каждый год и официальный источник.
CLASS ProductionCalendar 'Производственный календарь';

calendarYear 'Год' = DATA INTEGER (ProductionCalendar);
calendarName 'Наименование' = DATA STRING[150] (ProductionCalendar);
calendarSourceUrl 'Официальный источник' = DATA STRING[500] (ProductionCalendar);
calendarVerifiedOn 'Проверено на дату' = DATA DATE (ProductionCalendar);

CLASS CalendarDay 'День производственного календаря';

productionCalendar 'Календарь' = DATA ProductionCalendar (CalendarDay);
calendarDate 'Дата' = DATA DATE (CalendarDay);
dayKindFiveDay 'Вид дня, пятидневка' = DATA CalendarDayKind (CalendarDay);
dayKindSixDay 'Вид дня, шестидневка' = DATA CalendarDayKind (CalendarDay);
holidayName 'Праздник / основание переноса' = DATA STRING[200] (CalendarDay);
excludeFromAnnualLeave 'Не включать в ежегодный отпуск' = DATA BOOLEAN (CalendarDay);
shortenedDay 'Сокращённый день' = DATA BOOLEAN (CalendarDay);
hoursFiveDay40 '5 дней / 40 часов' = DATA NUMERIC[6,2] (CalendarDay);
hoursSixDay40 '6 дней / 40 часов' = DATA NUMERIC[6,2] (CalendarDay);
hoursFiveDay36 '5 дней / 36 часов' = DATA NUMERIC[6,2] (CalendarDay);
hoursSixDay36 '6 дней / 36 часов' = DATA NUMERIC[6,2] (CalendarDay);

CONSTRAINT hoursFiveDay40(CalendarDay d) < 0 OR hoursSixDay40(d) < 0 OR
           hoursFiveDay36(d) < 0 OR hoursSixDay36(d) < 0
    MESSAGE 'Норма часов календарного дня не может быть отрицательной';

CLASS WorkTimeNorm 'Норма рабочего времени';

normCalendar 'Календарь' = DATA ProductionCalendar (WorkTimeNorm);
normPeriodFrom 'Период с' = DATA DATE (WorkTimeNorm);
normPeriodTo 'Период по' = DATA DATE (WorkTimeNorm);
normDaysFiveDay 'Рабочих дней, пятидневка' = DATA INTEGER (WorkTimeNorm);
normDaysSixDay 'Рабочих дней, шестидневка' = DATA INTEGER (WorkTimeNorm);
normHoursFiveDay40 'Часов, 5/40' = DATA NUMERIC[10,2] (WorkTimeNorm);
normHoursSixDay40 'Часов, 6/40' = DATA NUMERIC[10,2] (WorkTimeNorm);
normHoursFiveDay36 'Часов, 5/36' = DATA NUMERIC[10,2] (WorkTimeNorm);
normHoursSixDay36 'Часов, 6/36' = DATA NUMERIC[10,2] (WorkTimeNorm);

CONSTRAINT normPeriodTo(WorkTimeNorm n) < normPeriodFrom(n)
    MESSAGE 'Окончание периода нормы не может быть раньше начала';

FORM productionCalendars 'Производственные календари'
    OBJECTS c = ProductionCalendar
    PROPERTIES(c) calendarYear, calendarName, calendarSourceUrl, calendarVerifiedOn
;

FORM calendarDays 'Дни производственного календаря'
    OBJECTS d = CalendarDay
    PROPERTIES(d) productionCalendar, calendarDate, dayKindFiveDay, dayKindSixDay, holidayName,
                  excludeFromAnnualLeave, shortenedDay, hoursFiveDay40, hoursSixDay40,
                  hoursFiveDay36, hoursSixDay36
;

FORM workTimeNorms 'Нормы рабочего времени'
    OBJECTS n = WorkTimeNorm
    PROPERTIES(n) normCalendar, normPeriodFrom, normPeriodTo,
                  normDaysFiveDay, normDaysSixDay, normHoursFiveDay40,
                  normHoursSixDay40, normHoursFiveDay36, normHoursSixDay36
;

calendarByYear(INTEGER year) = GROUP AGGR ProductionCalendar c BY calendarYear(c);
normCount(ProductionCalendar c) = GROUP SUM 1 BY normCalendar(WorkTimeNorm n);
calendarDayCount(ProductionCalendar c) = GROUP SUM 1 BY productionCalendar(CalendarDay d);
calendarDayByDate(ProductionCalendar c, DATE date) =
    GROUP AGGR CalendarDay d BY productionCalendar(d), calendarDate(d);

createDefaultCalendarDay2026(ProductionCalendar c, DATE date) {
    IF NOT calendarDayByDate(c, date) THEN {
        NEW d = CalendarDay {
            productionCalendar(d) <- c;
            calendarDate(d) <- date;

            IF extractDOWNumber(date) == 0 OR extractDOWNumber(date) == 6 THEN {
                dayKindFiveDay(d) <- CalendarDayKind.weekend;
                hoursFiveDay40(d) <- 0.00;
                hoursFiveDay36(d) <- 0.00;
            } ELSE {
                dayKindFiveDay(d) <- CalendarDayKind.workDay;
                hoursFiveDay40(d) <- 8.00;
                hoursFiveDay36(d) <- 7.20;
            }

            IF extractDOWNumber(date) == 0 THEN {
                dayKindSixDay(d) <- CalendarDayKind.weekend;
                hoursSixDay40(d) <- 0.00;
                hoursSixDay36(d) <- 0.00;
            } ELSE {
                dayKindSixDay(d) <- CalendarDayKind.workDay;
                IF extractDOWNumber(date) == 6 THEN
                    hoursSixDay40(d) <- 5.00;
                ELSE
                    hoursSixDay40(d) <- 7.00;
                hoursSixDay36(d) <- 6.00;
            }
        }
    }
}

setHoliday2026(ProductionCalendar c, DATE date, STRING[200] holidayCaption) {
    dayKindFiveDay(calendarDayByDate(c, date)) <- CalendarDayKind.holiday;
    dayKindSixDay(calendarDayByDate(c, date)) <- CalendarDayKind.holiday;
    holidayName(calendarDayByDate(c, date)) <- holidayCaption;
    excludeFromAnnualLeave(calendarDayByDate(c, date)) <- TRUE;
    hoursFiveDay40(calendarDayByDate(c, date)) <- 0.00;
    hoursFiveDay36(calendarDayByDate(c, date)) <- 0.00;
    hoursSixDay40(calendarDayByDate(c, date)) <- 0.00;
    hoursSixDay36(calendarDayByDate(c, date)) <- 0.00;
}

setTransferredWeekendBoth2026(ProductionCalendar c, DATE date, STRING[200] reason) {
    dayKindFiveDay(calendarDayByDate(c, date)) <- CalendarDayKind.transferredWeekend;
    dayKindSixDay(calendarDayByDate(c, date)) <- CalendarDayKind.transferredWeekend;
    holidayName(calendarDayByDate(c, date)) <- reason;
    hoursFiveDay40(calendarDayByDate(c, date)) <- 0.00;
    hoursFiveDay36(calendarDayByDate(c, date)) <- 0.00;
    hoursSixDay40(calendarDayByDate(c, date)) <- 0.00;
    hoursSixDay36(calendarDayByDate(c, date)) <- 0.00;
}

setTransferredWeekendFiveDay2026(ProductionCalendar c, DATE date, STRING[200] reason) {
    dayKindFiveDay(calendarDayByDate(c, date)) <- CalendarDayKind.transferredWeekend;
    holidayName(calendarDayByDate(c, date)) <- reason;
    hoursFiveDay40(calendarDayByDate(c, date)) <- 0.00;
    hoursFiveDay36(calendarDayByDate(c, date)) <- 0.00;
}

generateOfficialCalendarDays2026(ProductionCalendar c) {
    FOR iterate(DATE date, 2026_01_01, 2026_12_31) ORDER date DO
        createDefaultCalendarDay2026(c, date);

    setHoliday2026(c, 2026_01_01, 'Новый год');
    setHoliday2026(c, 2026_01_02, 'Новый год');
    setHoliday2026(c, 2026_01_07, 'Православное Рождество');
    setHoliday2026(c, 2026_03_08, 'Международный женский день');
    setHoliday2026(c, 2026_03_15, 'День Конституции Республики Казахстан');
    setHoliday2026(c, 2026_03_21, 'Наурыз мейрамы');
    setHoliday2026(c, 2026_03_22, 'Наурыз мейрамы');
    setHoliday2026(c, 2026_03_23, 'Наурыз мейрамы');
    setHoliday2026(c, 2026_05_01, 'Праздник единства народа Казахстана');
    setHoliday2026(c, 2026_05_07, 'День защитника Отечества');
    setHoliday2026(c, 2026_05_09, 'День Победы');
    setHoliday2026(c, 2026_05_27, 'Первый день Курбан-айта');
    setHoliday2026(c, 2026_07_06, 'День Столицы');
    setHoliday2026(c, 2026_10_25, 'День Республики');
    setHoliday2026(c, 2026_12_16, 'День Независимости');

    // Статья 84 ТК: это выходные, но не праздничные дни.
    // Поэтому они входят в продолжительность ежегодного отпуска.
    excludeFromAnnualLeave(calendarDayByDate(c, 2026_01_07)) <- NULL;
    excludeFromAnnualLeave(calendarDayByDate(c, 2026_05_27)) <- NULL;

    // Перенос 15 марта следует из статьи 3 Закона о праздниках и подтверждается
    // опубликованной годовой нормой. Остальные переносы перечислены календарём.
    setTransferredWeekendBoth2026(c, 2026_03_09, 'Перенос выходного с 8 марта');
    setTransferredWeekendBoth2026(c, 2026_03_16, 'Перенос выходного с 15 марта');
    setTransferredWeekendBoth2026(c, 2026_03_24, 'Перенос выходного Наурыз мейрамы');
    setTransferredWeekendFiveDay2026(c, 2026_03_25, 'Перенос выходного Наурыз мейрамы');
    setTransferredWeekendFiveDay2026(c, 2026_05_11, 'Перенос выходного с 9 мая');
    setTransferredWeekendBoth2026(c, 2026_10_26, 'Перенос выходного с 25 октября');
}

updateAnnualLeaveExclusions2026(ProductionCalendar c) {
    setHoliday2026(c, 2026_01_01, 'Новый год');
    setHoliday2026(c, 2026_01_02, 'Новый год');
    setHoliday2026(c, 2026_03_08, 'Международный женский день');
    setHoliday2026(c, 2026_03_15, 'День Конституции Республики Казахстан');
    setHoliday2026(c, 2026_03_21, 'Наурыз мейрамы');
    setHoliday2026(c, 2026_03_22, 'Наурыз мейрамы');
    setHoliday2026(c, 2026_03_23, 'Наурыз мейрамы');
    setHoliday2026(c, 2026_05_01, 'Праздник единства народа Казахстана');
    setHoliday2026(c, 2026_05_07, 'День защитника Отечества');
    setHoliday2026(c, 2026_05_09, 'День Победы');
    setHoliday2026(c, 2026_07_06, 'День Столицы');
    setHoliday2026(c, 2026_10_25, 'День Республики');
    setHoliday2026(c, 2026_12_16, 'День Независимости');
    excludeFromAnnualLeave(calendarDayByDate(c, 2026_01_07)) <- NULL;
    excludeFromAnnualLeave(calendarDayByDate(c, 2026_05_27)) <- NULL;
}

// Официальная годовая норма загружается идемпотентно. Детальные дни календаря
// остаются редактируемыми: переносы выходных могут меняться отдельным актом.
loadOfficialCalendar2026() {
    NEWSESSION {
        IF NOT calendarByYear(2026) THEN {
            NEW c = ProductionCalendar {
                calendarYear(c) <- 2026;
                calendarName(c) <- 'Производственный календарь РК на 2026 год';
                calendarSourceUrl(c) <- 'https://www.gov.kz/article/16887';
                calendarVerifiedOn(c) <- 2026_08_30;
            }
        }

        IF NOT normCount(calendarByYear(2026)) THEN {
            NEW n = WorkTimeNorm {
                normCalendar(n) <- calendarByYear(2026);
                normPeriodFrom(n) <- 2026_01_01;
                normPeriodTo(n) <- 2026_12_31;
                normDaysFiveDay(n) <- 246;
                normDaysSixDay(n) <- 298;
                normHoursFiveDay40(n) <- 1968.00;
                normHoursSixDay40(n) <- 1986.00;
                normHoursFiveDay36(n) <- 1771.20;
                normHoursSixDay36(n) <- 1788.00;
            }
        }

        IF NOT calendarDayCount(calendarByYear(2026)) THEN
            generateOfficialCalendarDays2026(calendarByYear(2026));
        updateAnnualLeaveExclusions2026(calendarByYear(2026));
        APPLY;
    }
}

onStarted() + { loadOfficialCalendar2026(); }
