MODULE KZAccessControl;

REQUIRE Security, KZOrganization, HRDepartment, HRPosition, HRStaffSchedule,
        HREmployment, HREmployeeCard, TimeWorkSchedule, TimeTimesheet, HRLeave,
        HRVacationSchedule, HRBusinessTrip, HRApproval, HRArchive,
        HRAccidentInsurance, HRPrintForms,
        PayrollSickLeave, PayrollInterimPayment, PayrollRecalculation,
        TaxesKZSocialPayments, TaxesKZIncomeTax, PayrollSettlement,
        PayrollPayments, PayrollEnforcement, PayrollCivilContract,
        PayrollCivilContractPayments, TaxesKZSocialTransferRegisters,
        ReportsKZForm20005;
NAMESPACE ZUPKZ;

employeeAllowed(Employee worker) = GROUP MAX organizationAllowed(organization(Employment contract))
    IF employee(contract) == worker;

// UI-фильтры не являются границей безопасности. Эти constraints запрещают
// любой workflow-переход чужой организации, включая Action API и прямой APPLY.
CONSTRAINT CHANGED(archiveCaseStatus(ArchiveCase c)) AND
           NOT organizationActionAllowed(archiveCaseOrganization(c))
    MESSAGE 'Нет доступа к архивному делу этой организации';
CONSTRAINT CHANGED(archiveDocumentStatus(ArchiveDocument d)) AND
           NOT organizationActionAllowed(archiveCaseOrganization(archiveDocumentCase(d)))
    MESSAGE 'Нет доступа к архивному документу этой организации';
CONSTRAINT CHANGED(form200Status(Form200Declaration d)) AND
           NOT organizationActionAllowed(form200Organization(d))
    MESSAGE 'Нет доступа к форме 200.00 этой организации';
CONSTRAINT CHANGED(personnelNoticeStatus(PersonnelNotice n)) AND
           NOT organizationActionAllowed(personnelNoticeOrganization(n))
    MESSAGE 'Нет доступа к уведомлению этой организации';
CONSTRAINT CHANGED(approvalStatus(ApprovalRequest r)) AND
           NOT organizationActionAllowed(approvalOrganization(r))
    MESSAGE 'Нет доступа к согласованию этой организации';
CONSTRAINT CHANGED(approvalStepStatus(ApprovalStep s)) AND
           NOT organizationActionAllowed(approvalOrganization(approvalStepRequest(s)))
    MESSAGE 'Нет доступа к этапу согласования этой организации';
CONSTRAINT CHANGED(vacationScheduleStatus(VacationSchedule s)) AND
           NOT organizationActionAllowed(vacationScheduleOrganization(s))
    MESSAGE 'Нет доступа к графику отпусков этой организации';
CONSTRAINT CHANGED(averageStatus(AverageEarningsDocument d)) AND
           NOT organizationActionAllowed(organization(employment(averageAssignment(d))))
    MESSAGE 'Нет доступа к среднему заработку этой организации';
CONSTRAINT CHANGED(recalculationStatus(PayrollRecalculation d)) AND
           NOT organizationActionAllowed(payrollOrganization(recalculationTargetRun(d)))
    MESSAGE 'Нет доступа к перерасчёту этой организации';
CONSTRAINT CHANGED(tripStatus(BusinessTripDocument d)) AND
           NOT organizationActionAllowed(tripOrganization(d))
    MESSAGE 'Нет доступа к командировке этой организации';
CONSTRAINT CHANGED(enforcementStatus(EnforcementOrder o)) AND
           NOT organizationActionAllowed(enforcementOrganization(o))
    MESSAGE 'Нет доступа к исполнительному документу этой организации';
CONSTRAINT CHANGED(enforcementCalculationStatus(EnforcementCalculationDocument d)) AND
           NOT organizationActionAllowed(payrollOrganization(
               taxCalculationPayrollRun(enforcementTaxCalculation(d))))
    MESSAGE 'Нет доступа к расчёту взысканий этой организации';
CONSTRAINT CHANGED(civilContractStatus(CivilContract c)) AND
           NOT organizationActionAllowed(civilContractOrganization(c))
    MESSAGE 'Нет доступа к договору ГПХ этой организации';
CONSTRAINT CHANGED(civilActStatus(CivilContractAct a)) AND
           NOT organizationActionAllowed(civilContractOrganization(civilActContract(a)))
    MESSAGE 'Нет доступа к акту ГПХ этой организации';
CONSTRAINT CHANGED(civilLiabilityStatus(CivilLiabilityDocument d)) AND
           NOT organizationActionAllowed(civilContractOrganization(
               civilActContract(civilLiabilityAct(d))))
    MESSAGE 'Нет доступа к платежам ГПХ этой организации';
CONSTRAINT CHANGED(interimPaymentStatus(InterimPayment p)) AND
           NOT organizationActionAllowed(organization(employment(interimPaymentAssignment(p))))
    MESSAGE 'Нет доступа к межрасчётной выплате этой организации';
CONSTRAINT CHANGED(sickLeaveStatus(SickLeaveDocument d)) AND
           NOT organizationActionAllowed(organization(employment(sickLeaveAssignment(d))))
    MESSAGE 'Нет доступа к больничному этой организации';
CONSTRAINT CHANGED(payrollRunStatus(PayrollRun r)) AND
           NOT organizationActionAllowed(payrollOrganization(r))
    MESSAGE 'Нет доступа к расчёту зарплаты этой организации';
CONSTRAINT CHANGED(taxCalculationStatus(TaxCalculationDocument d)) AND
           NOT organizationActionAllowed(payrollOrganization(taxCalculationPayrollRun(d)))
    MESSAGE 'Нет доступа к расчёту налогов этой организации';
CONSTRAINT CHANGED(leaveStatus(LeaveDocument l)) AND
           NOT organizationActionAllowed(organization(employment(leaveAssignment(l))))
    MESSAGE 'Нет доступа к отпуску этой организации';
CONSTRAINT CHANGED(paymentStatementStatus(PaymentStatement d)) AND
           NOT organizationActionAllowed(payrollOrganization(paymentStatementPayrollRun(d)))
    MESSAGE 'Нет доступа к платёжной ведомости этой организации';
CONSTRAINT CHANGED(bankRegisterStatus(SalaryBankRegister r)) AND
           NOT organizationActionAllowed(bankRegisterOrganization(r))
    MESSAGE 'Нет доступа к банковскому реестру этой организации';
CONSTRAINT CHANGED(liabilityStatus(PayrollLiabilityDocument d)) AND
           NOT organizationActionAllowed(payrollOrganization(liabilityPayrollRun(d)))
    MESSAGE 'Нет доступа к обязательным платежам этой организации';
CONSTRAINT CHANGED(socialPaymentStatus(SocialPaymentDocument d)) AND
           NOT organizationActionAllowed(payrollOrganization(socialPaymentPayrollRun(d)))
    MESSAGE 'Нет доступа к социальным платежам этой организации';
CONSTRAINT CHANGED(socialTransferStatus(SocialTransferRegister r)) AND
           NOT organizationActionAllowed(socialTransferOrganization(r))
    MESSAGE 'Нет доступа к реестру социальных платежей этой организации';
CONSTRAINT CHANGED(eventStatus(PersonnelEvent e)) AND
           NOT organizationActionAllowed(organization(eventEmployment(e)))
    MESSAGE 'Нет доступа к кадровому событию этой организации';
CONSTRAINT CHANGED(esutdStatus(PersonnelEvent e)) AND
           NOT organizationActionAllowed(organization(eventEmployment(e)))
    MESSAGE 'Нет доступа к ЕСУТД этой организации';
CONSTRAINT CHANGED(insurancePolicyStatus(AccidentInsurancePolicy p)) AND
           NOT organizationActionAllowed(insurancePolicyOrganization(p))
    MESSAGE 'Нет доступа к страховому договору этой организации';
CONSTRAINT CHANGED(workAccidentStatus(WorkAccident a)) AND
           NOT organizationActionAllowed(workAccidentOrganization(a))
    MESSAGE 'Нет доступа к несчастному случаю этой организации';
CONSTRAINT CHANGED(insuranceClaimStatus(AccidentInsuranceClaim c)) AND
           NOT organizationActionAllowed(workAccidentOrganization(insuranceClaimAccident(c)))
    MESSAGE 'Нет доступа к страховому требованию этой организации';
CONSTRAINT CHANGED(timesheetStatus(Timesheet t)) AND
           NOT organizationActionAllowed(timesheetOrganization(t))
    MESSAGE 'Нет доступа к табелю этой организации';

accessUserLogin 'Логин пользователя' (UserOrganizationAccess access) =
    login(accessUser(access) AS CustomUser);
accessOrganizationName 'Название организации' (UserOrganizationAccess access) =
    name(accessOrganization(access));

FORM userOrganizationAccesses 'Доступ к организациям'
    OBJECTS a = UserOrganizationAccess
    PROPERTIES(a) accessUser, accessOrganization, accessActive
    PROPERTIES(a) READONLY accessUserLogin, accessOrganizationName
;

denyBusinessFolders(UserRole role) {
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.masterData')) <- Permission.forbid;
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.legislation')) <- Permission.forbid;
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.personnel')) <- Permission.forbid;
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.workingTime')) <- Permission.forbid;
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.payroll')) <- Permission.forbid;
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.taxesKz')) <- Permission.forbid;
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.reportsKz')) <- Permission.forbid;
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.accessAdministration')) <- Permission.forbid;
}

permitBusinessFolders(UserRole role) {
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.masterData')) <- Permission.permit;
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.legislation')) <- Permission.permit;
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.personnel')) <- Permission.permit;
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.workingTime')) <- Permission.permit;
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.payroll')) <- Permission.permit;
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.taxesKz')) <- Permission.permit;
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.reportsKz')) <- Permission.permit;
}

ensureZupRoles() {
    IF NOT userRoleSID('zup_hr') THEN NEW role = UserRole {
        sid(role) <- 'zup_hr';
        name(role) <- 'ZUP KZ — HR';
    }
    IF NOT userRoleSID('zup_timekeeper') THEN NEW role = UserRole {
        sid(role) <- 'zup_timekeeper';
        name(role) <- 'ZUP KZ — Timekeeper';
    }
    IF NOT userRoleSID('zup_payroll') THEN NEW role = UserRole {
        sid(role) <- 'zup_payroll';
        name(role) <- 'ZUP KZ — Payroll';
    }
    IF NOT userRoleSID('zup_chief_accountant') THEN NEW role = UserRole {
        sid(role) <- 'zup_chief_accountant';
        name(role) <- 'ZUP KZ — Chief accountant';
    }
    IF NOT userRoleSID('zup_auditor') THEN NEW role = UserRole {
        sid(role) <- 'zup_auditor';
        name(role) <- 'ZUP KZ — Auditor';
    }

}

applyZupRolePermissions() {
    // Пользователей ЗУП создаёт администратор; публичная регистрация запрещена.
    disableRole(userRoleSID('selfRegister')) <- TRUE;

    denyBusinessFolders(userRoleSID('zup_hr'));
    denyBusinessFolders(userRoleSID('zup_timekeeper'));
    denyBusinessFolders(userRoleSID('zup_payroll'));
    denyBusinessFolders(userRoleSID('zup_chief_accountant'));
    denyBusinessFolders(userRoleSID('zup_auditor'));

    dataPermission(userRoleSID('zup_hr'),
        navigatorElementCanonicalName('ZUPKZ.masterData')) <- Permission.permit;
    dataPermission(userRoleSID('zup_hr'),
        navigatorElementCanonicalName('ZUPKZ.personnel')) <- Permission.permit;

    dataPermission(userRoleSID('zup_timekeeper'),
        navigatorElementCanonicalName('ZUPKZ.masterData')) <- Permission.permit;
    dataPermission(userRoleSID('zup_timekeeper'),
        navigatorElementCanonicalName('ZUPKZ.workingTime')) <- Permission.permit;

    dataPermission(userRoleSID('zup_payroll'),
        navigatorElementCanonicalName('ZUPKZ.masterData')) <- Permission.permit;
    dataPermission(userRoleSID('zup_payroll'),
        navigatorElementCanonicalName('ZUPKZ.legislation')) <- Permission.permit;
    dataPermission(userRoleSID('zup_payroll'),
        navigatorElementCanonicalName('ZUPKZ.payroll')) <- Permission.permit;

    permitBusinessFolders(userRoleSID('zup_chief_accountant'));
    permitBusinessFolders(userRoleSID('zup_auditor'));
    dataPermissionChange(userRoleSID('zup_auditor'), propertyGroup('System_root')) <- Permission.forbid;
    dataPermissionEditObjects(userRoleSID('zup_auditor'), propertyGroup('System_root')) <- Permission.forbid;
    // Только два действия чтения. Право изменения данных аудитору не выдаётся.
    dataPermissionChange(userRoleSID('zup_auditor'),
        actionCanonicalName('ZUPKZ.openPayrollSettlement[ZUPKZ.PayrollSettlementLine]')) <- Permission.permit;
    dataPermissionChange(userRoleSID('zup_auditor'),
        actionCanonicalName('ZUPKZ.printPayrollSettlementPdf[ZUPKZ.PayrollSettlementLine]')) <- Permission.permit;
}

loadZupRoles() {
    // userRoleSID is materialized: use a fresh session after creating roles.
    NEWSESSION {
        ensureZupRoles();
        APPLY;
    }
    NEWSESSION {
        applyZupRolePermissions();
        APPLY;
    }
}

// Initial synchronization and permission assignment are distinct platform phases.
// This guarantees that materialized userRoleSID resolves newly created roles.
onStarted() + { ensureZupRoles(); }
onFinallyStarted() + { applyZupRolePermissions(); }

