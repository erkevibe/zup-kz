MODULE PayrollCivilContract;

REQUIRE TaxesKZIncomeTax;
NAMESPACE ZUPKZ;

// Договор ГПХ — самостоятельный источник дохода физического лица. Он не
// создаёт трудовые отношения и не использует кадровое назначение/табель.
CLASS CivilContractStatus 'Статус договора ГПХ' {
    draft 'Черновик',
    active 'Действует',
    closed 'Закрыт',
    cancelled 'Отменён'
}

CLASS CivilContract 'Договор ГПХ';

civilContractOrganization 'Организация' = DATA Organization (CivilContract);
civilContractContractor 'Исполнитель' = DATA Employee (CivilContract);
civilContractNumber 'Номер договора' = DATA STRING[50] (CivilContract);
civilContractDate 'Дата договора' = DATA DATE (CivilContract);
civilContractFrom 'Начало работ' = DATA DATE (CivilContract);
civilContractTo 'Окончание работ' = DATA DATE (CivilContract);
civilContractSubject 'Предмет договора' = DATA STRING[500] (CivilContract);
civilContractAmount 'Сумма договора' = DATA NUMERIC[18,2] (CivilContract);
civilContractStatus 'Статус' = DATA CivilContractStatus (CivilContract);
civilContractLifecycleTransition = DATA LOCAL BOOLEAN (CivilContract);

CONSTRAINT civilContractTo(CivilContract c) < civilContractFrom(c)
    MESSAGE 'Окончание договора ГПХ не может быть раньше начала';
CONSTRAINT CHANGED(civilContractStatus(CivilContract c)) AND PREV(civilContractStatus(c)) AND
           NOT civilContractLifecycleTransition(c)
    MESSAGE 'Статус договора ГПХ изменяется только штатными действиями';

CLASS CivilContractActStatus 'Статус акта ГПХ' {
    draft 'Черновик',
    calculated 'Рассчитан',
    approved 'Утверждён',
    paid 'Выплачен',
    cancelled 'Отменён'
}

CLASS CivilContractAct 'Акт выполненных работ ГПХ';

civilActContract 'Договор' = DATA CivilContract (CivilContractAct);
civilActNumber 'Номер акта' = DATA STRING[50] (CivilContractAct);
civilActDate 'Дата акта' = DATA DATE (CivilContractAct);
civilActGrossIncome 'Начисленный доход' = DATA NUMERIC[18,2] (CivilContractAct);
civilActStatus 'Статус' = DATA CivilContractActStatus (CivilContractAct);
civilActCalculatedAt 'Рассчитан' = DATA DATETIME (CivilContractAct);
civilActApprovedAt 'Утверждён' = DATA DATETIME (CivilContractAct);
civilActPaymentDate 'Дата выплаты' = DATA DATE (CivilContractAct);
civilActPaymentReference 'Платёжный документ' = DATA STRING[100] (CivilContractAct);
civilActPaidAt 'Выплачен' = DATA DATETIME (CivilContractAct);
civilActLifecycleTransition = DATA LOCAL BOOLEAN (CivilContractAct);

CONSTRAINT CHANGED(civilActStatus(CivilContractAct a)) AND PREV(civilActStatus(a)) AND
           NOT civilActLifecycleTransition(a)
    MESSAGE 'Статус акта ГПХ изменяется только штатными действиями';

// Снимок законодательства и результата защищает уже утверждённый расчёт от
// последующего изменения ставок в справочнике.
civilActResident 'Налоговый резидент' = DATA BOOLEAN (CivilContractAct);
civilActCategoryCodes 'Категории 200.05' = DATA STRING[30] (CivilContractAct);
civilActAifc 'МФЦА' = DATA BOOLEAN (CivilContractAct);
civilActUnregisteredDivision 'Структурное подразделение' = DATA BOOLEAN (CivilContractAct);
civilActOpvBase 'База ОПВ' = DATA NUMERIC[18,2] (CivilContractAct);
civilActOpv 'ОПВ' = DATA NUMERIC[18,2] (CivilContractAct);
civilActVosmsBase 'База ВОСМС' = DATA NUMERIC[18,2] (CivilContractAct);
civilActVosms 'ВОСМС' = DATA NUMERIC[18,2] (CivilContractAct);
civilActSoBase 'База СО' = DATA NUMERIC[18,2] (CivilContractAct);
civilActSo 'Социальные отчисления' = DATA NUMERIC[18,2] (CivilContractAct);
civilActBasicDeduction 'Базовый вычет ИПН' = DATA NUMERIC[18,2] (CivilContractAct);
civilActSocialDeduction 'Социальный вычет ИПН' = DATA NUMERIC[18,2] (CivilContractAct);
civilActDeductionCodes 'Коды вычетов 200.05' = DATA STRING[10] (CivilContractAct);
civilActTaxableIncome 'Облагаемый доход ИПН' = DATA NUMERIC[18,2] (CivilContractAct);
civilActIpnThreshold 'Годовой порог ИПН' = DATA NUMERIC[18,2] (CivilContractAct);
civilActIpnBaseRate 'Базовая ставка ИПН, %' = DATA NUMERIC[18,6] (CivilContractAct);
civilActIpnHighRate 'Повышенная ставка ИПН, %' = DATA NUMERIC[18,6] (CivilContractAct);
civilActIpn 'ИПН' = DATA NUMERIC[18,2] (CivilContractAct);
civilActPayable 'К выплате' = DATA NUMERIC[18,2] (CivilContractAct);
civilActRegulatoryPack 'Нормативный набор' = DATA RegulatoryPack (CivilContractAct);
civilActTaxLedgerEntry 'Запись регистра ИПН' = DATA PersonalTaxLedgerEntry (CivilContractAct);
civilActTaxReversalLedgerEntry 'Сторнирующая запись регистра ИПН' =
    DATA PersonalTaxLedgerEntry (CivilContractAct);

CONSTRAINT CHANGED(civilActContract(CivilContractAct a)) AND
           PREV(civilActStatus(a)) != CivilContractActStatus.draft
    MESSAGE 'Нельзя изменить договор проведённого акта ГПХ';
CONSTRAINT CHANGED(civilActGrossIncome(CivilContractAct a)) AND
           PREV(civilActStatus(a)) != CivilContractActStatus.draft
    MESSAGE 'Нельзя изменить доход проведённого акта ГПХ';
CONSTRAINT (CHANGED(civilActDate(CivilContractAct a)) OR
            CHANGED(civilActResident(a)) OR CHANGED(civilActCategoryCodes(a)) OR
            CHANGED(civilActAifc(a)) OR CHANGED(civilActUnregisteredDivision(a)) OR
            CHANGED(civilActOpvBase(a)) OR CHANGED(civilActOpv(a)) OR
            CHANGED(civilActVosmsBase(a)) OR CHANGED(civilActVosms(a)) OR
            CHANGED(civilActSoBase(a)) OR CHANGED(civilActSo(a)) OR
            CHANGED(civilActBasicDeduction(a)) OR CHANGED(civilActSocialDeduction(a)) OR
            CHANGED(civilActDeductionCodes(a)) OR CHANGED(civilActTaxableIncome(a)) OR
            CHANGED(civilActIpnThreshold(a)) OR CHANGED(civilActIpnBaseRate(a)) OR
            CHANGED(civilActIpnHighRate(a)) OR CHANGED(civilActIpn(a)) OR
            CHANGED(civilActPayable(a)) OR CHANGED(civilActRegulatoryPack(a)) OR
            CHANGED(civilActTaxLedgerEntry(a))) AND
           PREV(civilActStatus(a)) != CivilContractActStatus.draft
    MESSAGE 'Нельзя изменить снимок рассчитанного акта ГПХ';

civilActOrganization(CivilContractAct a) = civilContractOrganization(civilActContract(a));
civilActContractor(CivilContractAct a) = civilContractContractor(civilActContract(a));
civilActTaxProfile(CivilContractAct a) =
    employeeTaxProfileOn(civilActOrganization(a), civilActContractor(a), civilActDate(a));
civilActSocialProfile(CivilContractAct a) =
    socialPaymentProfileOn(civilActOrganization(a), civilActContractor(a), civilActDate(a));
civilActMZP(CivilContractAct a) =
    numericStatutoryValueOn(statutoryParameterByCode('MZP'), civilActDate(a));
civilActMRP(CivilContractAct a) =
    numericStatutoryValueOn(statutoryParameterByCode('MRP'), civilActDate(a));
civilActParameter(CivilContractAct a, STRING[50] code) =
    numericStatutoryValueOn(statutoryParameterByCode(code), civilActDate(a));
missingCivilActStatutoryParameter(DATE date) =
    missingSocialStatutoryParameter(date) OR missingTaxStatutoryParameter(date);

calculatedCivilActOpvBase(CivilContractAct a) = socialCappedBase(
    civilActGrossIncome(a), civilActMZP(a) * civilActParameter(a, 'OPV_MAX_MZP'));
calculatedCivilActOpv(CivilContractAct a) =
    IF socialProfileOpvExempt(civilActSocialProfile(a)) THEN 0.00
    ELSE socialPaymentAmount(calculatedCivilActOpvBase(a), civilActParameter(a, 'OPV_RATE'));
calculatedCivilActVosmsBase(CivilContractAct a) = socialCappedBase(
    civilActGrossIncome(a), civilActMZP(a) * civilActParameter(a, 'VOSMS_MAX_MZP'));
calculatedCivilActVosms(CivilContractAct a) =
    IF socialProfileVosmsExempt(civilActSocialProfile(a)) THEN 0.00
    ELSE socialPaymentAmount(calculatedCivilActVosmsBase(a), civilActParameter(a, 'VOSMS_RATE'));
calculatedCivilActSoBase(CivilContractAct a) = socialCappedBase(
    taxPositive(civilActGrossIncome(a) - civilActOpv(a)),
    civilActMZP(a) * civilActParameter(a, 'SO_MAX_MZP'));
calculatedCivilActSo(CivilContractAct a) =
    IF socialProfileSoExempt(civilActSocialProfile(a)) THEN 0.00
    ELSE socialPaymentAmount(calculatedCivilActSoBase(a), civilActParameter(a, 'SO_RATE'));

civilActIncomeAfterSocialPayments(CivilContractAct a) = taxPositive(
    civilActGrossIncome(a) - civilActOpv(a) - civilActVosms(a) - civilActSo(a));
civilActPriorBasicDeduction(CivilContractAct a) = GROUP SUM
    taxLedgerBasicDeduction(PersonalTaxLedgerEntry e) IF
    taxLedgerOrganization(e) == civilActOrganization(a) AND
    taxLedgerEmployee(e) == civilActContractor(a) AND
    extractYear(taxLedgerDate(e)) == extractYear(civilActDate(a)) AND
    taxLedgerDate(e) <= civilActDate(a);
civilActBasicAvailable(CivilContractAct a) = taxPositive(
    civilActMRP(a) * civilActParameter(a, 'IPN_BASIC_ANNUAL_MRP') -
    (IF civilActPriorBasicDeduction(a) THEN civilActPriorBasicDeduction(a) ELSE 0.00));
calculatedCivilActBasicDeduction(CivilContractAct a) =
    IF taxProfileResident(civilActTaxProfile(a)) AND
       taxProfileBasicDeduction(civilActTaxProfile(a)) THEN
        taxMinimum(civilActIncomeAfterSocialPayments(a),
            taxMinimum(civilActMRP(a) * civilActParameter(a, 'IPN_BASIC_MONTHLY_MRP'),
                       civilActBasicAvailable(a)))
    ELSE 0.00;

civilActSocialLimit(CivilContractAct a) =
    IF taxProfileSocialDeduction(civilActTaxProfile(a)) ==
            IpnSocialDeductionKind.disabilityOneTwo THEN
        civilActMRP(a) * civilActParameter(a, 'IPN_SOCIAL_DISABILITY_MRP')
    ELSE IF taxProfileSocialDeduction(civilActTaxProfile(a)) ==
                 IpnSocialDeductionKind.protectedCategory OR
            taxProfileSocialDeduction(civilActTaxProfile(a)) ==
                 IpnSocialDeductionKind.protectedDependent THEN
        civilActMRP(a) * civilActParameter(a, 'IPN_SOCIAL_STANDARD_MRP')
    ELSE 0.00;
civilActPriorSocialDeduction(CivilContractAct a) = GROUP SUM
    taxLedgerSocialDeduction(PersonalTaxLedgerEntry e) IF
    taxLedgerOrganization(e) == civilActOrganization(a) AND
    taxLedgerEmployee(e) == civilActContractor(a) AND
    extractYear(taxLedgerDate(e)) == extractYear(civilActDate(a)) AND
    taxLedgerDate(e) <= civilActDate(a);
civilActSocialAvailable(CivilContractAct a) = taxPositive(
    civilActSocialLimit(a) -
    (IF civilActPriorSocialDeduction(a) THEN civilActPriorSocialDeduction(a) ELSE 0.00));
calculatedCivilActSocialDeduction(CivilContractAct a) =
    IF taxProfileResident(civilActTaxProfile(a)) THEN
        taxMinimum(
            taxPositive(civilActIncomeAfterSocialPayments(a) -
                calculatedCivilActBasicDeduction(a)),
            civilActSocialAvailable(a))
    ELSE 0.00;
calculatedCivilActTaxableIncome(CivilContractAct a) =
    IF taxProfileResident(civilActTaxProfile(a)) THEN
        taxPositive(civilActIncomeAfterSocialPayments(a) - calculatedCivilActBasicDeduction(a) -
            calculatedCivilActSocialDeduction(a))
    ELSE civilActGrossIncome(a);
civilActPriorTaxableIncome(CivilContractAct a) = GROUP SUM
    taxLedgerTaxableIncome(PersonalTaxLedgerEntry e) IF
    taxLedgerOrganization(e) == civilActOrganization(a) AND
    taxLedgerEmployee(e) == civilActContractor(a) AND
    extractYear(taxLedgerDate(e)) == extractYear(civilActDate(a)) AND
    taxLedgerDate(e) <= civilActDate(a);
calculatedCivilActIpn(CivilContractAct a) =
    IF taxProfileResident(civilActTaxProfile(a)) THEN
        progressiveIpn(
            (IF civilActPriorTaxableIncome(a) THEN civilActPriorTaxableIncome(a) ELSE 0.00) +
                civilActTaxableIncome(a),
            civilActIpnThreshold(a), civilActIpnBaseRate(a), civilActIpnHighRate(a)) -
        (IF progressiveIpn(civilActPriorTaxableIncome(a),
                           civilActIpnThreshold(a), civilActIpnBaseRate(a),
                           civilActIpnHighRate(a)) THEN
             progressiveIpn(civilActPriorTaxableIncome(a),
                            civilActIpnThreshold(a), civilActIpnBaseRate(a),
                            civilActIpnHighRate(a))
         ELSE 0.00)
    ELSE socialPaymentAmount(civilActGrossIncome(a),
        civilActParameter(a, 'IPN_NONRESIDENT_CIVIL_RATE'));
calculatedCivilActPayable(CivilContractAct a) = civilActGrossIncome(a) -
    civilActOpv(a) - civilActVosms(a) - civilActSo(a) - civilActIpn(a);

duplicateCivilActCount(CivilContractAct a) = GROUP SUM 1 IF
    civilActContract(CivilContractAct other) == civilActContract(a) AND
    civilActNumber(other) == civilActNumber(a);

activateCivilContract 'Активировать договор' (CivilContract c) {
    IF civilContractStatus(c) AND civilContractStatus(c) != CivilContractStatus.draft THEN
        MESSAGE 'Активировать можно только черновик договора';
    ELSE IF NOT civilContractOrganization(c) OR NOT civilContractContractor(c) OR
            NOT civilContractNumber(c) OR NOT civilContractDate(c) OR
            NOT civilContractFrom(c) OR NOT civilContractTo(c) OR
            NOT civilContractSubject(c) OR civilContractAmount(c) <= 0.00 THEN
        MESSAGE 'Заполните реквизиты договора и положительную сумму';
    ELSE {
        civilContractLifecycleTransition(c) <- TRUE;
        civilContractStatus(c) <- CivilContractStatus.active;
        APPLY;
    }
}

closeCivilContract 'Закрыть договор' (CivilContract c) {
    IF civilContractStatus(c) != CivilContractStatus.active THEN
        MESSAGE 'Закрыть можно только действующий договор';
    ELSE {
        civilContractLifecycleTransition(c) <- TRUE;
        civilContractStatus(c) <- CivilContractStatus.closed;
        APPLY;
    }
} CONFIRM;

cancelCivilContract 'Отменить договор' (CivilContract c) {
    IF civilContractStatus(c) AND civilContractStatus(c) != CivilContractStatus.draft THEN
        MESSAGE 'Отменить можно только черновик договора';
    ELSE {
        civilContractLifecycleTransition(c) <- TRUE;
        civilContractStatus(c) <- CivilContractStatus.cancelled;
        APPLY;
    }
} CONFIRM;

calculateCivilAct 'Рассчитать акт' (CivilContractAct a) {
    IF civilActStatus(a) AND civilActStatus(a) != CivilContractActStatus.draft THEN
        MESSAGE 'Акт уже рассчитан';
    ELSE IF NOT civilActContract(a) OR
            civilContractStatus(civilActContract(a)) != CivilContractStatus.active OR
            NOT civilActNumber(a) OR NOT civilActDate(a) OR civilActGrossIncome(a) <= 0.00 THEN
        MESSAGE 'Укажите действующий договор, номер, дату и положительную сумму акта';
    ELSE IF duplicateCivilActCount(a) > 1 THEN
        MESSAGE 'Номер акта должен быть уникален в пределах договора';
    ELSE IF civilActDate(a) < civilContractFrom(civilActContract(a)) OR
            civilActDate(a) > civilContractTo(civilActContract(a)) THEN
        MESSAGE 'Дата акта должна входить в срок договора';
    ELSE IF NOT iin(civilActContractor(a)) OR length(iin(civilActContractor(a))) != 12 THEN
        MESSAGE 'Заполните ИИН исполнителя (12 цифр)';
    ELSE IF NOT civilActTaxProfile(a) OR
            NOT taxProfileIncomeStatus(civilActTaxProfile(a)) OR
            taxProfileIncomeStatus(civilActTaxProfile(a)) != TaxIncomeStatus.civilContract THEN
        MESSAGE 'Укажите действующий налоговый профиль со статусом дохода «Договор ГПХ»';
    ELSE IF NOT approvedRegulatoryPackOn(civilActDate(a)) OR
            missingCivilActStatutoryParameter(civilActDate(a)) THEN
        MESSAGE 'Нет утверждённого и полного нормативного набора для даты акта ГПХ';
    ELSE IF NOT taxProfileResident(civilActTaxProfile(a)) AND
            (NOT civilActSocialProfile(a) OR
             NOT socialProfileBasis(civilActSocialProfile(a)) OR
             NOT socialProfileLegalSource(civilActSocialProfile(a))) THEN
        MESSAGE 'Для нерезидента укажите профиль ОПВ, ВОСМС и СО с нормативным основанием';
    ELSE {
        civilActResident(a) <- taxProfileResident(civilActTaxProfile(a));
        civilActCategoryCodes(a) <- taxProfileCategoryCodes(civilActTaxProfile(a));
        civilActAifc(a) <- taxProfileAifc(civilActTaxProfile(a));
        civilActUnregisteredDivision(a) <-
            taxProfileUnregisteredDivision(civilActTaxProfile(a));
        civilActOpvBase(a) <- calculatedCivilActOpvBase(a);
        civilActOpv(a) <-
            IF socialProfileOpvExempt(civilActSocialProfile(a)) THEN 0.00
            ELSE socialPaymentAmount(civilActOpvBase(a), civilActParameter(a, 'OPV_RATE'));
        civilActVosmsBase(a) <- calculatedCivilActVosmsBase(a);
        civilActVosms(a) <-
            IF socialProfileVosmsExempt(civilActSocialProfile(a)) THEN 0.00
            ELSE socialPaymentAmount(civilActVosmsBase(a), civilActParameter(a, 'VOSMS_RATE'));
        civilActSoBase(a) <- calculatedCivilActSoBase(a);
        civilActSo(a) <-
            IF socialProfileSoExempt(civilActSocialProfile(a)) THEN 0.00
            ELSE socialPaymentAmount(civilActSoBase(a), civilActParameter(a, 'SO_RATE'));
        civilActBasicDeduction(a) <-
            IF taxProfileResident(civilActTaxProfile(a)) THEN calculatedCivilActBasicDeduction(a)
            ELSE 0.00;
        civilActSocialDeduction(a) <-
            IF taxProfileResident(civilActTaxProfile(a)) THEN calculatedCivilActSocialDeduction(a)
            ELSE 0.00;
        civilActDeductionCodes(a) <-
            (IF calculatedCivilActBasicDeduction(a) > 0.00 THEN '1' ELSE '') +
            (IF calculatedCivilActSocialDeduction(a) > 0.00 THEN
                (IF calculatedCivilActBasicDeduction(a) > 0.00 THEN ',' ELSE '') +
                (IF taxProfileSocialDeduction(civilActTaxProfile(a)) ==
                        IpnSocialDeductionKind.disabilityOneTwo THEN '2'
                 ELSE IF taxProfileSocialDeduction(civilActTaxProfile(a)) ==
                        IpnSocialDeductionKind.protectedDependent THEN '4' ELSE '3')
             ELSE '');
        civilActTaxableIncome(a) <- calculatedCivilActTaxableIncome(a);
        civilActIpnThreshold(a) <- IF taxProfileResident(civilActTaxProfile(a)) THEN
            civilActMRP(a) * civilActParameter(a, 'IPN_THRESHOLD_MRP') ELSE 0.00;
        civilActIpnBaseRate(a) <- IF taxProfileResident(civilActTaxProfile(a)) THEN
            civilActParameter(a, 'IPN_BASE_RATE')
            ELSE civilActParameter(a, 'IPN_NONRESIDENT_CIVIL_RATE');
        civilActIpnHighRate(a) <- IF taxProfileResident(civilActTaxProfile(a)) THEN
            civilActParameter(a, 'IPN_HIGH_RATE')
            ELSE civilActParameter(a, 'IPN_NONRESIDENT_CIVIL_RATE');
        civilActIpn(a) <- calculatedCivilActIpn(a);
        civilActPayable(a) <- calculatedCivilActPayable(a);
        civilActRegulatoryPack(a) <- approvedRegulatoryPackOn(civilActDate(a));
        NEW e = PersonalTaxLedgerEntry {
            taxLedgerOrganization(e) <- civilActOrganization(a);
            taxLedgerEmployee(e) <- civilActContractor(a);
            taxLedgerDate(e) <- civilActDate(a);
            taxLedgerBasicDeduction(e) <- civilActBasicDeduction(a);
            taxLedgerSocialDeduction(e) <- civilActSocialDeduction(a);
            taxLedgerTaxableIncome(e) <- civilActTaxableIncome(a);
            taxLedgerIpn(e) <- civilActIpn(a);
            civilActTaxLedgerEntry(a) <- e;
        }
        civilActLifecycleTransition(a) <- TRUE;
        civilActStatus(a) <- CivilContractActStatus.calculated;
        civilActCalculatedAt(a) <- currentDateTime();
        APPLY;
    }
}

approveCivilAct 'Утвердить акт' (CivilContractAct a) {
    IF civilActStatus(a) == CivilContractActStatus.calculated THEN {
        civilActLifecycleTransition(a) <- TRUE;
        civilActStatus(a) <- CivilContractActStatus.approved;
        civilActApprovedAt(a) <- currentDateTime();
        APPLY;
    } ELSE MESSAGE 'Сначала рассчитайте акт';
}

cancelCivilAct 'Отменить и сторнировать' (CivilContractAct a) {
    IF civilActStatus(a) != CivilContractActStatus.calculated AND
       civilActStatus(a) != CivilContractActStatus.approved THEN
        MESSAGE 'Отменить можно только рассчитанный или утверждённый акт';
    ELSE IF civilActTaxReversalLedgerEntry(a) THEN
        MESSAGE 'Акт уже сторнирован';
    ELSE {
        NEW reversal = PersonalTaxLedgerEntry {
            taxLedgerOrganization(reversal) <- taxLedgerOrganization(civilActTaxLedgerEntry(a));
            taxLedgerEmployee(reversal) <- taxLedgerEmployee(civilActTaxLedgerEntry(a));
            taxLedgerDate(reversal) <- taxLedgerDate(civilActTaxLedgerEntry(a));
            taxLedgerBasicDeduction(reversal) <- -taxLedgerBasicDeduction(civilActTaxLedgerEntry(a));
            taxLedgerSocialDeduction(reversal) <- -taxLedgerSocialDeduction(civilActTaxLedgerEntry(a));
            taxLedgerTaxableIncome(reversal) <- -taxLedgerTaxableIncome(civilActTaxLedgerEntry(a));
            taxLedgerIpn(reversal) <- -taxLedgerIpn(civilActTaxLedgerEntry(a));
            taxLedgerReversalOf(reversal) <- civilActTaxLedgerEntry(a);
            civilActTaxReversalLedgerEntry(a) <- reversal;
        }
        civilActLifecycleTransition(a) <- TRUE;
        civilActStatus(a) <- CivilContractActStatus.cancelled;
        APPLY;
    }
} CONFIRM;

markCivilActPaid 'Отметить выплаченным' (CivilContractAct a) {
    IF civilActStatus(a) != CivilContractActStatus.approved THEN
        MESSAGE 'Выплатить можно только утверждённый акт';
    ELSE IF NOT civilActPaymentDate(a) OR NOT civilActPaymentReference(a) THEN
        MESSAGE 'Укажите дату и платёжный документ';
    ELSE IF civilActPaymentDate(a) < civilActDate(a) THEN
        MESSAGE 'Дата выплаты не может быть раньше даты акта';
    ELSE {
        civilActLifecycleTransition(a) <- TRUE;
        civilActStatus(a) <- CivilContractActStatus.paid;
        civilActPaidAt(a) <- currentDateTime();
        APPLY;
    }
}

FORM civilContracts 'Договоры ГПХ'
    OBJECTS c = CivilContract
    PROPERTIES(c) civilContractOrganization, civilContractContractor,
                  civilContractNumber, civilContractDate, civilContractFrom,
                  civilContractTo, civilContractSubject, civilContractAmount
    PROPERTIES(c) READONLY civilContractStatus
    PROPERTIES(c) activateCivilContract, closeCivilContract, cancelCivilContract
;

FORM civilContractActs 'Акты ГПХ'
    OBJECTS a = CivilContractAct
    PROPERTIES(a) civilActContract, civilActNumber, civilActDate,
                  civilActGrossIncome, civilActPaymentDate, civilActPaymentReference,
                  civilActResident, civilActCategoryCodes,
                  civilActOpvBase, civilActOpv, civilActVosmsBase, civilActVosms,
                  civilActSoBase, civilActSo, civilActBasicDeduction,
                  civilActSocialDeduction, civilActDeductionCodes,
                  civilActTaxableIncome, civilActIpnThreshold, civilActIpnBaseRate,
                  civilActIpnHighRate, civilActIpn, civilActPayable
    PROPERTIES(a) READONLY civilActStatus, civilActCalculatedAt,
                           civilActApprovedAt, civilActPaidAt, civilActRegulatoryPack
    PROPERTIES(a) calculateCivilAct, approveCivilAct, cancelCivilAct, markCivilActPaid
;
