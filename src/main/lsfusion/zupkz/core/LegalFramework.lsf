        ensureStatutoryValue(statutoryParameterByCode('OPVR_MIN_MZP'), 2026_01_01, NULL,
            1.000000, legalSourceByCode('SOCIAL_CODE_KZ'), 'Минимум 1 МЗП при наличии дохода');
        ensureStatutoryValue(statutoryParameterByCode('OPVR_MAX_MZP'), 2026_01_01, NULL,
            50.000000, legalSourceByCode('SOCIAL_CODE_KZ'), 'Максимум 50 МЗП в месяц');
