    CHANGED(leaveEntitlement(o)) OR
    CHANGED(leaveCalendar(o)) OR
    CHANGED(leaveWorkWeek(o)) OR
    CHANGED(leaveOutsideSchedule(o)) OR
    CHANGED(leaveAverageEarnings(o)) OR
    CHANGED(leaveBasis(o)) OR
    CHANGED(leaveStatus(o)) OR
    CHANGED(leaveApprovedAt(o)) OR
    CHANGED(leaveApprovedBy(o)) OR
    CHANGED(leaveCancelledAt(o)) OR
    CHANGED(leaveCancelledBy(o));
@protectSecondaryOrganizationObject(leaveDocument, LeaveDocument, leaveDocumentAccessOrganization, personnelChangeRoleAllowed);

