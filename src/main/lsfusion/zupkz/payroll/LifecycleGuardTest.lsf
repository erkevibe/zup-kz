MODULE LifecycleGuardTest;

REQUIRE InsuranceWorkflowTest, PayrollSettlement, PayrollCivilContractPayments,
        TaxesKZSocialTransferRegisters, HRBusinessTrip, PayrollEnforcement,
        PayrollRecalculation, PayrollInterimPayment, AverageEarnings;
NAMESPACE ZUPKZ;

lifecycleGuardTimesheet() = GROUP LAST Timesheet t
    IF timesheetNumber(t) == 'LIFECYCLE-GUARD' ORDER t;
lifecycleGuardRun() = GROUP LAST PayrollRun r
    IF payrollNumber(r) == 'LIFECYCLE-GUARD' ORDER r;
lifecycleGuardSummary() = GROUP LAST PayrollTimeSummary s
    IF summaryPayrollRun(s) == lifecycleGuardRun() ORDER s;
lifecycleGuardSocialDocument() = GROUP LAST SocialPaymentDocument d
    IF socialPaymentPayrollRun(d) == lifecycleGuardRun() ORDER d;
lifecycleGuardTaxDocument() = GROUP LAST TaxCalculationDocument d
    IF taxCalculationPayrollRun(d) == lifecycleGuardRun() ORDER d;
lifecycleGuardTaxLine() = GROUP LAST TaxCalculationLine l
    IF taxCalculationDocument(l) == lifecycleGuardTaxDocument() ORDER l;
lifecycleGuardPersonnelEvent() = GROUP LAST PersonnelEvent e
    IF orderNumber(e) == 'LIFECYCLE-GUARD' ORDER e;
lifecycleGuardPaymentStatement() = GROUP LAST PaymentStatement d
    IF paymentStatementNumber(d) == 'LIFECYCLE-GUARD' ORDER d;
lifecycleGuardPaymentLine() = GROUP LAST PaymentStatementLine l
    IF paymentLineStatement(l) == lifecycleGuardPaymentStatement() ORDER l;
lifecycleGuardForm200() = GROUP LAST Form200Declaration d
    IF form200Version(d) == 'LIFECYCLE-GUARD' ORDER d;
lifecycleGuardForm200Line() = GROUP LAST Form200MonthLine line
    IF form200LineDeclaration(line) == lifecycleGuardForm200() ORDER line;
lifecycleGuardApproval() = GROUP LAST ApprovalRequest r
    IF approvalTitle(r) == 'LIFECYCLE-GUARD' ORDER r;
lifecycleGuardApprovalStep() = GROUP LAST ApprovalStep s
    IF approvalStepRequest(s) == lifecycleGuardApproval() ORDER s;
lifecycleGuardArchiveCase() = GROUP LAST ArchiveCase c
    IF archiveCaseIndex(c) == 'LIFECYCLE-GUARD' ORDER c;
lifecycleGuardArchiveDocument() = GROUP LAST ArchiveDocument d
    IF archiveDocumentNumber(d) == 'LIFECYCLE-GUARD' ORDER d;
lifecycleGuardInsurancePolicy() = GROUP LAST AccidentInsurancePolicy p
    IF insurancePolicyNumber(p) == 'LIFECYCLE-GUARD' ORDER p;
lifecycleGuardWorkAccident() = GROUP LAST WorkAccident a
    IF workAccidentNumber(a) == 'LIFECYCLE-GUARD' ORDER a;
lifecycleGuardInsuranceClaim() = GROUP LAST AccidentInsuranceClaim c
    IF insuranceClaimNumber(c) == 'LIFECYCLE-GUARD' ORDER c;
lifecycleGuardLeave() = GROUP LAST LeaveDocument l
    IF leaveNumber(l) == 'LIFECYCLE-GUARD' ORDER l;
lifecycleGuardVacationSchedule() = GROUP LAST VacationSchedule s
    IF vacationScheduleNumber(s) == 'LIFECYCLE-GUARD' ORDER s;
lifecycleGuardTrip() = GROUP LAST BusinessTripDocument d
    IF tripNumber(d) == 'LIFECYCLE-GUARD' ORDER d;
lifecycleGuardAverage() = GROUP LAST AverageEarningsDocument d
    IF averageNumber(d) == 'LIFECYCLE-GUARD' ORDER d;
lifecycleGuardCivilContract() = GROUP LAST CivilContract c
    IF civilContractNumber(c) == 'LIFECYCLE-GUARD' ORDER c;
lifecycleGuardCivilAct() = GROUP LAST CivilContractAct a
    IF civilActNumber(a) == 'LIFECYCLE-GUARD' ORDER a;
lifecycleGuardCivilLiability() = GROUP LAST CivilLiabilityDocument d
    IF civilLiabilityNumber(d) == 'LIFECYCLE-GUARD' ORDER d;
lifecycleGuardEnforcementOrder() = GROUP LAST EnforcementOrder o
    IF enforcementNumber(o) == 'LIFECYCLE-GUARD' ORDER o;
lifecycleGuardEnforcementCalculation() = GROUP LAST EnforcementCalculationDocument d
    IF enforcementTaxCalculation(d) == lifecycleGuardTaxDocument() ORDER d;
lifecycleGuardInterimPayment() = GROUP LAST InterimPayment p
    IF interimPaymentNumber(p) == 'LIFECYCLE-GUARD' ORDER p;
lifecycleGuardBankRegister() = GROUP LAST SalaryBankRegister r
    IF bankRegisterNumber(r) == 'LIFECYCLE-GUARD' ORDER r;
lifecycleGuardLiability() = GROUP LAST PayrollLiabilityDocument d
    IF liabilityNumber(d) == 'LIFECYCLE-GUARD' ORDER d;
lifecycleGuardRecalculation() = GROUP LAST PayrollRecalculation d
    IF recalculationNumber(d) == 'LIFECYCLE-GUARD' ORDER d;
lifecycleGuardSickLeave() = GROUP LAST SickLeaveDocument d
    IF sickLeaveNumber(d) == 'LIFECYCLE-GUARD' ORDER d;
lifecycleGuardSocialTransfer() = GROUP LAST SocialTransferRegister r
    IF socialTransferNumber(r) == 'LIFECYCLE-GUARD' ORDER r;

lifecycleGuardSetupTest() {
    NEW timesheet = Timesheet {
        timesheetNumber(timesheet) <- 'LIFECYCLE-GUARD';
        timesheetStatus(timesheet) <- TimesheetStatus.draft;
        NEW run = PayrollRun {
            payrollNumber(run) <- 'LIFECYCLE-GUARD';
            payrollRunStatus(run) <- PayrollRunStatus.calculated;
            NEW summary = PayrollTimeSummary {
                summaryPayrollRun(summary) <- run;
                summaryWorkedHours(summary) <- 160.00;
            }
            NEW social = SocialPaymentDocument {
                socialPaymentPayrollRun(social) <- run;
                socialPaymentStatus(social) <- SocialPaymentStatus.calculated;
            }
            NEW taxes = TaxCalculationDocument {
                taxCalculationPayrollRun(taxes) <- run;
                taxCalculationStatus(taxes) <- TaxCalculationStatus.calculated;
                NEW taxLine = TaxCalculationLine {
                    taxCalculationDocument(taxLine) <- taxes;
                }
            }
        }
    }
    NEW personnelEvent = PersonnelEvent {
        orderNumber(personnelEvent) <- 'LIFECYCLE-GUARD';
        eventStatus(personnelEvent) <- PersonnelEventStatus.posted;
        esutdStatus(personnelEvent) <- EsutdStatus.accepted;
        esutdExternalId(personnelEvent) <- 'ESUTD-LIFECYCLE-GUARD';
    }
    NEW payment = PaymentStatement {
        paymentStatementNumber(payment) <- 'LIFECYCLE-GUARD';
        paymentStatementStatus(payment) <- PaymentStatementStatus.approved;
        NEW paymentLine = PaymentStatementLine {
            paymentLineStatement(paymentLine) <- payment;
            paymentLineAmountDue(paymentLine) <- 100.00;
            paymentLineAmount(paymentLine) <- 100.00;
        }
    }
    NEW declaration = Form200Declaration {
        form200Version(declaration) <- 'LIFECYCLE-GUARD';
        form200Status(declaration) <- Form200Status.calculated;
        NEW monthLine = Form200MonthLine {
            form200LineDeclaration(monthLine) <- declaration;
            form200LineAccruedIncome(monthLine) <- 100.00;
        }
    }
    NEW approval = ApprovalRequest {
        approvalTitle(approval) <- 'LIFECYCLE-GUARD';
        approvalStatus(approval) <- ApprovalRequestStatus.pending;
        NEW step = ApprovalStep {
            approvalStepRequest(step) <- approval;
            approvalStepSequence(step) <- 1;
            approvalStepStatus(step) <- ApprovalStepStatus.pending;
        }
    }
    NEW archiveCase = ArchiveCase {
        archiveCaseIndex(archiveCase) <- 'LIFECYCLE-GUARD';
        archiveCaseStatus(archiveCase) <- ArchiveCaseStatus.closed;
        NEW archiveDocument = ArchiveDocument {
            archiveDocumentCase(archiveDocument) <- archiveCase;
            archiveDocumentNumber(archiveDocument) <- 'LIFECYCLE-GUARD';
            archiveDocumentStatus(archiveDocument) <- ArchiveDocumentStatus.registered;
        }
    }
    NEW policy = AccidentInsurancePolicy {
        insurancePolicyNumber(policy) <- 'LIFECYCLE-GUARD';
        insurancePolicyPremium(policy) <- 100.00;
        insurancePolicyStatus(policy) <- AccidentInsurancePolicyStatus.active;
    }
    NEW accident = WorkAccident {
        workAccidentNumber(accident) <- 'LIFECYCLE-GUARD';
        workAccidentStatus(accident) <- WorkAccidentStatus.investigating;
    }
    NEW claim = AccidentInsuranceClaim {
        insuranceClaimNumber(claim) <- 'LIFECYCLE-GUARD';
        insuranceClaimStatus(claim) <- AccidentInsuranceClaimStatus.submitted;
    }
    NEW leave = LeaveDocument {
        leaveNumber(leave) <- 'LIFECYCLE-GUARD';
        leaveStatus(leave) <- LeaveStatus.approved;
    }
    NEW schedule = VacationSchedule {
        vacationScheduleNumber(schedule) <- 'LIFECYCLE-GUARD';
        vacationScheduleStatus(schedule) <- VacationScheduleStatus.approved;
    }
    NEW trip = BusinessTripDocument {
        tripNumber(trip) <- 'LIFECYCLE-GUARD';
        tripStatus(trip) <- BusinessTripStatus.approved;
    }
    NEW average = AverageEarningsDocument {
        averageNumber(average) <- 'LIFECYCLE-GUARD';
        averageStatus(average) <- AverageEarningsStatus.calculated;
    }
    NEW civilContract = CivilContract {
        civilContractNumber(civilContract) <- 'LIFECYCLE-GUARD';
        civilContractStatus(civilContract) <- CivilContractStatus.active;
        NEW civilAct = CivilContractAct {
            civilActContract(civilAct) <- civilContract;
            civilActNumber(civilAct) <- 'LIFECYCLE-GUARD';
            civilActStatus(civilAct) <- CivilContractActStatus.approved;
            NEW civilLiability = CivilLiabilityDocument {
                civilLiabilityAct(civilLiability) <- civilAct;
                civilLiabilityNumber(civilLiability) <- 'LIFECYCLE-GUARD';
                civilLiabilityStatus(civilLiability) <- PayrollLiabilityStatus.approved;
            }
        }
    }
    NEW enforcementOrder = EnforcementOrder {
        enforcementNumber(enforcementOrder) <- 'LIFECYCLE-GUARD';
        enforcementStatus(enforcementOrder) <- EnforcementOrderStatus.active;
    }
    NEW enforcementCalculation = EnforcementCalculationDocument {
        enforcementTaxCalculation(enforcementCalculation) <- lifecycleGuardTaxDocument();
        enforcementCalculationStatus(enforcementCalculation) <-
            EnforcementCalculationStatus.calculated;
    }
    NEW interim = InterimPayment {
        interimPaymentNumber(interim) <- 'LIFECYCLE-GUARD';
        interimPaymentStatus(interim) <- InterimPaymentStatus.approved;
    }
    NEW bankRegister = SalaryBankRegister {
        bankRegisterNumber(bankRegister) <- 'LIFECYCLE-GUARD';
        bankRegisterStatus(bankRegister) <- BankRegisterStatus.sent;
    }
    NEW liability = PayrollLiabilityDocument {
        liabilityNumber(liability) <- 'LIFECYCLE-GUARD';
        liabilityStatus(liability) <- PayrollLiabilityStatus.approved;
    }
    NEW recalculation = PayrollRecalculation {
        recalculationNumber(recalculation) <- 'LIFECYCLE-GUARD';
        recalculationStatus(recalculation) <- PayrollRecalculationStatus.calculated;
    }
    NEW sickLeave = SickLeaveDocument {
        sickLeaveNumber(sickLeave) <- 'LIFECYCLE-GUARD';
        sickLeaveStatus(sickLeave) <- SickLeaveStatus.approved;
    }
    NEW socialTransfer = SocialTransferRegister {
        socialTransferNumber(socialTransfer) <- 'LIFECYCLE-GUARD';
        socialTransferStatus(socialTransfer) <- SocialTransferRegisterStatus.sent;
    }
    APPLY;
    EXPORT JSON FROM setupSucceeded = NOT canceled();
}

timesheetStatusGuardTest() {
    timesheetStatus(lifecycleGuardTimesheet()) <- TimesheetStatus.approved;
    APPLY;
    EXPORT JSON FROM timesheetStatusBlocked = canceled();
}

payrollStatusGuardTest() {
    payrollRunStatus(lifecycleGuardRun()) <- PayrollRunStatus.draft;
    APPLY;
    EXPORT JSON FROM payrollStatusBlocked = canceled();
}

socialStatusGuardTest() {
    socialPaymentStatus(lifecycleGuardSocialDocument()) <- SocialPaymentStatus.approved;
    APPLY;
    EXPORT JSON FROM socialStatusBlocked = canceled();
}

payrollSnapshotGuardTest() {
    summaryWorkedHours(lifecycleGuardSummary()) <- 161.00;
    APPLY;
    EXPORT JSON FROM payrollSnapshotBlocked = canceled();
}

payrollSnapshotDeleteGuardTest() {
    DELETE PayrollTimeSummary s WHERE s == lifecycleGuardSummary();
    APPLY;
    EXPORT JSON FROM payrollSnapshotDeleteBlocked = canceled();
}

taxSnapshotGuardTest() {
    taxCalculationResident(lifecycleGuardTaxLine()) <- TRUE;
    APPLY;
    EXPORT JSON FROM taxSnapshotBlocked = canceled();
}

personnelEventStatusGuardTest() {
    eventStatus(lifecycleGuardPersonnelEvent()) <- PersonnelEventStatus.draft;
    APPLY;
    EXPORT JSON FROM personnelEventStatusBlocked = canceled();
}

esutdStatusGuardTest() {
    esutdStatus(lifecycleGuardPersonnelEvent()) <- EsutdStatus.rejected;
    APPLY;
    EXPORT JSON FROM esutdStatusBlocked = canceled();
}

esutdResponseGuardTest() {
    esutdExternalId(lifecycleGuardPersonnelEvent()) <- 'ESUTD-TAMPERED';
    APPLY;
    EXPORT JSON FROM esutdResponseBlocked = canceled();
}

paymentStatementStatusGuardTest() {
    paymentStatementStatus(lifecycleGuardPaymentStatement()) <- PaymentStatementStatus.draft;
    APPLY;
    EXPORT JSON FROM paymentStatementStatusBlocked = canceled();
}

paymentStatementSnapshotGuardTest() {
    paymentLineAmount(lifecycleGuardPaymentLine()) <- 99.00;
    APPLY;
    EXPORT JSON FROM paymentStatementSnapshotBlocked = canceled();
}

form200StatusGuardTest() {
    form200Status(lifecycleGuardForm200()) <- Form200Status.draft;
    APPLY;
    EXPORT JSON FROM form200StatusBlocked = canceled();
}

form200SnapshotGuardTest() {
    form200LineAccruedIncome(lifecycleGuardForm200Line()) <- 99.00;
    APPLY;
    EXPORT JSON FROM form200SnapshotBlocked = canceled();
}

approvalStatusGuardTest() {
    approvalStatus(lifecycleGuardApproval()) <- ApprovalRequestStatus.draft;
    APPLY;
    EXPORT JSON FROM approvalStatusBlocked = canceled();
}

approvalStepStatusGuardTest() {
    approvalStepStatus(lifecycleGuardApprovalStep()) <- ApprovalStepStatus.approved;
    APPLY;
    EXPORT JSON FROM approvalStepStatusBlocked = canceled();
}

archiveStatusGuardTest() {
    archiveCaseStatus(lifecycleGuardArchiveCase()) <- ArchiveCaseStatus.open;
    APPLY;
    EXPORT JSON FROM archiveStatusBlocked = canceled();
}

archiveDocumentStatusGuardTest() {
    archiveDocumentStatus(lifecycleGuardArchiveDocument()) <- ArchiveDocumentStatus.draft;
    APPLY;
    EXPORT JSON FROM archiveDocumentStatusBlocked = canceled();
}

insurancePolicyStatusGuardTest() {
    insurancePolicyStatus(lifecycleGuardInsurancePolicy()) <- AccidentInsurancePolicyStatus.draft;
    APPLY;
    EXPORT JSON FROM insurancePolicyStatusBlocked = canceled();
}

insurancePolicySnapshotGuardTest() {
    insurancePolicyPremium(lifecycleGuardInsurancePolicy()) <- 99.00;
    APPLY;
    EXPORT JSON FROM insurancePolicySnapshotBlocked = canceled();
}

workAccidentStatusGuardTest() {
    workAccidentStatus(lifecycleGuardWorkAccident()) <- WorkAccidentStatus.draft;
    APPLY;
    EXPORT JSON FROM workAccidentStatusBlocked = canceled();
}

insuranceClaimStatusGuardTest() {
    insuranceClaimStatus(lifecycleGuardInsuranceClaim()) <- AccidentInsuranceClaimStatus.draft;
    APPLY;
    EXPORT JSON FROM insuranceClaimStatusBlocked = canceled();
}

leaveStatusGuardTest() {
    leaveStatus(lifecycleGuardLeave()) <- LeaveStatus.cancelled;
    APPLY;
    EXPORT JSON FROM leaveStatusBlocked = canceled();
}

vacationScheduleStatusGuardTest() {
    vacationScheduleStatus(lifecycleGuardVacationSchedule()) <- VacationScheduleStatus.cancelled;
    APPLY;
    EXPORT JSON FROM vacationScheduleStatusBlocked = canceled();
}

tripStatusGuardTest() {
    tripStatus(lifecycleGuardTrip()) <- BusinessTripStatus.cancelled;
    APPLY;
    EXPORT JSON FROM tripStatusBlocked = canceled();
}

averageStatusGuardTest() {
    averageStatus(lifecycleGuardAverage()) <- AverageEarningsStatus.draft;
    APPLY;
    EXPORT JSON FROM averageStatusBlocked = canceled();
}

civilContractStatusGuardTest() {
    civilContractStatus(lifecycleGuardCivilContract()) <- CivilContractStatus.closed;
    APPLY;
    EXPORT JSON FROM civilContractStatusBlocked = canceled();
}

civilActStatusGuardTest() {
    civilActStatus(lifecycleGuardCivilAct()) <- CivilContractActStatus.paid;
    APPLY;
    EXPORT JSON FROM civilActStatusBlocked = canceled();
}

civilLiabilityStatusGuardTest() {
    civilLiabilityStatus(lifecycleGuardCivilLiability()) <- PayrollLiabilityStatus.paid;
    APPLY;
    EXPORT JSON FROM civilLiabilityStatusBlocked = canceled();
}

enforcementOrderStatusGuardTest() {
    enforcementStatus(lifecycleGuardEnforcementOrder()) <- EnforcementOrderStatus.suspended;
    APPLY;
    EXPORT JSON FROM enforcementOrderStatusBlocked = canceled();
}

enforcementCalculationStatusGuardTest() {
    enforcementCalculationStatus(lifecycleGuardEnforcementCalculation()) <-
        EnforcementCalculationStatus.approved;
    APPLY;
    EXPORT JSON FROM enforcementCalculationStatusBlocked = canceled();
}

interimPaymentStatusGuardTest() {
    interimPaymentStatus(lifecycleGuardInterimPayment()) <- InterimPaymentStatus.paid;
    APPLY;
    EXPORT JSON FROM interimPaymentStatusBlocked = canceled();
}

bankRegisterStatusGuardTest() {
    bankRegisterStatus(lifecycleGuardBankRegister()) <- BankRegisterStatus.accepted;
    APPLY;
    EXPORT JSON FROM bankRegisterStatusBlocked = canceled();
}

liabilityStatusGuardTest() {
    liabilityStatus(lifecycleGuardLiability()) <- PayrollLiabilityStatus.paid;
    APPLY;
    EXPORT JSON FROM liabilityStatusBlocked = canceled();
}

recalculationStatusGuardTest() {
    recalculationStatus(lifecycleGuardRecalculation()) <- PayrollRecalculationStatus.approved;
    APPLY;
    EXPORT JSON FROM recalculationStatusBlocked = canceled();
}

sickLeaveStatusGuardTest() {
    sickLeaveStatus(lifecycleGuardSickLeave()) <- SickLeaveStatus.cancelled;
    APPLY;
    EXPORT JSON FROM sickLeaveStatusBlocked = canceled();
}

socialTransferStatusGuardTest() {
    socialTransferStatus(lifecycleGuardSocialTransfer()) <- SocialTransferRegisterStatus.accepted;
    APPLY;
    EXPORT JSON FROM socialTransferStatusBlocked = canceled();
}

lifecycleGuardVerificationTest() {
    EXPORT JSON FROM
        timesheetStatusPreserved = timesheetStatus(lifecycleGuardTimesheet()) ==
            TimesheetStatus.draft,
        payrollStatusPreserved = payrollRunStatus(lifecycleGuardRun()) ==
            PayrollRunStatus.calculated,
        socialStatusPreserved = socialPaymentStatus(lifecycleGuardSocialDocument()) ==
            SocialPaymentStatus.calculated,
        payrollSnapshotPreserved = summaryWorkedHours(lifecycleGuardSummary()) == 160.00,
        taxSnapshotPreserved = NOT taxCalculationResident(lifecycleGuardTaxLine()),
        personnelEventStatusPreserved = eventStatus(lifecycleGuardPersonnelEvent()) ==
            PersonnelEventStatus.posted,
        esutdStatusPreserved = esutdStatus(lifecycleGuardPersonnelEvent()) ==
            EsutdStatus.accepted,
        esutdResponsePreserved = esutdExternalId(lifecycleGuardPersonnelEvent()) ==
            'ESUTD-LIFECYCLE-GUARD',
        paymentStatementStatusPreserved = paymentStatementStatus(lifecycleGuardPaymentStatement()) ==
            PaymentStatementStatus.approved,
        paymentStatementSnapshotPreserved = paymentLineAmount(lifecycleGuardPaymentLine()) == 100.00,
        form200StatusPreserved = form200Status(lifecycleGuardForm200()) == Form200Status.calculated,
        form200SnapshotPreserved = form200LineAccruedIncome(lifecycleGuardForm200Line()) == 100.00,
        approvalStatusPreserved = approvalStatus(lifecycleGuardApproval()) ==
            ApprovalRequestStatus.pending,
        approvalStepStatusPreserved = approvalStepStatus(lifecycleGuardApprovalStep()) ==
            ApprovalStepStatus.pending,
        archiveStatusPreserved = archiveCaseStatus(lifecycleGuardArchiveCase()) ==
            ArchiveCaseStatus.closed,
        archiveDocumentStatusPreserved = archiveDocumentStatus(lifecycleGuardArchiveDocument()) ==
            ArchiveDocumentStatus.registered,
        insurancePolicyStatusPreserved = insurancePolicyStatus(lifecycleGuardInsurancePolicy()) ==
            AccidentInsurancePolicyStatus.active,
        insurancePolicySnapshotPreserved = insurancePolicyPremium(lifecycleGuardInsurancePolicy()) == 100.00,
        workAccidentStatusPreserved = workAccidentStatus(lifecycleGuardWorkAccident()) ==
            WorkAccidentStatus.investigating,
        insuranceClaimStatusPreserved = insuranceClaimStatus(lifecycleGuardInsuranceClaim()) ==
            AccidentInsuranceClaimStatus.submitted,
        leaveStatusPreserved = leaveStatus(lifecycleGuardLeave()) == LeaveStatus.approved,
        vacationScheduleStatusPreserved = vacationScheduleStatus(lifecycleGuardVacationSchedule()) ==
            VacationScheduleStatus.approved,
        tripStatusPreserved = tripStatus(lifecycleGuardTrip()) == BusinessTripStatus.approved,
        averageStatusPreserved = averageStatus(lifecycleGuardAverage()) ==
            AverageEarningsStatus.calculated,
        civilContractStatusPreserved = civilContractStatus(lifecycleGuardCivilContract()) ==
            CivilContractStatus.active,
        civilActStatusPreserved = civilActStatus(lifecycleGuardCivilAct()) ==
            CivilContractActStatus.approved,
        civilLiabilityStatusPreserved = civilLiabilityStatus(lifecycleGuardCivilLiability()) ==
            PayrollLiabilityStatus.approved,
        enforcementOrderStatusPreserved = enforcementStatus(lifecycleGuardEnforcementOrder()) ==
            EnforcementOrderStatus.active,
        enforcementCalculationStatusPreserved =
            enforcementCalculationStatus(lifecycleGuardEnforcementCalculation()) ==
                EnforcementCalculationStatus.calculated,
        interimPaymentStatusPreserved = interimPaymentStatus(lifecycleGuardInterimPayment()) ==
            InterimPaymentStatus.approved,
        bankRegisterStatusPreserved = bankRegisterStatus(lifecycleGuardBankRegister()) ==
            BankRegisterStatus.sent,
        liabilityStatusPreserved = liabilityStatus(lifecycleGuardLiability()) ==
            PayrollLiabilityStatus.approved,
        recalculationStatusPreserved = recalculationStatus(lifecycleGuardRecalculation()) ==
            PayrollRecalculationStatus.calculated,
        sickLeaveStatusPreserved = sickLeaveStatus(lifecycleGuardSickLeave()) ==
            SickLeaveStatus.approved,
        socialTransferStatusPreserved = socialTransferStatus(lifecycleGuardSocialTransfer()) ==
            SocialTransferRegisterStatus.sent;
}
