scheduleOrganizationGuardTest() {
    NEW employmentOrg = Organization {
        bin(employmentOrg) <- '666666666671';
        NEW scheduleOrg = Organization {
            bin(scheduleOrg) <- '666666666672';
            NEW worker = Employee {
                iin(worker) <- '940404300006';
                lastName(worker) <- 'Организация';
                firstName(worker) <- 'График';
                NEW contract = Employment {
                    employee(contract) <- worker;
                    organization(contract) <- employmentOrg;
                    hireDate(contract) <- 2026_01_01;
                    NEW assignment = EmploymentAssignment {
                        employment(assignment) <- contract;
                        assignmentFrom(assignment) <- 2026_01_01;
                        NEW schedule = WorkSchedule {
                            scheduleOrganization(schedule) <- scheduleOrg;
                            scheduleCode(schedule) <- 'FOREIGN-ORGANIZATION';
                            NEW scheduleAssignment = EmployeeScheduleAssignment {
                                scheduleEmploymentAssignment(scheduleAssignment) <- assignment;
                                employeeWorkSchedule(scheduleAssignment) <- schedule;
                                employeeScheduleFrom(scheduleAssignment) <- 2026_01_01;
                                cycleStartDate(scheduleAssignment) <- 2026_01_01;
                            }
                        }
                    }
                }
            }
        }
    }
    APPLY;
    EXPORT JSON FROM scheduleOrganizationRejected = canceled();
}

