MODULE PayrollSettlement;

REQUIRE PayrollEnforcement;
NAMESPACE ZUPKZ;

// Дата выплаты задаётся трудовым / коллективным договором, но не может быть
// позже первой декады месяца, следующего за расчётным (статья 113 ТК РК).
payrollPaymentDueDate 'Дата выплаты' = DATA DATE (PayrollRun);
latestPayrollPaymentDate 'Предельная дата выплаты' (PayrollRun r) =
    firstDayOfMonth(sumMonth(payrollPeriodTo(r), 1)) + 9;
payrollPaymentLegalSource 'Нормативное основание выплаты' (PayrollRun r) =
    legalSourceByCode('LABOR_CODE_KZ');
payrollReopenReason 'Причина переоткрытия' = DATA STRING[500] (PayrollRun);
payrollResetReason 'Причина пересчёта' = DATA STRING[500] (PayrollRun);

CONSTRAINT payrollPaymentDueDate(PayrollRun r) <= payrollPeriodTo(r)
    MESSAGE 'Дата выплаты должна быть позже окончания расчётного периода';
CONSTRAINT payrollPaymentDueDate(PayrollRun r) > latestPayrollPaymentDate(r)
    MESSAGE 'Дата выплаты зарплаты не может быть позже первой декады следующего месяца';

approvedSocialPaymentForRun(PayrollRun run) = GROUP LAST SocialPaymentDocument d
    IF socialPaymentPayrollRun(d) == run AND socialPaymentStatus(d) == SocialPaymentStatus.approved
    ORDER d;
approvedTaxCalculationForRun(PayrollRun run) = GROUP LAST TaxCalculationDocument d
    IF taxCalculationPayrollRun(d) == run AND taxCalculationStatus(d) == TaxCalculationStatus.approved
    ORDER d;
approvedEnforcementForRun(PayrollRun run) = GROUP LAST EnforcementCalculationDocument d
    IF enforcementPayrollRun(d) == run AND
       enforcementCalculationStatus(d) == EnforcementCalculationStatus.approved
    ORDER d;

CLASS PayrollSettlementLine 'Расчётный листок';

settlementPayrollRun 'Расчёт зарплаты' = DATA PayrollRun (PayrollSettlementLine);
settlementEmployee 'Сотрудник' = DATA Employee (PayrollSettlementLine);
settlementAccrued 'Начислено' = DATA NUMERIC[18,2] (PayrollSettlementLine);
settlementPayrollDeducted 'Прочие удержания' = DATA NUMERIC[18,2] (PayrollSettlementLine);
settlementOpv 'ОПВ' = DATA NUMERIC[18,2] (PayrollSettlementLine);
settlementOpvr 'ОПВР работодателя' = DATA NUMERIC[18,2] (PayrollSettlementLine);
settlementSo 'Социальные отчисления' = DATA NUMERIC[18,2] (PayrollSettlementLine);
settlementVosms 'ВОСМС' = DATA NUMERIC[18,2] (PayrollSettlementLine);
settlementOosms 'ООСМС работодателя' = DATA NUMERIC[18,2] (PayrollSettlementLine);
settlementIpn 'ИПН' = DATA NUMERIC[18,2] (PayrollSettlementLine);
settlementSocialTax 'Социальный налог' = DATA NUMERIC[18,2] (PayrollSettlementLine);
settlementEnforcement 'Исполнительные удержания' = DATA NUMERIC[18,2] (PayrollSettlementLine);
settlementPayable 'К выплате' = DATA NUMERIC[18,2] (PayrollSettlementLine);
settlementClosedAt 'Закрыт' = DATA DATETIME (PayrollSettlementLine);
settlementLegalSource 'Нормативное основание' (PayrollSettlementLine l) =
    payrollPaymentLegalSource(settlementPayrollRun(l));

CLASS PayrollLifecycleOperation 'Операция с расчётом зарплаты' {
    closed 'Закрытие',
    reopened 'Переоткрытие',
    resetForRecalculation 'Сброс для пересчёта'
}

CLASS PayrollLifecycleEntry 'История расчёта зарплаты';

payrollLifecycleRun 'Расчёт зарплаты' = DATA PayrollRun (PayrollLifecycleEntry);
payrollLifecycleOperation 'Операция' = DATA PayrollLifecycleOperation (PayrollLifecycleEntry);
payrollLifecycleStatusFrom 'Статус до' = DATA PayrollRunStatus (PayrollLifecycleEntry);
payrollLifecycleStatusTo 'Статус после' = DATA PayrollRunStatus (PayrollLifecycleEntry);
payrollLifecycleReason 'Причина' = DATA STRING[500] (PayrollLifecycleEntry);
payrollLifecycleAt 'Дата и время' = DATA DATETIME (PayrollLifecycleEntry);
payrollLifecycleUser 'Пользователь' = DATA CustomUser (PayrollLifecycleEntry);

CONSTRAINT (CHANGED(payrollLifecycleRun(PayrollLifecycleEntry e)) OR
            CHANGED(payrollLifecycleOperation(e)) OR
            CHANGED(payrollLifecycleStatusFrom(e)) OR
            CHANGED(payrollLifecycleStatusTo(e)) OR
            CHANGED(payrollLifecycleReason(e)) OR CHANGED(payrollLifecycleAt(e)) OR
            CHANGED(payrollLifecycleUser(e))) AND PREV(payrollLifecycleRun(e))
    MESSAGE 'Историю расчёта зарплаты изменять нельзя';
CONSTRAINT DROPPED(PayrollLifecycleEntry e IS PayrollLifecycleEntry) AND
           PREV(payrollLifecycleRun(e))
    MESSAGE 'Историю расчёта зарплаты удалять нельзя';

recordPayrollLifecycle(PayrollRun run, PayrollLifecycleOperation operation,
                       PayrollRunStatus statusFrom, PayrollRunStatus statusTo,
                       STRING[500] reason) {
    NEW entry = PayrollLifecycleEntry {
        payrollLifecycleRun(entry) <- run;
        payrollLifecycleOperation(entry) <- operation;
        payrollLifecycleStatusFrom(entry) <- statusFrom;
        payrollLifecycleStatusTo(entry) <- statusTo;
        payrollLifecycleReason(entry) <- reason;
        payrollLifecycleAt(entry) <- currentDateTime();
        payrollLifecycleUser(entry) <- currentUser() AS CustomUser;
    }
}

CONSTRAINT (CHANGED(settlementPayrollRun(PayrollSettlementLine l)) OR
            CHANGED(settlementEmployee(l)) OR CHANGED(settlementAccrued(l)) OR
            CHANGED(settlementPayrollDeducted(l)) OR CHANGED(settlementOpv(l)) OR
            CHANGED(settlementOpvr(l)) OR CHANGED(settlementSo(l)) OR
            CHANGED(settlementVosms(l)) OR CHANGED(settlementOosms(l)) OR
            CHANGED(settlementIpn(l)) OR CHANGED(settlementSocialTax(l)) OR
            CHANGED(settlementEnforcement(l)) OR CHANGED(settlementPayable(l)) OR
            CHANGED(settlementClosedAt(l))) AND
           (PREV(payrollRunStatus(settlementPayrollRun(l))) == PayrollRunStatus.approved OR
            PREV(payrollRunStatus(settlementPayrollRun(l))) == PayrollRunStatus.paid) AND
           NOT payrollLifecycleTransition(PREV(settlementPayrollRun(l)))
    MESSAGE 'Нельзя изменить закрытый расчётный листок';
CONSTRAINT DROPPED(PayrollSettlementLine l IS PayrollSettlementLine) AND
           (PREV(payrollRunStatus(settlementPayrollRun(l))) == PayrollRunStatus.approved OR
            PREV(payrollRunStatus(settlementPayrollRun(l))) == PayrollRunStatus.paid) AND
           NOT payrollLifecycleTransition(PREV(settlementPayrollRun(l)))
    MESSAGE 'Нельзя удалить закрытый расчётный листок';

settlementLineByEmployee(PayrollRun run, Employee worker) =
    GROUP AGGR PayrollSettlementLine l BY settlementPayrollRun(l), settlementEmployee(l);
payrollAccruedByEmployee(PayrollRun run, Employee worker) =
    GROUP SUM calculationAmount(PayrollLine l)
    IF linePayrollRun(l) == run AND
       employee(employment(linePayrollAssignment(l))) == worker AND
       calculationCategory(lineCalculationType(l)) == CalculationCategory.accrual;
payrollDeductedByEmployee(PayrollRun run, Employee worker) =
    GROUP SUM calculationAmount(PayrollLine l)
    IF linePayrollRun(l) == run AND
       employee(employment(linePayrollAssignment(l))) == worker AND
       calculationCategory(lineCalculationType(l)) == CalculationCategory.deduction;
approvedSocialLine(PayrollRun run, Employee worker) =
    socialPaymentLineByEmployee(approvedSocialPaymentForRun(run), worker);
approvedTaxLine(PayrollRun run, Employee worker) =
    taxCalculationLineByEmployee(approvedTaxCalculationForRun(run), worker);
approvedEnforcementByEmployee(PayrollRun run, Employee worker) = GROUP SUM
    enforcementWithheldAmount(EnforcementCalculationLine l)
    IF enforcementCalculationDocument(l) == approvedEnforcementForRun(run) AND
       enforcementLineEmployee(l) == worker;

calculatedSettlementPayable(PayrollRun run, Employee worker) = taxPositive(
    (IF payrollAccruedByEmployee(run, worker) THEN payrollAccruedByEmployee(run, worker) ELSE 0.00) -
    (IF payrollDeductedByEmployee(run, worker) THEN payrollDeductedByEmployee(run, worker) ELSE 0.00) -
    (IF opvAmount(approvedSocialLine(run, worker)) THEN opvAmount(approvedSocialLine(run, worker)) ELSE 0.00) -
    (IF vosmsAmount(approvedSocialLine(run, worker)) THEN vosmsAmount(approvedSocialLine(run, worker)) ELSE 0.00) -
    (IF ipnAmount(approvedTaxLine(run, worker)) THEN ipnAmount(approvedTaxLine(run, worker)) ELSE 0.00) -
    (IF approvedEnforcementByEmployee(run, worker) THEN approvedEnforcementByEmployee(run, worker) ELSE 0.00));

closePayroll 'Закрыть расчёт' (PayrollRun r) {
    IF payrollRunStatus(r) != PayrollRunStatus.calculated THEN
        MESSAGE 'Закрыть можно только рассчитанную зарплату';
    ELSE IF NOT payrollPaymentDueDate(r) THEN
        MESSAGE 'Укажите дату выплаты зарплаты';
    ELSE IF NOT approvedSocialPaymentForRun(r) THEN
        MESSAGE 'Сначала утвердите социальные платежи';
    ELSE IF NOT approvedTaxCalculationForRun(r) THEN
        MESSAGE 'Сначала утвердите ИПН и социальный налог';
    ELSE IF NOT approvedEnforcementForRun(r) THEN
        MESSAGE 'Сначала рассчитайте и утвердите исполнительные удержания';
    ELSE {
        FOR worker IS Employee AND payrollEmployeeLineCount(r, worker) DO {
            NEW l = PayrollSettlementLine {
                settlementPayrollRun(l) <- r;
                settlementEmployee(l) <- worker;
                settlementAccrued(l) <- payrollAccruedByEmployee(r, worker);
                settlementPayrollDeducted(l) <- payrollDeductedByEmployee(r, worker);
                settlementOpv(l) <- opvAmount(approvedSocialLine(r, worker));
                settlementOpvr(l) <- opvrAmount(approvedSocialLine(r, worker));
                settlementSo(l) <- soAmount(approvedSocialLine(r, worker));
                settlementVosms(l) <- vosmsAmount(approvedSocialLine(r, worker));
                settlementOosms(l) <- oosmsAmount(approvedSocialLine(r, worker));
                settlementIpn(l) <- ipnAmount(approvedTaxLine(r, worker));
                settlementSocialTax(l) <- socialTaxAmount(approvedTaxLine(r, worker));
                settlementEnforcement(l) <- approvedEnforcementByEmployee(r, worker);
                settlementPayable(l) <- calculatedSettlementPayable(r, worker);
                settlementClosedAt(l) <- currentDateTime();
            }
        }
        recordPayrollLifecycle(r, PayrollLifecycleOperation.closed,
            PayrollRunStatus.calculated, PayrollRunStatus.approved, NULL);
        payrollLifecycleTransition(r) <- TRUE;
        payrollRunStatus(r) <- PayrollRunStatus.approved;
        APPLY;
    }
}

CLASS PaymentMethod 'Способ выплаты' {
    bankTransfer 'Банк',
    cash 'Касса'
}

CLASS PaymentStatementStatus 'Статус ведомости' {
    draft 'Черновик',
    calculated 'Заполнена',
    approved 'Утверждена',
    paid 'Выплачена'
}

CLASS PaymentStatement 'Ведомость выплаты зарплаты';

paymentStatementPayrollRun 'Расчёт зарплаты' = DATA PayrollRun (PaymentStatement);
paymentStatementNumber 'Номер' = DATA STRING[50] (PaymentStatement);
paymentStatementDate 'Дата выплаты' = DATA DATE (PaymentStatement);
paymentStatementMethod 'Способ выплаты' = DATA PaymentMethod (PaymentStatement);
paymentStatementBankAccount 'Счёт организации' = DATA STRING[34] (PaymentStatement);
paymentStatementStatus 'Статус' = DATA PaymentStatementStatus (PaymentStatement);
paymentStatementCalculatedAt 'Заполнена' = DATA DATETIME (PaymentStatement);
paymentStatementApprovedAt 'Утверждена' = DATA DATETIME (PaymentStatement);
paymentStatementPaidAt 'Выплачена' = DATA DATETIME (PaymentStatement);
paymentStatementLifecycleTransition = DATA LOCAL BOOLEAN (PaymentStatement);
paymentStatementOverdue 'Просрочена' (PaymentStatement d) =
    paymentStatementDate(d) > payrollPaymentDueDate(paymentStatementPayrollRun(d));

CLASS PaymentStatementLine 'Строка ведомости';

paymentLineStatement 'Ведомость' = DATA PaymentStatement (PaymentStatementLine);
paymentLineSettlement 'Расчётный листок' = DATA PayrollSettlementLine (PaymentStatementLine);
paymentLineAmountDue 'Остаток до выплаты' = DATA NUMERIC[18,2] (PaymentStatementLine);
paymentLineAmount 'Сумма выплаты' = DATA NUMERIC[18,2] (PaymentStatementLine);

CONSTRAINT CHANGED(paymentStatementStatus(PaymentStatement d)) AND
           PREV(paymentStatementStatus(d)) AND NOT paymentStatementLifecycleTransition(d)
    MESSAGE 'Статус платёжной ведомости изменяется только штатными действиями';
CONSTRAINT (CHANGED(paymentStatementCalculatedAt(PaymentStatement d)) OR
            CHANGED(paymentStatementApprovedAt(d)) OR CHANGED(paymentStatementPaidAt(d))) AND
           PREV(paymentStatementStatus(d)) AND NOT paymentStatementLifecycleTransition(d)
    MESSAGE 'Служебные даты платёжной ведомости изменяются только штатными действиями';
CONSTRAINT (CHANGED(paymentStatementPayrollRun(PaymentStatement d)) OR
            CHANGED(paymentStatementNumber(d)) OR CHANGED(paymentStatementDate(d)) OR
            CHANGED(paymentStatementMethod(d)) OR CHANGED(paymentStatementBankAccount(d))) AND
           PREV(paymentStatementStatus(d)) != PaymentStatementStatus.draft
    MESSAGE 'Нельзя изменить реквизиты заполненной платёжной ведомости';
CONSTRAINT (CHANGED(paymentLineStatement(PaymentStatementLine l)) OR
            CHANGED(paymentLineSettlement(l)) OR CHANGED(paymentLineAmountDue(l))) AND
           PREV(paymentLineStatement(l))
    MESSAGE 'Нельзя изменить источник строки платёжной ведомости';
CONSTRAINT CHANGED(paymentLineAmount(PaymentStatementLine l)) AND
           (PREV(paymentStatementStatus(paymentLineStatement(l))) == PaymentStatementStatus.approved OR
            PREV(paymentStatementStatus(paymentLineStatement(l))) == PaymentStatementStatus.paid)
    MESSAGE 'Нельзя изменить сумму утверждённой платёжной ведомости';
CONSTRAINT DROPPED(PaymentStatementLine l IS PaymentStatementLine) AND
           (PREV(paymentStatementStatus(paymentLineStatement(l))) == PaymentStatementStatus.approved OR
            PREV(paymentStatementStatus(paymentLineStatement(l))) == PaymentStatementStatus.paid)
    MESSAGE 'Нельзя удалить строку утверждённой платёжной ведомости';

paymentLineEmployee 'Сотрудник' (PaymentStatementLine l) =
    settlementEmployee(paymentLineSettlement(l));
paymentLineBySettlement(PaymentStatement statement, PayrollSettlementLine settlement) =
    GROUP AGGR PaymentStatementLine l BY paymentLineStatement(l), paymentLineSettlement(l);
committedPaymentAmount(PayrollSettlementLine settlement) = GROUP SUM
    paymentLineAmount(PaymentStatementLine l)
    IF paymentLineSettlement(l) == settlement AND
       (paymentStatementStatus(paymentLineStatement(l)) == PaymentStatementStatus.approved OR
        paymentStatementStatus(paymentLineStatement(l)) == PaymentStatementStatus.paid);
paidPaymentAmount(PayrollSettlementLine settlement) = GROUP SUM
    paymentLineAmount(PaymentStatementLine l)
    IF paymentLineSettlement(l) == settlement AND
       paymentStatementStatus(paymentLineStatement(l)) == PaymentStatementStatus.paid;
remainingSettlementAmount 'Остаток к выплате' (PayrollSettlementLine settlement) = taxPositive(
    settlementPayable(settlement) -
    (IF committedPaymentAmount(settlement) THEN committedPaymentAmount(settlement) ELSE 0.00));
unpaidSettlementAmount 'Фактически не выплачено' (PayrollSettlementLine settlement) = taxPositive(
    settlementPayable(settlement) -
    (IF paidPaymentAmount(settlement) THEN paidPaymentAmount(settlement) ELSE 0.00));

calculatePaymentStatement 'Заполнить ведомость' (PaymentStatement d) {
    IF paymentStatementStatus(d) AND paymentStatementStatus(d) != PaymentStatementStatus.draft THEN
        MESSAGE 'Ведомость уже заполнена';
    ELSE IF NOT paymentStatementPayrollRun(d) OR
            payrollRunStatus(paymentStatementPayrollRun(d)) != PayrollRunStatus.approved THEN
        MESSAGE 'Выберите закрытый и ещё не выплаченный расчёт зарплаты';
    ELSE IF NOT paymentStatementNumber(d) OR NOT paymentStatementDate(d) OR
            NOT paymentStatementMethod(d) THEN
        MESSAGE 'Укажите номер, дату и способ выплаты';
    ELSE {
        FOR settlementPayrollRun(PayrollSettlementLine s) == paymentStatementPayrollRun(d) AND
            remainingSettlementAmount(s) > 0.00 DO {
            NEW l = PaymentStatementLine {
                paymentLineStatement(l) <- d;
                paymentLineSettlement(l) <- s;
                paymentLineAmountDue(l) <- remainingSettlementAmount(s);
                paymentLineAmount(l) <- remainingSettlementAmount(s);
            }
        }
        paymentStatementLifecycleTransition(d) <- TRUE;
        paymentStatementStatus(d) <- PaymentStatementStatus.calculated;
        paymentStatementCalculatedAt(d) <- currentDateTime();
        APPLY;
    }
}

invalidPaymentLineCount(PaymentStatement d) = GROUP SUM 1
    IF paymentLineStatement(PaymentStatementLine l) == d AND
       (NOT paymentLineAmount(l) OR paymentLineAmount(l) <= 0.00 OR
        paymentLineAmount(l) > paymentLineAmountDue(l));
paymentStatementLineCount(PaymentStatement d) = GROUP SUM 1
    IF paymentLineStatement(PaymentStatementLine l) == d;

approvePaymentStatement 'Утвердить ведомость' (PaymentStatement d) {
    IF paymentStatementStatus(d) != PaymentStatementStatus.calculated THEN
        MESSAGE 'Сначала заполните ведомость';
    ELSE IF NOT paymentStatementLineCount(d) THEN
        MESSAGE 'В ведомости нет сумм к выплате';
    ELSE IF invalidPaymentLineCount(d) THEN
        MESSAGE 'Сумма выплаты должна быть положительной и не превышать остаток';
    ELSE {
        paymentStatementLifecycleTransition(d) <- TRUE;
        paymentStatementStatus(d) <- PaymentStatementStatus.approved;
        paymentStatementApprovedAt(d) <- currentDateTime();
        APPLY;
    }
}

remainingPayrollAmount 'Остаток к выплате' (PayrollRun run) =
    GROUP SUM remainingSettlementAmount(PayrollSettlementLine s)
    IF settlementPayrollRun(s) == run;
unpaidPayrollAmount 'Фактически не выплачено' (PayrollRun run) =
    GROUP SUM unpaidSettlementAmount(PayrollSettlementLine s)
    IF settlementPayrollRun(s) == run;

markPaymentStatementPaid 'Отметить выплаченной' (PaymentStatement d) {
    IF paymentStatementStatus(d) != PaymentStatementStatus.approved THEN
        MESSAGE 'Сначала утвердите ведомость';
    ELSE {
        paymentStatementLifecycleTransition(d) <- TRUE;
        paymentStatementStatus(d) <- PaymentStatementStatus.paid;
        paymentStatementPaidAt(d) <- currentDateTime();
        APPLY;
        IF NOT unpaidPayrollAmount(paymentStatementPayrollRun(d)) THEN {
            payrollLifecycleTransition(paymentStatementPayrollRun(d)) <- TRUE;
            payrollRunStatus(paymentStatementPayrollRun(d)) <- PayrollRunStatus.paid;
            APPLY;
        }
    }
}

totalPaymentStatementAmount 'Сумма ведомости' (PaymentStatement d) = GROUP SUM
    paymentLineAmount(PaymentStatementLine l) IF paymentLineStatement(l) == d;
activePaymentStatementCount(PayrollRun run) = GROUP SUM 1 IF
    paymentStatementPayrollRun(PaymentStatement d) == run AND
    paymentStatementStatus(d) != PaymentStatementStatus.draft;

reopenPayroll 'Переоткрыть расчёт' (PayrollRun r) {
    IF payrollRunStatus(r) != PayrollRunStatus.approved THEN
        MESSAGE 'Переоткрыть можно только закрытый и ещё не выплаченный расчёт';
    ELSE IF activePaymentStatementCount(r) THEN
        MESSAGE 'Нельзя переоткрыть расчёт после заполнения платёжной ведомости';
    ELSE IF NOT payrollReopenReason(r) THEN
        MESSAGE 'Укажите причину переоткрытия расчёта';
    ELSE {
        recordPayrollLifecycle(r, PayrollLifecycleOperation.reopened,
            PayrollRunStatus.approved, PayrollRunStatus.calculated, payrollReopenReason(r));
        payrollLifecycleTransition(r) <- TRUE;
        DELETE PayrollSettlementLine l WHERE settlementPayrollRun(l) == r;
        payrollRunStatus(r) <- PayrollRunStatus.calculated;
        payrollReopenReason(r) <- NULL;
        APPLY;
    }
}

payrollSettlementLineCountForRun(PayrollRun run) = GROUP SUM 1 IF
    settlementPayrollRun(PayrollSettlementLine l) == run;

resetPayrollForRecalculation 'Сбросить для пересчёта' (PayrollRun r) {
    IF payrollRunStatus(r) != PayrollRunStatus.calculated THEN
        MESSAGE 'Сбросить можно только рассчитанную зарплату';
    ELSE IF payrollSettlementLineCountForRun(r) THEN
        MESSAGE 'Сначала переоткройте закрытый расчёт';
    ELSE IF activePaymentStatementCount(r) THEN
        MESSAGE 'Нельзя пересчитать зарплату после формирования платёжной ведомости';
    ELSE IF NOT payrollResetReason(r) THEN
        MESSAGE 'Укажите причину пересчёта зарплаты';
    ELSE {
        FOR enforcementPayrollRun(EnforcementCalculationDocument d) == r AND
            (enforcementCalculationStatus(d) == EnforcementCalculationStatus.calculated OR
             enforcementCalculationStatus(d) == EnforcementCalculationStatus.approved) DO
            cancelEnforcementSnapshot(d);
        FOR taxCalculationPayrollRun(TaxCalculationDocument d) == r AND
            (taxCalculationStatus(d) == TaxCalculationStatus.calculated OR
             taxCalculationStatus(d) == TaxCalculationStatus.approved) DO
            cancelTaxesSnapshot(d);
        FOR socialPaymentPayrollRun(SocialPaymentDocument d) == r AND
            (socialPaymentStatus(d) == SocialPaymentStatus.calculated OR
             socialPaymentStatus(d) == SocialPaymentStatus.approved) DO
            cancelSocialPaymentsSnapshot(d);

        recordPayrollLifecycle(r, PayrollLifecycleOperation.resetForRecalculation,
            PayrollRunStatus.calculated, PayrollRunStatus.timeCollected, payrollResetReason(r));
        payrollLifecycleTransition(r) <- TRUE;
        DELETE PayrollLine l WHERE linePayrollRun(l) == r;
        payrollRunStatus(r) <- PayrollRunStatus.timeCollected;
        payrollCalculatedAt(r) <- NULL;
        payrollResetReason(r) <- NULL;
        APPLY;
    }
}

settlementRunNumber 'Расчёт зарплаты' (PayrollSettlementLine l) = payrollNumber(settlementPayrollRun(l));
settlementEmployeeName 'Сотрудник' (PayrollSettlementLine l) = employeeFullName(settlementEmployee(l));
settlementLegalCode 'Нормативное основание' (PayrollSettlementLine l) = code(settlementLegalSource(l));
statementRunNumber 'Расчёт зарплаты' (PaymentStatement d) = payrollNumber(paymentStatementPayrollRun(d));
statementStatusName 'Статус' (PaymentStatement d) = caption(paymentStatementStatus(d));
statementMethodName 'Способ выплаты' (PaymentStatement d) = caption(paymentStatementMethod(d));
statementLineNumber 'Ведомость' (PaymentStatementLine l) = paymentStatementNumber(paymentLineStatement(l));
statementLineRunNumber 'Расчёт зарплаты' (PaymentStatementLine l) = settlementRunNumber(paymentLineSettlement(l));
statementLineEmployeeName 'Сотрудник' (PaymentStatementLine l) = employeeFullName(paymentLineEmployee(l));
changeStatementRun(PaymentStatement d) {
    DIALOG payrollRuns OBJECTS r = paymentStatementPayrollRun(d) NULL INPUT selected NULL
    DO paymentStatementPayrollRun(d) <- selected;
}
FORM paymentMethods 'Способы выплаты'
    OBJECTS m = PaymentMethod
    PROPERTIES(m) READONLY caption
;
changeStatementMethod(PaymentStatement d) {
    DIALOG paymentMethods OBJECTS m = paymentStatementMethod(d) NULL INPUT selected NULL
    DO paymentStatementMethod(d) <- selected;
}

FORM payrollSettlements 'Расчётные листки'
    OBJECTS l = PayrollSettlementLine
    PROPERTIES(l) READONLY settlementRunNumber, settlementEmployeeName, settlementAccrued,
                           settlementPayrollDeducted, settlementOpv, settlementVosms,
                           settlementIpn, settlementEnforcement, settlementPayable,
                           settlementOpvr, settlementSo, settlementOosms, settlementSocialTax,
                           settlementClosedAt, settlementLegalCode, remainingSettlementAmount,
                           unpaidSettlementAmount
;

FORM payrollLifecycleEntries 'История закрытия расчётов зарплаты'
    OBJECTS e = PayrollLifecycleEntry
    PROPERTIES(e) READONLY payrollLifecycleRun, payrollLifecycleOperation,
                           payrollLifecycleStatusFrom, payrollLifecycleStatusTo,
                           payrollLifecycleReason, payrollLifecycleAt, payrollLifecycleUser
;

FORM paymentStatements 'Ведомости выплаты зарплаты'
    OBJECTS d = PaymentStatement
    PROPERTIES(d) statementRunNumber ON CHANGE changeStatementRun(d), paymentStatementNumber,
                  paymentStatementDate, statementMethodName ON CHANGE changeStatementMethod(d), paymentStatementBankAccount
    PROPERTIES(d) READONLY statementStatusName, paymentStatementCalculatedAt,
                           paymentStatementApprovedAt, paymentStatementPaidAt,
                           paymentStatementOverdue, totalPaymentStatementAmount
    PROPERTIES(d) calculatePaymentStatement, approvePaymentStatement, markPaymentStatementPaid
;

FORM paymentStatementLines 'Строки ведомостей выплаты'
    OBJECTS l = PaymentStatementLine
    PROPERTIES(l) paymentLineAmount
    PROPERTIES(l) READONLY statementLineNumber, statementLineRunNumber,
                           statementLineEmployeeName, paymentLineAmountDue
;

// Повторная подготовка не создаёт дубли. Отменённые документы остаются в истории.
closingSocial(PayrollRun r) = GROUP LAST SocialPaymentDocument d IF
    socialPaymentPayrollRun(d) == r AND socialPaymentStatus(d) != SocialPaymentStatus.cancelled ORDER d;
closingTaxes(PayrollRun r) = GROUP LAST TaxCalculationDocument d IF
    taxCalculationPayrollRun(d) == r AND taxCalculationStatus(d) != TaxCalculationStatus.cancelled ORDER d;
closingEnforcement(PayrollRun r) = GROUP LAST EnforcementCalculationDocument d IF
    enforcementPayrollRun(d) == r AND enforcementCalculationStatus(d) != EnforcementCalculationStatus.cancelled ORDER d;
closingStatement(PayrollRun r) = GROUP LAST PaymentStatement d IF paymentStatementPayrollRun(d) == r ORDER d;
closingSocialCount(PayrollRun r) = GROUP SUM 1 IF socialPaymentPayrollRun(SocialPaymentDocument d) == r AND
    socialPaymentStatus(d) != SocialPaymentStatus.cancelled;
closingTaxCount(PayrollRun r) = GROUP SUM 1 IF taxCalculationPayrollRun(TaxCalculationDocument d) == r AND
    taxCalculationStatus(d) != TaxCalculationStatus.cancelled;
closingEnforcementCount(PayrollRun r) = GROUP SUM 1 IF enforcementPayrollRun(EnforcementCalculationDocument d) == r AND
    enforcementCalculationStatus(d) != EnforcementCalculationStatus.cancelled;
CONSTRAINT closingSocialCount(PayrollRun r) > 1 MESSAGE 'У расчёта уже есть неотменённый документ социальных платежей';
CONSTRAINT closingTaxCount(PayrollRun r) > 1 MESSAGE 'У расчёта уже есть неотменённый налоговый документ';
CONSTRAINT closingEnforcementCount(PayrollRun r) > 1 MESSAGE 'У расчёта уже есть неотменённый документ взысканий';

closingDocumentsRoleAllowed() = has(currentUser() AS CustomUser, userRoleSID('admin')) OR
    has(currentUser() AS CustomUser, userRoleSID('zup_chief_accountant'));
closingDocumentsAllowed(PayrollRun r) = closingDocumentsRoleAllowed() AND organizationActionAllowed(payrollOrganization(r));
closingDocumentsReady(PayrollRun r) = closingSocial(r) AND closingTaxes(r) AND closingEnforcement(r);

preparePayrollClosingDocuments 'Подготовить документы закрытия' (PayrollRun r) {
    IF NOT closingDocumentsAllowed(r) THEN MESSAGE 'Нет прав на подготовку документов этой организации';
    ELSE IF closingTaxes(r) AND NOT (taxCalculationSocialPayments(closingTaxes(r)) == closingSocial(r)) THEN
        MESSAGE 'Налоговый документ связан с другими социальными платежами; проверьте документы';
    ELSE IF closingEnforcement(r) AND NOT (enforcementTaxCalculation(closingEnforcement(r)) == closingTaxes(r)) THEN
        MESSAGE 'Документ взысканий связан с другим налоговым расчётом; проверьте документы';
    ELSE IF NOT closingDocumentsReady(r) THEN {
        IF payrollRunStatus(r) != PayrollRunStatus.calculated THEN MESSAGE 'Сначала рассчитайте зарплату';
        ELSE {
            IF NOT closingSocial(r) THEN NEW d = SocialPaymentDocument {
                socialPaymentPayrollRun(d) <- r;
                socialPaymentStatus(d) <- SocialPaymentStatus.draft;
            }
            IF NOT closingTaxes(r) THEN NEW d = TaxCalculationDocument {
                taxCalculationPayrollRun(d) <- r;
                taxCalculationSocialPayments(d) <- closingSocial(r);
                taxCalculationStatus(d) <- TaxCalculationStatus.draft;
            }
            IF NOT closingEnforcement(r) THEN NEW d = EnforcementCalculationDocument {
                enforcementTaxCalculation(d) <- closingTaxes(r);
                enforcementCalculationStatus(d) <- EnforcementCalculationStatus.draft;
            }
            APPLY;
        }
    }
}
openPayrollSocial '1. Социальные платежи' (PayrollRun r) {
    preparePayrollClosingDocuments(r);
    IF closingDocumentsAllowed(r) AND closingSocial(r) THEN
        SHOW socialPaymentDocuments OBJECTS d = closingSocial(r) NOWAIT;
}
openPayrollTaxes '2. ИПН и социальный налог' (PayrollRun r) {
    preparePayrollClosingDocuments(r);
    IF closingDocumentsAllowed(r) AND closingTaxes(r) THEN
        SHOW taxCalculationDocuments OBJECTS d = closingTaxes(r) NOWAIT;
}
openPayrollEnforcement '3. Проверка взысканий' (PayrollRun r) {
    preparePayrollClosingDocuments(r);
    IF closingDocumentsAllowed(r) AND closingEnforcement(r) THEN
        SHOW enforcementCalculationDocuments OBJECTS d = closingEnforcement(r) NOWAIT;
}
preparePayrollStatement(PayrollRun r) {
    IF NOT closingDocumentsAllowed(r) THEN MESSAGE 'Нет прав на подготовку ведомости этой организации';
    ELSE IF NOT closingStatement(r) THEN {
        IF payrollRunStatus(r) != PayrollRunStatus.approved THEN MESSAGE 'Сначала закройте расчёт зарплаты';
        ELSE NEW d = PaymentStatement {
            paymentStatementPayrollRun(d) <- r;
            paymentStatementDate(d) <- payrollPaymentDueDate(r);
            paymentStatementMethod(d) <- PaymentMethod.bankTransfer;
            paymentStatementStatus(d) <- PaymentStatementStatus.draft;
            APPLY;
        }
    }
}
openPayrollStatement '4. Ведомость выплаты' (PayrollRun r) {
    preparePayrollStatement(r);
    IF closingDocumentsAllowed(r) AND closingStatement(r) THEN
        SHOW paymentStatements OBJECTS d = closingStatement(r) NOWAIT;
}

EXTEND FORM payrollRuns
    PROPERTIES(r) payrollPaymentDueDate, latestPayrollPaymentDate, payrollPaymentLegalSource,
                  remainingPayrollAmount, unpaidPayrollAmount, payrollReopenReason,
                  payrollResetReason
    PROPERTIES(r) closePayroll, reopenPayroll, resetPayrollForRecalculation
    PROPERTIES(r) SHOWIF closingDocumentsRoleAllowed() openPayrollSocial, openPayrollTaxes,
                  openPayrollEnforcement, openPayrollStatement
;
