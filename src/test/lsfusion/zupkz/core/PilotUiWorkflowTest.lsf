MODULE PilotUiWorkflowTest;

REQUIRE AccessWorkflowTest;
NAMESPACE ZUPKZ;

pilotUiOrganization() = organizationByBin('555555555555');
pilotUiEmployee() = GROUP LAST Employee e IF iin(e) == '900101350001' ORDER e;
pilotUiCard() = GROUP LAST EmployeeCard c IF cardEmployee(c) == pilotUiEmployee() ORDER c;
pilotUiTimesheet() = GROUP LAST Timesheet t IF timesheetNumber(t) == 'UI-TS-2026-08' ORDER t;
pilotUiPayrollRun() = GROUP LAST PayrollRun r IF payrollNumber(r) == 'UI-PAY-2026-08' ORDER r;
pilotUiBonus() = GROUP LAST PayrollInput i IF inputPayrollRun(i) == pilotUiPayrollRun() ORDER i;
pilotUiEmployment() = GROUP LAST Employment e IF
    employee(e) == pilotUiEmployee() AND organization(e) == pilotUiOrganization() ORDER e;
pilotUiAssignment() = activeAssignmentOn(pilotUiEmployment(), 2026_08_01);
pilotUiFullTimesheet() = GROUP LAST Timesheet t IF
    timesheetOrganization(t) == pilotUiOrganization() AND timesheetNumber(t) == 'UI-TS-FULL-2026-08' ORDER t;
pilotUiSchedule() = GROUP LAST WorkSchedule s IF
    scheduleOrganization(s) == pilotUiOrganization() AND scheduleCode(s) == 'UI-5-40' ORDER s;

// Старый однодневный табель сохраняется отменённым; полный табель создаётся один раз.
pilotUiFullMonthSetupTest() {
    IF NOT pilotUiAssignment() OR NOT calendarByYear(2026) THEN
        MESSAGE 'Сначала подготовьте сотрудника и календарь 2026';
    ELSE IF pilotUiFullTimesheet() THEN
        EXPORT JSON FROM alreadyExists = TRUE, days = timesheetLineCount(pilotUiFullTimesheet());
    ELSE IF payrollRunStatus(pilotUiPayrollRun()) != PayrollRunStatus.draft THEN
        MESSAGE 'Нельзя менять набор времени уже начатого расчёта';
    ELSE {
        IF NOT pilotUiSchedule() THEN NEW s = WorkSchedule {
            scheduleOrganization(s) <- pilotUiOrganization();
            scheduleCode(s) <- 'UI-5-40';
            scheduleName(s) <- 'UI — пятидневка 40 часов';
            scheduleType(s) <- WorkScheduleType.fiveDay;
            weeklyHours(s) <- 40.00;
            accountingPeriodKind(s) <- AccountingPeriodKind.month;
            scheduleValidFrom(s) <- 2026_08_01;
            NEW a = EmployeeScheduleAssignment {
                scheduleEmploymentAssignment(a) <- pilotUiAssignment();
                employeeWorkSchedule(a) <- s;
                employeeScheduleFrom(a) <- 2026_08_01;
            }
        }
        APPLY;
        IF timesheetStatus(pilotUiTimesheet()) == TimesheetStatus.approved THEN
            cancelTimesheet(pilotUiTimesheet());
        NEW t = Timesheet {
            timesheetOrganization(t) <- pilotUiOrganization();
            timesheetNumber(t) <- 'UI-TS-FULL-2026-08';
            timesheetPeriodFrom(t) <- 2026_08_01;
            timesheetPeriodTo(t) <- 2026_08_31;
            timesheetStatus(t) <- TimesheetStatus.draft;
            APPLY;
            fillTimesheet(t);
        }
        EXPORT JSON FROM created = TRUE, days = timesheetLineCount(pilotUiFullTimesheet()),
            originalPreserved = timesheetStatus(pilotUiTimesheet()) == TimesheetStatus.cancelled;
    }
}

pilotUiVerificationTest() {
    EXPORT JSON FROM
        employee = employeeFullName(pilotUiEmployee()),
        fullMonthDays = timesheetLineCount(pilotUiFullTimesheet()),
        timesheetApproved = timesheetStatus(pilotUiFullTimesheet()) == TimesheetStatus.approved,
        approver = login(approvedBy(pilotUiFullTimesheet())),
        approverLabel = timesheetApproverName(pilotUiFullTimesheet()),
        originalPreserved = timesheetStatus(pilotUiTimesheet()) == TimesheetStatus.cancelled,
        plannedHours = summaryPlannedHours(payrollTimeSummaryByKey(pilotUiPayrollRun(), pilotUiAssignment())),
        workedHours = summaryWorkedHours(payrollTimeSummaryByKey(pilotUiPayrollRun(), pilotUiAssignment())),
        calculated = payrollRunStatus(pilotUiPayrollRun()) == PayrollRunStatus.calculated OR
            payrollRunStatus(pilotUiPayrollRun()) == PayrollRunStatus.approved OR
            payrollRunStatus(pilotUiPayrollRun()) == PayrollRunStatus.paid,
        lineCount = payrollLineCount(pilotUiPayrollRun()),
        accrued = totalAccrued(pilotUiPayrollRun()),
        expectedAccrued = totalAccrued(pilotUiPayrollRun()) == 400000.00;
}

pilotUiSocial() = GROUP LAST SocialPaymentDocument d IF
    socialPaymentPayrollRun(d) == pilotUiPayrollRun() ORDER d;
pilotUiTaxes() = GROUP LAST TaxCalculationDocument d IF
    taxCalculationPayrollRun(d) == pilotUiPayrollRun() ORDER d;
pilotUiEnforcement() = GROUP LAST EnforcementCalculationDocument d IF
    enforcementPayrollRun(d) == pilotUiPayrollRun() ORDER d;
pilotUiStatement() = GROUP LAST PaymentStatement d IF
    paymentStatementPayrollRun(d) == pilotUiPayrollRun() AND
    paymentStatementNumber(d) == 'UI-BANK-2026-08' ORDER d;
pilotUiSettlement() = settlementLineByEmployee(pilotUiPayrollRun(), pilotUiEmployee());

// Только черновики: расчёт, утверждение и закрытие выполняет проверяющий через UI.
pilotUiSettlementSetupTest() {
    IF pilotUiSocial() AND pilotUiTaxes() AND pilotUiEnforcement() AND pilotUiStatement() THEN
        EXPORT JSON FROM alreadyExists = TRUE;
    ELSE IF pilotUiSocial() OR pilotUiTaxes() OR pilotUiEnforcement() OR pilotUiStatement() THEN
        MESSAGE 'Неполный набор: проверьте существующие документы, автоматического сброса нет';
    ELSE IF payrollRunStatus(pilotUiPayrollRun()) != PayrollRunStatus.calculated THEN
        MESSAGE 'Сначала рассчитайте зарплату пилотного сотрудника';
    ELSE IF employeeTaxProfileOn(pilotUiOrganization(), pilotUiEmployee(), 2026_08_31) THEN
        MESSAGE 'Налоговый профиль уже существует: проверьте его вручную';
    ELSE {
        NEW p = EmployeeTaxProfile {
            taxProfileOrganization(p) <- pilotUiOrganization();
            taxProfileEmployee(p) <- pilotUiEmployee();
            taxProfileValidFrom(p) <- 2026_08_01;
            taxProfileResident(p) <- TRUE;
            taxProfileIncomeStatus(p) <- TaxIncomeStatus.employee;
            taxProfileBasicDeduction(p) <- TRUE;
            taxProfileSocialDeduction(p) <- IpnSocialDeductionKind.none;
            taxProfileBasis(p) <- 'Синтетическое заявление UI: базовый вычет у одного агента';
        }
        NEW s = SocialPaymentDocument {
            socialPaymentPayrollRun(s) <- pilotUiPayrollRun();
            socialPaymentStatus(s) <- SocialPaymentStatus.draft;
            NEW t = TaxCalculationDocument {
                taxCalculationPayrollRun(t) <- pilotUiPayrollRun();
                taxCalculationSocialPayments(t) <- s;
                taxCalculationStatus(t) <- TaxCalculationStatus.draft;
                NEW e = EnforcementCalculationDocument {
                    enforcementTaxCalculation(e) <- t;
                    enforcementCalculationStatus(e) <- EnforcementCalculationStatus.draft;
                }
            }
        }
        NEW p = PaymentStatement {
            paymentStatementPayrollRun(p) <- pilotUiPayrollRun();
            paymentStatementNumber(p) <- 'UI-BANK-2026-08';
            paymentStatementDate(p) <- 2026_09_10;
            paymentStatementMethod(p) <- PaymentMethod.bankTransfer;
            paymentStatementBankAccount(p) <- payrollIban(pilotUiOrganization());
            paymentStatementStatus(p) <- PaymentStatementStatus.draft;
        }
        APPLY;
        EXPORT JSON FROM draftsReady = pilotUiSocial() AND pilotUiTaxes() AND
            pilotUiEnforcement() AND pilotUiStatement();
    }
}

pilotUiSettlementVerificationTest() {
    EXPORT JSON FROM
        socialApproved = socialPaymentStatus(pilotUiSocial()) == SocialPaymentStatus.approved,
        taxesApproved = taxCalculationStatus(pilotUiTaxes()) == TaxCalculationStatus.approved,
        enforcementApproved = enforcementCalculationStatus(pilotUiEnforcement()) == EnforcementCalculationStatus.approved,
        payrollClosed = payrollRunStatus(pilotUiPayrollRun()) == PayrollRunStatus.approved,
        settlementCount = payrollSettlementLineCountForRun(pilotUiPayrollRun()),
        accrued = settlementAccrued(pilotUiSettlement()),
        opv = settlementOpv(pilotUiSettlement()), opvr = settlementOpvr(pilotUiSettlement()),
        so = settlementSo(pilotUiSettlement()), vosms = settlementVosms(pilotUiSettlement()),
        oosms = settlementOosms(pilotUiSettlement()), ipn = settlementIpn(pilotUiSettlement()),
        socialTax = settlementSocialTax(pilotUiSettlement()),
        basicDeduction = totalIpnBasicDeduction(pilotUiTaxes()),
        payable = settlementPayable(pilotUiSettlement()),
        statementFilled = paymentStatementStatus(pilotUiStatement()) == PaymentStatementStatus.calculated,
        statementLines = paymentStatementLineCount(pilotUiStatement()),
        statementAmount = totalPaymentStatementAmount(pilotUiStatement()),
        unpaid = unpaidPayrollAmount(pilotUiPayrollRun()),
        notPaid = NOT paymentStatementPaidAt(pilotUiStatement()),
        socialPack = packCode(socialPaymentRegulatoryPack(pilotUiSocial())),
        taxPack = packCode(taxCalculationRegulatoryPack(pilotUiTaxes()));
}

// Постоянный набор для ручной ролевой проверки. Повторный запуск ничего не создаёт.
pilotUiPreparationRun() = GROUP LAST PayrollRun r IF payrollOrganization(r) == pilotUiOrganization() AND
    payrollNumber(r) == 'UI-PREP-2026-09' ORDER r;
pilotUiPreparationTimesheet() = GROUP LAST Timesheet t IF timesheetOrganization(t) == pilotUiOrganization() AND
    timesheetNumber(t) == 'UI-PREP-TS-2026-09' ORDER t;

// Только исходные время и начисление. Связанные документы создаются через UI.
pilotUiPreparationSetupTest() {
    IF pilotUiPreparationRun() THEN EXPORT JSON FROM alreadyExists = TRUE;
    ELSE IF NOT pilotUiAssignment() OR NOT pilotUiSchedule() THEN MESSAGE 'Нет исходного сотрудника и графика';
    ELSE IF pilotUiPreparationTimesheet() THEN MESSAGE 'Частичная подготовка: проверьте сохранённый сентябрьский табель';
    ELSE NEW t = Timesheet {
        timesheetOrganization(t) <- pilotUiOrganization();
        timesheetNumber(t) <- 'UI-PREP-TS-2026-09';
        timesheetPeriodFrom(t) <- 2026_09_01;
        timesheetPeriodTo(t) <- 2026_09_30;
        timesheetStatus(t) <- TimesheetStatus.draft;
        APPLY;
        fillTimesheet(t);
        approveTimesheet(t);
        NEW r = PayrollRun {
            payrollOrganization(r) <- pilotUiOrganization();
            payrollNumber(r) <- 'UI-PREP-2026-09';
            payrollPeriodFrom(r) <- 2026_09_01;
            payrollPeriodTo(r) <- 2026_09_30;
            payrollPaymentDueDate(r) <- 2026_10_09;
            payrollRunStatus(r) <- PayrollRunStatus.draft;
            APPLY;
            collectApprovedTime(r);
            calculatePayroll(r);
        }
        EXPORT JSON FROM accrued = totalAccrued(pilotUiPreparationRun()),
            noClosingDocuments = NOT closingSocial(pilotUiPreparationRun()) AND
                NOT closingTaxes(pilotUiPreparationRun()) AND NOT closingEnforcement(pilotUiPreparationRun()) AND
                NOT closingStatement(pilotUiPreparationRun());
    }
}

pilotUiPreparationDeniedTest() {
    preparePayrollClosingDocuments(pilotUiPreparationRun());
    preparePayrollStatement(pilotUiPreparationRun());
    EXPORT JSON FROM roleDenied = NOT closingDocumentsRoleAllowed(),
        noClosingDocuments = NOT closingSocial(pilotUiPreparationRun()) AND
            NOT closingTaxes(pilotUiPreparationRun()) AND NOT closingEnforcement(pilotUiPreparationRun()) AND
            NOT closingStatement(pilotUiPreparationRun());
}

pilotUiPreparationVerificationTest() {
    EXPORT JSON FROM socialCount = closingSocialCount(pilotUiPreparationRun()),
        taxCount = closingTaxCount(pilotUiPreparationRun()),
        enforcementCount = closingEnforcementCount(pilotUiPreparationRun()),
        statementCount = (GROUP SUM 1 IF paymentStatementPayrollRun(PaymentStatement d) == pilotUiPreparationRun()),
        linkedSocial = taxCalculationSocialPayments(closingTaxes(pilotUiPreparationRun())) == closingSocial(pilotUiPreparationRun()),
        linkedTaxes = enforcementTaxCalculation(closingEnforcement(pilotUiPreparationRun())) == closingTaxes(pilotUiPreparationRun()),
        payrollClosed = payrollRunStatus(pilotUiPreparationRun()) == PayrollRunStatus.approved,
        accrued = totalAccrued(pilotUiPreparationRun()),
        payable = settlementPayable(settlementLineByEmployee(pilotUiPreparationRun(), pilotUiEmployee())),
        statementFilled = paymentStatementStatus(closingStatement(pilotUiPreparationRun())) == PaymentStatementStatus.calculated,
        statementAmount = totalPaymentStatementAmount(closingStatement(pilotUiPreparationRun())),
        notPaid = NOT paymentStatementPaidAt(closingStatement(pilotUiPreparationRun())),
        socialRunLabel = socialPaymentRunNumber(closingSocial(pilotUiPreparationRun())),
        employeeLabel = settlementEmployeeName(settlementLineByEmployee(pilotUiPreparationRun(), pilotUiEmployee()));
}

// Проверка представления на сохранённом сентябрьском снимке, без записи в БД.
pilotUiEmptySettlement = DATA LOCAL PayrollSettlementLine ();
pilotUiPayslipVerificationTest() {
    EXPORT JSON FROM
        allowed = settlementViewAllowed(settlementLineByEmployee(pilotUiPreparationRun(), pilotUiEmployee())),
        withheld = settlementTotalDeducted(settlementLineByEmployee(pilotUiPreparationRun(), pilotUiEmployee())),
        accrued = settlementAccrued(settlementLineByEmployee(pilotUiPreparationRun(), pilotUiEmployee())),
        payable = settlementPayable(settlementLineByEmployee(pilotUiPreparationRun(), pilotUiEmployee())),
        organization = settlementOrganizationName(settlementLineByEmployee(pilotUiPreparationRun(), pilotUiEmployee())),
        employee = settlementEmployeeName(settlementLineByEmployee(pilotUiPreparationRun(), pilotUiEmployee())),
        nullDenied = NOT settlementViewAllowed(pilotUiEmptySettlement());
}
pilotUiPayslipPdfTest() {
    IF NOT settlementViewAllowed(settlementLineByEmployee(pilotUiPreparationRun(), pilotUiEmployee())) THEN
        EXPORT JSON FROM denied = TRUE;
    ELSE PRINT payrollSettlementCard OBJECTS
        l = settlementLineByEmployee(pilotUiPreparationRun(), pilotUiEmployee()) PDF TO exportFile;
}
pilotUiPayslipAugustPdfTest() {
    IF NOT settlementViewAllowed(pilotUiSettlement()) THEN EXPORT JSON FROM denied = TRUE;
    ELSE PRINT payrollSettlementCard OBJECTS l = pilotUiSettlement() PDF TO exportFile;
}
pilotUiPayslipDetailVerificationTest() {
    EXPORT JSON FROM
        augustCount = settlementDetailCount(pilotUiSettlement()),
        septemberCount = settlementDetailCount(settlementLineByEmployee(pilotUiPreparationRun(), pilotUiEmployee())),
        augustSalary = (GROUP SUM calculationAmount(PayrollLine d) IF settlementContainsLine(pilotUiSettlement(), d) AND
            calculationCode(lineCalculationType(d)) == 'BASE_SALARY'),
        augustBonus = (GROUP SUM calculationAmount(PayrollLine d) IF settlementContainsLine(pilotUiSettlement(), d) AND
            calculationCode(lineCalculationType(d)) == 'FIXED_BONUS'),
        augustAccrued = (GROUP SUM calculationAmount(PayrollLine d) IF settlementContainsLine(pilotUiSettlement(), d) AND
            calculationCategory(lineCalculationType(d)) == CalculationCategory.accrual),
        crossPeriodLeaks = (GROUP SUM 1 IF settlementContainsLine(pilotUiSettlement(), PayrollLine d) AND
            linePayrollRun(d) == pilotUiPreparationRun()),
        allowed = settlementViewAllowed(pilotUiSettlement());
}

pilotUiDeductionsRun() = GROUP LAST PayrollRun r IF payrollOrganization(r) == pilotUiOrganization() AND
    payrollNumber(r) == 'UI-DEDUCT-2026-10' ORDER r;
pilotUiDeductionsTimesheet() = GROUP LAST Timesheet t IF timesheetOrganization(t) == pilotUiOrganization() AND
    timesheetNumber(t) == 'UI-DEDUCT-TS-2026-10' ORDER t;
pilotUiSecondEmployee() = GROUP LAST Employee e IF iin(e) == '910202350002' ORDER e;
pilotUiSecondAssignment() = GROUP LAST EmploymentAssignment a IF
    employee(employment(a)) == pilotUiSecondEmployee() AND organization(employment(a)) == pilotUiOrganization() ORDER a;
pilotUiDeductionsSettlement(Employee e) = settlementLineByEmployee(pilotUiDeductionsRun(), e);

// Добавляет один постоянный набор; не переоткрывает старые расчёты и не сбрасывает данные.
// Это подготовка источников для UI-теста зарплаты, не приёмка кадрового оформления.
pilotUiDeductionsSetupTest() {
    IF login(currentUser() AS CustomUser) != 'ui-chief' OR NOT organizationAllowed(pilotUiOrganization()) THEN
        EXPORT JSON FROM denied = TRUE;
    ELSE IF pilotUiDeductionsRun() THEN EXPORT JSON FROM alreadyExists = TRUE;
    ELSE IF pilotUiSecondEmployee() OR pilotUiDeductionsTimesheet() OR
            uiRoleTestUser('ui-auditor-isolated') OR organizationByBin('666666666666') THEN
        MESSAGE 'Частичный набор UI-DEDUCT: проверьте существующие данные, автоматического сброса нет';
    ELSE IF NOT pilotUiAssignment() OR NOT pilotUiSchedule() OR NOT calculationTypeByCode('OTHER_DEDUCTION') THEN
        MESSAGE 'Нет исходного сотрудника, графика или вида удержания';
    ELSE {
        NEW isolated = Organization {
            name(isolated) <- 'UI Isolated Organization';
            bin(isolated) <- '666666666666';
            createUiRoleTestUser('ui-auditor-isolated', 'zup_auditor', isolated);
        }
        NEW worker = Employee {
            iin(worker) <- '910202350002';
            lastName(worker) <- 'Тестов';
            firstName(worker) <- 'Данияр';
            middleName(worker) <- 'Контрольный';
            birthDate(worker) <- 1991_02_02;
            NEW contract = Employment {
                employee(contract) <- worker;
                organization(contract) <- pilotUiOrganization();
                department(contract) <- department(pilotUiEmployment());
                position(contract) <- position(pilotUiEmployment());
                hireDate(contract) <- 2026_10_01;
                contractNumber(contract) <- 'UI-DEDUCT-TD-002';
                contractDate(contract) <- 2026_09_30;
                employmentKind(contract) <- EmploymentKind.primary;
                contractTermKind(contract) <- ContractTermKind.indefinite;
                salary(contract) <- 200000.00;
                NEW assignment = EmploymentAssignment {
                    employment(assignment) <- contract;
                    assignmentFrom(assignment) <- 2026_10_01;
                    fte(assignment) <- 1.0000;
                    assignmentSalary(assignment) <- 200000.00;
                    NEW schedule = EmployeeScheduleAssignment {
                        scheduleEmploymentAssignment(schedule) <- assignment;
                        employeeWorkSchedule(schedule) <- pilotUiSchedule();
                        employeeScheduleFrom(schedule) <- 2026_10_01;
                    }
                }
            }
            NEW profile = EmployeeTaxProfile {
                taxProfileOrganization(profile) <- pilotUiOrganization();
                taxProfileEmployee(profile) <- worker;
                taxProfileValidFrom(profile) <- 2026_10_01;
                taxProfileResident(profile) <- TRUE;
                taxProfileIncomeStatus(profile) <- TaxIncomeStatus.employee;
                taxProfileBasicDeduction(profile) <- TRUE;
                taxProfileSocialDeduction(profile) <- IpnSocialDeductionKind.none;
                taxProfileBasis(profile) <- 'Синтетический UI-набор: базовый вычет';
            }
        }
        NEW order = EnforcementOrder {
            enforcementOrganization(order) <- pilotUiOrganization();
            enforcementEmployee(order) <- pilotUiEmployee();
            enforcementNumber(order) <- 'UI-DEDUCT-ORDER-001';
            enforcementDate(order) <- 2026_09_30;
            enforcementValidFrom(order) <- 2026_10_01;
            enforcementValidTo(order) <- 2026_10_31;
            enforcementKind(order) <- EnforcementOrderKind.other;
            enforcementCalculationKind(order) <- EnforcementCalculationKind.fixedAmount;
            enforcementStatus(order) <- EnforcementOrderStatus.active;
            enforcementPriority(order) <- 5;
            enforcementFixedAmount(order) <- 20000.00;
            enforcementRecipient(order) <- 'Синтетический получатель UI — не перечислять';
            enforcementBasis(order) <- 'Тест отображения фиксированного взыскания, не реальный исполнительный документ';
        }
        NEW sheet = Timesheet {
            timesheetOrganization(sheet) <- pilotUiOrganization();
            timesheetNumber(sheet) <- 'UI-DEDUCT-TS-2026-10';
            timesheetPeriodFrom(sheet) <- 2026_10_01;
            timesheetPeriodTo(sheet) <- 2026_10_31;
            timesheetStatus(sheet) <- TimesheetStatus.draft;
        }
        NEW run = PayrollRun {
            payrollOrganization(run) <- pilotUiOrganization();
            payrollNumber(run) <- 'UI-DEDUCT-2026-10';
            payrollPeriodFrom(run) <- 2026_10_01;
            payrollPeriodTo(run) <- 2026_10_31;
            payrollPaymentDueDate(run) <- 2026_11_10;
            payrollRunStatus(run) <- PayrollRunStatus.draft;
            NEW first = PayrollInput {
                inputPayrollRun(first) <- run;
                inputAssignment(first) <- pilotUiAssignment();
                inputCalculationType(first) <- calculationTypeByCode('OTHER_DEDUCTION');
                inputManualAmount(first) <- 15000.00;
                inputBasis(first) <- 'UI: прочее удержание 15 000 по синтетическому заявлению';
            }
            NEW second = PayrollInput {
                inputPayrollRun(second) <- run;
                inputAssignment(second) <- pilotUiSecondAssignment();
                inputCalculationType(second) <- calculationTypeByCode('OTHER_DEDUCTION');
                inputManualAmount(second) <- 4000.00;
                inputBasis(second) <- 'UI: контроль изоляции удержания второго сотрудника';
            }
        }
        APPLY;
        fillTimesheet(pilotUiDeductionsTimesheet());
        EXPORT JSON FROM ready = TRUE, days = timesheetLineCount(pilotUiDeductionsTimesheet());
    }
}

pilotUiDeductionsVerificationTest() {
    EXPORT JSON FROM closed = payrollRunStatus(pilotUiDeductionsRun()) == PayrollRunStatus.approved,
        settlementCount = payrollSettlementLineCountForRun(pilotUiDeductionsRun()),
        firstAccrued = settlementAccrued(pilotUiDeductionsSettlement(pilotUiEmployee())),
        firstOther = settlementPayrollDeducted(pilotUiDeductionsSettlement(pilotUiEmployee())),
        firstEnforcement = settlementEnforcement(pilotUiDeductionsSettlement(pilotUiEmployee())),
        firstWithheld = settlementTotalDeducted(pilotUiDeductionsSettlement(pilotUiEmployee())),
        firstPayable = settlementPayable(pilotUiDeductionsSettlement(pilotUiEmployee())),
        firstLines = settlementDetailCount(pilotUiDeductionsSettlement(pilotUiEmployee())),
        secondAccrued = settlementAccrued(pilotUiDeductionsSettlement(pilotUiSecondEmployee())),
        secondOther = settlementPayrollDeducted(pilotUiDeductionsSettlement(pilotUiSecondEmployee())),
        secondEnforcement = settlementEnforcement(pilotUiDeductionsSettlement(pilotUiSecondEmployee())),
        secondWithheld = settlementTotalDeducted(pilotUiDeductionsSettlement(pilotUiSecondEmployee())),
        secondPayable = settlementPayable(pilotUiDeductionsSettlement(pilotUiSecondEmployee())),
        secondLines = settlementDetailCount(pilotUiDeductionsSettlement(pilotUiSecondEmployee())),
        wrongEmployeeLines = (GROUP SUM 1 IF settlementContainsLine(pilotUiDeductionsSettlement(pilotUiEmployee()), PayrollLine d) AND
            employee(employment(linePayrollAssignment(d))) == pilotUiSecondEmployee()),
        noPayment = NOT closingStatement(pilotUiDeductionsRun());
}

pilotUiPayslipAccessVerificationTest() {
    EXPORT JSON FROM authenticated = login(currentUser() AS CustomUser),
        payrollRole = settlementViewRoleAllowed(),
        organizationAllowed = organizationAllowed(pilotUiOrganization()),
        isolatedOrganizationAllowed = organizationAllowed(organizationByBin('666666666666')),
        targetExists = pilotUiSettlement() IS PayrollSettlementLine,
        targetAllowed = settlementViewAllowed(pilotUiSettlement()),
        nullDenied = NOT settlementViewAllowed(pilotUiEmptySettlement()),
        visibleCount = (GROUP SUM 1 IF settlementViewAllowed(PayrollSettlementLine l));
}
// Намеренно обращаются к настоящим действиям с существующим, но недоступным объектом.
// Ни одно из действий не изменяет расчёты; PDF при отказе не формируется.
pilotUiHiddenPayslipOpenTest() { openPayrollSettlement(pilotUiSettlement()); }
pilotUiHiddenPayslipPrintTest() { printPayrollSettlementPdf(pilotUiSettlement()); }

pilotUiEnforcementLine() = GROUP LAST EnforcementCalculationLine l IF
    enforcementCalculationDocument(l) == closingEnforcement(pilotUiDeductionsRun()) ORDER l;
// Запускается только после установки защит. Ожидается отказ APPLY; CANCEL
// очищает отклонённые изменения только этой API-сессии, не данные базы.
pilotUiEnforcementGuardTest(STRING[20] mode) {
    IF login(currentUser() AS CustomUser) != 'ui-chief' OR
        NOT pilotUiEnforcementLine() OR enforcementWithheldAmount(pilotUiEnforcementLine()) != 20000.00 THEN
        EXPORT JSON FROM fixtureError = TRUE;
    ELSE {
        IF mode == 'amount' THEN enforcementWithheldAmount(pilotUiEnforcementLine()) <- 19999.00;
        ELSE IF mode == 'delete' THEN DELETE EnforcementCalculationLine l WHERE l == pilotUiEnforcementLine();
        ELSE IF mode == 'relink' THEN enforcementCalculationDocument(pilotUiEnforcementLine()) <- pilotUiEnforcement();
        ELSE IF mode == 'source' THEN enforcementTaxCalculation(closingEnforcement(pilotUiDeductionsRun())) <- pilotUiTaxes();
        ELSE IF mode == 'timestamp' THEN enforcementCalculatedAt(closingEnforcement(pilotUiDeductionsRun())) <- NULL;
        ELSE RETURN;
        APPLY;
        IF canceled() THEN {
            CANCEL;
            EXPORT JSON FROM blocked = TRUE,
                amount = enforcementWithheldAmount(pilotUiEnforcementLine()),
                sourcePreserved = enforcementTaxCalculation(closingEnforcement(pilotUiDeductionsRun())) ==
                    closingTaxes(pilotUiDeductionsRun());
        } ELSE EXPORT JSON FROM unexpectedWrite = TRUE;
    }
}

pilotUiEnforcementCycleRun() = GROUP LAST PayrollRun r IF payrollOrganization(r) == pilotUiOrganization() AND
    payrollNumber(r) == 'UI-ENFORCE-2026-11' ORDER r;
pilotUiEnforcementCycleTimesheet() = GROUP LAST Timesheet t IF timesheetOrganization(t) == pilotUiOrganization() AND
    timesheetNumber(t) == 'UI-ENFORCE-TS-2026-11' ORDER t;
pilotUiEnforcementCycleOrder() = GROUP LAST EnforcementOrder o IF enforcementOrganization(o) == pilotUiOrganization() AND
    enforcementNumber(o) == 'UI-ENFORCE-ORDER-001' ORDER o;
pilotUiCancelledEnforcement() = GROUP LAST EnforcementCalculationDocument d IF
    enforcementPayrollRun(d) == pilotUiEnforcementCycleRun() AND
    enforcementCalculationStatus(d) == EnforcementCalculationStatus.cancelled ORDER d;

// Постоянный ноябрьский набор. Только подготовка источников через API;
// расчёт взысканий, отмена и повторная подготовка выполняются настоящими кнопками UI.
pilotUiEnforcementCycleSetupTest() {
    IF login(currentUser() AS CustomUser) != 'ui-chief' OR NOT organizationAllowed(pilotUiOrganization()) THEN
        EXPORT JSON FROM denied = TRUE;
    ELSE IF pilotUiEnforcementCycleRun() THEN EXPORT JSON FROM alreadyExists = TRUE;
    ELSE IF pilotUiEnforcementCycleTimesheet() OR pilotUiEnforcementCycleOrder() THEN
        MESSAGE 'Частичный ноябрьский набор: автоматического сброса нет';
    ELSE IF NOT pilotUiSecondAssignment() OR payrollRunStatus(pilotUiDeductionsRun()) != PayrollRunStatus.approved THEN
        MESSAGE 'Сначала завершите октябрьский UI-набор';
    ELSE {
        NEW order = EnforcementOrder {
            enforcementOrganization(order) <- pilotUiOrganization();
            enforcementEmployee(order) <- pilotUiEmployee();
            enforcementNumber(order) <- 'UI-ENFORCE-ORDER-001';
            enforcementDate(order) <- 2026_10_31;
            enforcementValidFrom(order) <- 2026_11_01;
            enforcementValidTo(order) <- 2026_11_30;
            enforcementKind(order) <- EnforcementOrderKind.other;
            enforcementCalculationKind(order) <- EnforcementCalculationKind.fixedAmount;
            enforcementStatus(order) <- EnforcementOrderStatus.active;
            enforcementPriority(order) <- 5;
            enforcementFixedAmount(order) <- 25000.00;
            enforcementRecipient(order) <- 'Синтетический получатель UI — не перечислять';
            enforcementBasis(order) <- 'UI: первый расчёт, отмена и повторная подготовка после установки защит';
        }
        NEW sheet = Timesheet {
            timesheetOrganization(sheet) <- pilotUiOrganization();
            timesheetNumber(sheet) <- 'UI-ENFORCE-TS-2026-11';
            timesheetPeriodFrom(sheet) <- 2026_11_01;
            timesheetPeriodTo(sheet) <- 2026_11_30;
            timesheetStatus(sheet) <- TimesheetStatus.draft;
        }
        NEW run = PayrollRun {
            payrollOrganization(run) <- pilotUiOrganization();
            payrollNumber(run) <- 'UI-ENFORCE-2026-11';
            payrollPeriodFrom(run) <- 2026_11_01;
            payrollPeriodTo(run) <- 2026_11_30;
            payrollPaymentDueDate(run) <- 2026_12_10;
            payrollRunStatus(run) <- PayrollRunStatus.draft;
        }
        APPLY;
        EXPORT JSON FROM created = pilotUiEnforcementCycleRun() IS PayrollRun;
    }
}
pilotUiHistoryRun() = GROUP LAST PayrollRun r IF payrollOrganization(r) == pilotUiOrganization() AND
    payrollNumber(r) == 'UI-HISTORY-2026-12' ORDER r;
pilotUiHistorySheet() = GROUP LAST Timesheet t IF timesheetOrganization(t) == pilotUiOrganization() AND
    timesheetNumber(t) == 'UI-HISTORY-TS-2026-12' ORDER t;
preparePilotUiEnforcementSources(PayrollRun run, Timesheet sheet) {
    IF login(currentUser() AS CustomUser) != 'ui-chief' OR NOT closingDocumentsAllowed(run) OR
       NOT ((run == pilotUiEnforcementCycleRun() AND sheet == pilotUiEnforcementCycleTimesheet()) OR
            (run == pilotUiHistoryRun() AND sheet == pilotUiHistorySheet())) THEN
        EXPORT JSON FROM denied = TRUE;
    ELSE {
        IF timesheetStatus(sheet) == TimesheetStatus.draft THEN {
            IF NOT timesheetLineCount(sheet) THEN fillTimesheet(sheet);
            approveTimesheet(sheet);
        }
        IF payrollRunStatus(run) == PayrollRunStatus.draft THEN
            collectApprovedTime(run);
        IF payrollRunStatus(run) == PayrollRunStatus.timeCollected THEN
            calculatePayroll(run);
        preparePayrollClosingDocuments(run);
        IF socialPaymentStatus(closingSocial(run)) == SocialPaymentStatus.draft THEN
            calculateSocialPayments(closingSocial(run));
        IF socialPaymentStatus(closingSocial(run)) == SocialPaymentStatus.calculated THEN
            approveSocialPayments(closingSocial(run));
        IF taxCalculationStatus(closingTaxes(run)) == TaxCalculationStatus.draft THEN
            calculateTaxes(closingTaxes(run));
        IF taxCalculationStatus(closingTaxes(run)) == TaxCalculationStatus.calculated THEN
            approveTaxes(closingTaxes(run));
        EXPORT JSON FROM sourceReady = taxCalculationStatus(closingTaxes(run)) == TaxCalculationStatus.approved,
            days = timesheetLineCount(sheet),
            accrued = totalAccrued(run),
            beforeEnforcement = payableAfterTaxes(closingTaxes(run));
    }
}
pilotUiEnforcementCycleSourcesTest() {
    preparePilotUiEnforcementSources(pilotUiEnforcementCycleRun(), pilotUiEnforcementCycleTimesheet());
}
pilotUiEnforcementCycleVerificationTest() {
    EXPORT JSON FROM activeCount = closingEnforcementCount(pilotUiEnforcementCycleRun()),
        documentCount = (GROUP SUM 1 IF enforcementPayrollRun(EnforcementCalculationDocument d) == pilotUiEnforcementCycleRun()),
        status = caption(enforcementCalculationStatus(closingEnforcement(pilotUiEnforcementCycleRun()))),
        amount = totalEnforcementWithheld(closingEnforcement(pilotUiEnforcementCycleRun())),
        payable = payableAfterEnforcement(closingEnforcement(pilotUiEnforcementCycleRun())),
        activeLines = (GROUP SUM 1 IF enforcementCalculationDocument(EnforcementCalculationLine l) == closingEnforcement(pilotUiEnforcementCycleRun())),
        activeStamped = enforcementCalculatedAt(closingEnforcement(pilotUiEnforcementCycleRun())) IS DATETIME,
        cancelledAmount = totalEnforcementWithheld(pilotUiCancelledEnforcement()),
        cancelledLines = (GROUP SUM 1 IF enforcementCalculationDocument(EnforcementCalculationLine l) == pilotUiCancelledEnforcement()),
        cancelledStamped = enforcementCalculatedAt(pilotUiCancelledEnforcement()) IS DATETIME,
        cancelledSourcePreserved = enforcementTaxCalculation(pilotUiCancelledEnforcement()) == closingTaxes(pilotUiEnforcementCycleRun()),
        payrollStillCalculated = payrollRunStatus(pilotUiEnforcementCycleRun()) == PayrollRunStatus.calculated,
        noPayment = NOT closingStatement(pilotUiEnforcementCycleRun()),
        oldMonthsClosed = payrollRunStatus(pilotUiPayrollRun()) == PayrollRunStatus.approved AND
            payrollRunStatus(pilotUiPreparationRun()) == PayrollRunStatus.approved AND
            payrollRunStatus(pilotUiDeductionsRun()) == PayrollRunStatus.approved;
}

pilotUiUnusedEnforcementOrder() = GROUP LAST EnforcementOrder o IF
    enforcementNumber(o) == 'UI-UNUSED-OWNER-001' AND enforcementOrganization(o) == pilotUiOrganization() ORDER o;
// Один неактивированный документ для положительного UI-теста выбора владельца.
pilotUiUnusedEnforcementSetupTest() {
    IF login(currentUser() AS CustomUser) != 'ui-chief' OR NOT organizationAllowed(pilotUiOrganization()) THEN RETURN;
    IF NOT pilotUiUnusedEnforcementOrder() THEN NEW o = EnforcementOrder {
        enforcementNumber(o) <- 'UI-UNUSED-OWNER-001';
        enforcementOrganization(o) <- pilotUiOrganization();
        enforcementEmployee(o) <- pilotUiEmployee();
        enforcementBasis(o) <- 'Синтетический неактивный документ: проверка выбора владельца до расчёта';
        APPLY;
    }
    EXPORT JSON FROM exists = pilotUiUnusedEnforcementOrder() IS EnforcementOrder,
        unused = NOT enforcementOrderUsed(pilotUiUnusedEnforcementOrder());
}
pilotUiUnusedEnforcementVerificationTest() {
    EXPORT JSON FROM owner = enforcementEmployeeName(pilotUiUnusedEnforcementOrder()),
        unused = NOT enforcementOrderUsed(pilotUiUnusedEnforcementOrder()),
        inactive = NOT enforcementStatus(pilotUiUnusedEnforcementOrder()),
        statusName = enforcementOrderStatusName(pilotUiUnusedEnforcementOrder()),
        kindName = enforcementKindName(pilotUiUnusedEnforcementOrder()),
        methodName = enforcementMethodName(pilotUiUnusedEnforcementOrder()),
        activeStatusName = enforcementOrderStatusName(pilotUiEnforcementCycleOrder()),
        missing = enforcementActivationMissing(pilotUiUnusedEnforcementOrder()),
        completeOrderReady = NOT enforcementActivationMissing(pilotUiEnforcementCycleOrder()),
        usedOwnerPreserved = enforcementEmployee(pilotUiEnforcementCycleOrder()) == pilotUiEmployee();
}
// Только после установки защиты: ожидаемый отказ APPLY не меняет постоянный набор.
pilotUiSourceGuardTest(STRING[20] mode) {
    IF login(currentUser() AS CustomUser) != 'ui-chief' OR NOT pilotUiEnforcementCycleOrder() OR
       enforcementEmployee(pilotUiEnforcementCycleOrder()) != pilotUiEmployee() THEN
        EXPORT JSON FROM fixtureError = TRUE;
    ELSE {
        IF mode == 'owner' THEN enforcementEmployee(pilotUiEnforcementCycleOrder()) <- pilotUiSecondEmployee();
        ELSE IF mode == 'clear-owner' THEN enforcementEmployee(pilotUiEnforcementCycleOrder()) <- NULL;
        ELSE IF mode == 'organization' THEN enforcementOrganization(pilotUiEnforcementCycleOrder()) <- organizationByBin('666666666666');
        ELSE IF mode == 'delete-order' THEN DELETE EnforcementOrder o WHERE o == pilotUiEnforcementCycleOrder();
        ELSE IF mode == 'tax-run' THEN taxCalculationPayrollRun(closingTaxes(pilotUiEnforcementCycleRun())) <- pilotUiPayrollRun();
        ELSE IF mode == 'tax-social' THEN taxCalculationSocialPayments(closingTaxes(pilotUiEnforcementCycleRun())) <- pilotUiSocial();
        ELSE IF mode == 'social-run' THEN socialPaymentPayrollRun(closingSocial(pilotUiEnforcementCycleRun())) <- pilotUiPayrollRun();
        ELSE RETURN;
        APPLY;
        IF canceled() THEN {
            CANCEL;
            EXPORT JSON FROM blocked = TRUE,
                ownerPreserved = enforcementEmployee(pilotUiEnforcementCycleOrder()) == pilotUiEmployee(),
                organizationPreserved = enforcementOrganization(pilotUiEnforcementCycleOrder()) == pilotUiOrganization(),
                taxRunPreserved = taxCalculationPayrollRun(closingTaxes(pilotUiEnforcementCycleRun())) == pilotUiEnforcementCycleRun(),
                taxSocialPreserved = taxCalculationSocialPayments(closingTaxes(pilotUiEnforcementCycleRun())) == closingSocial(pilotUiEnforcementCycleRun()),
                socialRunPreserved = socialPaymentPayrollRun(closingSocial(pilotUiEnforcementCycleRun())) == pilotUiEnforcementCycleRun(),
                firstAmount = approvedEnforcementByEmployee(pilotUiEnforcementCycleRun(), pilotUiEmployee()),
                secondAmount = approvedEnforcementByEmployee(pilotUiEnforcementCycleRun(), pilotUiSecondEmployee());
        } ELSE EXPORT JSON FROM unexpectedWrite = TRUE;
    }
}

pilotUiHistoryOrder() = GROUP LAST EnforcementOrder o IF enforcementOrganization(o) == pilotUiOrganization() AND
    enforcementNumber(o) == 'UI-HISTORY-ORDER-001' ORDER o;
pilotUiHistoryFirst() = GROUP LAST EnforcementCalculationLine l IF enforcementPayrollRun(enforcementCalculationDocument(l)) ==
    pilotUiHistoryRun() ORDER DESC l;
pilotUiHistoryCurrent() = GROUP LAST EnforcementCalculationLine l IF enforcementCalculationDocument(l) ==
    closingEnforcement(pilotUiHistoryRun()) ORDER l;
pilotUiHistorySetupTest() {
    IF login(currentUser() AS CustomUser) != 'ui-chief' OR NOT organizationAllowed(pilotUiOrganization()) THEN RETURN;
    IF pilotUiHistoryRun() THEN EXPORT JSON FROM alreadyExists = TRUE;
    ELSE IF pilotUiHistorySheet() OR pilotUiHistoryOrder() THEN MESSAGE 'Частичный декабрьский набор: автоматического сброса нет';
    ELSE {
        NEW o = EnforcementOrder {
            enforcementOrganization(o) <- pilotUiOrganization();
            enforcementEmployee(o) <- pilotUiEmployee();
            enforcementNumber(o) <- 'UI-HISTORY-ORDER-001';
            enforcementDate(o) <- 2026_11_30;
            enforcementValidFrom(o) <- 2026_12_01;
            enforcementValidTo(o) <- 2026_12_31;
            enforcementKind(o) <- EnforcementOrderKind.other;
            enforcementCalculationKind(o) <- EnforcementCalculationKind.incomeShare;
            enforcementStatus(o) <- EnforcementOrderStatus.active;
            enforcementPriority(o) <- 5;
            enforcementPercent(o) <- 10.000000;
            enforcementBasis(o) <- 'UI: исходные условия 10 процентов';
        }
        NEW t = Timesheet {
            timesheetOrganization(t) <- pilotUiOrganization();
            timesheetNumber(t) <- 'UI-HISTORY-TS-2026-12';
            timesheetPeriodFrom(t) <- 2026_12_01;
            timesheetPeriodTo(t) <- 2026_12_31;
            timesheetStatus(t) <- TimesheetStatus.draft;
        }
        NEW r = PayrollRun {
            payrollOrganization(r) <- pilotUiOrganization();
            payrollNumber(r) <- 'UI-HISTORY-2026-12';
            payrollPeriodFrom(r) <- 2026_12_01;
            payrollPeriodTo(r) <- 2026_12_31;
            payrollPaymentDueDate(r) <- 2027_01_08;
            payrollRunStatus(r) <- PayrollRunStatus.draft;
        }
        APPLY;
        EXPORT JSON FROM created = pilotUiHistoryRun() IS PayrollRun;
    }
}
pilotUiHistorySourcesTest() { preparePilotUiEnforcementSources(pilotUiHistoryRun(), pilotUiHistorySheet()); }
// Меняем только синтетический источник, не сохранённую строку. Снимок должен остаться прежним.
pilotUiHistoryChangeSourceTest() {
    IF login(currentUser() AS CustomUser) != 'ui-chief' OR NOT enforcementConditionsRecorded(pilotUiHistoryFirst()) THEN RETURN;
    enforcementPercent(pilotUiHistoryOrder()) <- 20.000000;
    enforcementPriority(pilotUiHistoryOrder()) <- 4;
    enforcementBasis(pilotUiHistoryOrder()) <- 'UI: изменённые условия 20 процентов';
    APPLY;
}
pilotUiHistoryVerificationTest() {
    EXPORT JSON FROM recorded = enforcementConditionsRecorded(pilotUiHistoryFirst()),
        percent = enforcementSavedPercent(pilotUiHistoryFirst()), priority = enforcementSavedPriority(pilotUiHistoryFirst()),
        basis = enforcementSavedBasis(pilotUiHistoryFirst()), gross = enforcementSavedGrossIncome(pilotUiHistoryFirst()),
        net = enforcementSavedNetIncome(pilotUiHistoryFirst()), amount = enforcementWithheldAmount(pilotUiHistoryFirst()),
        sourcePercent = enforcementPercent(pilotUiHistoryOrder()),
        currentPercent = enforcementSavedPercent(pilotUiHistoryCurrent()), currentPriority = enforcementSavedPriority(pilotUiHistoryCurrent()),
        currentBasis = enforcementSavedBasis(pilotUiHistoryCurrent()), currentAmount = enforcementWithheldAmount(pilotUiHistoryCurrent()),
        firstCancelled = enforcementCalculationStatus(enforcementCalculationDocument(pilotUiHistoryFirst())) == EnforcementCalculationStatus.cancelled,
        count = (GROUP SUM 1 IF enforcementPayrollRun(EnforcementCalculationDocument d) == pilotUiHistoryRun()),
        activeCount = closingEnforcementCount(pilotUiHistoryRun()),
        legacyUnrecorded = NOT enforcementConditionsRecorded(pilotUiEnforcementLine()),
        legacyPercentAbsent = NOT enforcementSavedPercent(pilotUiEnforcementLine()),
        noPayment = NOT closingStatement(pilotUiHistoryRun());
}
pilotUiHistoryGuardTest(STRING[20] mode) {
    IF login(currentUser() AS CustomUser) != 'ui-chief' OR NOT enforcementConditionsRecorded(pilotUiHistoryFirst()) THEN RETURN;
    IF mode == 'percent' THEN enforcementSavedPercent(pilotUiHistoryFirst()) <- 99.000000;
    ELSE IF mode == 'basis' THEN enforcementSavedBasis(pilotUiHistoryFirst()) <- 'Подмена';
    ELSE IF mode == 'flag' THEN enforcementConditionsRecorded(pilotUiHistoryFirst()) <- NULL;
    ELSE IF mode == 'legacy' THEN enforcementConditionsRecorded(pilotUiEnforcementLine()) <- TRUE;
    ELSE RETURN;
    APPLY;
    IF canceled() THEN { CANCEL; EXPORT JSON FROM blocked = TRUE; }
    ELSE EXPORT JSON FROM unexpectedWrite = TRUE;
}

pilotUiDataSetupTest() {
    IF pilotUiPayrollRun() THEN
        EXPORT JSON FROM
            alreadyExists = TRUE,
            employee = employeeFullName(pilotUiEmployee()),
            timesheetStatus = timesheetStatus(pilotUiTimesheet()),
            payrollStatus = payrollRunStatus(pilotUiPayrollRun());
    ELSE IF NOT pilotUiOrganization() THEN
        MESSAGE 'Сначала выполните uiRoleSetupTest';
    ELSE {
        NEW department = Department {
            organization(department) <- pilotUiOrganization();
            code(department) <- 'UI-ACC';
            name(department) <- 'Бухгалтерия';
            NEW position = Position {
                organization(position) <- pilotUiOrganization();
                code(position) <- 'UI-ACCOUNTANT';
                name(position) <- 'Бухгалтер по расчёту зарплаты';
                NEW staff = StaffPosition {
                    organization(staff) <- pilotUiOrganization();
                    department(staff) <- department;
                    position(staff) <- position;
                    staffCode(staff) <- 'UI-ACC-001';
                    validFrom(staff) <- 2026_01_01;
                    plannedFTE(staff) <- 1.0000;
                    salaryMin(staff) <- 250000.00;
                    salaryMax(staff) <- 500000.00;
                    NEW worker = Employee {
                        iin(worker) <- '900101350001';
                        lastName(worker) <- 'Серикова';
                        firstName(worker) <- 'Айгуль';
                        middleName(worker) <- 'Маратовна';
                        birthDate(worker) <- 1990_01_01;
                        gender(worker) <- Gender.female;
                        citizenshipCode(worker) <- 'KAZ';
                        personalDataConsentDate(worker) <- 2026_07_20;
                        personalDataPurpose(worker) <- 'Кадровый учёт и расчёт заработной платы';
                        NEW paymentAccount = EmployeePaymentAccount {
                            paymentAccountOrganization(paymentAccount) <- pilotUiOrganization();
                            paymentAccountEmployee(paymentAccount) <- worker;
                            paymentAccountBankName(paymentAccount) <- 'Тестовый банк';
                            paymentAccountBic(paymentAccount) <- 'TESTKZKX';
                            paymentAccountIban(paymentAccount) <- 'KZ000000000000000001';
                            paymentAccountValidFrom(paymentAccount) <- 2026_01_01;
                        }
                        NEW card = EmployeeCard {
                            cardEmployee(card) <- worker;
                            cardOrganization(card) <- pilotUiOrganization();
                            cardNumber(card) <- 'UI-T2-001';
                            cardDate(card) <- 2026_07_20;
                            personnelNumber(card) <- 'UI-0001';
                            maritalStatus(card) <- MaritalStatus.married;
                            consentDate(card) <- 2026_07_20;
                            consentPurpose(card) <- 'Кадровый учёт и расчёт заработной платы';
                            consentDataScope(card) <- 'Персональные, кадровые и расчётные данные';
                            consentThirdPartyTransfer(card) <- ConsentPermission.allowed;
                            consentCrossBorderTransfer(card) <- ConsentPermission.prohibited;
                            consentPublicDistribution(card) <- ConsentPermission.prohibited;
                            NEW contract = Employment {
                                employee(contract) <- worker;
                                organization(contract) <- pilotUiOrganization();
                                department(contract) <- department;
                                position(contract) <- position;
                                hireDate(contract) <- 2026_08_01;
                                contractNumber(contract) <- 'UI-TD-001';
                                contractDate(contract) <- 2026_07_20;
                                employmentKind(contract) <- EmploymentKind.primary;
                                contractTermKind(contract) <- ContractTermKind.indefinite;
                                workPlace(contract) <- 'г. Алматы';
                                workConditions(contract) <- 'Нормальные условия труда';
                                salary(contract) <- 350000.00;
                                NEW assignment = EmploymentAssignment {
                                    employment(assignment) <- contract;
                                    staffPosition(assignment) <- staff;
                                    assignmentFrom(assignment) <- 2026_08_01;
                                    fte(assignment) <- 1.0000;
                                    assignmentSalary(assignment) <- 350000.00;
                                    NEW hire = PersonnelEvent {
                                        eventKind(hire) <- PersonnelEventKind.hire;
                                        eventEmployment(hire) <- contract;
                                        eventAssignment(hire) <- assignment;
                                        eventStaffPosition(hire) <- staff;
                                        eventFte(hire) <- 1.0000;
                                        eventSalary(hire) <- 350000.00;
                                        effectiveDate(hire) <- 2026_08_01;
                                        orderNumber(hire) <- 'UI-HIRE-001';
                                        orderDate(hire) <- 2026_07_20;
                                        basis(hire) <- 'Трудовой договор UI-TD-001';
                                        eventStatus(hire) <- PersonnelEventStatus.posted;
                                        eventPostedAt(hire) <- currentDateTime();
                                        esutdStatus(hire) <- EsutdStatus.notSubmitted;
                                        NEW timesheet = Timesheet {
                                            timesheetOrganization(timesheet) <- pilotUiOrganization();
                                            timesheetNumber(timesheet) <- 'UI-TS-2026-08';
                                            timesheetPeriodFrom(timesheet) <- 2026_08_01;
                                            timesheetPeriodTo(timesheet) <- 2026_08_31;
                                            timesheetStatus(timesheet) <- TimesheetStatus.draft;
                                            NEW line = TimesheetLine {
                                                lineTimesheet(line) <- timesheet;
                                                lineEmploymentAssignment(line) <- assignment;
                                                lineDate(line) <- 2026_08_03;
                                                attendanceKind(line) <- AttendanceKind.worked;
                                                plannedHoursLine(line) <- 8.00;
                                                workedHours(line) <- 8.00;
                                                lineComment(line) <- 'Строка для ролевого UI-теста';
                                                NEW run = PayrollRun {
                                                    payrollOrganization(run) <- pilotUiOrganization();
                                                    payrollNumber(run) <- 'UI-PAY-2026-08';
                                                    payrollPeriodFrom(run) <- 2026_08_01;
                                                    payrollPeriodTo(run) <- 2026_08_31;
                                                    payrollPaymentDueDate(run) <- 2026_09_10;
                                                    payrollRunStatus(run) <- PayrollRunStatus.draft;
                                                    NEW bonus = PayrollInput {
                                                        inputPayrollRun(bonus) <- run;
                                                        inputAssignment(bonus) <- assignment;
                                                        inputCalculationType(bonus) <- calculationTypeByCode('FIXED_BONUS');
                                                        inputManualAmount(bonus) <- 50000.00;
                                                        inputBasis(bonus) <- 'Премия за август 2026 года';
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        payrollBankName(pilotUiOrganization()) <- 'Тестовый банк';
        payrollBankBic(pilotUiOrganization()) <- 'TESTKZKX';
        payrollIban(pilotUiOrganization()) <- 'KZ000000000000000002';
        APPLY;

        EXPORT JSON FROM
            created = TRUE,
            employee = employeeFullName(pilotUiEmployee()),
            cardReady = employeeCardReady(pilotUiCard()),
            timesheetStatus = timesheetStatus(pilotUiTimesheet()),
            payrollStatus = payrollRunStatus(pilotUiPayrollRun()),
            bonusAmount = inputAmount(pilotUiBonus());
    }
}

// Одноразовый набор для сквозного ролевого UI-маршрута. Деловые переходы
// выполняются в браузере; эти действия только готовят и сверяют fixture.
pilotUiRoleEmployee() = GROUP LAST Employee e IF iin(e) == '940404350004' ORDER e;
pilotUiRoleContract() = GROUP LAST Employment e IF
    organization(e) == pilotUiOrganization() AND contractNumber(e) == 'UI-E2E-TD-2026' ORDER e;
pilotUiRoleHire() = GROUP LAST PersonnelEvent e IF
    eventEmployment(e) == pilotUiRoleContract() AND orderNumber(e) == 'UI-E2E-HIRE-2026' ORDER e;
pilotUiRoleAssignment() = lastAssignment(pilotUiRoleContract());
pilotUiRoleStaff() = GROUP LAST StaffPosition s IF
    organization(s) == pilotUiOrganization() AND staffCode(s) == 'UI-ACC-001' ORDER s;
pilotUiRoleSchedule() = GROUP LAST WorkSchedule s IF
    scheduleOrganization(s) == pilotUiOrganization() AND scheduleCode(s) == 'UI-E2E-5-40' ORDER s;
pilotUiRoleScheduleAssignment() = GROUP LAST EmployeeScheduleAssignment a IF
    scheduleEmploymentAssignment(a) == pilotUiRoleAssignment() ORDER a;
pilotUiRoleTimesheet() = GROUP LAST Timesheet t IF
    timesheetOrganization(t) == pilotUiOrganization() AND
    timesheetNumber(t) == 'UI-E2E-TS-2026-06' ORDER t;
pilotUiRoleRun() = GROUP LAST PayrollRun r IF
    payrollOrganization(r) == pilotUiOrganization() AND
    payrollNumber(r) == 'UI-E2E-PAY-2026-06' ORDER r;

pilotUiRoleJourneySetupTest() {
    IF login(currentUser() AS CustomUser) != 'ui-chief' OR NOT organizationAllowed(pilotUiOrganization()) THEN
        EXPORT JSON FROM denied = TRUE;
    ELSE IF pilotUiRoleContract() THEN
        EXPORT JSON FROM alreadyExists = TRUE,
            eventStatus = caption(eventStatus(pilotUiRoleHire())),
            assignmentCount = assignmentCount(pilotUiRoleContract());
    ELSE IF pilotUiRoleEmployee() OR NOT pilotUiRoleStaff() THEN
        MESSAGE 'Неполный UI-E2E fixture: проверьте сотрудника или штатную единицу';
    ELSE NEW worker = Employee {
        iin(worker) <- '940404350004';
        lastName(worker) <- 'Маршрутова';
        firstName(worker) <- 'Раяна';
        middleName(worker) <- 'Проверочная';
        birthDate(worker) <- 1994_04_04;
        gender(worker) <- Gender.female;
        citizenshipCode(worker) <- 'KAZ';
        personalDataConsentDate(worker) <- 2026_05_25;
        personalDataPurpose(worker) <- 'Синтетический сквозной ролевой UI-тест';
        NEW paymentAccount = EmployeePaymentAccount {
            paymentAccountOrganization(paymentAccount) <- pilotUiOrganization();
            paymentAccountEmployee(paymentAccount) <- worker;
            paymentAccountBankName(paymentAccount) <- 'Тестовый банк';
            paymentAccountBic(paymentAccount) <- 'TESTKZKX';
            paymentAccountIban(paymentAccount) <- 'KZ000000000000000004';
            paymentAccountValidFrom(paymentAccount) <- 2026_01_01;
        }
        NEW contract = Employment {
            employee(contract) <- worker;
            organization(contract) <- pilotUiOrganization();
            contractNumber(contract) <- 'UI-E2E-TD-2026';
            contractDate(contract) <- 2026_05_25;
            employmentKind(contract) <- EmploymentKind.primary;
            contractTermKind(contract) <- ContractTermKind.indefinite;
            workPlace(contract) <- 'г. Алматы';
            workConditions(contract) <- 'Нормальные условия труда';
            salary(contract) <- 300000.00;
            NEW event = PersonnelEvent {
                eventKind(event) <- PersonnelEventKind.hire;
                eventEmployment(event) <- contract;
                eventStaffPosition(event) <- pilotUiRoleStaff();
                eventFte(event) <- 1.0000;
                eventSalary(event) <- 300000.00;
                effectiveDate(event) <- 2026_06_01;
                orderNumber(event) <- 'UI-E2E-HIRE-2026';
                orderDate(event) <- 2026_05_25;
                basis(event) <- 'Трудовой договор UI-E2E-TD-2026';
                eventStatus(event) <- PersonnelEventStatus.draft;
                esutdStatus(event) <- EsutdStatus.notSubmitted;
            }
        }
        APPLY;
        IF canceled() THEN {
            CANCEL;
            EXPORT JSON FROM rejected = TRUE;
        } ELSE EXPORT JSON FROM created = TRUE,
                employee = employeeFullName(pilotUiRoleEmployee()),
                eventStatus = caption(eventStatus(pilotUiRoleHire())),
                assignmentCount = assignmentCount(pilotUiRoleContract());
    }
}

pilotUiRoleJourneyTimeSetupTest() {
    IF login(currentUser() AS CustomUser) != 'ui-chief' OR NOT organizationAllowed(pilotUiOrganization()) THEN
        EXPORT JSON FROM denied = TRUE;
    ELSE IF eventStatus(pilotUiRoleHire()) != PersonnelEventStatus.posted OR NOT pilotUiRoleAssignment() THEN
        MESSAGE 'Сначала кадровик должен провести приём UI-E2E-HIRE-2026';
    ELSE IF pilotUiRoleTimesheet() OR pilotUiRoleRun() OR pilotUiRoleScheduleAssignment() THEN
        EXPORT JSON FROM alreadyExists = TRUE,
            timesheetStatus = caption(timesheetStatus(pilotUiRoleTimesheet())),
            payrollStatus = caption(payrollRunStatus(pilotUiRoleRun()));
    ELSE {
        IF NOT pilotUiRoleSchedule() THEN NEW schedule = WorkSchedule {
            scheduleOrganization(schedule) <- pilotUiOrganization();
            scheduleCode(schedule) <- 'UI-E2E-5-40';
            scheduleName(schedule) <- 'UI E2E — пятидневка 40 часов';
            scheduleType(schedule) <- WorkScheduleType.fiveDay;
            weeklyHours(schedule) <- 40.00;
            accountingPeriodKind(schedule) <- AccountingPeriodKind.month;
            scheduleValidFrom(schedule) <- 2026_01_01;
            APPLY;
        }
        NEW scheduleAssignment = EmployeeScheduleAssignment {
            scheduleEmploymentAssignment(scheduleAssignment) <- pilotUiRoleAssignment();
            employeeWorkSchedule(scheduleAssignment) <- pilotUiRoleSchedule();
            employeeScheduleFrom(scheduleAssignment) <- 2026_06_01;
            cycleStartDate(scheduleAssignment) <- 2026_06_01;
        }
        IF NOT employeeTaxProfileOn(pilotUiOrganization(), pilotUiRoleEmployee(), 2026_06_30) THEN
            NEW profile = EmployeeTaxProfile {
                taxProfileOrganization(profile) <- pilotUiOrganization();
                taxProfileEmployee(profile) <- pilotUiRoleEmployee();
                taxProfileValidFrom(profile) <- 2026_06_01;
                taxProfileResident(profile) <- TRUE;
                taxProfileIncomeStatus(profile) <- TaxIncomeStatus.employee;
                taxProfileBasicDeduction(profile) <- TRUE;
                taxProfileSocialDeduction(profile) <- IpnSocialDeductionKind.none;
                taxProfileBasis(profile) <- 'Синтетический профиль UI-E2E';
            }
        NEW timesheet = Timesheet {
            timesheetOrganization(timesheet) <- pilotUiOrganization();
            timesheetNumber(timesheet) <- 'UI-E2E-TS-2026-06';
            timesheetPeriodFrom(timesheet) <- 2026_06_01;
            timesheetPeriodTo(timesheet) <- 2026_06_30;
            timesheetStatus(timesheet) <- TimesheetStatus.draft;
        }
        NEW run = PayrollRun {
            payrollOrganization(run) <- pilotUiOrganization();
            payrollNumber(run) <- 'UI-E2E-PAY-2026-06';
            payrollPeriodFrom(run) <- 2026_06_01;
            payrollPeriodTo(run) <- 2026_06_30;
            payrollPaymentDueDate(run) <- 2026_07_10;
            payrollRunStatus(run) <- PayrollRunStatus.draft;
        }
        APPLY;
        IF canceled() THEN {
            CANCEL;
            EXPORT JSON FROM rejected = TRUE;
        } ELSE EXPORT JSON FROM created = TRUE,
                timesheetStatus = caption(timesheetStatus(pilotUiRoleTimesheet())),
                payrollStatus = caption(payrollRunStatus(pilotUiRoleRun()));
    }
}

pilotUiRoleJourneyVerificationTest() {
    EXPORT JSON FROM
        employee = employeeFullName(pilotUiRoleEmployee()),
        hirePosted = eventStatus(pilotUiRoleHire()) == PersonnelEventStatus.posted,
        hireDate = hireDate(pilotUiRoleContract()),
        assignmentCount = assignmentCount(pilotUiRoleContract()),
        assignmentSalary = assignmentSalary(pilotUiRoleAssignment()),
        timesheetApproved = timesheetStatus(pilotUiRoleTimesheet()) == TimesheetStatus.approved,
        timesheetApprover = login(approvedBy(pilotUiRoleTimesheet())),
        timesheetLines = timesheetLineCount(pilotUiRoleTimesheet()),
        payrollStatus = caption(payrollRunStatus(pilotUiRoleRun())),
        gross = totalAccrued(pilotUiRoleRun()),
        socialApproved = socialPaymentStatus(closingSocial(pilotUiRoleRun())) == SocialPaymentStatus.approved,
        taxesApproved = taxCalculationStatus(closingTaxes(pilotUiRoleRun())) == TaxCalculationStatus.approved,
        enforcementApproved = enforcementCalculationStatus(closingEnforcement(pilotUiRoleRun())) ==
            EnforcementCalculationStatus.approved,
        statementStatus = caption(paymentStatementStatus(closingStatement(pilotUiRoleRun()))),
        statementAmount = totalPaymentStatementAmount(closingStatement(pilotUiRoleRun())),
        remaining = remainingPayrollAmount(pilotUiRoleRun()),
        nextStep = payrollWorkplaceNextStep(pilotUiRoleRun());
}
