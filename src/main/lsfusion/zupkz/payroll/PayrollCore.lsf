MODULE PayrollCore;

REQUIRE SystemEvents, KZOrganization, KZLegalFramework, HREmployment, TimeTimesheet;
NAMESPACE ZUPKZ;

CLASS PayrollRunStatus 'Статус расчёта зарплаты' {
    draft 'Черновик',
    timeCollected 'Табель собран',
    calculated 'Рассчитан',
    approved 'Утверждён',
    paid 'Выплачен'
}

CLASS CalculationCategory 'Категория расчёта' {
    accrual 'Начисление',
    deduction 'Удержание',
    employerCharge 'Начисление работодателя',
    information 'Информационный показатель'
}

CLASS FormulaKind 'Вид формулы' {
    monthlySalaryByHours 'Оклад по часам',
    hourlyRate 'Часовая ставка',
    fixedAmount 'Фиксированная сумма',
    percentage 'Процент от базы',
    manual 'Ввод вручную'
}

CLASS CalculationType 'Вид начисления / удержания';

calculationCode 'Код' = DATA STRING[50] (CalculationType);
calculationName 'Наименование' = DATA STRING[200] (CalculationType);
calculationCategory 'Категория' = DATA CalculationCategory (CalculationType);
formulaKind 'Формула' = DATA FormulaKind (CalculationType);
coefficientParameter 'Параметр коэффициента' = DATA StatutoryParameter (CalculationType);
calculationDescription 'Описание' = DATA STRING[500] (CalculationType);

CLASS PayrollRule 'Правило расчёта';

ruleCalculationType 'Вид расчёта' = DATA CalculationType (PayrollRule);
ruleValidFrom 'Действует с' = DATA DATE (PayrollRule);
ruleValidTo 'Действует по' = DATA DATE (PayrollRule);
ruleCoefficientParameter 'Коэффициент' = DATA StatutoryParameter (PayrollRule);
rulePriority 'Приоритет' = DATA INTEGER (PayrollRule);
ruleConditionDescription 'Условие применения' = DATA STRING[500] (PayrollRule);

CONSTRAINT ruleValidTo(PayrollRule r) < ruleValidFrom(r)
    MESSAGE 'Дата окончания правила не может быть раньше даты начала';

CLASS PayrollRun 'Расчёт зарплаты';

payrollOrganization 'Организация' = DATA Organization (PayrollRun);
payrollNumber 'Номер' = DATA STRING[50] (PayrollRun);
payrollPeriodFrom 'Период с' = DATA DATE (PayrollRun);
payrollPeriodTo 'Период по' = DATA DATE (PayrollRun);
payrollRunStatus 'Статус' = DATA PayrollRunStatus (PayrollRun);
payrollCalculatedAt 'Рассчитан' = DATA DATETIME (PayrollRun);

CONSTRAINT payrollPeriodTo(PayrollRun r) < payrollPeriodFrom(r)
    MESSAGE 'Окончание расчётного периода не может быть раньше начала';

// Снимок утверждённого табеля. После расчёта он сохраняет исходные показатели,
// даже если следующий табель будет исправлен отдельным документом перерасчёта.
CLASS PayrollTimeSummary 'Данные табеля для расчёта';

summaryPayrollRun 'Расчёт зарплаты' = DATA PayrollRun (PayrollTimeSummary);
summaryAssignment 'Назначение сотрудника' = DATA EmploymentAssignment (PayrollTimeSummary);
summaryPlannedHours 'Плановых часов' = DATA NUMERIC[10,2] (PayrollTimeSummary);
summaryWorkedHours 'Отработано часов' = DATA NUMERIC[10,2] (PayrollTimeSummary);
summaryNightHours 'Ночных часов' = DATA NUMERIC[10,2] (PayrollTimeSummary);
summaryOvertimeHours 'Сверхурочных часов' = DATA NUMERIC[10,2] (PayrollTimeSummary);
summaryHolidayHours 'Праздничных часов' = DATA NUMERIC[10,2] (PayrollTimeSummary);
summaryWeekendHours 'Часов в выходной' = DATA NUMERIC[10,2] (PayrollTimeSummary);
summaryBusinessTripHours 'Часов командировки' = DATA NUMERIC[10,2] (PayrollTimeSummary);
summaryAbsenceHours 'Часов отсутствия' = DATA NUMERIC[10,2] (PayrollTimeSummary);

CLASS PayrollLine 'Строка расчёта зарплаты';

linePayrollRun 'Расчёт зарплаты' = DATA PayrollRun (PayrollLine);
linePayrollAssignment 'Назначение сотрудника' = DATA EmploymentAssignment (PayrollLine);
lineCalculationType 'Вид расчёта' = DATA CalculationType (PayrollLine);
lineTimeSummary 'Данные табеля' = DATA PayrollTimeSummary (PayrollLine);
calculationBase 'Расчётная база' = DATA NUMERIC[18,2] (PayrollLine);
calculationQuantity 'Количество' = DATA NUMERIC[18,6] (PayrollLine);
calculationRate 'Ставка' = DATA NUMERIC[18,6] (PayrollLine);
calculationCoefficient 'Коэффициент' = DATA NUMERIC[18,6] (PayrollLine);
calculationAmount 'Сумма' = DATA NUMERIC[18,2] (PayrollLine);
calculationNote 'Комментарий' = DATA STRING[500] (PayrollLine);

// Оклад покрывает каждый фактически отработанный час по одинарной ставке.
// Доплата за особые часы доводит полную оплату часа до нормативного коэффициента.
payrollHourlyRate(NUMERIC[18,2] monthlySalary, NUMERIC[10,2] plannedHours) =
    ROUND(monthlySalary / plannedHours, 6)
    IF monthlySalary > 0.00 AND plannedHours > 0.00;
salaryForWorkedHours(NUMERIC[18,2] monthlySalary, NUMERIC[10,2] plannedHours,
                     NUMERIC[10,2] workedHours) =
    ROUND(monthlySalary * workedHours / plannedHours, 2)
    IF monthlySalary > 0.00 AND plannedHours > 0.00 AND workedHours >= 0.00;
specialHoursAdditionalPay(NUMERIC[18,2] monthlySalary, NUMERIC[10,2] plannedHours,
                          NUMERIC[10,2] specialHours, NUMERIC[18,6] totalCoefficient) =
    ROUND(payrollHourlyRate(monthlySalary, plannedHours) * specialHours *
          (totalCoefficient - 1.000000), 2)
    IF specialHours > 0.00 AND totalCoefficient >= 1.000000;

effectiveSalary(EmploymentAssignment assignment) =
    IF assignmentSalary(assignment) THEN assignmentSalary(assignment)
    ELSE salary(employment(assignment));
hourlyRate(PayrollTimeSummary summary) =
    payrollHourlyRate(effectiveSalary(summaryAssignment(summary)), summaryPlannedHours(summary));
baseSalaryAmount(PayrollTimeSummary summary) =
    salaryForWorkedHours(effectiveSalary(summaryAssignment(summary)),
                         summaryPlannedHours(summary), summaryWorkedHours(summary));
nightAdditionalAmount(PayrollTimeSummary summary, PayrollRun run) =
    specialHoursAdditionalPay(effectiveSalary(summaryAssignment(summary)),
        summaryPlannedHours(summary), summaryNightHours(summary),
        numericStatutoryValueOn(statutoryParameterByCode('MIN_NIGHT_COEF'), payrollPeriodTo(run)));
overtimeAdditionalAmount(PayrollTimeSummary summary, PayrollRun run) =
    specialHoursAdditionalPay(effectiveSalary(summaryAssignment(summary)),
        summaryPlannedHours(summary), summaryOvertimeHours(summary),
        numericStatutoryValueOn(statutoryParameterByCode('MIN_OVERTIME_COEF'), payrollPeriodTo(run)));
holidayWeekendHours(PayrollTimeSummary summary) =
    (IF summaryHolidayHours(summary) THEN summaryHolidayHours(summary) ELSE 0.00) +
    (IF summaryWeekendHours(summary) THEN summaryWeekendHours(summary) ELSE 0.00);
holidayAdditionalAmount(PayrollTimeSummary summary, PayrollRun run) =
    specialHoursAdditionalPay(effectiveSalary(summaryAssignment(summary)),
        summaryPlannedHours(summary), holidayWeekendHours(summary),
        numericStatutoryValueOn(statutoryParameterByCode('MIN_HOLIDAY_COEF'), payrollPeriodTo(run)));

calculationTypeByCode(STRING[50] code) =
    GROUP AGGR CalculationType t BY calculationCode(t);

ensureCalculationType(STRING[50] code, STRING[200] name, FormulaKind formula,
                      StatutoryParameter coefficient, STRING[500] typeDescription) {
    IF NOT calculationTypeByCode(code) THEN {
        NEW t = CalculationType {
            calculationCode(t) <- code;
            calculationName(t) <- name;
            calculationCategory(t) <- CalculationCategory.accrual;
            formulaKind(t) <- formula;
            coefficientParameter(t) <- coefficient;
            calculationDescription(t) <- typeDescription;
        }
    }
}

loadBaselineCalculationTypes() {
    NEWSESSION {
        ensureCalculationType('BASE_SALARY', 'Оплата по окладу', FormulaKind.monthlySalaryByHours,
            NULL, 'Оклад пропорционально фактически отработанным часам');
        ensureCalculationType('NIGHT_ADDITIONAL', 'Доплата за ночные часы', FormulaKind.hourlyRate,
            statutoryParameterByCode('MIN_NIGHT_COEF'), 'Доплата к одинарной ставке до установленного коэффициента');
        ensureCalculationType('OVERTIME_ADDITIONAL', 'Доплата за сверхурочные часы', FormulaKind.hourlyRate,
            statutoryParameterByCode('MIN_OVERTIME_COEF'), 'Доплата к одинарной ставке до установленного коэффициента');
        ensureCalculationType('HOLIDAY_ADDITIONAL', 'Доплата за праздничные и выходные часы', FormulaKind.hourlyRate,
            statutoryParameterByCode('MIN_HOLIDAY_COEF'), 'Доплата к одинарной ставке до установленного коэффициента');
        APPLY;
    }
}

approvedTimeLineCount(EmploymentAssignment assignment, DATE dateFrom, DATE dateTo) =
    GROUP SUM 1 IF lineEmploymentAssignment(TimesheetLine l) == assignment AND
                   lineDate(l) >= dateFrom AND lineDate(l) <= dateTo AND
                   timesheetStatus(lineTimesheet(l)) == TimesheetStatus.approved;
approvedPlannedHours(EmploymentAssignment assignment, DATE dateFrom, DATE dateTo) =
    GROUP SUM plannedHoursLine(TimesheetLine l)
    IF lineEmploymentAssignment(l) == assignment AND lineDate(l) >= dateFrom AND
       lineDate(l) <= dateTo AND timesheetStatus(lineTimesheet(l)) == TimesheetStatus.approved;
approvedWorkedHours(EmploymentAssignment assignment, DATE dateFrom, DATE dateTo) =
    GROUP SUM workedHours(TimesheetLine l)
    IF lineEmploymentAssignment(l) == assignment AND lineDate(l) >= dateFrom AND
       lineDate(l) <= dateTo AND timesheetStatus(lineTimesheet(l)) == TimesheetStatus.approved;
approvedNightHours(EmploymentAssignment assignment, DATE dateFrom, DATE dateTo) =
    GROUP SUM nightHours(TimesheetLine l)
    IF lineEmploymentAssignment(l) == assignment AND lineDate(l) >= dateFrom AND
       lineDate(l) <= dateTo AND timesheetStatus(lineTimesheet(l)) == TimesheetStatus.approved;
approvedOvertimeHours(EmploymentAssignment assignment, DATE dateFrom, DATE dateTo) =
    GROUP SUM overtimeHours(TimesheetLine l)
    IF lineEmploymentAssignment(l) == assignment AND lineDate(l) >= dateFrom AND
       lineDate(l) <= dateTo AND timesheetStatus(lineTimesheet(l)) == TimesheetStatus.approved;
approvedHolidayHours(EmploymentAssignment assignment, DATE dateFrom, DATE dateTo) =
    GROUP SUM holidayHours(TimesheetLine l)
    IF lineEmploymentAssignment(l) == assignment AND lineDate(l) >= dateFrom AND
       lineDate(l) <= dateTo AND timesheetStatus(lineTimesheet(l)) == TimesheetStatus.approved;
approvedWeekendHours(EmploymentAssignment assignment, DATE dateFrom, DATE dateTo) =
    GROUP SUM weekendHours(TimesheetLine l)
    IF lineEmploymentAssignment(l) == assignment AND lineDate(l) >= dateFrom AND
       lineDate(l) <= dateTo AND timesheetStatus(lineTimesheet(l)) == TimesheetStatus.approved;
approvedBusinessTripHours(EmploymentAssignment assignment, DATE dateFrom, DATE dateTo) =
    GROUP SUM businessTripHours(TimesheetLine l)
    IF lineEmploymentAssignment(l) == assignment AND lineDate(l) >= dateFrom AND
       lineDate(l) <= dateTo AND timesheetStatus(lineTimesheet(l)) == TimesheetStatus.approved;
approvedAbsenceHours(EmploymentAssignment assignment, DATE dateFrom, DATE dateTo) =
    GROUP SUM absenceHours(TimesheetLine l)
    IF lineEmploymentAssignment(l) == assignment AND lineDate(l) >= dateFrom AND
       lineDate(l) <= dateTo AND timesheetStatus(lineTimesheet(l)) == TimesheetStatus.approved;

payrollTimeSummaryByKey(PayrollRun run, EmploymentAssignment assignment) =
    GROUP AGGR PayrollTimeSummary s BY summaryPayrollRun(s), summaryAssignment(s);

collectApprovedTime 'Собрать утверждённый табель' (PayrollRun r) {
    IF payrollRunStatus(r) == PayrollRunStatus.timeCollected OR
       payrollRunStatus(r) == PayrollRunStatus.calculated OR
       payrollRunStatus(r) == PayrollRunStatus.approved OR
       payrollRunStatus(r) == PayrollRunStatus.paid THEN
        MESSAGE 'Табель уже собран. Для исправления создайте новый расчёт или документ перерасчёта';
    ELSE {
        FOR assignment IS EmploymentAssignment AND
            organization(employment(assignment)) == payrollOrganization(r) AND
            approvedTimeLineCount(assignment, payrollPeriodFrom(r), payrollPeriodTo(r))
        DO {
            IF NOT payrollTimeSummaryByKey(r, assignment) THEN {
                NEW s = PayrollTimeSummary {
                    summaryPayrollRun(s) <- r;
                    summaryAssignment(s) <- assignment;
                    summaryPlannedHours(s) <- approvedPlannedHours(assignment, payrollPeriodFrom(r), payrollPeriodTo(r));
                    summaryWorkedHours(s) <- approvedWorkedHours(assignment, payrollPeriodFrom(r), payrollPeriodTo(r));
                    summaryNightHours(s) <- approvedNightHours(assignment, payrollPeriodFrom(r), payrollPeriodTo(r));
                    summaryOvertimeHours(s) <- approvedOvertimeHours(assignment, payrollPeriodFrom(r), payrollPeriodTo(r));
                    summaryHolidayHours(s) <- approvedHolidayHours(assignment, payrollPeriodFrom(r), payrollPeriodTo(r));
                    summaryWeekendHours(s) <- approvedWeekendHours(assignment, payrollPeriodFrom(r), payrollPeriodTo(r));
                    summaryBusinessTripHours(s) <- approvedBusinessTripHours(assignment, payrollPeriodFrom(r), payrollPeriodTo(r));
                    summaryAbsenceHours(s) <- approvedAbsenceHours(assignment, payrollPeriodFrom(r), payrollPeriodTo(r));
                }
            }
        }
        payrollRunStatus(r) <- PayrollRunStatus.timeCollected;
        APPLY;
    }
}

createPayrollLine(PayrollRun run, PayrollTimeSummary summary, CalculationType type,
                  NUMERIC[18,2] base, NUMERIC[18,6] quantity,
                  NUMERIC[18,6] rate, NUMERIC[18,6] coefficient,
                  NUMERIC[18,2] amount, STRING[500] lineNote) {
    NEW l = PayrollLine {
        linePayrollRun(l) <- run;
        linePayrollAssignment(l) <- summaryAssignment(summary);
        lineCalculationType(l) <- type;
        lineTimeSummary(l) <- summary;
        calculationBase(l) <- base;
        calculationQuantity(l) <- quantity;
        calculationRate(l) <- rate;
        calculationCoefficient(l) <- coefficient;
        calculationAmount(l) <- amount;
        calculationNote(l) <- lineNote;
    }
}

invalidPayrollSummaryCount(PayrollRun run) = GROUP SUM 1
    IF summaryPayrollRun(PayrollTimeSummary s) == run AND
       (NOT effectiveSalary(summaryAssignment(s)) OR effectiveSalary(summaryAssignment(s)) <= 0.00 OR
        NOT summaryPlannedHours(s) OR summaryPlannedHours(s) <= 0.00 OR
        NOT summaryWorkedHours(s) OR summaryWorkedHours(s) < 0.00);
payrollSummaryCount(PayrollRun run) = GROUP SUM 1 IF summaryPayrollRun(PayrollTimeSummary s) == run;
hasNightHours(PayrollRun run) = GROUP SUM 1
    IF summaryPayrollRun(PayrollTimeSummary s) == run AND summaryNightHours(s) > 0.00;
hasOvertimeHours(PayrollRun run) = GROUP SUM 1
    IF summaryPayrollRun(PayrollTimeSummary s) == run AND summaryOvertimeHours(s) > 0.00;
hasHolidayHours(PayrollRun run) = GROUP SUM 1
    IF summaryPayrollRun(PayrollTimeSummary s) == run AND holidayWeekendHours(s) > 0.00;
missingPayrollCoefficient(PayrollRun run) =
    (hasNightHours(run) AND NOT numericStatutoryValueOn(
        statutoryParameterByCode('MIN_NIGHT_COEF'), payrollPeriodTo(run))) OR
    (hasOvertimeHours(run) AND NOT numericStatutoryValueOn(
        statutoryParameterByCode('MIN_OVERTIME_COEF'), payrollPeriodTo(run))) OR
    (hasHolidayHours(run) AND NOT numericStatutoryValueOn(
        statutoryParameterByCode('MIN_HOLIDAY_COEF'), payrollPeriodTo(run)));

calculatePayroll 'Рассчитать зарплату' (PayrollRun r) {
    IF payrollRunStatus(r) != PayrollRunStatus.timeCollected THEN
        MESSAGE 'Сначала соберите утверждённый табель';
    ELSE IF NOT payrollSummaryCount(r) THEN
        MESSAGE 'Нет данных утверждённого табеля для расчёта';
    ELSE IF invalidPayrollSummaryCount(r) THEN
        MESSAGE 'Не заполнен оклад, плановые или фактические часы';
    ELSE IF missingPayrollCoefficient(r) THEN
        MESSAGE 'Не задан нормативный коэффициент на дату расчёта';
    ELSE {
        FOR summaryPayrollRun(PayrollTimeSummary s) == r DO {
            createPayrollLine(r, s, calculationTypeByCode('BASE_SALARY'),
                effectiveSalary(summaryAssignment(s)), summaryWorkedHours(s), hourlyRate(s),
                1.000000, baseSalaryAmount(s), 'Оплата фактически отработанных часов');

            IF summaryNightHours(s) > 0.00 THEN
                createPayrollLine(r, s, calculationTypeByCode('NIGHT_ADDITIONAL'),
                    effectiveSalary(summaryAssignment(s)), summaryNightHours(s), hourlyRate(s),
                    numericStatutoryValueOn(statutoryParameterByCode('MIN_NIGHT_COEF'), payrollPeriodTo(r)),
                    nightAdditionalAmount(s, r), 'Доплата за ночные часы');

            IF summaryOvertimeHours(s) > 0.00 THEN
                createPayrollLine(r, s, calculationTypeByCode('OVERTIME_ADDITIONAL'),
                    effectiveSalary(summaryAssignment(s)), summaryOvertimeHours(s), hourlyRate(s),
                    numericStatutoryValueOn(statutoryParameterByCode('MIN_OVERTIME_COEF'), payrollPeriodTo(r)),
                    overtimeAdditionalAmount(s, r), 'Доплата за сверхурочные часы');

            IF holidayWeekendHours(s) > 0.00 THEN
                createPayrollLine(r, s, calculationTypeByCode('HOLIDAY_ADDITIONAL'),
                    effectiveSalary(summaryAssignment(s)), holidayWeekendHours(s),
                    hourlyRate(s),
                    numericStatutoryValueOn(statutoryParameterByCode('MIN_HOLIDAY_COEF'), payrollPeriodTo(r)),
                    holidayAdditionalAmount(s, r), 'Доплата за праздничные и выходные часы');
        }
        payrollRunStatus(r) <- PayrollRunStatus.calculated;
        payrollCalculatedAt(r) <- currentDateTime();
        APPLY;
    }
}

totalAccrued 'Начислено' (PayrollRun run) = GROUP SUM calculationAmount(PayrollLine l)
    IF linePayrollRun(l) == run AND calculationCategory(lineCalculationType(l)) == CalculationCategory.accrual;
totalDeducted 'Удержано' (PayrollRun run) = GROUP SUM calculationAmount(PayrollLine l)
    IF linePayrollRun(l) == run AND calculationCategory(lineCalculationType(l)) == CalculationCategory.deduction;
payrollLineCount(PayrollRun run) = GROUP SUM 1 IF linePayrollRun(PayrollLine l) == run;
totalPayable 'К выплате до налогов' (PayrollRun run) =
    (IF totalAccrued(run) THEN totalAccrued(run) ELSE 0.00) -
    (IF totalDeducted(run) THEN totalDeducted(run) ELSE 0.00);

onStarted() + { loadBaselineCalculationTypes(); }

FORM calculationTypes 'Виды начислений и удержаний'
    OBJECTS c = CalculationType
    PROPERTIES(c) calculationCode, calculationName, calculationCategory,
                  formulaKind, coefficientParameter, calculationDescription
;

FORM payrollRules 'Правила расчёта'
    OBJECTS r = PayrollRule
    PROPERTIES(r) ruleCalculationType, ruleValidFrom, ruleValidTo,
                  ruleCoefficientParameter, rulePriority, ruleConditionDescription
;

FORM payrollRuns 'Расчёты зарплаты'
    OBJECTS r = PayrollRun
    PROPERTIES(r) payrollOrganization, payrollNumber, payrollPeriodFrom,
                  payrollPeriodTo, payrollRunStatus, payrollCalculatedAt,
                  totalAccrued, totalDeducted, totalPayable
    PROPERTIES(r) collectApprovedTime, calculatePayroll
;

FORM payrollTimeSummaries 'Данные табеля для расчёта'
    OBJECTS s = PayrollTimeSummary
    PROPERTIES(s) summaryPayrollRun, summaryAssignment, summaryPlannedHours,
                  summaryWorkedHours, summaryNightHours, summaryOvertimeHours,
                  summaryHolidayHours, summaryWeekendHours,
                  summaryBusinessTripHours, summaryAbsenceHours
;

FORM payrollLines 'Строки расчёта зарплаты'
    OBJECTS l = PayrollLine
    PROPERTIES(l) linePayrollRun, linePayrollAssignment, lineCalculationType,
                  lineTimeSummary, calculationBase, calculationQuantity,
                  calculationRate, calculationCoefficient, calculationAmount,
                  calculationNote
;
