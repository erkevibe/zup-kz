            'https://www.adilet.zan.kz/rus/docs/Z2500000239', 2026_01_01, 2026_08_31);
        ensureLegalSource('AVERAGE_WAGE_RULES_908', 'Единые правила исчисления средней заработной платы',
            'https://www.adilet.zan.kz/rus/docs/V1500012533', 2016_01_01, 2026_09_03);
        ensureLegalSource('SICK_LEAVE_RULES_907', 'Правила назначения и выплаты социального пособия по временной нетрудоспособности',
