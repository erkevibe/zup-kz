paymentAccountSecuritySetupTest() {
    IF NOT accessAssignedDepartment() THEN NEW department = Department {
        organization(department) <- accessAssignedOrganization();
        code(department) <- 'ACCESS-ASSIGNED-DEPT';
        name(department) <- 'Доступное подразделение';
    }
    APPLY;
    IF NOT accessAssignedTimesheet() THEN NEW timesheet = Timesheet {
        timesheetOrganization(timesheet) <- accessAssignedOrganization();
        timesheetNumber(timesheet) <- 'ACCESS-ASSIGNED-TIME';
        timesheetPeriodFrom(timesheet) <- 2026_02_01;
        timesheetPeriodTo(timesheet) <- 2026_02_28;
        timesheetStatus(timesheet) <- TimesheetStatus.draft;
    }
    IF NOT accessAssignedPayrollRun() THEN NEW run = PayrollRun {
        payrollOrganization(run) <- accessAssignedOrganization();
        payrollNumber(run) <- 'ACCESS-ASSIGNED-PAYROLL';
        payrollPeriodFrom(run) <- 2026_02_01;
        payrollPeriodTo(run) <- 2026_02_28;
        payrollRunStatus(run) <- PayrollRunStatus.draft;
    }
    IF NOT accessAssignedArchiveCase() THEN NEW archive = ArchiveCase {
        archiveCaseOrganization(archive) <- accessAssignedOrganization();
        archiveCaseIndex(archive) <- 'ACCESS-ASSIGNED-ARCHIVE';
        archiveCaseYear(archive) <- 2026;
        archiveCaseTitle(archive) <- 'Доступное архивное дело';
        archiveCaseStatus(archive) <- ArchiveCaseStatus.open;
    }
    IF NOT accessAssignedForm200() THEN NEW declaration = Form200Declaration {
        form200Organization(declaration) <- accessAssignedOrganization();
        form200PeriodStart(declaration) <- 2026_04_01;
        form200Kind(declaration) <- Form200Kind.initial;
        form200Version(declaration) <- 'ACCESS-ASSIGNED-FORM-200';
        form200Status(declaration) <- Form200Status.draft;
    }
    APPLY;
    IF NOT roleSecurityEmployee() THEN NEW roleWorker = Employee {
        iin(roleWorker) <- '960606300006';
        lastName(roleWorker) <- 'Ролевой';
        firstName(roleWorker) <- 'Контроль';
        NEW roleContract = Employment {
            employee(roleContract) <- roleWorker;
            organization(roleContract) <- accessAssignedOrganization();
            contractNumber(roleContract) <- 'SECURITY-ROLE-A';
            hireDate(roleContract) <- 2026_01_01;
        }
    }
    APPLY;
    IF NOT paymentSecurityEmployee() THEN NEW worker = Employee {
        iin(worker) <- '950505300005';
        lastName(worker) <- 'Совместитель';
        firstName(worker) <- 'Безопасный';
        NEW contractA = Employment {
            employee(contractA) <- worker;
            organization(contractA) <- accessAssignedOrganization();
            contractNumber(contractA) <- 'SECURITY-ORG-A';
            hireDate(contractA) <- 2026_01_01;
        }
        NEW contractB = Employment {
            employee(contractB) <- worker;
            organization(contractB) <- accessHiddenOrganization();
            contractNumber(contractB) <- 'SECURITY-ORG-B';
            hireDate(contractB) <- 2026_01_01;
        }
        NEW accountAFirst = EmployeePaymentAccount {
            paymentAccountOrganization(accountAFirst) <- accessAssignedOrganization();
            paymentAccountEmployee(accountAFirst) <- worker;
            paymentAccountBankName(accountAFirst) <- 'Банк A старый';
            paymentAccountBic(accountAFirst) <- 'BANKKZKA';
            paymentAccountIban(accountAFirst) <- 'KZ000000000000000011';
            paymentAccountValidFrom(accountAFirst) <- 2026_01_01;
            paymentAccountValidTo(accountAFirst) <- 2026_06_30;
        }
        NEW accountASecond = EmployeePaymentAccount {
            paymentAccountOrganization(accountASecond) <- accessAssignedOrganization();
            paymentAccountEmployee(accountASecond) <- worker;
            paymentAccountBankName(accountASecond) <- 'Банк A новый';
            paymentAccountBic(accountASecond) <- 'BANKKZKA';
            paymentAccountIban(accountASecond) <- 'KZ000000000000000012';
            paymentAccountValidFrom(accountASecond) <- 2026_07_01;
        }
        NEW accountB = EmployeePaymentAccount {
            paymentAccountOrganization(accountB) <- accessHiddenOrganization();
            paymentAccountEmployee(accountB) <- worker;
            paymentAccountBankName(accountB) <- 'Банк B';
            paymentAccountBic(accountB) <- 'BANKKZKB';
            paymentAccountIban(accountB) <- 'KZ000000000000000021';
            paymentAccountValidFrom(accountB) <- 2026_01_01;
        }
    }
    APPLY;
    IF NOT hiddenOnlySecurityEmployee() THEN NEW hiddenWorker = Employee {
        iin(hiddenWorker) <- '970707300007';
        lastName(hiddenWorker) <- 'Скрытый';
        firstName(hiddenWorker) <- 'Сотрудник';
        NEW hiddenContract = Employment {
            employee(hiddenContract) <- hiddenWorker;
            organization(hiddenContract) <- accessHiddenOrganization();
            contractNumber(hiddenContract) <- 'SECURITY-HIDDEN-ONLY';
            hireDate(hiddenContract) <- 2026_01_01;
        }
    }
    APPLY;
    EXPORT JSON FROM
        created = paymentSecurityEmployee() IS Employee,
        organizationAOldSelected = paymentAccountIban(employeePaymentAccountOn(
            accessAssignedOrganization(), paymentSecurityEmployee(), 2026_06_30)) ==
            'KZ000000000000000011',
        organizationANewSelected = paymentAccountIban(employeePaymentAccountOn(
            accessAssignedOrganization(), paymentSecurityEmployee(), 2026_07_01)) ==
            'KZ000000000000000012',
        organizationBSelected = paymentAccountIban(employeePaymentAccountOn(
            accessHiddenOrganization(), paymentSecurityEmployee(), 2026_07_01)) ==
            'KZ000000000000000021',
        noAccountBeforeValidity = employeePaymentAccountCountOn(
            accessAssignedOrganization(), paymentSecurityEmployee(), 2025_12_31) == 0;
}

