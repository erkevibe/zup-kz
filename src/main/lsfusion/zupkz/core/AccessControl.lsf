MODULE KZAccessControl;

REQUIRE Security, KZOrganization, HRDepartment, HRPosition, HRStaffSchedule,
        HREmployment, HREmployeeCard, TimeWorkSchedule, TimeTimesheet, HRLeave,
        HRVacationSchedule, HRBusinessTrip, HRApproval, HRArchive,
        HRAccidentInsurance, HRPrintForms,
        PayrollSickLeave, PayrollInterimPayment, PayrollRecalculation,
        TaxesKZSocialPayments, TaxesKZIncomeTax, PayrollSettlement,
        PayrollPayments, PayrollEnforcement, PayrollCivilContract,
        PayrollCivilContractPayments, TaxesKZSocialTransferRegisters,
        ReportsKZForm20005;
NAMESPACE ZUPKZ;

employeeAllowed(Employee worker) = GROUP MAX organizationAllowed(organization(Employment contract))
    IF employee(contract) == worker;

// Единый серверный предикат для изменений организационных данных. Проверяем
// и новое, и предыдущее владение: это не позволяет "перетащить" чужой объект
// в доступную организацию, изменить его реквизиты или удалить его через API.
organizationChangeDenied(Organization org) = org AND NOT organizationChangeAllowed(org);

organizationContentChanged(Organization org) =
    CHANGED(name(org)) OR CHANGED(shortName(org)) OR CHANGED(bin(org)) OR
    CHANGED(payrollBankName(org)) OR CHANGED(payrollBankBic(org)) OR
    CHANGED(payrollIban(org));
CONSTRAINT organizationContentChanged(Organization org) AND
           NOT organizationChangeAllowed(org)
    MESSAGE 'Нет доступа к изменению этой организации';
CONSTRAINT DROPPED(Organization org IS Organization) AND
           NOT PREV(organizationChangeAllowed(org))
    MESSAGE 'Нет доступа к удалению этой организации';

departmentContentChanged(Department d) =
    CHANGED(organization(d)) OR CHANGED(code(d)) OR CHANGED(name(d));
CONSTRAINT departmentContentChanged(Department d) AND
           (organizationChangeDenied(organization(d)) OR
            organizationChangeDenied(PREV(organization(d))))
    MESSAGE 'Нет доступа к изменению подразделения этой организации';
CONSTRAINT DROPPED(Department d IS Department) AND
           organizationChangeDenied(PREV(organization(d)))
    MESSAGE 'Нет доступа к удалению подразделения этой организации';

positionContentChanged(Position p) =
    CHANGED(organization(p)) OR CHANGED(code(p)) OR CHANGED(name(p));
CONSTRAINT positionContentChanged(Position p) AND
           (organizationChangeDenied(organization(p)) OR
            organizationChangeDenied(PREV(organization(p))))
    MESSAGE 'Нет доступа к изменению должности этой организации';
CONSTRAINT DROPPED(Position p IS Position) AND
           organizationChangeDenied(PREV(organization(p)))
    MESSAGE 'Нет доступа к удалению должности этой организации';

staffPositionContentChanged(StaffPosition s) =
    CHANGED(organization(s)) OR CHANGED(department(s)) OR CHANGED(position(s)) OR
    CHANGED(staffCode(s)) OR CHANGED(validFrom(s)) OR CHANGED(validTo(s)) OR
    CHANGED(plannedFTE(s)) OR CHANGED(salaryMin(s)) OR CHANGED(salaryMax(s));
CONSTRAINT staffPositionContentChanged(StaffPosition s) AND
           (organizationChangeDenied(organization(s)) OR
            organizationChangeDenied(PREV(organization(s))))
    MESSAGE 'Нет доступа к изменению штатной единицы этой организации';
CONSTRAINT DROPPED(StaffPosition s IS StaffPosition) AND
           organizationChangeDenied(PREV(organization(s)))
    MESSAGE 'Нет доступа к удалению штатной единицы этой организации';

employmentContentChanged(Employment e) =
    CHANGED(employee(e)) OR CHANGED(organization(e)) OR CHANGED(department(e)) OR
    CHANGED(position(e)) OR CHANGED(hireDate(e)) OR CHANGED(contractNumber(e)) OR
    CHANGED(contractDate(e)) OR CHANGED(employmentKind(e)) OR
    CHANGED(contractTermKind(e)) OR CHANGED(contractEndDate(e)) OR
    CHANGED(workPlace(e)) OR CHANGED(workConditions(e)) OR CHANGED(salary(e));
CONSTRAINT employmentContentChanged(Employment e) AND
           (organizationChangeDenied(organization(e)) OR
            organizationChangeDenied(PREV(organization(e))))
    MESSAGE 'Нет доступа к изменению трудового договора этой организации';
CONSTRAINT DROPPED(Employment e IS Employment) AND
           organizationChangeDenied(PREV(organization(e)))
    MESSAGE 'Нет доступа к удалению трудового договора этой организации';

assignmentContentChanged(EmploymentAssignment a) =
    CHANGED(employment(a)) OR CHANGED(staffPosition(a)) OR CHANGED(assignmentFrom(a)) OR
    CHANGED(assignmentTo(a)) OR CHANGED(fte(a)) OR CHANGED(assignmentSalary(a));
CONSTRAINT assignmentContentChanged(EmploymentAssignment a) AND
           (organizationChangeDenied(organization(employment(a))) OR
            organizationChangeDenied(PREV(organization(employment(a)))))
    MESSAGE 'Нет доступа к изменению назначения этой организации';
CONSTRAINT DROPPED(EmploymentAssignment a IS EmploymentAssignment) AND
           organizationChangeDenied(PREV(organization(employment(a))))
    MESSAGE 'Нет доступа к удалению назначения этой организации';

personnelEventContentChanged(PersonnelEvent e) =
    CHANGED(eventKind(e)) OR CHANGED(eventEmployment(e)) OR CHANGED(eventAssignment(e)) OR
    CHANGED(eventStaffPosition(e)) OR CHANGED(eventFte(e)) OR CHANGED(eventSalary(e)) OR
    CHANGED(effectiveDate(e)) OR CHANGED(orderNumber(e)) OR CHANGED(orderDate(e)) OR
    CHANGED(basis(e)) OR CHANGED(esutdStatus(e)) OR CHANGED(esutdSubmittedAt(e)) OR
    CHANGED(esutdRespondedAt(e)) OR CHANGED(esutdExternalId(e)) OR
    CHANGED(esutdRejectionReason(e)) OR CHANGED(eventStatus(e)) OR
    CHANGED(eventPostedAt(e)) OR CHANGED(eventCancelledAt(e)) OR
    CHANGED(eventPreviousAssignment(e)) OR CHANGED(eventPreviousAssignmentTo(e)) OR
    CHANGED(eventPreviousHireDate(e)) OR CHANGED(eventPreviousContractEndDate(e));
CONSTRAINT personnelEventContentChanged(PersonnelEvent e) AND
           (organizationChangeDenied(organization(eventEmployment(e))) OR
            organizationChangeDenied(PREV(organization(eventEmployment(e)))))
    MESSAGE 'Нет доступа к изменению кадрового события этой организации';
CONSTRAINT DROPPED(PersonnelEvent e IS PersonnelEvent) AND
           organizationChangeDenied(PREV(organization(eventEmployment(e))))
    MESSAGE 'Нет доступа к удалению кадрового события этой организации';

employeeCardContentChanged(EmployeeCard c) =
    CHANGED(cardEmployee(c)) OR CHANGED(cardOrganization(c)) OR CHANGED(cardNumber(c)) OR
    CHANGED(cardDate(c)) OR CHANGED(personnelNumber(c)) OR CHANGED(birthPlace(c)) OR
    CHANGED(nationality(c)) OR CHANGED(maritalStatus(c)) OR CHANGED(phone(c)) OR
    CHANGED(email(c)) OR CHANGED(registeredAddress(c)) OR CHANGED(residentialAddress(c)) OR
    CHANGED(consentDate(c)) OR CHANGED(consentValidUntil(c)) OR CHANGED(consentPurpose(c)) OR
    CHANGED(consentDataScope(c)) OR CHANGED(consentThirdPartyTransfer(c)) OR
    CHANGED(consentCrossBorderTransfer(c)) OR CHANGED(consentPublicDistribution(c)) OR
    CHANGED(consentWithdrawnAt(c));
CONSTRAINT employeeCardContentChanged(EmployeeCard c) AND
           (organizationChangeDenied(cardOrganization(c)) OR
            organizationChangeDenied(PREV(cardOrganization(c))))
    MESSAGE 'Нет доступа к изменению личной карточки этой организации';
CONSTRAINT DROPPED(EmployeeCard c IS EmployeeCard) AND
           organizationChangeDenied(PREV(cardOrganization(c)))
    MESSAGE 'Нет доступа к удалению личной карточки этой организации';

identityDocumentContentChanged(EmployeeIdentityDocument d) =
    CHANGED(identityCard(d)) OR CHANGED(identityType(d)) OR CHANGED(identityNumber(d)) OR
    CHANGED(identityIssuedDate(d)) OR CHANGED(identityValidUntil(d)) OR CHANGED(identityIssuer(d));
CONSTRAINT identityDocumentContentChanged(EmployeeIdentityDocument d) AND
           (organizationChangeDenied(cardOrganization(identityCard(d))) OR
            organizationChangeDenied(PREV(cardOrganization(identityCard(d)))))
    MESSAGE 'Нет доступа к изменению удостоверяющего документа этой организации';
CONSTRAINT DROPPED(EmployeeIdentityDocument d IS EmployeeIdentityDocument) AND
           organizationChangeDenied(PREV(cardOrganization(identityCard(d))))
    MESSAGE 'Нет доступа к удалению удостоверяющего документа этой организации';

educationContentChanged(EmployeeEducation e) =
    CHANGED(educationCard(e)) OR CHANGED(educationLevel(e)) OR
    CHANGED(educationInstitution(e)) OR CHANGED(educationGraduationYear(e)) OR
    CHANGED(educationDiplomaNumber(e)) OR CHANGED(educationSpeciality(e)) OR
    CHANGED(educationQualification(e));
CONSTRAINT educationContentChanged(EmployeeEducation e) AND
           (organizationChangeDenied(cardOrganization(educationCard(e))) OR
            organizationChangeDenied(PREV(cardOrganization(educationCard(e)))))
    MESSAGE 'Нет доступа к изменению сведений об образовании этой организации';
CONSTRAINT DROPPED(EmployeeEducation e IS EmployeeEducation) AND
           organizationChangeDenied(PREV(cardOrganization(educationCard(e))))
    MESSAGE 'Нет доступа к удалению сведений об образовании этой организации';

familyMemberContentChanged(EmployeeFamilyMember m) =
    CHANGED(familyCard(m)) OR CHANGED(familyRelation(m)) OR CHANGED(familyLastName(m)) OR
    CHANGED(familyFirstName(m)) OR CHANGED(familyMiddleName(m)) OR
    CHANGED(familyBirthDate(m)) OR CHANGED(familyIin(m));
CONSTRAINT familyMemberContentChanged(EmployeeFamilyMember m) AND
           (organizationChangeDenied(cardOrganization(familyCard(m))) OR
            organizationChangeDenied(PREV(cardOrganization(familyCard(m)))))
    MESSAGE 'Нет доступа к изменению сведений о семье этой организации';
CONSTRAINT DROPPED(EmployeeFamilyMember m IS EmployeeFamilyMember) AND
           organizationChangeDenied(PREV(cardOrganization(familyCard(m))))
    MESSAGE 'Нет доступа к удалению сведений о семье этой организации';

militaryRecordContentChanged(EmployeeMilitaryRecord r) =
    CHANGED(militaryCard(r)) OR CHANGED(militaryStatus(r)) OR CHANGED(militaryCategory(r)) OR
    CHANGED(militaryRank(r)) OR CHANGED(militaryProfile(r)) OR
    CHANGED(militarySpeciality(r)) OR CHANGED(militaryFitness(r)) OR
    CHANGED(militaryAuthority(r)) OR CHANGED(militaryDocument(r)) OR
    CHANGED(militarySpecialRegister(r));
CONSTRAINT militaryRecordContentChanged(EmployeeMilitaryRecord r) AND
           (organizationChangeDenied(cardOrganization(militaryCard(r))) OR
            organizationChangeDenied(PREV(cardOrganization(militaryCard(r)))))
    MESSAGE 'Нет доступа к изменению воинского учёта этой организации';
CONSTRAINT DROPPED(EmployeeMilitaryRecord r IS EmployeeMilitaryRecord) AND
           organizationChangeDenied(PREV(cardOrganization(militaryCard(r))))
    MESSAGE 'Нет доступа к удалению воинского учёта этой организации';

previousEmploymentContentChanged(EmployeePreviousEmployment h) =
    CHANGED(previousEmploymentCard(h)) OR CHANGED(previousEmployer(h)) OR
    CHANGED(previousPosition(h)) OR CHANGED(previousDateFrom(h)) OR
    CHANGED(previousDateTo(h)) OR CHANGED(previousEmploymentBasis(h));
CONSTRAINT previousEmploymentContentChanged(EmployeePreviousEmployment h) AND
           (organizationChangeDenied(cardOrganization(previousEmploymentCard(h))) OR
            organizationChangeDenied(PREV(cardOrganization(previousEmploymentCard(h)))))
    MESSAGE 'Нет доступа к изменению трудовой истории этой организации';
CONSTRAINT DROPPED(EmployeePreviousEmployment h IS EmployeePreviousEmployment) AND
           organizationChangeDenied(PREV(cardOrganization(previousEmploymentCard(h))))
    MESSAGE 'Нет доступа к удалению трудовой истории этой организации';

workScheduleContentChanged(WorkSchedule s) =
    CHANGED(scheduleOrganization(s)) OR CHANGED(scheduleCode(s)) OR CHANGED(scheduleName(s)) OR
    CHANGED(scheduleType(s)) OR CHANGED(weeklyHours(s)) OR CHANGED(accountingPeriodKind(s)) OR
    CHANGED(scheduleValidFrom(s)) OR CHANGED(scheduleValidTo(s));
CONSTRAINT workScheduleContentChanged(WorkSchedule s) AND
           (organizationChangeDenied(scheduleOrganization(s)) OR
            organizationChangeDenied(PREV(scheduleOrganization(s))))
    MESSAGE 'Нет доступа к изменению графика работы этой организации';
CONSTRAINT DROPPED(WorkSchedule s IS WorkSchedule) AND
           organizationChangeDenied(PREV(scheduleOrganization(s)))
    MESSAGE 'Нет доступа к удалению графика работы этой организации';

shiftTemplateContentChanged(ShiftTemplate s) =
    CHANGED(shiftSchedule(s)) OR CHANGED(shiftCode(s)) OR CHANGED(shiftName(s)) OR
    CHANGED(shiftStartTime(s)) OR CHANGED(shiftEndTime(s)) OR CHANGED(breakMinutes(s)) OR
    CHANGED(plannedHours(s)) OR CHANGED(plannedNightHours(s));
CONSTRAINT shiftTemplateContentChanged(ShiftTemplate s) AND
           (organizationChangeDenied(scheduleOrganization(shiftSchedule(s))) OR
            organizationChangeDenied(PREV(scheduleOrganization(shiftSchedule(s)))))
    MESSAGE 'Нет доступа к изменению смены этой организации';
CONSTRAINT DROPPED(ShiftTemplate s IS ShiftTemplate) AND
           organizationChangeDenied(PREV(scheduleOrganization(shiftSchedule(s))))
    MESSAGE 'Нет доступа к удалению смены этой организации';

scheduleCycleDayContentChanged(ScheduleCycleDay d) =
    CHANGED(cycleSchedule(d)) OR CHANGED(cycleDayNumber(d)) OR
    CHANGED(cycleShift(d)) OR CHANGED(cycleDayOff(d));
CONSTRAINT scheduleCycleDayContentChanged(ScheduleCycleDay d) AND
           (organizationChangeDenied(scheduleOrganization(cycleSchedule(d))) OR
            organizationChangeDenied(PREV(scheduleOrganization(cycleSchedule(d)))))
    MESSAGE 'Нет доступа к изменению цикла графика этой организации';
CONSTRAINT DROPPED(ScheduleCycleDay d IS ScheduleCycleDay) AND
           organizationChangeDenied(PREV(scheduleOrganization(cycleSchedule(d))))
    MESSAGE 'Нет доступа к удалению цикла графика этой организации';

employeeScheduleContentChanged(EmployeeScheduleAssignment a) =
    CHANGED(scheduleEmploymentAssignment(a)) OR CHANGED(employeeWorkSchedule(a)) OR
    CHANGED(employeeScheduleFrom(a)) OR CHANGED(employeeScheduleTo(a)) OR
    CHANGED(cycleStartDate(a));
CONSTRAINT employeeScheduleContentChanged(EmployeeScheduleAssignment a) AND
           (organizationChangeDenied(organization(employment(scheduleEmploymentAssignment(a)))) OR
            organizationChangeDenied(PREV(organization(employment(scheduleEmploymentAssignment(a))))))
    MESSAGE 'Нет доступа к изменению графика сотрудника этой организации';
CONSTRAINT DROPPED(EmployeeScheduleAssignment a IS EmployeeScheduleAssignment) AND
           organizationChangeDenied(PREV(organization(employment(scheduleEmploymentAssignment(a)))))
    MESSAGE 'Нет доступа к удалению графика сотрудника этой организации';

timesheetContentChanged(Timesheet t) =
    CHANGED(timesheetOrganization(t)) OR CHANGED(timesheetNumber(t)) OR
    CHANGED(timesheetPeriodFrom(t)) OR CHANGED(timesheetPeriodTo(t)) OR
    CHANGED(timesheetStatus(t)) OR CHANGED(approvedAt(t)) OR CHANGED(approvedBy(t)) OR
    CHANGED(cancelledAt(t)) OR CHANGED(cancelledBy(t));
CONSTRAINT timesheetContentChanged(Timesheet t) AND
           (organizationChangeDenied(timesheetOrganization(t)) OR
            organizationChangeDenied(PREV(timesheetOrganization(t))))
    MESSAGE 'Нет доступа к изменению табеля этой организации';
CONSTRAINT DROPPED(Timesheet t IS Timesheet) AND
           organizationChangeDenied(PREV(timesheetOrganization(t)))
    MESSAGE 'Нет доступа к удалению табеля этой организации';

timesheetLineContentChanged(TimesheetLine l) =
    CHANGED(lineTimesheet(l)) OR CHANGED(lineEmploymentAssignment(l)) OR CHANGED(lineDate(l)) OR
    CHANGED(attendanceKind(l)) OR CHANGED(actualStartTime(l)) OR CHANGED(actualEndTime(l)) OR
    CHANGED(plannedHoursLine(l)) OR CHANGED(workedHours(l)) OR CHANGED(nightHours(l)) OR
    CHANGED(overtimeHours(l)) OR CHANGED(holidayHours(l)) OR CHANGED(weekendHours(l)) OR
    CHANGED(businessTripHours(l)) OR CHANGED(absenceHours(l)) OR
    CHANGED(overtimeConsentDocument(l)) OR CHANGED(employerAct(l)) OR
    CHANGED(lineComment(l)) OR CHANGED(generatedLine(l)) OR
    CHANGED(lineBusinessTrip(l)) OR CHANGED(businessTripCreatedLine(l));
CONSTRAINT timesheetLineContentChanged(TimesheetLine l) AND
           (organizationChangeDenied(timesheetOrganization(lineTimesheet(l))) OR
            organizationChangeDenied(PREV(timesheetOrganization(lineTimesheet(l)))))
    MESSAGE 'Нет доступа к изменению строки табеля этой организации';
CONSTRAINT DROPPED(TimesheetLine l IS TimesheetLine) AND
           organizationChangeDenied(PREV(timesheetOrganization(lineTimesheet(l))))
    MESSAGE 'Нет доступа к удалению строки табеля этой организации';

payrollRunContentChanged(PayrollRun r) =
    CHANGED(payrollOrganization(r)) OR CHANGED(payrollNumber(r)) OR
    CHANGED(payrollPeriodFrom(r)) OR CHANGED(payrollPeriodTo(r)) OR
    CHANGED(payrollRunStatus(r)) OR CHANGED(payrollCalculatedAt(r)) OR
    CHANGED(payrollPaymentDueDate(r)) OR CHANGED(payrollReopenReason(r)) OR
    CHANGED(payrollResetReason(r));
CONSTRAINT payrollRunContentChanged(PayrollRun r) AND
           (organizationChangeDenied(payrollOrganization(r)) OR
            organizationChangeDenied(PREV(payrollOrganization(r))))
    MESSAGE 'Нет доступа к изменению расчёта зарплаты этой организации';
CONSTRAINT DROPPED(PayrollRun r IS PayrollRun) AND
           organizationChangeDenied(PREV(payrollOrganization(r)))
    MESSAGE 'Нет доступа к удалению расчёта зарплаты этой организации';

payrollInputContentChanged(PayrollInput i) =
    CHANGED(inputPayrollRun(i)) OR CHANGED(inputAssignment(i)) OR
    CHANGED(inputCalculationType(i)) OR CHANGED(inputBase(i)) OR CHANGED(inputPercent(i)) OR
    CHANGED(inputManualAmount(i)) OR CHANGED(inputBasis(i));
CONSTRAINT payrollInputContentChanged(PayrollInput i) AND
           (organizationChangeDenied(payrollOrganization(inputPayrollRun(i))) OR
            organizationChangeDenied(PREV(payrollOrganization(inputPayrollRun(i)))))
    MESSAGE 'Нет доступа к изменению начисления этой организации';
CONSTRAINT DROPPED(PayrollInput i IS PayrollInput) AND
           organizationChangeDenied(PREV(payrollOrganization(inputPayrollRun(i))))
    MESSAGE 'Нет доступа к удалению начисления этой организации';

// UI-фильтры не являются границей безопасности. Эти constraints запрещают
// любой workflow-переход чужой организации, включая Action API и прямой APPLY.
CONSTRAINT CHANGED(archiveCaseStatus(ArchiveCase c)) AND
           NOT organizationActionAllowed(archiveCaseOrganization(c))
    MESSAGE 'Нет доступа к архивному делу этой организации';
CONSTRAINT CHANGED(archiveDocumentStatus(ArchiveDocument d)) AND
           NOT organizationActionAllowed(archiveCaseOrganization(archiveDocumentCase(d)))
    MESSAGE 'Нет доступа к архивному документу этой организации';
CONSTRAINT CHANGED(form200Status(Form200Declaration d)) AND
           NOT organizationActionAllowed(form200Organization(d))
    MESSAGE 'Нет доступа к форме 200.00 этой организации';
CONSTRAINT CHANGED(personnelNoticeStatus(PersonnelNotice n)) AND
           NOT organizationActionAllowed(personnelNoticeOrganization(n))
    MESSAGE 'Нет доступа к уведомлению этой организации';
CONSTRAINT CHANGED(approvalStatus(ApprovalRequest r)) AND
           NOT organizationActionAllowed(approvalOrganization(r))
    MESSAGE 'Нет доступа к согласованию этой организации';
CONSTRAINT CHANGED(approvalStepStatus(ApprovalStep s)) AND
           NOT organizationActionAllowed(approvalOrganization(approvalStepRequest(s)))
    MESSAGE 'Нет доступа к этапу согласования этой организации';
CONSTRAINT CHANGED(vacationScheduleStatus(VacationSchedule s)) AND
           NOT organizationActionAllowed(vacationScheduleOrganization(s))
    MESSAGE 'Нет доступа к графику отпусков этой организации';
CONSTRAINT CHANGED(averageStatus(AverageEarningsDocument d)) AND
           NOT organizationActionAllowed(organization(employment(averageAssignment(d))))
    MESSAGE 'Нет доступа к среднему заработку этой организации';
CONSTRAINT CHANGED(recalculationStatus(PayrollRecalculation d)) AND
           NOT organizationActionAllowed(payrollOrganization(recalculationTargetRun(d)))
    MESSAGE 'Нет доступа к перерасчёту этой организации';
CONSTRAINT CHANGED(tripStatus(BusinessTripDocument d)) AND
           NOT organizationActionAllowed(tripOrganization(d))
    MESSAGE 'Нет доступа к командировке этой организации';
CONSTRAINT CHANGED(enforcementStatus(EnforcementOrder o)) AND
           NOT organizationActionAllowed(enforcementOrganization(o))
    MESSAGE 'Нет доступа к исполнительному документу этой организации';
CONSTRAINT CHANGED(enforcementCalculationStatus(EnforcementCalculationDocument d)) AND
           NOT organizationActionAllowed(payrollOrganization(
               taxCalculationPayrollRun(enforcementTaxCalculation(d))))
    MESSAGE 'Нет доступа к расчёту взысканий этой организации';
CONSTRAINT CHANGED(civilContractStatus(CivilContract c)) AND
           NOT organizationActionAllowed(civilContractOrganization(c))
    MESSAGE 'Нет доступа к договору ГПХ этой организации';
CONSTRAINT CHANGED(civilActStatus(CivilContractAct a)) AND
           NOT organizationActionAllowed(civilContractOrganization(civilActContract(a)))
    MESSAGE 'Нет доступа к акту ГПХ этой организации';
CONSTRAINT CHANGED(civilLiabilityStatus(CivilLiabilityDocument d)) AND
           NOT organizationActionAllowed(civilContractOrganization(
               civilActContract(civilLiabilityAct(d))))
    MESSAGE 'Нет доступа к платежам ГПХ этой организации';
CONSTRAINT CHANGED(interimPaymentStatus(InterimPayment p)) AND
           NOT organizationActionAllowed(organization(employment(interimPaymentAssignment(p))))
    MESSAGE 'Нет доступа к межрасчётной выплате этой организации';
CONSTRAINT CHANGED(sickLeaveStatus(SickLeaveDocument d)) AND
           NOT organizationActionAllowed(organization(employment(sickLeaveAssignment(d))))
    MESSAGE 'Нет доступа к больничному этой организации';
CONSTRAINT CHANGED(payrollRunStatus(PayrollRun r)) AND
           NOT organizationActionAllowed(payrollOrganization(r))
    MESSAGE 'Нет доступа к расчёту зарплаты этой организации';
CONSTRAINT CHANGED(taxCalculationStatus(TaxCalculationDocument d)) AND
           NOT organizationActionAllowed(payrollOrganization(taxCalculationPayrollRun(d)))
    MESSAGE 'Нет доступа к расчёту налогов этой организации';
CONSTRAINT CHANGED(leaveStatus(LeaveDocument l)) AND
           NOT organizationActionAllowed(organization(employment(leaveAssignment(l))))
    MESSAGE 'Нет доступа к отпуску этой организации';
CONSTRAINT CHANGED(paymentStatementStatus(PaymentStatement d)) AND
           NOT organizationActionAllowed(payrollOrganization(paymentStatementPayrollRun(d)))
    MESSAGE 'Нет доступа к платёжной ведомости этой организации';
CONSTRAINT CHANGED(bankRegisterStatus(SalaryBankRegister r)) AND
           NOT organizationActionAllowed(bankRegisterOrganization(r))
    MESSAGE 'Нет доступа к банковскому реестру этой организации';
CONSTRAINT CHANGED(liabilityStatus(PayrollLiabilityDocument d)) AND
           NOT organizationActionAllowed(payrollOrganization(liabilityPayrollRun(d)))
    MESSAGE 'Нет доступа к обязательным платежам этой организации';
CONSTRAINT CHANGED(socialPaymentStatus(SocialPaymentDocument d)) AND
           NOT organizationActionAllowed(payrollOrganization(socialPaymentPayrollRun(d)))
    MESSAGE 'Нет доступа к социальным платежам этой организации';
CONSTRAINT CHANGED(socialTransferStatus(SocialTransferRegister r)) AND
           NOT organizationActionAllowed(socialTransferOrganization(r))
    MESSAGE 'Нет доступа к реестру социальных платежей этой организации';
CONSTRAINT CHANGED(eventStatus(PersonnelEvent e)) AND
           NOT organizationActionAllowed(organization(eventEmployment(e)))
    MESSAGE 'Нет доступа к кадровому событию этой организации';
CONSTRAINT CHANGED(esutdStatus(PersonnelEvent e)) AND
           NOT organizationActionAllowed(organization(eventEmployment(e)))
    MESSAGE 'Нет доступа к ЕСУТД этой организации';
CONSTRAINT CHANGED(insurancePolicyStatus(AccidentInsurancePolicy p)) AND
           NOT organizationActionAllowed(insurancePolicyOrganization(p))
    MESSAGE 'Нет доступа к страховому договору этой организации';
CONSTRAINT CHANGED(workAccidentStatus(WorkAccident a)) AND
           NOT organizationActionAllowed(workAccidentOrganization(a))
    MESSAGE 'Нет доступа к несчастному случаю этой организации';
CONSTRAINT CHANGED(insuranceClaimStatus(AccidentInsuranceClaim c)) AND
           NOT organizationActionAllowed(workAccidentOrganization(insuranceClaimAccident(c)))
    MESSAGE 'Нет доступа к страховому требованию этой организации';
CONSTRAINT CHANGED(timesheetStatus(Timesheet t)) AND
           NOT organizationActionAllowed(timesheetOrganization(t))
    MESSAGE 'Нет доступа к табелю этой организации';

accessUserLogin 'Логин пользователя' (UserOrganizationAccess access) =
    login(accessUser(access) AS CustomUser);
accessOrganizationName 'Название организации' (UserOrganizationAccess access) =
    name(accessOrganization(access));

FORM userOrganizationAccesses 'Доступ к организациям'
    OBJECTS a = UserOrganizationAccess
    PROPERTIES(a) accessUser, accessOrganization, accessActive
    PROPERTIES(a) READONLY accessUserLogin, accessOrganizationName
;

denyBusinessFolders(UserRole role) {
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.masterData')) <- Permission.forbid;
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.legislation')) <- Permission.forbid;
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.personnel')) <- Permission.forbid;
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.workingTime')) <- Permission.forbid;
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.payroll')) <- Permission.forbid;
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.taxesKz')) <- Permission.forbid;
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.reportsKz')) <- Permission.forbid;
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.accessAdministration')) <- Permission.forbid;
    // QA-формы и системное администрирование не входят ни в одну бизнес-роль.
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.uiTestInternalForms')) <- Permission.forbid;
    dataPermission(role, navigatorElementCanonicalName('System.administration')) <- Permission.forbid;
    dataPermission(role, navigatorElementCanonicalName('SystemEvents.showDesign')) <- Permission.forbid;
}

permitBusinessFolders(UserRole role) {
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.masterData')) <- Permission.permit;
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.legislation')) <- Permission.permit;
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.personnel')) <- Permission.permit;
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.workingTime')) <- Permission.permit;
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.payroll')) <- Permission.permit;
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.taxesKz')) <- Permission.permit;
    dataPermission(role, navigatorElementCanonicalName('ZUPKZ.reportsKz')) <- Permission.permit;
}

ensureZupRoles() {
    IF NOT userRoleSID('zup_hr') THEN NEW role = UserRole {
        sid(role) <- 'zup_hr';
        name(role) <- 'ZUP KZ — HR';
    }
    IF NOT userRoleSID('zup_timekeeper') THEN NEW role = UserRole {
        sid(role) <- 'zup_timekeeper';
        name(role) <- 'ZUP KZ — Timekeeper';
    }
    IF NOT userRoleSID('zup_payroll') THEN NEW role = UserRole {
        sid(role) <- 'zup_payroll';
        name(role) <- 'ZUP KZ — Payroll';
    }
    IF NOT userRoleSID('zup_chief_accountant') THEN NEW role = UserRole {
        sid(role) <- 'zup_chief_accountant';
        name(role) <- 'ZUP KZ — Chief accountant';
    }
    IF NOT userRoleSID('zup_auditor') THEN NEW role = UserRole {
        sid(role) <- 'zup_auditor';
        name(role) <- 'ZUP KZ — Auditor';
    }

}

applyZupRolePermissions() {
    // Пользователей ЗУП создаёт администратор; публичная регистрация запрещена.
    disableRole(userRoleSID('selfRegister')) <- TRUE;

    denyBusinessFolders(userRoleSID('zup_hr'));
    denyBusinessFolders(userRoleSID('zup_timekeeper'));
    denyBusinessFolders(userRoleSID('zup_payroll'));
    denyBusinessFolders(userRoleSID('zup_chief_accountant'));
    denyBusinessFolders(userRoleSID('zup_auditor'));

    dataPermission(userRoleSID('zup_hr'),
        navigatorElementCanonicalName('ZUPKZ.masterData')) <- Permission.permit;
    dataPermission(userRoleSID('zup_hr'),
        navigatorElementCanonicalName('ZUPKZ.personnel')) <- Permission.permit;

    dataPermission(userRoleSID('zup_timekeeper'),
        navigatorElementCanonicalName('ZUPKZ.masterData')) <- Permission.permit;
    dataPermission(userRoleSID('zup_timekeeper'),
        navigatorElementCanonicalName('ZUPKZ.workingTime')) <- Permission.permit;

    dataPermission(userRoleSID('zup_payroll'),
        navigatorElementCanonicalName('ZUPKZ.masterData')) <- Permission.permit;
    dataPermission(userRoleSID('zup_payroll'),
        navigatorElementCanonicalName('ZUPKZ.legislation')) <- Permission.permit;
    dataPermission(userRoleSID('zup_payroll'),
        navigatorElementCanonicalName('ZUPKZ.payroll')) <- Permission.permit;

    permitBusinessFolders(userRoleSID('zup_chief_accountant'));
    permitBusinessFolders(userRoleSID('zup_auditor'));
    dataPermissionChange(userRoleSID('zup_auditor'), propertyGroup('System_root')) <- Permission.forbid;
    dataPermissionEditObjects(userRoleSID('zup_auditor'), propertyGroup('System_root')) <- Permission.forbid;
    // Только действия чтения. Право изменения данных аудитору не выдаётся.
    dataPermissionChange(userRoleSID('zup_auditor'),
        actionCanonicalName('ZUPKZ.openPayrollSettlement[ZUPKZ.PayrollSettlementLine]')) <- Permission.permit;
    dataPermissionChange(userRoleSID('zup_auditor'),
        actionCanonicalName('ZUPKZ.printPayrollSettlementPdf[ZUPKZ.PayrollSettlementLine]')) <- Permission.permit;
    dataPermissionChange(userRoleSID('zup_auditor'),
        actionCanonicalName('ZUPKZ.downloadEnforcementOrdersXlsx[]')) <- Permission.permit;
    dataPermissionChange(userRoleSID('zup_auditor'),
        actionCanonicalName('ZUPKZ.downloadEnforcementLinesXlsx[]')) <- Permission.permit;
}

loadZupRoles() {
    // userRoleSID is materialized: use a fresh session after creating roles.
    NEWSESSION {
        ensureZupRoles();
        APPLY;
    }
    NEWSESSION {
        applyZupRolePermissions();
        APPLY;
    }
}

// Initial synchronization and permission assignment are distinct platform phases.
// This guarantees that materialized userRoleSID resolves newly created roles.
onStarted() + { ensureZupRoles(); }
onFinallyStarted() + { applyZupRolePermissions(); }

