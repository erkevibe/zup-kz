shiftPlannedHoursGuardTest() {
    NEW org = Organization {
        bin(org) <- '666666666678';
        NEW schedule = WorkSchedule {
            scheduleOrganization(schedule) <- org;
            NEW shift = ShiftTemplate {
                shiftSchedule(shift) <- schedule;
                shiftStartTime(shift) <- 09:00;
                shiftEndTime(shift) <- 17:00;
                breakMinutes(shift) <- 60;
                plannedHours(shift) <- 8.00;
            }
        }
    }
    APPLY;
    EXPORT JSON FROM shiftPlannedHoursRejected = canceled();
}

overnightShiftDurationTest() {
    NEW org = Organization {
        bin(org) <- '666666666679';
        NEW schedule = WorkSchedule {
            scheduleOrganization(schedule) <- org;
            NEW shift = ShiftTemplate {
                shiftSchedule(shift) <- schedule;
                shiftStartTime(shift) <- 22:00;
                shiftEndTime(shift) <- 06:00;
                breakMinutes(shift) <- 60;
                plannedHours(shift) <- 7.00;
                APPLY;
                EXPORT JSON FROM
                    overnightShiftAccepted = NOT canceled(),
                    overnightAvailableMinutes = shiftAvailableMinutes(shift);
            }
        }
    }
}
