MODULE AccessWorkflowTest;

REQUIRE SickLeaveWorkflowTest;
NAMESPACE ZUPKZ;

accessAssignedOrganization() = organizationByBin('333333333333');
accessHiddenOrganization() = organizationByBin('222222222222');
accessHiddenTimesheet() = GROUP LAST Timesheet t IF
    timesheetNumber(t) == 'ACCESS-HIDDEN-1' ORDER t;
accessHiddenDepartment() = GROUP LAST Department d IF code(d) == 'ACCESS-HIDDEN-DEPT' ORDER d;
accessHiddenDeleteDepartment() = GROUP LAST Department d IF
    code(d) == 'ACCESS-HIDDEN-DELETE' ORDER d;
accessAssignedDepartment() = GROUP LAST Department d IF
    code(d) == 'ACCESS-ASSIGNED-DEPT' ORDER d;
accessAssignedTimesheet() = GROUP LAST Timesheet t IF
    timesheetNumber(t) == 'ACCESS-ASSIGNED-TIME' OR
    timesheetNumber(t) == 'ACCESS-ASSIGNED-TIME-OK' ORDER t;
accessAssignedPayrollRun() = GROUP LAST PayrollRun r IF
    payrollNumber(r) == 'ACCESS-ASSIGNED-PAYROLL' OR
    payrollNumber(r) == 'ACCESS-ASSIGNED-PAYROLL-OK' ORDER r;
accessAssignedArchiveCase() = GROUP LAST ArchiveCase c IF
    archiveCaseIndex(c) == 'ACCESS-ASSIGNED-ARCHIVE' ORDER c;
accessAssignedForm200() = GROUP LAST Form200Declaration d IF
    form200Version(d) == 'ACCESS-ASSIGNED-FORM-200' ORDER d;
accessHiddenPayrollRun() = GROUP LAST PayrollRun r IF
    payrollNumber(r) == 'ACCESS-HIDDEN-PAYROLL' ORDER r;
accessHiddenArchiveCase() = GROUP LAST ArchiveCase c IF
    archiveCaseIndex(c) == 'ACCESS-HIDDEN-ARCHIVE' ORDER c;
accessHiddenArchiveDocument() = GROUP LAST ArchiveDocument d IF
    archiveDocumentNumber(d) == 'ACCESS-HIDDEN-FILE' ORDER d;
accessHiddenNotice() = GROUP LAST PersonnelNotice n IF
    personnelNoticeNumber(n) == 'ACCESS-HIDDEN-NOTICE' ORDER n;
accessHiddenEnforcement() = GROUP LAST EnforcementOrder o IF
    enforcementNumber(o) == 'ACCESS-HIDDEN-ENFORCEMENT' ORDER o;
accessHiddenPaymentStatement() = GROUP LAST PaymentStatement d IF
    paymentStatementNumber(d) == 'ACCESS-HIDDEN-PAYMENT' ORDER d;
accessHiddenForm200() = GROUP LAST Form200Declaration d IF
    form200Version(d) == 'ACCESS-HIDDEN-FORM-200' ORDER d;
paymentSecurityEmployee() = GROUP LAST Employee e IF iin(e) == '950505300005' ORDER e;
roleSecurityEmployee() = GROUP LAST Employee e IF iin(e) == '960606300006' ORDER e;
hiddenOnlySecurityEmployee() = GROUP LAST Employee e IF iin(e) == '970707300007' ORDER e;
legacyMigrationEmployee() = GROUP LAST Employee e IF iin(e) == '980808300008' ORDER e;
legacyMigrationAmbiguousEmployee() = GROUP LAST Employee e IF iin(e) == '990909300009' ORDER e;
hiddenEmployeeAssignedPaymentAccountCount() = GROUP SUM 1 IF
    paymentAccountOrganization(EmployeePaymentAccount account) == accessAssignedOrganization() AND
    paymentAccountEmployee(account) == hiddenOnlySecurityEmployee();
hiddenEmployeeInjectedEmploymentCount() = GROUP SUM 1 IF
    employee(Employment contract) == hiddenOnlySecurityEmployee() AND
    contractNumber(contract) == 'SECURITY-HIDDEN-INJECT';
paymentSecurityAccountAFirst() = GROUP LAST EmployeePaymentAccount a IF
    paymentAccountEmployee(a) == paymentSecurityEmployee() AND
    paymentAccountOrganization(a) == accessAssignedOrganization() AND
    paymentAccountValidFrom(a) == 2026_01_01 ORDER a;
paymentSecurityAccountASecond() = GROUP LAST EmployeePaymentAccount a IF
    paymentAccountEmployee(a) == paymentSecurityEmployee() AND
    paymentAccountOrganization(a) == accessAssignedOrganization() AND
    paymentAccountValidFrom(a) == 2026_07_01 ORDER a;
paymentSecurityAccountB() = GROUP LAST EmployeePaymentAccount a IF
    paymentAccountEmployee(a) == paymentSecurityEmployee() AND
    paymentAccountOrganization(a) == accessHiddenOrganization() ORDER a;
uiRoleTestUser(STRING[100] value) = GROUP LAST CustomUser u IF login(u) == value ORDER u;

createUiRoleTestUser(STRING[100] loginValue, STRING[50] roleSid, Organization org) {
    IF NOT uiRoleTestUser(loginValue) THEN
        NEW user = CustomUser {
            login(user) <- loginValue;
            calculateBase64Hash('SHA-256', 'zup-ui-test-only');
            sha256Password(user) <- calculatedHash();
            in(user, userRoleSID(roleSid)) <- TRUE;
            NEW access = UserOrganizationAccess {
                accessUser(access) <- user;
                accessOrganization(access) <- org;
                accessActive(access) <- TRUE;
            }
        }
}

uiRoleSetupTest() {
    loadZupRoles();
    IF NOT organizationByBin('555555555555') THEN
        NEW org = Organization {
            name(org) <- 'UI Test Organization';
            bin(org) <- '555555555555';
        }
    APPLY;

    createUiRoleTestUser('ui-hr', 'zup_hr', organizationByBin('555555555555'));
    createUiRoleTestUser('ui-time', 'zup_timekeeper', organizationByBin('555555555555'));
    createUiRoleTestUser('ui-payroll', 'zup_payroll', organizationByBin('555555555555'));
    createUiRoleTestUser('ui-chief', 'zup_chief_accountant', organizationByBin('555555555555'));
    createUiRoleTestUser('ui-auditor', 'zup_auditor', organizationByBin('555555555555'));
    IF NOT uiRoleTestUser('ui-employee') THEN
        NEW employeeAccount = CustomUser {
            login(employeeAccount) <- 'ui-employee';
            calculateBase64Hash('SHA-256', 'zup-ui-test-only');
            sha256Password(employeeAccount) <- calculatedHash();
            in(employeeAccount, userRoleSID('zup_employee')) <- TRUE;
        }
    APPLY;

    EXPORT JSON FROM
        hrReady = has(uiRoleTestUser('ui-hr'), userRoleSID('zup_hr')),
        timeReady = has(uiRoleTestUser('ui-time'), userRoleSID('zup_timekeeper')),
        payrollReady = has(uiRoleTestUser('ui-payroll'), userRoleSID('zup_payroll')),
        chiefReady = has(uiRoleTestUser('ui-chief'), userRoleSID('zup_chief_accountant')),
        auditorReady = has(uiRoleTestUser('ui-auditor'), userRoleSID('zup_auditor')),
        employeeReady = has(uiRoleTestUser('ui-employee'), userRoleSID('zup_employee'));
}

initialRolePermissionsTest() {
    EXPORT JSON FROM
        hrPersonnelPermitted = dataPermission(userRoleSID('zup_hr'),
            navigatorElementCanonicalName('ZUPKZ.personnel')) == Permission.permit,
        hrPayrollForbidden = dataPermission(userRoleSID('zup_hr'),
            navigatorElementCanonicalName('ZUPKZ.payroll')) == Permission.forbid,
        timeWorkingTimePermitted = dataPermission(userRoleSID('zup_timekeeper'),
            navigatorElementCanonicalName('ZUPKZ.workingTime')) == Permission.permit,
        payrollPayrollPermitted = dataPermission(userRoleSID('zup_payroll'),
            navigatorElementCanonicalName('ZUPKZ.payroll')) == Permission.permit,
        chiefReportsPermitted = dataPermission(userRoleSID('zup_chief_accountant'),
            navigatorElementCanonicalName('ZUPKZ.reportsKz')) == Permission.permit,
        hrUiTestForbidden = dataPermission(userRoleSID('zup_hr'),
            navigatorElementCanonicalName('ZUPKZ.uiTestInternalForms')) == Permission.forbid,
        chiefUiTestForbidden = dataPermission(userRoleSID('zup_chief_accountant'),
            navigatorElementCanonicalName('ZUPKZ.uiTestInternalForms')) == Permission.forbid,
        chiefAdministrationForbidden = dataPermission(userRoleSID('zup_chief_accountant'),
            navigatorElementCanonicalName('System.administration')) == Permission.forbid,
        auditorAdministrationForbidden = dataPermission(userRoleSID('zup_auditor'),
            navigatorElementCanonicalName('System.administration')) == Permission.forbid,
        chiefDesignForbidden = dataPermission(userRoleSID('zup_chief_accountant'),
            navigatorElementCanonicalName('SystemEvents.showDesign')) == Permission.forbid,
        auditorReadOnly = dataPermissionChange(userRoleSID('zup_auditor'),
            propertyGroup('System_root')) == Permission.forbid,
        timekeeperMasterDataWriteDenied = NOT masterDataChangeRoleAllowed(
            uiRoleTestUser('ui-time')),
        payrollMasterDataWriteDenied = NOT masterDataChangeRoleAllowed(
            uiRoleTestUser('ui-payroll')),
        hrMasterDataWriteDenied = NOT masterDataChangeRoleAllowed(uiRoleTestUser('ui-hr')),
        chiefMasterDataWriteDenied = NOT masterDataChangeRoleAllowed(uiRoleTestUser('ui-chief')),
        employeeCabinetPermitted = dataPermission(userRoleSID('zup_employee'),
            navigatorElementCanonicalName('ZUPKZ.employeeSelfService')) == Permission.permit,
        employeePayrollForbidden = dataPermission(userRoleSID('zup_employee'),
            navigatorElementCanonicalName('ZUPKZ.payroll')) == Permission.forbid,
        employeeReadOnly = dataPermissionChange(userRoleSID('zup_employee'),
            propertyGroup('System_root')) == Permission.forbid;
}

employeeCabinetOwnEmployee() = GROUP LAST Employee e IF iin(e) == '901010400010' ORDER e;
employeeCabinetForeignEmployee() = GROUP LAST Employee e IF iin(e) == '911111400011' ORDER e;
employeeCabinetRun() = GROUP LAST PayrollRun r IF payrollNumber(r) == 'CABINET-2026-08' ORDER r;
employeeCabinetOwnSettlement() = settlementLineByEmployee(
    employeeCabinetRun(), employeeCabinetOwnEmployee());
employeeCabinetForeignSettlement() = settlementLineByEmployee(
    employeeCabinetRun(), employeeCabinetForeignEmployee());
employeeCabinetOrganization() = organizationByBin('555555555555');
employeeCabinetDepartment() = GROUP LAST Department d IF
    organization(d) == employeeCabinetOrganization() AND code(d) == 'CABINET-DEPT' ORDER d;
employeeCabinetPosition() = GROUP LAST Position p IF
    organization(p) == employeeCabinetOrganization() AND code(p) == 'CABINET-SPECIALIST' ORDER p;
employeeCabinetStaff() = GROUP LAST StaffPosition s IF
    organization(s) == employeeCabinetOrganization() AND staffCode(s) == 'CABINET-STAFF-001' ORDER s;
employeeCabinetCard() = GROUP LAST EmployeeCard c IF
    cardEmployee(c) == employeeCabinetOwnEmployee() AND
    cardOrganization(c) == employeeCabinetOrganization() ORDER c;
employeeCabinetEmployment() = GROUP LAST Employment e IF
    employee(e) == employeeCabinetOwnEmployee() AND contractNumber(e) == 'CABINET-TD-001' ORDER e;
employeeCabinetAssignment() = GROUP LAST EmploymentAssignment a IF
    employment(a) == employeeCabinetEmployment() ORDER a;
employeeCabinetHire() = GROUP LAST PersonnelEvent e IF
    eventEmployment(e) == employeeCabinetEmployment() AND orderNumber(e) == 'CABINET-HIRE-001' ORDER e;
employeeCabinetLeave() = GROUP LAST LeaveDocument l IF
    leaveAssignment(l) == employeeCabinetAssignment() AND leaveNumber(l) == 'CABINET-LEAVE-001' ORDER l;
employeeCabinetLegacySickLeave() = GROUP LAST SickLeaveDocument d IF
    sickLeaveAssignment(d) == employeeCabinetAssignment() AND
    sickLeaveNumber(d) == 'CABINET-SICK-001' ORDER d;
employeeCabinetSickAverage() = GROUP LAST AverageEarningsDocument d IF
    averageAssignment(d) == employeeCabinetAssignment() AND
    averageNumber(d) == 'CABINET-AVG-SICK-002' ORDER d;
employeeCabinetSickLeave() = GROUP LAST SickLeaveDocument d IF
    sickLeaveAssignment(d) == employeeCabinetAssignment() AND
    sickLeaveNumber(d) == 'CABINET-SICK-002' ORDER d;

employeeCabinetSetupTest() {
    IF NOT employeeCabinetOwnEmployee() THEN NEW own = Employee {
        iin(own) <- '901010400010';
        lastName(own) <- 'Кабинетов';
        firstName(own) <- 'Сотрудник';
    }
    IF NOT employeeCabinetForeignEmployee() THEN NEW foreign = Employee {
        iin(foreign) <- '911111400011';
        lastName(foreign) <- 'Чужой';
        firstName(foreign) <- 'Сотрудник';
    }
    IF NOT employeeCabinetDepartment() THEN NEW department = Department {
        organization(department) <- employeeCabinetOrganization();
        code(department) <- 'CABINET-DEPT';
        name(department) <- 'Отдел клиентского сервиса';
    }
    IF NOT employeeCabinetPosition() THEN NEW position = Position {
        organization(position) <- employeeCabinetOrganization();
        code(position) <- 'CABINET-SPECIALIST';
        name(position) <- 'Специалист по работе с клиентами';
    }
    APPLY;

    IF NOT birthDate(employeeCabinetOwnEmployee()) THEN
        birthDate(employeeCabinetOwnEmployee()) <- 1990_10_10;
    IF NOT gender(employeeCabinetOwnEmployee()) THEN
        gender(employeeCabinetOwnEmployee()) <- Gender.male;
    IF NOT citizenshipCode(employeeCabinetOwnEmployee()) THEN
        citizenshipCode(employeeCabinetOwnEmployee()) <- 'KAZ';
    IF NOT employeeCabinetStaff() THEN NEW staff = StaffPosition {
        organization(staff) <- employeeCabinetOrganization();
        department(staff) <- employeeCabinetDepartment();
        position(staff) <- employeeCabinetPosition();
        staffCode(staff) <- 'CABINET-STAFF-001';
        validFrom(staff) <- 2026_01_01;
        plannedFTE(staff) <- 1.0000;
        salaryMin(staff) <- 300000.00;
        salaryMax(staff) <- 500000.00;
    }
    IF NOT employeeCabinetCard() THEN NEW card = EmployeeCard {
        cardEmployee(card) <- employeeCabinetOwnEmployee();
        cardOrganization(card) <- employeeCabinetOrganization();
        cardNumber(card) <- 'CABINET-T2-001';
        cardDate(card) <- 2026_01_05;
        personnelNumber(card) <- 'CAB-0001';
        phone(card) <- '+7 701 555 01 01';
        email(card) <- 'employee@example.test';
        registeredAddress(card) <- 'г. Алматы, тестовый адрес регистрации';
        residentialAddress(card) <- 'г. Алматы, тестовый адрес проживания';
    }
    IF NOT employeeCabinetEmployment() THEN NEW contract = Employment {
        employee(contract) <- employeeCabinetOwnEmployee();
        organization(contract) <- employeeCabinetOrganization();
        department(contract) <- employeeCabinetDepartment();
        position(contract) <- employeeCabinetPosition();
        hireDate(contract) <- 2026_01_12;
        contractNumber(contract) <- 'CABINET-TD-001';
        contractDate(contract) <- 2026_01_05;
        employmentKind(contract) <- EmploymentKind.primary;
        contractTermKind(contract) <- ContractTermKind.indefinite;
        workPlace(contract) <- 'г. Алматы';
        workConditions(contract) <- 'Нормальные условия труда';
        salary(contract) <- 400000.00;
    }
    APPLY;

    IF NOT employeeCabinetAssignment() THEN NEW assignment = EmploymentAssignment {
        employment(assignment) <- employeeCabinetEmployment();
        staffPosition(assignment) <- employeeCabinetStaff();
        assignmentFrom(assignment) <- 2026_01_12;
        fte(assignment) <- 1.0000;
        assignmentSalary(assignment) <- 400000.00;
    }
    APPLY;

    // Представительный набор для визуальной приёмки; расчётные алгоритмы
    // отпусков и больничных проверяются отдельными workflow-тестами.
    IF NOT employeeCabinetHire() THEN NEW hire = PersonnelEvent {
        eventKind(hire) <- PersonnelEventKind.hire;
        eventEmployment(hire) <- employeeCabinetEmployment();
        eventAssignment(hire) <- employeeCabinetAssignment();
        eventStaffPosition(hire) <- employeeCabinetStaff();
        eventFte(hire) <- 1.0000;
        eventSalary(hire) <- 400000.00;
        effectiveDate(hire) <- 2026_01_12;
        orderNumber(hire) <- 'CABINET-HIRE-001';
        orderDate(hire) <- 2026_01_05;
        basis(hire) <- 'Трудовой договор CABINET-TD-001';
        eventStatus(hire) <- PersonnelEventStatus.posted;
        eventPostedAt(hire) <- currentDateTime();
        esutdStatus(hire) <- EsutdStatus.notSubmitted;
    }
    IF NOT employeeCabinetLeave() THEN NEW leave = LeaveDocument {
        leaveNumber(leave) <- 'CABINET-LEAVE-001';
        leaveOrderDate(leave) <- 2026_08_25;
        leaveAssignment(leave) <- employeeCabinetAssignment();
        leaveKind(leave) <- LeaveKind.unpaid;
        leaveDateFrom(leave) <- 2026_09_14;
        leaveDateTo(leave) <- 2026_09_18;
        leaveCalendar(leave) <- calendarByYear(2026);
        leaveWorkWeek(leave) <- LeaveWorkWeek.fiveDay;
        leaveBasis(leave) <- 'Учебный UI-сценарий: личное заявление';
        leaveStatus(leave) <- LeaveStatus.approved;
        leaveApprovedAt(leave) <- currentDateTime();
        leaveApprovedBy(leave) <- currentUser() AS CustomUser;
    }
    IF sickLeaveStatus(employeeCabinetLegacySickLeave()) == SickLeaveStatus.approved THEN
        cancelSickLeave(employeeCabinetLegacySickLeave());
    IF NOT employeeCabinetSickAverage() THEN NEW average = AverageEarningsDocument {
        averageNumber(average) <- 'CABINET-AVG-SICK-002';
        averageAssignment(average) <- employeeCabinetAssignment();
        averageEventKind(average) <- AverageEarningsEventKind.sickLeave;
        averageMode(average) <- AverageEarningsMode.daily;
        averageEventFrom(average) <- 2026_10_05;
        averageEventTo(average) <- 2026_10_07;
        averagePeriodFrom(average) <- 2025_10_01;
        averagePeriodTo(average) <- 2026_09_30;
        averageEventWorkDays(average) <- 3.00;
        averageStatus(average) <- AverageEarningsStatus.baseCollected;
        NEW base = AverageEarningsBaseLine {
            baseAverageDocument(base) <- average;
            baseEarnings(base) <- 420000.00;
            baseWorkedDays(base) <- 21.00;
            baseIncreaseCoefficient(base) <- 1.000000;
            baseIncluded(base) <- TRUE;
            baseNote(base) <- 'Учебная база среднего заработка для UI';
            calculateAverageEarnings(average);
        }
    }
    IF NOT employeeCabinetSickLeave() THEN NEW sick = SickLeaveDocument {
        sickLeaveNumber(sick) <- 'CABINET-SICK-002';
        sickLeaveIssueDate(sick) <- 2026_10_07;
        sickLeaveMedicalOrganization(sick) <- 'Учебная поликлиника';
        sickLeaveAssignment(sick) <- employeeCabinetAssignment();
        sickLeaveFrom(sick) <- 2026_10_05;
        sickLeaveTo(sick) <- 2026_10_07;
        sickLeaveReason(sick) <- SickLeaveReason.illness;
        sickLeaveAverage(sick) <- employeeCabinetSickAverage();
        sickLeaveStatus(sick) <- SickLeaveStatus.draft;
        NEW benefit = SickLeaveBenefitLine {
            sickBenefitDocument(benefit) <- sick;
            sickBenefitMonth(benefit) <- 2026_10_05;
            sickBenefitWorkDays(benefit) <- 3.00;
            sickBenefitNote(benefit) <- 'Учебный UI-сценарий';
            calculateSickLeave(sick);
            approveSickLeave(sick);
        }
    }
    IF NOT employeeCabinetRun() THEN NEW run = PayrollRun {
        payrollOrganization(run) <- employeeCabinetOrganization();
        payrollNumber(run) <- 'CABINET-2026-08';
        payrollPeriodFrom(run) <- 2026_08_01;
        payrollPeriodTo(run) <- 2026_08_31;
        payrollRunStatus(run) <- PayrollRunStatus.approved;
        NEW ownLine = PayrollSettlementLine {
            settlementPayrollRun(ownLine) <- run;
            settlementEmployee(ownLine) <- employeeCabinetOwnEmployee();
            settlementAccrued(ownLine) <- 400000.00;
            settlementPayable(ownLine) <- 320000.00;
            settlementClosedAt(ownLine) <- currentDateTime();
        }
        NEW foreignLine = PayrollSettlementLine {
            settlementPayrollRun(foreignLine) <- run;
            settlementEmployee(foreignLine) <- employeeCabinetForeignEmployee();
            settlementAccrued(foreignLine) <- 500000.00;
            settlementPayable(foreignLine) <- 400000.00;
            settlementClosedAt(foreignLine) <- currentDateTime();
        }
    }
    APPLY;

    // Старый UI-набор мог содержать только начислено/к выплате. Доводим
    // синтетический закрытый снимок до арифметически согласованного состояния.
    payrollLifecycleTransition(employeeCabinetRun()) <- TRUE;
    settlementOpv(employeeCabinetOwnSettlement()) <- 40000.00;
    settlementVosms(employeeCabinetOwnSettlement()) <- 8000.00;
    settlementIpn(employeeCabinetOwnSettlement()) <- 32000.00;
    settlementOpv(employeeCabinetForeignSettlement()) <- 50000.00;
    settlementVosms(employeeCabinetForeignSettlement()) <- 10000.00;
    settlementIpn(employeeCabinetForeignSettlement()) <- 40000.00;
    employeeUser(employeeCabinetOwnEmployee()) <- uiRoleTestUser('ui-employee');
    APPLY;

    EXPORT JSON FROM
        employeeMapped = employeeByUser(uiRoleTestUser('ui-employee')) ==
            employeeCabinetOwnEmployee(),
        cardCreated = employeeCabinetCard() IS EmployeeCard,
        employmentCreated = employeeCabinetEmployment() IS Employment,
        assignmentCreated = employeeCabinetAssignment() IS EmploymentAssignment,
        hireEventCreated = eventStatus(employeeCabinetHire()) == PersonnelEventStatus.posted,
        leaveCreated = leaveStatus(employeeCabinetLeave()) == LeaveStatus.approved,
        sickLeaveCreated = sickLeaveStatus(employeeCabinetSickLeave()) == SickLeaveStatus.approved,
        ownSettlementCreated = settlementPayable(employeeCabinetOwnSettlement()) == 320000.00,
        foreignSettlementCreated = settlementPayable(employeeCabinetForeignSettlement()) == 400000.00,
        settlementBalanced = settlementAccrued(employeeCabinetOwnSettlement()) -
            settlementTotalDeducted(employeeCabinetOwnSettlement()) ==
            settlementPayable(employeeCabinetOwnSettlement());
}

employeeCabinetFixtureVerificationTest() {
    EXPORT JSON FROM
        employeeMappedPersisted = employeeByUser(uiRoleTestUser('ui-employee')) ==
            employeeCabinetOwnEmployee(),
        cardPersisted = employeeCabinetCard() IS EmployeeCard,
        employmentPersisted = employeeCabinetEmployment() IS Employment,
        assignmentPersisted = employeeCabinetAssignment() IS EmploymentAssignment,
        hireEventPersisted = eventStatus(employeeCabinetHire()) == PersonnelEventStatus.posted,
        leavePersisted = leaveStatus(employeeCabinetLeave()) == LeaveStatus.approved,
        sickLeavePersisted = sickLeaveStatus(employeeCabinetSickLeave()) == SickLeaveStatus.approved,
        settlementPersisted = settlementAccrued(employeeCabinetOwnSettlement()) -
            settlementTotalDeducted(employeeCabinetOwnSettlement()) ==
            settlementPayable(employeeCabinetOwnSettlement());
}

employeeCabinetAccessTest() {
    EXPORT JSON FROM
        ownSettlementAllowed = settlementViewAllowedFor(uiRoleTestUser('ui-employee'),
            employeeCabinetOwnSettlement()),
        foreignSettlementDenied = NOT settlementViewAllowedFor(uiRoleTestUser('ui-employee'),
            employeeCabinetForeignSettlement()),
        employeeHasNoOrganizationAccess = NOT userOrganizationAllowed(
            uiRoleTestUser('ui-employee'), organizationByBin('555555555555')),
        employeeCannotChangeBinding = NOT employeeUserAdministrationAllowed(
            uiRoleTestUser('ui-employee')),
        administratorCanChangeBinding = employeeUserAdministrationAllowed(
            currentUser() AS CustomUser),
        employeeCabinetPermitted = dataPermission(userRoleSID('zup_employee'),
            navigatorElementCanonicalName('ZUPKZ.employeeSelfService')) == Permission.permit,
        employeePayrollForbidden = dataPermission(userRoleSID('zup_employee'),
            navigatorElementCanonicalName('ZUPKZ.payroll')) == Permission.forbid,
        employeeReadOnly = dataPermissionChange(userRoleSID('zup_employee'),
            propertyGroup('System_root')) == Permission.forbid;
}

accessWorkflowTest() {
    loadZupRoles();
    NEW assignedOrg = Organization {
        name(assignedOrg) <- 'Доступ A';
        bin(assignedOrg) <- '333333333333';
        NEW hiddenOrg = Organization {
            name(hiddenOrg) <- 'Доступ B';
            bin(hiddenOrg) <- '222222222222';
            NEW user = CustomUser {
                login(user) <- 'zup-access-test';
                calculateBase64Hash('SHA-256', 'zup-access-ci-only');
                sha256Password(user) <- calculatedHash();
                in(user, userRoleSID('zup_hr')) <- TRUE;
                NEW access = UserOrganizationAccess {
                    accessUser(access) <- user;
                    accessOrganization(access) <- assignedOrg;
                    accessActive(access) <- TRUE;

                    createUiRoleTestUser('zup-access-hr', 'zup_hr', assignedOrg);
                    createUiRoleTestUser('zup-access-time', 'zup_timekeeper', assignedOrg);
                    createUiRoleTestUser('zup-access-payroll', 'zup_payroll', assignedOrg);
                    createUiRoleTestUser('zup-access-chief', 'zup_chief_accountant', assignedOrg);

                    NEW hiddenDepartment = Department {
                        organization(hiddenDepartment) <- hiddenOrg;
                        code(hiddenDepartment) <- 'ACCESS-HIDDEN-DEPT';
                        name(hiddenDepartment) <- 'Скрытое подразделение';
                    }
                    NEW hiddenDeleteDepartment = Department {
                        organization(hiddenDeleteDepartment) <- hiddenOrg;
                        code(hiddenDeleteDepartment) <- 'ACCESS-HIDDEN-DELETE';
                        name(hiddenDeleteDepartment) <- 'Скрытое подразделение для удаления';
                    }
                    NEW hiddenPayroll = PayrollRun {
                        payrollOrganization(hiddenPayroll) <- hiddenOrg;
                        payrollNumber(hiddenPayroll) <- 'ACCESS-HIDDEN-PAYROLL';
                        payrollPeriodFrom(hiddenPayroll) <- 2026_01_01;
                        payrollPeriodTo(hiddenPayroll) <- 2026_01_31;
                        payrollRunStatus(hiddenPayroll) <- PayrollRunStatus.draft;

                        NEW hiddenArchive = ArchiveCase {
                            archiveCaseOrganization(hiddenArchive) <- hiddenOrg;
                            archiveCaseIndex(hiddenArchive) <- 'ACCESS-HIDDEN-ARCHIVE';
                            archiveCaseYear(hiddenArchive) <- 2026;
                            archiveCaseTitle(hiddenArchive) <- 'Скрытое архивное дело';
                            archiveCaseStatus(hiddenArchive) <- ArchiveCaseStatus.open;

                            NEW hiddenArchiveDocument = ArchiveDocument {
                                archiveDocumentCase(hiddenArchiveDocument) <- hiddenArchive;
                                archiveDocumentNumber(hiddenArchiveDocument) <- 'ACCESS-HIDDEN-FILE';
                                archiveDocumentTitle(hiddenArchiveDocument) <- 'Скрытый архивный документ';
                            }
                        }

                        NEW hiddenNotice = PersonnelNotice {
                            personnelNoticeOrganization(hiddenNotice) <- hiddenOrg;
                            personnelNoticeNumber(hiddenNotice) <- 'ACCESS-HIDDEN-NOTICE';
                            personnelNoticeStatus(hiddenNotice) <- PersonnelNoticeStatus.draft;
                        }

                        NEW hiddenEnforcement = EnforcementOrder {
                            enforcementOrganization(hiddenEnforcement) <- hiddenOrg;
                            enforcementNumber(hiddenEnforcement) <- 'ACCESS-HIDDEN-ENFORCEMENT';
                            enforcementStatus(hiddenEnforcement) <- EnforcementOrderStatus.active;
                        }

                        NEW hiddenPayment = PaymentStatement {
                            paymentStatementPayrollRun(hiddenPayment) <- hiddenPayroll;
                            paymentStatementNumber(hiddenPayment) <- 'ACCESS-HIDDEN-PAYMENT';
                            paymentStatementStatus(hiddenPayment) <- PaymentStatementStatus.draft;
                        }

                        NEW hiddenDeclaration = Form200Declaration {
                            form200Organization(hiddenDeclaration) <- hiddenOrg;
                            form200PeriodStart(hiddenDeclaration) <- 2026_01_01;
                            form200Kind(hiddenDeclaration) <- Form200Kind.initial;
                            form200Version(hiddenDeclaration) <- 'ACCESS-HIDDEN-FORM-200';
                            form200Status(hiddenDeclaration) <- Form200Status.draft;
                        }
                    }

                    NEW hiddenTimesheet = Timesheet {
                        timesheetOrganization(hiddenTimesheet) <- hiddenOrg;
                        timesheetNumber(hiddenTimesheet) <- 'ACCESS-HIDDEN-1';
                        timesheetPeriodFrom(hiddenTimesheet) <- 2026_01_01;
                        timesheetPeriodTo(hiddenTimesheet) <- 2026_01_31;
                        timesheetStatus(hiddenTimesheet) <- TimesheetStatus.draft;

                        APPLY;

                        EXPORT JSON FROM
                            allRolesCreated = userRoleSID('zup_hr') AND
                                userRoleSID('zup_timekeeper') AND userRoleSID('zup_payroll') AND
                                userRoleSID('zup_chief_accountant') AND userRoleSID('zup_auditor') AND
                                userRoleSID('zup_employee'),
                            userHasHrRole = has(user, userRoleSID('zup_hr')),
                            assignedOrganizationAllowed = userOrganizationAllowed(user, assignedOrg),
                            hiddenOrganizationRejected = NOT userOrganizationAllowed(user, hiddenOrg),
                            hrPersonnelPermitted = dataPermission(userRoleSID('zup_hr'),
                                navigatorElementCanonicalName('ZUPKZ.personnel')) == Permission.permit,
                            hrPayrollForbidden = dataPermission(userRoleSID('zup_hr'),
                                navigatorElementCanonicalName('ZUPKZ.payroll')) == Permission.forbid,
                            hrUiTestForbidden = dataPermission(userRoleSID('zup_hr'),
                                navigatorElementCanonicalName('ZUPKZ.uiTestInternalForms')) == Permission.forbid,
                            chiefUiTestForbidden = dataPermission(userRoleSID('zup_chief_accountant'),
                                navigatorElementCanonicalName('ZUPKZ.uiTestInternalForms')) == Permission.forbid,
                            chiefAdministrationForbidden = dataPermission(userRoleSID('zup_chief_accountant'),
                                navigatorElementCanonicalName('System.administration')) == Permission.forbid,
                            auditorAdministrationForbidden = dataPermission(userRoleSID('zup_auditor'),
                                navigatorElementCanonicalName('System.administration')) == Permission.forbid,
                            chiefDesignForbidden = dataPermission(userRoleSID('zup_chief_accountant'),
                                navigatorElementCanonicalName('SystemEvents.showDesign')) == Permission.forbid,
                            selfRegistrationDisabled = disableRole('selfRegister'),
                            auditorReadOnly = dataPermissionChange(userRoleSID('zup_auditor'),
                                propertyGroup('System_root')) == Permission.forbid;
                    }
                }
            }
        }
    }
}

crossOrganizationPolicyTest() {
    changeOrganizationName(accessHiddenOrganization(), 'УТЕЧК');
    changeOrganizationName(accessAssignedOrganization(), 'Доступ A изменён');

