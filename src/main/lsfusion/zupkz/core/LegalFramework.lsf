        ensureStatutoryParameter('OPV_RATE', 'Ставка ОПВ', 'percent', 'Обязательные пенсионные взносы работника');
        ensureStatutoryParameter('OPV_MAX_MZP', 'Максимальная база ОПВ', 'MZP', 'Предел месячного дохода для ОПВ');
        ensureStatutoryParameter('OPVR_RATE', 'Ставка ОПВР', 'percent', 'Обязательные пенсионные взносы работодателя');
        ensureStatutoryParameter('OPVR_MIN_MZP', 'Минимальная база ОПВР', 'MZP', 'Минимальная месячная база ОПВР');
        ensureStatutoryParameter('OPVR_MAX_MZP', 'Максимальная база ОПВР', 'MZP', 'Максимальная месячная база ОПВР');
        ensureStatutoryParameter('SO_RATE', 'Ставка социальных отчислений', 'percent', 'Социальные отчисления работодателя');
        ensureStatutoryParameter('SO_MIN_MZP', 'Минимальная база СО', 'MZP', 'Минимальная месячная база социальных отчислений');
        ensureStatutoryParameter('SO_MAX_MZP', 'Максимальная база СО', 'MZP', 'Максимальная месячная база социальных отчислений');
        ensureStatutoryParameter('VOSMS_RATE', 'Ставка взносов ОСМС', 'percent', 'Взносы работника на ОСМС');
        ensureStatutoryParameter('VOSMS_MAX_MZP', 'Максимальная база ВОСМС', 'MZP', 'Максимальная месячная база взносов ОСМС');
        ensureStatutoryParameter('OOSMS_RATE', 'Ставка отчислений ОСМС', 'percent', 'Отчисления работодателя на ОСМС');
        ensureStatutoryParameter('OOSMS_MAX_MZP', 'Максимальная база ООСМС', 'MZP', 'Максимальная месячная база отчислений ОСМС');
        ensureStatutoryParameter('IPN_BASE_RATE', 'Базовая ставка ИПН', 'percent', 'Ставка ИПН до годового порога');
        ensureStatutoryParameter('IPN_HIGH_RATE', 'Повышенная ставка ИПН', 'percent', 'Ставка ИПН с превышения годового порога');
        ensureStatutoryParameter('IPN_THRESHOLD_MRP', 'Годовой порог ИПН', 'MRP', 'Порог применения повышенной ставки ИПН');
        ensureStatutoryParameter('IPN_BASIC_MONTHLY_MRP', 'Базовый вычет ИПН за месяц', 'MRP', 'Базовый налоговый вычет за календарный месяц');
        ensureStatutoryParameter('IPN_BASIC_ANNUAL_MRP', 'Базовый вычет ИПН за год', 'MRP', 'Предельный базовый налоговый вычет за год');
        ensureStatutoryParameter('IPN_SOCIAL_STANDARD_MRP', 'Социальный вычет ИПН', 'MRP', 'Годовой социальный вычет для предусмотренных категорий');
        ensureStatutoryParameter('IPN_SOCIAL_DISABILITY_MRP', 'Социальный вычет ИПН для инвалидности I–II групп', 'MRP', 'Годовой социальный вычет для лиц с инвалидностью I–II групп');
        ensureStatutoryParameter('SOCIAL_TAX_RATE', 'Ставка социального налога', 'percent', 'Общая ставка социального налога');
        ensureStatutoryParameter('SOCIAL_TAX_AGRI_RATE', 'Ставка социального налога для сельхозпроизводителей', 'percent', 'Льготная ставка по соответствующим объектам');
        ensureStatutoryParameter('LIVING_MINIMUM', 'Прожиточный минимум', 'KZT', 'Величина прожиточного минимума на соответствующий год');
        ensureStatutoryParameter('ENFORCEMENT_MAX_RATE', 'Максимум удержаний по исполнительным документам', 'percent', 'Доля дохода, которая может быть удержана');
        ensureStatutoryParameter('ALIMONY_ONE_CHILD_RATE', 'Алименты на одного ребёнка', 'percent', 'Законная доля дохода при отсутствии иного размера в документе');
        ensureStatutoryParameter('ALIMONY_TWO_CHILD_RATE', 'Алименты на двух детей', 'percent', 'Законная доля дохода при отсутствии иного размера в документе');
        ensureStatutoryParameter('ALIMONY_THREE_CHILD_RATE', 'Алименты на трёх и более детей', 'percent', 'Законная доля дохода при отсутствии иного размера в документе');

