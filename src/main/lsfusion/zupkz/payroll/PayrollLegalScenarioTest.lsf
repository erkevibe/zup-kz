MODULE PayrollLegalScenarioTest;

REQUIRE PayrollFormulaTest;
NAMESPACE ZUPKZ;

legalScenarioEmployee(STRING[12] iinValue) = GROUP AGGR Employee e BY iin(e);
legalScenarioLineCount(SocialPaymentDocument document) = GROUP SUM 1 IF
    socialPaymentDocument(SocialPaymentLine line) == document;

createLegalScenarioWorker(PayrollRun run, STRING[12] iinValue, STRING[100] lastNameValue,
                          DATE birthDateValue, NUMERIC[18,2] grossIncome,
                          BOOLEAN resident, BOOLEAN basicDeduction,
                          IpnSocialDeductionKind socialDeduction) {
    NEW worker = Employee {
        iin(worker) <- iinValue;
        lastName(worker) <- lastNameValue;
        firstName(worker) <- 'Сценарий';
        birthDate(worker) <- birthDateValue;
        citizenshipCode(worker) <- IF resident THEN 'KZ' ELSE 'KGZ';

        NEW taxProfile = EmployeeTaxProfile {
            taxProfileOrganization(taxProfile) <- payrollOrganization(run);
            taxProfileEmployee(taxProfile) <- worker;
            taxProfileValidFrom(taxProfile) <- 2026_01_01;
            taxProfileResident(taxProfile) <- resident;
            taxProfileIncomeStatus(taxProfile) <- TaxIncomeStatus.employee;
            taxProfileBasicDeduction(taxProfile) <- basicDeduction;
            taxProfileSocialDeduction(taxProfile) <- socialDeduction;
            taxProfileBasis(taxProfile) <- 'Эталонный сценарий 2026';

            // Social obligations are configured independently from tax residency.
            NEW socialProfile = SocialPaymentProfile {
                socialProfileOrganization(socialProfile) <- payrollOrganization(run);
                socialProfileEmployee(socialProfile) <- worker;
                socialProfileValidFrom(socialProfile) <- 2026_01_01;
                socialProfileBasis(socialProfile) <- 'Эталонный сценарий 2026';

                NEW contract = Employment {
                    employee(contract) <- worker;
                    organization(contract) <- payrollOrganization(run);
                    salary(contract) <- grossIncome;

                    NEW assignment = EmploymentAssignment {
                        employment(assignment) <- contract;
                        assignmentFrom(assignment) <- 2026_01_01;
                        assignmentSalary(assignment) <- grossIncome;

                        NEW line = PayrollLine {
                            linePayrollRun(line) <- run;
                            linePayrollAssignment(line) <- assignment;
                            lineCalculationType(line) <- calculationTypeByCode('BASE_SALARY');
                            calculationBase(line) <- grossIncome;
                            calculationAmount(line) <- grossIncome;
                            calculationNote(line) <- 'Эталонный сценарий 2026';
                        }
                    }
                }
            }
        }
    }
}

// Independent legal branches use the same gross income so differences remain visible.
payrollLegalScenarioTest() {
    NEW org = Organization {
        bin(org) <- '770909300009';
        name(org) <- 'Эталонные сценарии 2026';

        NEW run = PayrollRun {
            payrollOrganization(run) <- org;
            payrollNumber(run) <- 'LEGAL-GOLDEN-2026-01';
            payrollPeriodFrom(run) <- 2026_01_01;
            payrollPeriodTo(run) <- 2026_01_31;
            payrollRunStatus(run) <- PayrollRunStatus.draft;

            createLegalScenarioWorker(run, '910101300001', 'Резидент', 1991_01_01,
                500000.00, TRUE, TRUE, IpnSocialDeductionKind.none);
            createLegalScenarioWorker(run, '920202300002', 'Нерезидент', 1992_02_02,
                500000.00, NULL, NULL, IpnSocialDeductionKind.none);
            createLegalScenarioWorker(run, '930303300003', 'Инвалидность I–II', 1993_03_03,
                500000.00, TRUE, TRUE, IpnSocialDeductionKind.disabilityOneTwo);
            createLegalScenarioWorker(run, '750101300004', 'Граница ОПВР', 1975_01_01,
                500000.00, TRUE, TRUE, IpnSocialDeductionKind.none);
            createLegalScenarioWorker(run, '741231300005', 'До границы ОПВР', 1974_12_31,
                500000.00, TRUE, TRUE, IpnSocialDeductionKind.none);

            payrollRunStatus(run) <- PayrollRunStatus.calculated;

            NEW social = SocialPaymentDocument {
                socialPaymentPayrollRun(social) <- run;
                socialPaymentStatus(social) <- SocialPaymentStatus.draft;
                calculateSocialPayments(social);

                NEW taxes = TaxCalculationDocument {
                    taxCalculationPayrollRun(taxes) <- run;
                    taxCalculationSocialPayments(taxes) <- social;
                    taxCalculationStatus(taxes) <- TaxCalculationStatus.draft;
                    calculateTaxes(taxes);

                    EXPORT JSON FROM
                        scenarioCount = legalScenarioLineCount(social),
                        residentOpv = opvAmount(socialPaymentLineByEmployee(
                            social, legalScenarioEmployee('910101300001'))),
                        residentOpvr = opvrAmount(socialPaymentLineByEmployee(
                            social, legalScenarioEmployee('910101300001'))),
                        residentSo = soAmount(socialPaymentLineByEmployee(
                            social, legalScenarioEmployee('910101300001'))),
                        residentVosms = vosmsAmount(socialPaymentLineByEmployee(
                            social, legalScenarioEmployee('910101300001'))),
                        residentOosms = oosmsAmount(socialPaymentLineByEmployee(
                            social, legalScenarioEmployee('910101300001'))),
                        residentBasicDeduction = ipnBasicDeduction(taxCalculationLineByEmployee(
                            taxes, legalScenarioEmployee('910101300001'))),
                        residentTaxableIncome = ipnTaxableIncome(taxCalculationLineByEmployee(
                            taxes, legalScenarioEmployee('910101300001'))),
                        residentIpn = ipnAmount(taxCalculationLineByEmployee(
                            taxes, legalScenarioEmployee('910101300001'))),
                        nonresidentRecorded = NOT taxCalculationResident(taxCalculationLineByEmployee(
                            taxes, legalScenarioEmployee('920202300002'))),
                        nonresidentBasicDeduction = ipnBasicDeduction(taxCalculationLineByEmployee(
                            taxes, legalScenarioEmployee('920202300002'))),
                        nonresidentSocialDeduction = ipnSocialDeduction(taxCalculationLineByEmployee(
                            taxes, legalScenarioEmployee('920202300002'))),
                        nonresidentTaxableIncome = ipnTaxableIncome(taxCalculationLineByEmployee(
                            taxes, legalScenarioEmployee('920202300002'))),
                        nonresidentIpn = ipnAmount(taxCalculationLineByEmployee(
                            taxes, legalScenarioEmployee('920202300002'))),
                        disabilityBasicDeduction = ipnBasicDeduction(taxCalculationLineByEmployee(
                            taxes, legalScenarioEmployee('930303300003'))),
                        disabilitySocialDeduction = ipnSocialDeduction(taxCalculationLineByEmployee(
                            taxes, legalScenarioEmployee('930303300003'))),
                        disabilityTaxableIncome = ipnTaxableIncome(taxCalculationLineByEmployee(
                            taxes, legalScenarioEmployee('930303300003'))),
                        disabilityIpn = ipnAmount(taxCalculationLineByEmployee(
                            taxes, legalScenarioEmployee('930303300003'))),
                        disabilityDeductionCodes = taxCalculationDeductionCodes(
                            taxCalculationLineByEmployee(taxes,
                                legalScenarioEmployee('930303300003'))),
                        opvrBoundaryIncluded = NOT opvrExempt(socialPaymentLineByEmployee(
                            social, legalScenarioEmployee('750101300004'))),
                        opvrBoundaryAmount = opvrAmount(socialPaymentLineByEmployee(
                            social, legalScenarioEmployee('750101300004'))),
                        opvrBeforeBoundaryExempt = opvrExempt(socialPaymentLineByEmployee(
                            social, legalScenarioEmployee('741231300005'))),
                        opvrBeforeBoundaryAmount = opvrAmount(socialPaymentLineByEmployee(
                            social, legalScenarioEmployee('741231300005'))),
                        regulatoryPack = packCode(socialPaymentRegulatoryPack(social));
                }
            }
        }
    }
}
