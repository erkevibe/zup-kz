MODULE TimeWorkflowTest;

REQUIRE HRWorkflowTest;
NAMESPACE ZUPKZ;

timeWorkflowTest() {
    NEW org = Organization {
        bin(org) <- '666666666666';
        NEW worker = Employee {
            iin(worker) <- '940404300004';
            lastName(worker) <- 'Табельный';
            firstName(worker) <- 'Тест';
            NEW contract = Employment {
                employee(contract) <- worker;
                organization(contract) <- org;
                hireDate(contract) <- 2026_01_01;
                salary(contract) <- 168000.00;
                NEW assignment = EmploymentAssignment {
                    employment(assignment) <- contract;
                    assignmentFrom(assignment) <- 2026_01_01;
                    assignmentSalary(assignment) <- 168000.00;
                    NEW january = Timesheet {
                        timesheetOrganization(january) <- org;
                        timesheetNumber(january) <- 'TS-2026-01';
                        timesheetPeriodFrom(january) <- 2026_01_01;
                        timesheetPeriodTo(january) <- 2026_01_31;
                        timesheetStatus(january) <- TimesheetStatus.draft;
                        NEW januaryLine = TimesheetLine {
                            lineTimesheet(januaryLine) <- january;
                            lineEmploymentAssignment(januaryLine) <- assignment;
                            lineDate(januaryLine) <- 2026_01_05;
                            attendanceKind(januaryLine) <- AttendanceKind.worked;
                            plannedHoursLine(januaryLine) <- 8.00;
                            workedHours(januaryLine) <- 8.00;
                            approveTimesheet(january);
                            NEW run = PayrollRun {
                                payrollOrganization(run) <- org;
                                payrollNumber(run) <- 'TIME-TEST-2026-01';
                                payrollPeriodFrom(run) <- 2026_01_01;
                                payrollPeriodTo(run) <- 2026_01_31;
                                payrollRunStatus(run) <- PayrollRunStatus.draft;
                                collectApprovedTime(run);
                                cancelTimesheet(january);
                                NEW february = Timesheet {
                                    timesheetOrganization(february) <- org;
                                    timesheetNumber(february) <- 'TS-2026-02';
                                    timesheetPeriodFrom(february) <- 2026_02_01;
                                    timesheetPeriodTo(february) <- 2026_02_28;
                                    timesheetStatus(february) <- TimesheetStatus.draft;
                                    NEW februaryLine = TimesheetLine {
                                        lineTimesheet(februaryLine) <- february;
                                        lineEmploymentAssignment(februaryLine) <- assignment;
                                        lineDate(februaryLine) <- 2026_02_02;
                                        attendanceKind(februaryLine) <- AttendanceKind.worked;
                                        plannedHoursLine(februaryLine) <- 8.00;
                                        workedHours(februaryLine) <- 8.00;
                                        approveTimesheet(february);
                                        cancelTimesheet(february);

                                        EXPORT JSON FROM
                                            januaryApproved = timesheetStatus(january) ==
                                                TimesheetStatus.approved,
                                            januaryApproverSet = approvedBy(january) ==
                                                currentUser() AS CustomUser,
                                            usedTimesheetCancellationRejected = timesheetStatus(january) ==
                                                TimesheetStatus.approved,
                                            februaryCancelled = timesheetStatus(february) ==
                                                TimesheetStatus.cancelled,
                                            februaryCancellerSet = cancelledBy(february) ==
                                                currentUser() AS CustomUser,
                                            payrollTimeCollected = payrollRunStatus(run) ==
                                                PayrollRunStatus.timeCollected,
                                            summaryPlannedHoursResult = summaryPlannedHours(
                                                payrollTimeSummaryByKey(run, assignment)),
                                            summaryWorkedHoursResult = summaryWorkedHours(
                                                payrollTimeSummaryByKey(run, assignment));
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

scheduleOverlapGuardAssignment() = GROUP LAST EmploymentAssignment a IF
    contractNumber(employment(a)) == 'SCHEDULE-OVERLAP-GUARD' ORDER a;
scheduleOverlapGuardCount() = GROUP SUM 1 IF
    scheduleEmploymentAssignment(EmployeeScheduleAssignment a) == scheduleOverlapGuardAssignment();

scheduleOverlapGuardTest() {
    NEW org = Organization {
        bin(org) <- '666666666667';
        NEW worker = Employee {
            iin(worker) <- '940404300005';
            lastName(worker) <- 'Графиков';
            firstName(worker) <- 'Тест';
            NEW contract = Employment {
                employee(contract) <- worker;
                organization(contract) <- org;
                contractNumber(contract) <- 'SCHEDULE-OVERLAP-GUARD';
                hireDate(contract) <- 2026_01_01;
                NEW assignment = EmploymentAssignment {
                    employment(assignment) <- contract;
                    assignmentFrom(assignment) <- 2026_01_01;
                    NEW schedule = WorkSchedule {
                        scheduleOrganization(schedule) <- org;
                        scheduleCode(schedule) <- 'SCHEDULE-OVERLAP-GUARD';
                        scheduleType(schedule) <- WorkScheduleType.fiveDay;
                        NEW original = EmployeeScheduleAssignment {
                            scheduleEmploymentAssignment(original) <- assignment;
                            employeeWorkSchedule(original) <- schedule;
                            employeeScheduleFrom(original) <- 2026_01_01;
                            employeeScheduleTo(original) <- 2026_06_30;
                        }
                        APPLY;
                        NEW overlap = EmployeeScheduleAssignment {
                            scheduleEmploymentAssignment(overlap) <- assignment;
                            employeeWorkSchedule(overlap) <- schedule;
                            employeeScheduleFrom(overlap) <- 2026_06_30;
                            employeeScheduleTo(overlap) <- 2026_12_31;
                        }
                        APPLY;
                        EXPORT JSON FROM scheduleOverlapRejected = canceled();
                    }
                }
            }
        }
    }
}

scheduleOverlapGuardVerificationTest() {
    EXPORT JSON FROM scheduleOriginalPreserved = scheduleOverlapGuardCount() == 1;
}
