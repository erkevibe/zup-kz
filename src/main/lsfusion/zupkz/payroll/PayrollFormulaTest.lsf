                    taxProfileIncomeStatus(contractorTaxProfile) <- TaxIncomeStatus.civilContract;
                    taxProfileBasicDeduction(contractorTaxProfile) <- NULL;
                    taxProfileSocialDeduction(contractorTaxProfile) <- IpnSocialDeductionKind.none;
                    NEW civilContract = CivilContract {
                        civilContractOrganization(civilContract) <- org;
                        civilContractContractor(civilContract) <- contractor;
                        civilContractNumber(civilContract) <- 'GPH-2026-01';
                        civilContractDate(civilContract) <- 2026_01_10;
                        civilContractFrom(civilContract) <- 2026_01_10;
                        civilContractTo(civilContract) <- 2026_01_31;
                        civilContractSubject(civilContract) <- 'Тестовые консультационные услуги';
                        civilContractAmount(civilContract) <- 1000000.00;
                        civilContractStatus(civilContract) <- CivilContractStatus.active;
                        NEW civilAct = CivilContractAct {
                            civilActContract(civilAct) <- civilContract;
                            civilActNumber(civilAct) <- 'ACT-2026-01';
