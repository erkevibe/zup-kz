MODULE KZOrganization;

REQUIRE Utils, Authentication, Security;
NAMESPACE ZUPKZ;

CLASS Organization 'Организация';

name 'Наименование' = DATA STRING[200] (Organization);
shortName 'Краткое наименование' = DATA STRING[100] (Organization);
bin 'БИН' = DATA STRING[12] (Organization);

organizationBinCount(STRING[12] value) = GROUP SUM 1 IF bin(Organization o) == value;
organizationByBin(STRING[12] value) = GROUP AGGR Organization o BY bin(o);
CONSTRAINT bin(Organization o) AND length(bin(o)) != 12
    MESSAGE 'БИН должен содержать 12 символов';
CONSTRAINT bin(Organization o) AND NOT onlyDigits(bin(o))
    MESSAGE 'БИН должен состоять только из цифр';
CONSTRAINT organizationBinCount(STRING[12] value) > 1
    MESSAGE 'БИН должен быть уникальным';

// Единая row-level политика. Она живёт в core, чтобы доменные
// модули могли проверять доступ, не завися от UI-фильтров.
CLASS UserOrganizationAccess 'Доступ пользователя к организации';

accessUser 'Пользователь' = DATA CustomUser (UserOrganizationAccess);
accessOrganization 'Организация' = DATA Organization (UserOrganizationAccess);
accessActive 'Активен' = DATA BOOLEAN (UserOrganizationAccess);

accessPairCount(CustomUser user, Organization org) = GROUP SUM 1 IF
    accessUser(UserOrganizationAccess a) == user AND accessOrganization(a) == org;
CONSTRAINT accessPairCount(CustomUser user, Organization org) > 1
    MESSAGE 'Организация может быть назначена пользователю только один раз';

userOrganizationAllowed(CustomUser user, Organization org) =
    has(user, userRoleSID('admin')) OR GROUP MAX accessActive(UserOrganizationAccess a)
        IF accessUser(a) == user AND accessOrganization(a) == org;
canReadOrganization(CustomUser user, Organization org) = userOrganizationAllowed(user, org);
canChangeOrganization(CustomUser user, Organization org) = userOrganizationAllowed(user, org);
canExecuteOrganizationAction(CustomUser user, Organization org) = userOrganizationAllowed(user, org);

organizationAllowed(Organization org) =
    canReadOrganization(currentUser() AS CustomUser, org);
organizationChangeAllowed(Organization org) =
    canChangeOrganization(currentUser() AS CustomUser, org);
organizationActionAllowed(Organization org) =
    canExecuteOrganizationAction(currentUser() AS CustomUser, org);
allowedOrganizationName(Organization org) = name(org) IF organizationAllowed(org);

changeOrganizationName 'Изменить наименование' (Organization org, STRING[200] newName) {
    IF NOT organizationChangeAllowed(org) THEN
        MESSAGE 'Нет доступа к организации';
    ELSE {
        name(org) <- newName;
        APPLY;
    }
}

FORM organizations 'Организации'
    OBJECTS o = Organization
    PROPERTIES(o) name, shortName, bin
;
