MODULE PayrollEnforcement;

REQUIRE TaxesKZIncomeTax;
NAMESPACE ZUPKZ;

CLASS EnforcementOrderKind 'Вид исполнительного требования' {
    alimony 'Алименты',
    healthOrSurvivorDamage 'Вред здоровью / смерть кормильца',
    employeeClaim 'Требование работника',
    authorOrPropertyDamage 'Авторское вознаграждение / ущерб имуществу',
    securedClaim 'Обеспеченное залогом требование',
    taxOrLegalEntityDamage 'Налоги / ущерб юридическому лицу',
    other 'Прочее требование'
}

CLASS EnforcementCalculationKind 'Способ расчёта взыскания' {
    incomeShare 'Доля дохода',
    fixedAmount 'Фиксированная сумма'
}

CLASS EnforcementOrderStatus 'Статус исполнительного документа' {
    active 'Действует',
    suspended 'Приостановлен',
    closed 'Завершён'
}

CLASS EnforcementOrder 'Исполнительный документ';

enforcementOrganization 'Организация' = DATA Organization (EnforcementOrder);
enforcementEmployee 'Сотрудник' = DATA Employee (EnforcementOrder);
enforcementKind 'Вид требования' = DATA EnforcementOrderKind (EnforcementOrder);
enforcementCalculationKind 'Способ расчёта' = DATA EnforcementCalculationKind (EnforcementOrder);
enforcementStatus 'Статус' = DATA EnforcementOrderStatus (EnforcementOrder);
enforcementLifecycleTransition = DATA LOCAL BOOLEAN (EnforcementOrder);
enforcementNumber 'Номер документа' = DATA STRING[80] (EnforcementOrder);
enforcementDate 'Дата документа' = DATA DATE (EnforcementOrder);
enforcementValidFrom 'Удерживать с' = DATA DATE (EnforcementOrder);
enforcementValidTo 'Удерживать по' = DATA DATE (EnforcementOrder);
enforcementPriority 'Очередь' = DATA INTEGER (EnforcementOrder);
enforcementPercent 'Доля, %' = DATA NUMERIC[18,6] (EnforcementOrder);
enforcementFixedAmount 'Фиксированная сумма' = DATA NUMERIC[18,2] (EnforcementOrder);
enforcementChildCount 'Количество детей' = DATA INTEGER (EnforcementOrder);
enforcementRemainingDebt 'Остаток задолженности' = DATA NUMERIC[18,2] (EnforcementOrder);
enforcementRecipient 'Получатель' = DATA STRING[250] (EnforcementOrder);
enforcementRecipientIin 'ИИН получателя' = DATA STRING[12] (EnforcementOrder);
enforcementRecipientIban 'IBAN получателя' = DATA STRING[34] (EnforcementOrder);
enforcementOfficer 'Судебный исполнитель' = DATA STRING[250] (EnforcementOrder);
enforcementProceedingNumber 'Номер производства' = DATA STRING[80] (EnforcementOrder);
enforcementBasis 'Основание' = DATA STRING[500] (EnforcementOrder);
enforcementLegalSource 'Нормативное основание' = DATA LegalSource (EnforcementOrder);

CONSTRAINT enforcementValidTo(EnforcementOrder o) < enforcementValidFrom(o)
    MESSAGE 'Окончание удержания не может быть раньше начала';
CONSTRAINT enforcementPriority(EnforcementOrder o) < 1 OR enforcementPriority(o) > 5
    MESSAGE 'Очередь исполнительного требования должна быть от 1 до 5';
CONSTRAINT enforcementPercent(EnforcementOrder o) < 0.000000 OR enforcementPercent(o) > 100.000000
    MESSAGE 'Доля удержания должна быть от 0 до 100 процентов';
CONSTRAINT enforcementFixedAmount(EnforcementOrder o) < 0.00 OR enforcementRemainingDebt(o) < 0.00
    MESSAGE 'Сумма взыскания и остаток задолженности не могут быть отрицательными';
CONSTRAINT CHANGED(enforcementStatus(EnforcementOrder o)) AND PREV(enforcementStatus(o)) AND
           NOT enforcementLifecycleTransition(o)
    MESSAGE 'Статус исполнительного документа изменяется только штатными действиями';

protectedMinimumException(EnforcementOrder o) =
    enforcementKind(o) == EnforcementOrderKind.alimony OR
    enforcementKind(o) == EnforcementOrderKind.healthOrSurvivorDamage;

CLASS EnforcementCalculationStatus 'Статус расчёта взысканий' {
    draft 'Черновик',
    calculated 'Рассчитан',
    approved 'Утверждён',
    cancelled 'Отменён'
}

CLASS EnforcementCalculationDocument 'Расчёт исполнительных удержаний';

enforcementTaxCalculation 'Расчёт налогов' = DATA TaxCalculationDocument (EnforcementCalculationDocument);
enforcementCalculationStatus 'Статус' = DATA EnforcementCalculationStatus (EnforcementCalculationDocument);
enforcementCalculatedAt 'Рассчитан' = DATA DATETIME (EnforcementCalculationDocument);
enforcementCalculationLifecycleTransition =
    DATA LOCAL BOOLEAN (EnforcementCalculationDocument);

CONSTRAINT CHANGED(enforcementCalculationStatus(EnforcementCalculationDocument d)) AND
           PREV(enforcementCalculationStatus(d)) AND
           NOT enforcementCalculationLifecycleTransition(d)
    MESSAGE 'Статус расчёта взысканий изменяется только штатными действиями';

enforcementPayrollRun(EnforcementCalculationDocument d) =
    taxCalculationPayrollRun(enforcementTaxCalculation(d));
enforcementCalculationDate(EnforcementCalculationDocument d) =
    payrollPeriodTo(enforcementPayrollRun(d));
enforcementCalculationOrganization(EnforcementCalculationDocument d) =
    payrollOrganization(enforcementPayrollRun(d));

CONSTRAINT CHANGED(enforcementTaxCalculation(EnforcementCalculationDocument d)) AND
           PREV(enforcementCalculatedAt(d))
    MESSAGE 'Нельзя менять источник рассчитанных исполнительных удержаний';
CONSTRAINT CHANGED(enforcementCalculatedAt(EnforcementCalculationDocument d)) AND
           PREV(enforcementCalculatedAt(d))
    MESSAGE 'Нельзя менять дату выполнения расчёта исполнительных удержаний';
CONSTRAINT DROPPED(EnforcementCalculationDocument d IS EnforcementCalculationDocument) AND
           PREV(enforcementCalculatedAt(d))
    MESSAGE 'Рассчитанные исполнительные удержания нельзя удалять; используйте отмену';

calculatedEnforcementDocumentCount(TaxCalculationDocument taxDocument) = GROUP SUM 1 IF
    enforcementTaxCalculation(EnforcementCalculationDocument d) == taxDocument AND
    (enforcementCalculationStatus(d) == EnforcementCalculationStatus.calculated OR
     enforcementCalculationStatus(d) == EnforcementCalculationStatus.approved);
CONSTRAINT calculatedEnforcementDocumentCount(TaxCalculationDocument taxDocument) > 1
    MESSAGE 'Для налогового расчёта может быть только один рассчитанный документ взысканий';

CLASS EnforcementCalculationLine 'Строка исполнительного удержания';

enforcementCalculationDocument 'Документ' = DATA EnforcementCalculationDocument (EnforcementCalculationLine);
enforcementCalculationOrder 'Исполнительный документ' = DATA EnforcementOrder (EnforcementCalculationLine);
enforcementRequestedAmount 'Сумма по документу' = DATA NUMERIC[18,2] (EnforcementCalculationLine);
enforcementMaximumAmount 'Максимум удержаний' = DATA NUMERIC[18,2] (EnforcementCalculationLine);
enforcementWithheldAmount 'Удержано' = DATA NUMERIC[18,2] (EnforcementCalculationLine);

// Условия фиксируются вместе с суммой. NULL доли/долга допустим и не означает
// отсутствие снимка. Старые расчёты не заполняем сегодняшними значениями.
enforcementConditionsRecorded = DATA BOOLEAN (EnforcementCalculationLine);
enforcementSavedOrderNumber 'Номер на дату расчёта' = DATA STRING[80] (EnforcementCalculationLine);
enforcementSavedBasis 'Основание на дату расчёта' = DATA STRING[500] (EnforcementCalculationLine);
enforcementSavedPriority 'Очередь на дату расчёта' = DATA INTEGER (EnforcementCalculationLine);
enforcementSavedPercent 'Применённая доля, %' = DATA NUMERIC[18,6] (EnforcementCalculationLine);
enforcementSavedGrossIncome 'Доход для взыскания' = DATA NUMERIC[18,2] (EnforcementCalculationLine);
enforcementSavedNetIncome 'Доход после налогов' = DATA NUMERIC[18,2] (EnforcementCalculationLine);
enforcementSavedKind 'Вид требования на дату расчёта' = DATA STRING[100] (EnforcementCalculationLine);
enforcementSavedMethod 'Способ расчёта на дату расчёта' = DATA STRING[100] (EnforcementCalculationLine);
enforcementSavedFixedAmount 'Фиксированная сумма по источнику' = DATA NUMERIC[18,2] (EnforcementCalculationLine);
enforcementSavedDebt 'Остаток долга по источнику' = DATA NUMERIC[18,2] (EnforcementCalculationLine);
enforcementConditionsStatus 'Условия расчёта' (EnforcementCalculationLine l) =
    IF enforcementConditionsRecorded(l) THEN 'Сохранены' ELSE 'Не сохранялись (старый расчёт)';

// Снимок записывает только первое штатное выполнение расчёта.
// Отмена сохраняет строки; исправления выполняются новым расчётом, не правкой снимка.
enforcementSnapshotWriteAllowed(EnforcementCalculationDocument d) =
    d IS EnforcementCalculationDocument AND enforcementCalculationLifecycleTransition(d) AND
    NOT PREV(enforcementCalculatedAt(d)) AND organizationActionAllowed(enforcementCalculationOrganization(d));
CONSTRAINT (CHANGED(enforcementCalculationDocument(EnforcementCalculationLine l)) OR
            CHANGED(enforcementCalculationOrder(l)) OR CHANGED(enforcementRequestedAmount(l)) OR
            CHANGED(enforcementMaximumAmount(l)) OR CHANGED(enforcementWithheldAmount(l)) OR
            CHANGED(enforcementSavedOrderNumber(l)) OR
            CHANGED(enforcementSavedBasis(l)) OR
            CHANGED(enforcementSavedPriority(l)) OR
            CHANGED(enforcementSavedPercent(l)) OR
            CHANGED(enforcementSavedGrossIncome(l)) OR
            CHANGED(enforcementSavedNetIncome(l)) OR
            CHANGED(enforcementSavedKind(l)) OR
            CHANGED(enforcementSavedMethod(l)) OR
            CHANGED(enforcementSavedFixedAmount(l)) OR
            CHANGED(enforcementSavedDebt(l)) OR
            CHANGED(enforcementConditionsRecorded(l))) AND
           (NOT enforcementSnapshotWriteAllowed(enforcementCalculationDocument(l)) OR
            PREV(enforcementCalculatedAt(enforcementCalculationDocument(l))))
    MESSAGE 'Строки исполнительных удержаний записываются только штатным расчётом';
CONSTRAINT DROPPED(EnforcementCalculationLine l IS EnforcementCalculationLine) AND
           PREV(enforcementCalculatedAt(enforcementCalculationDocument(l)))
    MESSAGE 'Нельзя удалять строки рассчитанных исполнительных удержаний';

// Владелец входит в идентичность снимка: его смена переносила бы взыскание
// другому сотруднику при закрытии зарплаты. Отмена расчёта сохраняет эту связь.
enforcementOrderUsed(EnforcementOrder o) = GROUP SUM 1 IF
    enforcementCalculationOrder(EnforcementCalculationLine l) == o AND
    enforcementCalculatedAt(enforcementCalculationDocument(l));
CONSTRAINT (CHANGED(enforcementEmployee(EnforcementOrder o)) OR CHANGED(enforcementOrganization(o))) AND
           PREV(enforcementOrderUsed(o))
    MESSAGE 'Нельзя менять сотрудника или организацию использованного исполнительного документа; создайте новый документ';
CONSTRAINT DROPPED(EnforcementOrder o IS EnforcementOrder) AND PREV(enforcementOrderUsed(o))
    MESSAGE 'Использованный исполнительный документ нельзя удалять; используйте завершение';

enforcementLineEmployee(EnforcementCalculationLine l) =
    enforcementEmployee(enforcementCalculationOrder(l));
enforcementLinePriority 'Очередь' (EnforcementCalculationLine l) =
    enforcementPriority(enforcementCalculationOrder(l));
enforcementLineTaxDocument(EnforcementCalculationLine l) =
    enforcementTaxCalculation(enforcementCalculationDocument(l));
enforcementLineByOrder(EnforcementCalculationDocument d, EnforcementOrder o) =
    GROUP AGGR EnforcementCalculationLine l BY enforcementCalculationDocument(l),
                                                enforcementCalculationOrder(l);
taxCalculationLineByEmployee(TaxCalculationDocument d, Employee worker) =
    GROUP AGGR TaxCalculationLine l BY taxCalculationDocument(l), taxCalculationEmployee(l);
enforcementTaxLine(EnforcementCalculationLine l) =
    taxCalculationLineByEmployee(enforcementLineTaxDocument(l), enforcementLineEmployee(l));

enforcementGrossIncome 'Доход для взыскания' (EnforcementCalculationLine l) =
    payrollAssessmentBase(taxCalculationRun(enforcementTaxLine(l)), enforcementLineEmployee(l),
                          AssessmentBaseKind.enforcement);
enforcementIncomeAfterTaxes 'Доход после налогов' (EnforcementCalculationLine l) = taxPositive(
    enforcementGrossIncome(l) -
    (IF ipnOpvDeduction(enforcementTaxLine(l)) THEN ipnOpvDeduction(enforcementTaxLine(l)) ELSE 0.00) -
    (IF ipnVosmsDeduction(enforcementTaxLine(l)) THEN ipnVosmsDeduction(enforcementTaxLine(l)) ELSE 0.00) -
    (IF ipnAmount(enforcementTaxLine(l)) THEN ipnAmount(enforcementTaxLine(l)) ELSE 0.00));

enforcementParameter(EnforcementCalculationLine l, STRING[50] code) =
    numericStatutoryValueOn(statutoryParameterByCode(code),
        enforcementCalculationDate(enforcementCalculationDocument(l)));
defaultAlimonyPercent(EnforcementCalculationLine l) =
    IF enforcementChildCount(enforcementCalculationOrder(l)) == 1 THEN
        enforcementParameter(l, 'ALIMONY_ONE_CHILD_RATE')
    ELSE IF enforcementChildCount(enforcementCalculationOrder(l)) == 2 THEN
        enforcementParameter(l, 'ALIMONY_TWO_CHILD_RATE')
    ELSE IF enforcementChildCount(enforcementCalculationOrder(l)) >= 3 THEN
        enforcementParameter(l, 'ALIMONY_THREE_CHILD_RATE');
effectiveEnforcementPercent 'Применённая доля, %' (EnforcementCalculationLine l) =
    IF enforcementPercent(enforcementCalculationOrder(l)) THEN
        enforcementPercent(enforcementCalculationOrder(l))
    ELSE IF enforcementKind(enforcementCalculationOrder(l)) == EnforcementOrderKind.alimony THEN
        defaultAlimonyPercent(l);
calculatedEnforcementRequest(EnforcementCalculationLine l) =
    IF enforcementCalculationKind(enforcementCalculationOrder(l)) == EnforcementCalculationKind.incomeShare THEN
        socialPaymentAmount(enforcementIncomeAfterTaxes(l), effectiveEnforcementPercent(l))
    ELSE enforcementFixedAmount(enforcementCalculationOrder(l));
debtLimitedEnforcementRequest(EnforcementCalculationLine l) =
    IF enforcementRemainingDebt(enforcementCalculationOrder(l)) THEN
        taxMinimum(calculatedEnforcementRequest(l), enforcementRemainingDebt(enforcementCalculationOrder(l)))
    ELSE calculatedEnforcementRequest(l);

employeeHasProtectedMinimumException(EnforcementCalculationDocument d, Employee worker) = GROUP SUM 1 IF
    enforcementCalculationDocument(EnforcementCalculationLine l) == d AND
    enforcementLineEmployee(l) == worker AND
    protectedMinimumException(enforcementCalculationOrder(l));
livingMinimumOnEnforcementDate(EnforcementCalculationLine l) =
    numericStatutoryValueOn(statutoryParameterByCode('LIVING_MINIMUM'),
        enforcementCalculationDate(enforcementCalculationDocument(l)));
calculatedMaximumEnforcementWithholding(EnforcementCalculationLine l) = taxMinimum(
    socialPaymentAmount(enforcementIncomeAfterTaxes(l), enforcementParameter(l, 'ENFORCEMENT_MAX_RATE')),
    IF employeeHasProtectedMinimumException(enforcementCalculationDocument(l), enforcementLineEmployee(l)) THEN
        enforcementIncomeAfterTaxes(l)
    ELSE taxPositive(enforcementIncomeAfterTaxes(l) - livingMinimumOnEnforcementDate(l)));

higherPriorityRequested(EnforcementCalculationLine l) = GROUP SUM enforcementRequestedAmount(EnforcementCalculationLine p)
    IF enforcementCalculationDocument(p) == enforcementCalculationDocument(l) AND
       enforcementLineEmployee(p) == enforcementLineEmployee(l) AND
       enforcementLinePriority(p) < enforcementLinePriority(l);
samePriorityRequested(EnforcementCalculationLine l) = GROUP SUM enforcementRequestedAmount(EnforcementCalculationLine p)
    IF enforcementCalculationDocument(p) == enforcementCalculationDocument(l) AND
       enforcementLineEmployee(p) == enforcementLineEmployee(l) AND
       enforcementLinePriority(p) == enforcementLinePriority(l);
priorityAvailableAmount(EnforcementCalculationLine l) = taxPositive(
    enforcementMaximumAmount(l) - taxMinimum(enforcementMaximumAmount(l),
        IF higherPriorityRequested(l) THEN higherPriorityRequested(l) ELSE 0.00));
calculatedEnforcementWithholding(EnforcementCalculationLine l) =
    IF samePriorityRequested(l) <= priorityAvailableAmount(l) THEN enforcementRequestedAmount(l)
    ELSE ROUND(priorityAvailableAmount(l) * enforcementRequestedAmount(l) /
               samePriorityRequested(l), 2)
    IF enforcementRequestedAmount(l) > 0.00 AND samePriorityRequested(l) > 0.00;
enforcementUnpaidAmount 'Не удержано' (EnforcementCalculationLine l) =
    enforcementRequestedAmount(l) - enforcementWithheldAmount(l);

activeEnforcementOrder(EnforcementCalculationDocument d, EnforcementOrder o) =
    enforcementOrganization(o) == enforcementCalculationOrganization(d) AND
    enforcementStatus(o) == EnforcementOrderStatus.active AND
    enforcementValidFrom(o) <= enforcementCalculationDate(d) AND
    (NOT enforcementValidTo(o) OR enforcementValidTo(o) >= enforcementCalculationDate(d));

activateEnforcementOrder 'Активировать' (EnforcementOrder o) {
    IF enforcementStatus(o) == EnforcementOrderStatus.closed THEN
        MESSAGE 'Завершённый исполнительный документ нельзя активировать';
    ELSE IF NOT enforcementOrganization(o) OR NOT enforcementEmployee(o) OR
            NOT enforcementKind(o) OR NOT enforcementCalculationKind(o) OR
            NOT enforcementNumber(o) OR NOT enforcementDate(o) OR
            NOT enforcementValidFrom(o) OR NOT enforcementPriority(o) THEN
        MESSAGE 'Заполните обязательные реквизиты исполнительного документа';
    ELSE {
        enforcementLifecycleTransition(o) <- TRUE;
        enforcementStatus(o) <- EnforcementOrderStatus.active;
        APPLY;
    }
}

suspendEnforcementOrder 'Приостановить' (EnforcementOrder o) {
    IF enforcementStatus(o) != EnforcementOrderStatus.active THEN
        MESSAGE 'Приостановить можно только действующий документ';
    ELSE {
        enforcementLifecycleTransition(o) <- TRUE;
        enforcementStatus(o) <- EnforcementOrderStatus.suspended;
        APPLY;
    }
}

closeEnforcementOrder 'Завершить' (EnforcementOrder o) {
    IF enforcementStatus(o) != EnforcementOrderStatus.active AND
       enforcementStatus(o) != EnforcementOrderStatus.suspended THEN
        MESSAGE 'Завершить можно только действующий или приостановленный документ';
    ELSE {
        enforcementLifecycleTransition(o) <- TRUE;
        enforcementStatus(o) <- EnforcementOrderStatus.closed;
        APPLY;
    }
}

captureEnforcementConditions(EnforcementCalculationLine l) {
    enforcementSavedOrderNumber(l) <- enforcementNumber(enforcementCalculationOrder(l));
    enforcementSavedBasis(l) <- enforcementBasis(enforcementCalculationOrder(l));
    enforcementSavedPriority(l) <- enforcementLinePriority(l);
    enforcementSavedPercent(l) <- effectiveEnforcementPercent(l);
    enforcementSavedGrossIncome(l) <- enforcementGrossIncome(l);
    enforcementSavedNetIncome(l) <- enforcementIncomeAfterTaxes(l);
    enforcementSavedKind(l) <- caption(enforcementKind(enforcementCalculationOrder(l)));
    enforcementSavedMethod(l) <- caption(enforcementCalculationKind(enforcementCalculationOrder(l)));
    enforcementSavedFixedAmount(l) <- enforcementFixedAmount(enforcementCalculationOrder(l));
    enforcementSavedDebt(l) <- enforcementRemainingDebt(enforcementCalculationOrder(l));
    enforcementConditionsRecorded(l) <- TRUE;
}

calculateEnforcement 'Рассчитать' (EnforcementCalculationDocument d) {
    IF enforcementCalculationStatus(d) AND
       enforcementCalculationStatus(d) != EnforcementCalculationStatus.draft THEN
        MESSAGE 'Исполнительные удержания уже рассчитаны';
    ELSE IF NOT enforcementTaxCalculation(d) OR
            (taxCalculationStatus(enforcementTaxCalculation(d)) != TaxCalculationStatus.calculated AND
             taxCalculationStatus(enforcementTaxCalculation(d)) != TaxCalculationStatus.approved) THEN
        MESSAGE 'Выберите рассчитанный налоговый документ';
    ELSE {
        FOR activeEnforcementOrder(d, EnforcementOrder o) DO {
            NEW l = EnforcementCalculationLine {
                enforcementCalculationDocument(l) <- d;
                enforcementCalculationOrder(l) <- o;
            }
        }
        FOR enforcementCalculationDocument(EnforcementCalculationLine l) == d DO {
            captureEnforcementConditions(l);
            enforcementMaximumAmount(l) <- calculatedMaximumEnforcementWithholding(l);
        }
        FOR enforcementCalculationDocument(EnforcementCalculationLine l) == d DO
            enforcementRequestedAmount(l) <- debtLimitedEnforcementRequest(l);
        FOR enforcementCalculationDocument(EnforcementCalculationLine l) == d DO
            enforcementWithheldAmount(l) <- calculatedEnforcementWithholding(l);
        enforcementCalculationLifecycleTransition(d) <- TRUE;
        enforcementCalculationStatus(d) <- EnforcementCalculationStatus.calculated;
        enforcementCalculatedAt(d) <- currentDateTime();
        APPLY;
    }
}

approveEnforcement 'Утвердить' (EnforcementCalculationDocument d) {
    IF enforcementCalculationStatus(d) == EnforcementCalculationStatus.calculated THEN {
        enforcementCalculationLifecycleTransition(d) <- TRUE;
        enforcementCalculationStatus(d) <- EnforcementCalculationStatus.approved;
        APPLY;
    } ELSE
        MESSAGE 'Сначала рассчитайте исполнительные удержания';
}

cancelEnforcementSnapshot(EnforcementCalculationDocument d) {
    enforcementCalculationLifecycleTransition(d) <- TRUE;
    enforcementCalculationStatus(d) <- EnforcementCalculationStatus.cancelled;
}

cancelEnforcement 'Отменить' (EnforcementCalculationDocument d) {
    IF enforcementCalculationStatus(d) != EnforcementCalculationStatus.calculated AND
       enforcementCalculationStatus(d) != EnforcementCalculationStatus.approved THEN
        MESSAGE 'Отменить можно только рассчитанный или утверждённый документ взысканий';
    ELSE IF payrollRunStatus(enforcementPayrollRun(d)) != PayrollRunStatus.calculated THEN
        MESSAGE 'Взыскания закрытого расчёта отменять нельзя';
    ELSE {
        cancelEnforcementSnapshot(d);
        APPLY;
    }
}

totalEnforcementWithheld 'Исполнительные удержания' (EnforcementCalculationDocument d) =
    GROUP SUM enforcementWithheldAmount(EnforcementCalculationLine l)
    IF enforcementCalculationDocument(l) == d;
enforcementWithheldByOrder(EnforcementCalculationDocument d, EnforcementOrder o) =
    GROUP SUM enforcementWithheldAmount(EnforcementCalculationLine l)
    IF enforcementCalculationDocument(l) == d AND enforcementCalculationOrder(l) == o;
payableAfterEnforcement 'К выплате после взысканий' (EnforcementCalculationDocument d) = taxPositive(
    payableAfterTaxes(enforcementTaxCalculation(d)) -
    (IF totalEnforcementWithheld(d) THEN totalEnforcementWithheld(d) ELSE 0.00));

enforcementOrganizationName 'Организация' (EnforcementOrder o) = name(enforcementOrganization(o));
enforcementEmployeeName 'Сотрудник' (EnforcementOrder o) = employeeFullName(enforcementEmployee(o));
changeEnforcementOrganization(EnforcementOrder o) {
    IF enforcementOrderUsed(o) THEN MESSAGE 'Организация использованного исполнительного документа зафиксирована';
    ELSE DIALOG organizations OBJECTS o = enforcementOrganization(o) NULL INPUT selected NULL
        DO enforcementOrganization(o) <- selected;
}
changeEnforcementEmployee(EnforcementOrder o) {
    IF enforcementOrderUsed(o) THEN MESSAGE 'Сотрудник использованного исполнительного документа зафиксирован';
    ELSE DIALOG employees OBJECTS e = enforcementEmployee(o) NULL INPUT selected NULL
        DO enforcementEmployee(o) <- selected;
}

FORM enforcementOrders 'Исполнительные документы'
    OBJECTS o = EnforcementOrder
    PROPERTIES(o) enforcementOrganizationName ON CHANGE changeEnforcementOrganization(o) READONLYIF enforcementOrderUsed(o),
                  enforcementEmployeeName ON CHANGE changeEnforcementEmployee(o) READONLYIF enforcementOrderUsed(o)
    PROPERTIES(o) enforcementKind,
                  enforcementCalculationKind, enforcementNumber,
                  enforcementDate, enforcementValidFrom, enforcementValidTo,
                  enforcementPriority, enforcementPercent, enforcementFixedAmount,
                  enforcementChildCount, enforcementRemainingDebt,
                  enforcementRecipient, enforcementRecipientIin, enforcementRecipientIban,
                  enforcementOfficer, enforcementProceedingNumber,
                  enforcementBasis, enforcementLegalSource
    PROPERTIES(o) READONLY enforcementStatus
    PROPERTIES(o) activateEnforcementOrder, suspendEnforcementOrder, closeEnforcementOrder
;

enforcementRunNumber 'Расчёт зарплаты' (EnforcementCalculationDocument d) = payrollNumber(enforcementPayrollRun(d));
enforcementStatusName 'Статус' (EnforcementCalculationDocument d) = caption(enforcementCalculationStatus(d));
changeEnforcementTaxes(EnforcementCalculationDocument d) {
    DIALOG taxCalculationDocuments OBJECTS d = enforcementTaxCalculation(d) NULL INPUT selected NULL
    DO enforcementTaxCalculation(d) <- selected;
}

FORM enforcementCalculationDocuments 'Расчёт исполнительных удержаний'
    OBJECTS d = EnforcementCalculationDocument
    PROPERTIES(d) enforcementRunNumber ON CHANGE changeEnforcementTaxes(d)
    PROPERTIES(d) READONLY totalEnforcementWithheld, payableAfterEnforcement,
                           enforcementStatusName, enforcementCalculatedAt
    PROPERTIES(d) calculateEnforcement, approveEnforcement, cancelEnforcement
;

enforcementLineRunNumber 'Расчёт зарплаты' (EnforcementCalculationLine l) =
    enforcementRunNumber(enforcementCalculationDocument(l));
enforcementLineOrderNumber 'Исполнительный документ' (EnforcementCalculationLine l) =
    enforcementNumber(enforcementCalculationOrder(l));
enforcementLineEmployeeName 'Сотрудник' (EnforcementCalculationLine l) =
    employeeFullName(enforcementLineEmployee(l));
enforcementLineStatusName 'Статус' (EnforcementCalculationLine l) =
    enforcementStatusName(enforcementCalculationDocument(l));
enforcementLineCalculatedAt 'Рассчитан' (EnforcementCalculationLine l) =
    enforcementCalculatedAt(enforcementCalculationDocument(l));

FORM enforcementCalculationLines 'Строки исполнительных удержаний'
    OBJECTS l = EnforcementCalculationLine
    PROPERTIES(l) READONLY enforcementLineRunNumber, enforcementLineEmployeeName,
                  enforcementLineStatusName, enforcementWithheldAmount
    PROPERTIES(l) PANEL READONLY selectedEmployee = enforcementLineEmployeeName,
                  enforcementLineCalculatedAt, enforcementConditionsStatus,
                  enforcementSavedOrderNumber, enforcementSavedPriority,
                  enforcementSavedGrossIncome, enforcementSavedNetIncome,
                  enforcementSavedPercent, enforcementSavedBasis, enforcementSavedKind,
                  enforcementSavedMethod, enforcementSavedFixedAmount, enforcementSavedDebt, enforcementRequestedAmount,
                  enforcementMaximumAmount, enforcementUnpaidAmount
;

// Штатная панель выбранной строки: те же фильтры организаций и READONLY,
// без нового действия открытия и отдельной схемы прав. Только сохранённые условия.
DESIGN enforcementCalculationLines {
    PROPERTY(enforcementLineRunNumber(l)) { caption = 'Расчёт'; charWidth = 19; }
    PROPERTY(enforcementLineEmployeeName(l)) { charWidth = 28; }
    PROPERTY(enforcementLineStatusName(l)) { charWidth = 10; }
    PROPERTY(enforcementWithheldAmount(l)) { caption = 'Удержано, ₸'; charWidth = 12; }
    MOVE BOX(l) FIRST { caption = 'Удержания — выберите строку для просмотра'; height = 240; flex = 0; }
    NEW details AFTER BOX(l) {
        caption = 'Выбранное удержание · суммы в тенге';
        MOVE PROPERTY(selectedEmployee) { charWidth = 40; charHeight = 2; }
        MOVE PROPERTY(enforcementLineCalculatedAt(l));
        MOVE PROPERTY(enforcementConditionsStatus(l)) { charWidth = 40; }
        NEW detailTabs {
            tabbed = TRUE;
            NEW amounts {
                caption = 'Суммы';
                MOVE PROPERTY(enforcementRequestedAmount(l));
                MOVE PROPERTY(enforcementMaximumAmount(l));
                MOVE PROPERTY(enforcementUnpaidAmount(l));
                MOVE PROPERTY(enforcementSavedGrossIncome(l));
                MOVE PROPERTY(enforcementSavedNetIncome(l));
            }
            NEW conditions {
                caption = 'Условия на дату расчёта';
                MOVE PROPERTY(enforcementSavedOrderNumber(l)) { caption = 'Документ'; charWidth = 40; }
                MOVE PROPERTY(enforcementSavedKind(l)) { caption = 'Вид требования'; charWidth = 40; charHeight = 2; }
                MOVE PROPERTY(enforcementSavedMethod(l)) { caption = 'Способ расчёта'; charWidth = 40; }
                MOVE PROPERTY(enforcementSavedPriority(l)) { caption = 'Очередь'; }
                MOVE PROPERTY(enforcementSavedPercent(l)) { caption = 'Доля, %'; }
                MOVE PROPERTY(enforcementSavedFixedAmount(l)) { caption = 'Фиксированная сумма'; }
                MOVE PROPERTY(enforcementSavedDebt(l)) { caption = 'Остаток долга'; }
                MOVE PROPERTY(enforcementSavedBasis(l)) { caption = 'Основание'; charWidth = 40; charHeight = 3; }
            }
        }
    }
}
