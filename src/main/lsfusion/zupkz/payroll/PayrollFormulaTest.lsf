MODULE PayrollFormulaTest;

REQUIRE ZUPKZ;
NAMESPACE ZUPKZ;

// Headless smoke-test endpoint. The production top module does not require this module.
payrollFormulaTest() {
    NEW org = Organization {
        NEW worker = Employee {
            NEW contract = Employment {
                employee(contract) <- worker;
                organization(contract) <- org;
                salary(contract) <- 100000.00;
                NEW assignment = EmploymentAssignment {
                    employment(assignment) <- contract;
                    assignmentFrom(assignment) <- 2026_01_01;
                    assignmentSalary(assignment) <- 100000.00;
                    NEW run = PayrollRun {
                        payrollOrganization(run) <- org;
                        payrollPeriodFrom(run) <- 2026_01_01;
                        payrollPeriodTo(run) <- 2026_01_31;
                        payrollRunStatus(run) <- PayrollRunStatus.timeCollected;
                        NEW summary = PayrollTimeSummary {
                            summaryPayrollRun(summary) <- run;
                            summaryAssignment(summary) <- assignment;
                            summaryPlannedHours(summary) <- 168.00;
                            summaryWorkedHours(summary) <- 186.00;
                            summaryWorkedDays(summary) <- 23.00;
                            summaryNightHours(summary) <- 8.00;
                            summaryOvertimeHours(summary) <- 10.00;
                            summaryHolidayHours(summary) <- 8.00;
                            calculatePayroll(run);

                            NEW sickAverage = AverageEarningsDocument {
                                averageAssignment(sickAverage) <- assignment;
                                averageEventKind(sickAverage) <- AverageEarningsEventKind.sickLeave;
                                averageMode(sickAverage) <- AverageEarningsMode.daily;
                                averageStatus(sickAverage) <- AverageEarningsStatus.calculated;
                                NEW sickAverageBase = AverageEarningsBaseLine {
                                    baseAverageDocument(sickAverageBase) <- sickAverage;
                                    baseEarnings(sickAverageBase) <- 1230000.00;
                                    baseWorkedDays(sickAverageBase) <- 246.00;
                                    baseIncreaseCoefficient(sickAverageBase) <- 1.000000;
                                    baseIncluded(sickAverageBase) <- TRUE;

                                    NEW ordinarySick = SickLeaveDocument {
                                        sickLeaveAssignment(ordinarySick) <- assignment;
                                        sickLeaveFrom(ordinarySick) <- 2026_01_15;
                                        sickLeaveTo(ordinarySick) <- 2026_02_10;
                                        sickLeaveReason(ordinarySick) <- SickLeaveReason.illness;
                                        sickLeaveAverage(ordinarySick) <- sickAverage;
                                        NEW januarySick = SickLeaveBenefitLine {
                                            sickBenefitDocument(januarySick) <- ordinarySick;
                                            sickBenefitMonth(januarySick) <- 2026_01_15;
                                            sickBenefitWorkDays(januarySick) <- 30.00;
                                            NEW februarySick = SickLeaveBenefitLine {
                                                sickBenefitDocument(februarySick) <- ordinarySick;
                                                sickBenefitMonth(februarySick) <- 2026_02_01;
                                                sickBenefitWorkDays(februarySick) <- 10.00;

                                                NEW injurySick = SickLeaveDocument {
                                                    sickLeaveAssignment(injurySick) <- assignment;
                                                    sickLeaveFrom(injurySick) <- 2026_01_15;
                                                    sickLeaveTo(injurySick) <- 2026_01_31;
                                                    sickLeaveReason(injurySick) <- SickLeaveReason.workInjury;
                                                    sickLeaveProductionActNumber(injurySick) <- 'N-1';
                                                    sickLeaveAverage(injurySick) <- sickAverage;
                                                    NEW injuryLine = SickLeaveBenefitLine {
                                                        sickBenefitDocument(injuryLine) <- injurySick;
                                                        sickBenefitMonth(injuryLine) <- 2026_01_15;
                                                        sickBenefitWorkDays(injuryLine) <- 30.00;

                                                        NEW excludedSick = SickLeaveDocument {
                                                            sickLeaveAssignment(excludedSick) <- assignment;
                                                            sickLeaveFrom(excludedSick) <- 2026_01_15;
                                                            sickLeaveTo(excludedSick) <- 2026_01_31;
                                                            sickLeaveReason(excludedSick) <- SickLeaveReason.illness;
                                                            sickLeaveExclusionReason(excludedSick) <-
                                                                SickLeaveExclusionReason.unpaidLeave;
                                                            sickLeaveAverage(excludedSick) <- sickAverage;
                                                            NEW excludedLine = SickLeaveBenefitLine {
                                                                sickBenefitDocument(excludedLine) <- excludedSick;
                                                                sickBenefitMonth(excludedLine) <- 2026_01_15;
                                                                sickBenefitWorkDays(excludedLine) <- 30.00;

                            EXPORT JSON FROM
                                fullMonth = salaryForWorkedHours(100000.00, 168.00, 168.00),
                                halfMonth = salaryForWorkedHours(100000.00, 168.00, 84.00),
                                nightAdditional = specialHoursAdditionalPay(100000.00, 168.00, 8.00, 1.500000),
                                overtimeAdditional = specialHoursAdditionalPay(100000.00, 168.00, 10.00, 1.500000),
                                holidayAdditional = specialHoursAdditionalPay(100000.00, 168.00, 8.00, 1.500000),
                                overtimeTotal = salaryForWorkedHours(100000.00, 168.00, 178.00) +
                                                specialHoursAdditionalPay(100000.00, 168.00, 10.00, 1.500000),
                                documentLineCount = payrollLineCount(run),
                                documentAccrued = totalAccrued(run),
                                documentPayable = totalPayable(run),
                                averageDaily = averageDailyEarnings(1200000.00, 246.00),
                                averageHourly = averageHourlyEarnings(1200000.00, 1968.00),
                                averagePayDays = averagePayByDays(1200000.00, 246.00, 10.00),
                                averagePayHours = averagePayByHours(1200000.00, 1968.00, 80.00),
                                averagePaySummarized = averagePaySummarized(1200000.00, 1968.00,
                                                                           7.876000, 10.00),
                                positiveRecalculation = payrollRecalculationDelta(100000.00, 110000.00),
                                negativeRecalculation = payrollRecalculationDelta(100000.00, 95000.00),
                                annualLeaveWithHoliday = annualLeaveDays(calendarByYear(2026),
                                                                         2026_03_13, 2026_03_18),
                                annualLeaveWithReligiousDay = annualLeaveDays(calendarByYear(2026),
                                                                              2026_01_06, 2026_01_08),
                                vacationInterimPayment = interimGrossAmount(InterimPaymentKind.vacation,
                                                                             48780.49, NULL, NULL),
                                advanceInterimPayment = interimGrossAmount(InterimPaymentKind.advance,
                                                                            NULL, NULL, 50000.00),
                                sickLeaveMonthlyCap2026 = sickLeaveMonthlyCap(2026_01_15),
                                sickLeaveBelowCap = sickBenefitWithCap(80000.00,
                                                                      sickLeaveMonthlyCap(2026_01_15)),
                                sickLeaveAtCap = sickBenefitWithCap(150000.00,
                                                                   sickLeaveMonthlyCap(2026_01_15)),
                                sickLeaveCapExempt = sickLeaveGrossAmount(injurySick),
                                sickLeaveAcrossMonths = sickLeaveGrossAmount(ordinarySick),
                                sickLeaveExcluded = sickLeaveGrossAmount(excludedSick),
                                sickLeaveInterimPayment = interimGrossAmount(InterimPaymentKind.sickLeave,
                                                                             NULL,
                                                                             sickLeaveGrossAmount(ordinarySick),
                                                                             NULL),
                                scheduledLeavePaymentDue = thirdPreviousWorkDate(calendarByYear(2026),
                                                                                 LeaveWorkWeek.fiveDay,
                                                                                 2026_07_13),
                                outsideSchedulePaymentDue = thirdNextWorkDate(calendarByYear(2026),
                                                                              LeaveWorkWeek.fiveDay,
                                                                              2026_07_13);
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
