        ensureStatutoryValue(statutoryParameterByCode('MRP'), 2026_01_01, 2026_12_31,
            4325.000000, legalSourceByCode('BUDGET_2026_2028'), 'Закон о республиканском бюджете');
        ensureStatutoryValue(statutoryParameterByCode('MIN_OVERTIME_COEF'), 2016_01_01, NULL,
            1.500000, legalSourceByCode('LABOR_CODE_KZ'), 'Не ниже полуторного размера');
        ensureStatutoryValue(statutoryParameterByCode('MIN_HOLIDAY_COEF'), 2016_01_01, NULL,
            1.500000, legalSourceByCode('LABOR_CODE_KZ'), 'Не ниже полуторного размера');
        ensureStatutoryValue(statutoryParameterByCode('MIN_NIGHT_COEF'), 2016_01_01, NULL,
            1.500000, legalSourceByCode('LABOR_CODE_KZ'), 'Не ниже полуторного размера');
        ensureStatutoryValue(statutoryParameterByCode('SICK_LEAVE_MONTHLY_CAP_MRP'), 2023_07_01, NULL,
