MODULE TimeWorkSchedule;

REQUIRE KZOrganization, HREmployment, Time;
NAMESPACE ZUPKZ;

CLASS WorkScheduleType 'Вид графика работы' {
    fiveDay 'Пятидневная неделя',
    sixDay 'Шестидневная неделя',
    shift 'Сменный график',
    summarized 'Суммированный учёт'
}

CLASS AccountingPeriodKind 'Учётный период' {
    month 'Месяц',
    quarter 'Квартал',
    halfYear 'Полугодие',
    year 'Год',
    workPeriod 'Период выполнения работы'
}

CLASS WorkSchedule 'График работы';

scheduleOrganization 'Организация' = DATA Organization (WorkSchedule);
scheduleCode 'Код' = DATA STRING[50] (WorkSchedule);
scheduleName 'Наименование' = DATA STRING[150] (WorkSchedule);
scheduleType 'Вид графика' = DATA WorkScheduleType (WorkSchedule);
weeklyHours 'Недельная норма часов' = DATA NUMERIC[6,2] (WorkSchedule);
accountingPeriodKind 'Учётный период' = DATA AccountingPeriodKind (WorkSchedule);
scheduleValidFrom 'Действует с' = DATA DATE (WorkSchedule);
scheduleValidTo 'Действует по' = DATA DATE (WorkSchedule);

CONSTRAINT scheduleValidTo(WorkSchedule s) < scheduleValidFrom(s)
    MESSAGE 'Дата окончания графика не может быть раньше даты начала';
CONSTRAINT weeklyHours(WorkSchedule s) < 0
    MESSAGE 'Недельная норма часов не может быть отрицательной';

// Шаблоны смен позволяют описать циклы 2/2, сутки через трое и другие режимы.
CLASS ShiftTemplate 'Шаблон смены';

shiftSchedule 'График' = DATA WorkSchedule (ShiftTemplate);
shiftCode 'Код смены' = DATA STRING[30] (ShiftTemplate);
shiftName 'Наименование' = DATA STRING[100] (ShiftTemplate);
shiftStartTime 'Начало' = DATA TIME (ShiftTemplate);
shiftEndTime 'Окончание' = DATA TIME (ShiftTemplate);
breakMinutes 'Перерыв, минут' = DATA INTEGER (ShiftTemplate);
plannedHours 'Плановых часов' = DATA NUMERIC[6,2] (ShiftTemplate);
plannedNightHours 'Плановых ночных часов' = DATA NUMERIC[6,2] (ShiftTemplate);

CONSTRAINT breakMinutes(ShiftTemplate s) < 0 OR plannedHours(s) < 0 OR
           plannedNightHours(s) < 0
    MESSAGE 'Продолжительность смены и перерыва не может быть отрицательной';
CONSTRAINT plannedNightHours(ShiftTemplate s) > plannedHours(s)
    MESSAGE 'Ночные часы не могут превышать продолжительность смены';

CLASS ScheduleCycleDay 'День цикла графика';

cycleSchedule 'График' = DATA WorkSchedule (ScheduleCycleDay);
cycleDayNumber 'Номер дня цикла' = DATA INTEGER (ScheduleCycleDay);
cycleShift 'Смена' = DATA ShiftTemplate (ScheduleCycleDay);
cycleDayOff 'Выходной' = DATA BOOLEAN (ScheduleCycleDay);

CONSTRAINT cycleDayNumber(ScheduleCycleDay d) <= 0
    MESSAGE 'Номер дня цикла должен быть больше нуля';
cycleDayKeyCount(WorkSchedule schedule, INTEGER dayNumber) = GROUP SUM 1 IF
    cycleSchedule(ScheduleCycleDay d) == schedule AND cycleDayNumber(d) == dayNumber;
CONSTRAINT cycleSchedule(ScheduleCycleDay d) AND cycleDayNumber(d) AND
           cycleDayKeyCount(cycleSchedule(d), cycleDayNumber(d)) > 1
    MESSAGE 'Номер дня должен быть уникальным внутри цикла графика';
CONSTRAINT cycleShift(ScheduleCycleDay d) AND cycleSchedule(d) AND
           shiftSchedule(cycleShift(d)) != cycleSchedule(d)
    MESSAGE 'Смена должна принадлежать тому же графику, что и день цикла';
CONSTRAINT cycleShift(ScheduleCycleDay d) AND cycleDayOff(d)
    MESSAGE 'День цикла не может одновременно быть сменой и выходным';

CLASS EmployeeScheduleAssignment 'Назначение графика сотруднику';

scheduleEmploymentAssignment 'Назначение сотрудника' = DATA EmploymentAssignment (EmployeeScheduleAssignment);
employeeWorkSchedule 'График' = DATA WorkSchedule (EmployeeScheduleAssignment);
employeeScheduleFrom 'Действует с' = DATA DATE (EmployeeScheduleAssignment);
employeeScheduleTo 'Действует по' = DATA DATE (EmployeeScheduleAssignment);
cycleStartDate 'Начало цикла' = DATA DATE (EmployeeScheduleAssignment);

CONSTRAINT employeeScheduleTo(EmployeeScheduleAssignment a) < employeeScheduleFrom(a)
    MESSAGE 'Дата окончания назначения графика не может быть раньше даты начала';
overlappingEmployeeScheduleCount(EmployeeScheduleAssignment a) = GROUP SUM 1 IF
    scheduleEmploymentAssignment(EmployeeScheduleAssignment other) ==
        scheduleEmploymentAssignment(a) AND
    employeeScheduleFrom(other) <=
        (IF employeeScheduleTo(a) THEN employeeScheduleTo(a) ELSE 9999_12_31) AND
    (IF employeeScheduleTo(other) THEN employeeScheduleTo(other) ELSE 9999_12_31) >=
        employeeScheduleFrom(a);
CONSTRAINT scheduleEmploymentAssignment(EmployeeScheduleAssignment a) AND
           employeeScheduleFrom(a) AND overlappingEmployeeScheduleCount(a) > 1
    MESSAGE 'Периоды графиков одного назначения сотрудника не должны пересекаться';
CONSTRAINT scheduleEmploymentAssignment(EmployeeScheduleAssignment a) AND
           employeeWorkSchedule(a) AND
           organization(employment(scheduleEmploymentAssignment(a))) !=
               scheduleOrganization(employeeWorkSchedule(a))
    MESSAGE 'График и назначение сотрудника должны принадлежать одной организации';
CONSTRAINT scheduleEmploymentAssignment(EmployeeScheduleAssignment a) AND
           employeeScheduleFrom(a) AND
           employeeScheduleFrom(a) < assignmentFrom(scheduleEmploymentAssignment(a))
    MESSAGE 'График сотрудника не может начинаться раньше назначения';
CONSTRAINT scheduleEmploymentAssignment(EmployeeScheduleAssignment a) AND
           assignmentTo(scheduleEmploymentAssignment(a)) AND
           (NOT employeeScheduleTo(a) OR
            employeeScheduleTo(a) > assignmentTo(scheduleEmploymentAssignment(a)))
    MESSAGE 'График сотрудника не может продолжаться после окончания назначения';
CONSTRAINT employeeWorkSchedule(EmployeeScheduleAssignment a) AND
           employeeScheduleFrom(a) AND scheduleValidFrom(employeeWorkSchedule(a)) AND
           employeeScheduleFrom(a) < scheduleValidFrom(employeeWorkSchedule(a))
    MESSAGE 'Назначение графика не может начинаться раньше срока действия графика';
CONSTRAINT employeeWorkSchedule(EmployeeScheduleAssignment a) AND
           scheduleValidTo(employeeWorkSchedule(a)) AND
           (NOT employeeScheduleTo(a) OR
            employeeScheduleTo(a) > scheduleValidTo(employeeWorkSchedule(a)))
    MESSAGE 'Назначение графика не может продолжаться после срока действия графика';

FORM workSchedules 'Графики работы'
    OBJECTS s = WorkSchedule
    PROPERTIES(s) scheduleOrganization, scheduleCode, scheduleName, scheduleType,
                  weeklyHours, accountingPeriodKind, scheduleValidFrom, scheduleValidTo
;

FORM shiftTemplates 'Шаблоны смен'
    OBJECTS s = ShiftTemplate
    PROPERTIES(s) shiftSchedule, shiftCode, shiftName, shiftStartTime, shiftEndTime,
                  breakMinutes, plannedHours, plannedNightHours
;

FORM scheduleCycleDays 'Циклы графиков'
    OBJECTS d = ScheduleCycleDay
    PROPERTIES(d) cycleSchedule, cycleDayNumber, cycleShift, cycleDayOff
;

FORM employeeScheduleAssignments 'Графики сотрудников'
    OBJECTS a = EmployeeScheduleAssignment
    PROPERTIES(a) scheduleEmploymentAssignment, employeeWorkSchedule,
                  employeeScheduleFrom, employeeScheduleTo, cycleStartDate
;

employeeScheduleAssignmentOn(EmploymentAssignment assignment, DATE date) =
    GROUP LAST EmployeeScheduleAssignment a
    IF scheduleEmploymentAssignment(a) == assignment AND
       employeeScheduleFrom(a) <= date AND
       (NOT employeeScheduleTo(a) OR employeeScheduleTo(a) >= date)
    ORDER employeeScheduleFrom(a), a;

workScheduleOn(EmploymentAssignment assignment, DATE date) =
    employeeWorkSchedule(employeeScheduleAssignmentOn(assignment, date));

cycleLength(WorkSchedule schedule) =
    GROUP MAX cycleDayNumber(ScheduleCycleDay d) BY cycleSchedule(d);

cycleDayByNumber(WorkSchedule schedule, INTEGER number) =
    GROUP AGGR ScheduleCycleDay d BY cycleSchedule(d), cycleDayNumber(d);

cycleNumberOn(EmployeeScheduleAssignment assignment, DATE date) =
    [FORMULA INTEGER 'MOD($1, $2) + 1'](
        daysBetweenDates(cycleStartDate(assignment), date),
        cycleLength(employeeWorkSchedule(assignment))
    ) IF cycleStartDate(assignment) <= date AND cycleLength(employeeWorkSchedule(assignment));

shiftOn(EmployeeScheduleAssignment assignment, DATE date) =
    cycleShift(cycleDayByNumber(employeeWorkSchedule(assignment),
                                cycleNumberOn(assignment, date)));
