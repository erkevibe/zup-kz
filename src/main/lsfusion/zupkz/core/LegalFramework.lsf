MODULE KZLegalFramework;

REQUIRE SystemEvents, Authentication;
NAMESPACE ZUPKZ;

CLASS RegulatoryPackStatus 'Статус нормативного набора' {
    draft 'Черновик',
    approved 'Утверждён',
    retired 'Выведен из действия'
}

CLASS RegulatoryPack 'Нормативный набор';

packCode 'Код' = DATA STRING[50] (RegulatoryPack);
packName 'Наименование' = DATA STRING[200] (RegulatoryPack);
packVersion 'Версия' = DATA STRING[30] (RegulatoryPack);
packValidFrom 'Действует с' = DATA DATE (RegulatoryPack);
packValidTo 'Действует по' = DATA DATE (RegulatoryPack);
packStatus 'Статус' = DATA RegulatoryPackStatus (RegulatoryPack);
packApprovedAt 'Утверждён' = DATA DATETIME (RegulatoryPack);
packApprovedBy 'Кем утверждён' = DATA CustomUser (RegulatoryPack);
regulatoryPackLifecycleTransition = DATA LOCAL BOOLEAN (RegulatoryPack);

regulatoryPackCodeCount(STRING[50] value) = GROUP SUM 1 IF
    packCode(RegulatoryPack p) == value;
CONSTRAINT regulatoryPackCodeCount(STRING[50] value) > 1
    MESSAGE 'Код нормативного набора должен быть уникальным';
CONSTRAINT packValidTo(RegulatoryPack p) < packValidFrom(p)
    MESSAGE 'Дата окончания набора не может быть раньше даты начала';
overlappingApprovedPackCount(RegulatoryPack p) = GROUP SUM 1 IF
    packStatus(RegulatoryPack other) == RegulatoryPackStatus.approved AND
    packValidFrom(other) <= (IF packValidTo(p) THEN packValidTo(p) ELSE 9999_12_31) AND
    (IF packValidTo(other) THEN packValidTo(other) ELSE 9999_12_31) >= packValidFrom(p);
CONSTRAINT packStatus(RegulatoryPack p) == RegulatoryPackStatus.approved AND
           overlappingApprovedPackCount(p) > 1
    MESSAGE 'Периоды утверждённых нормативных наборов не должны пересекаться';
CONSTRAINT CHANGED(packStatus(RegulatoryPack p)) AND PREV(packStatus(p)) AND
           NOT regulatoryPackLifecycleTransition(p)
    MESSAGE 'Статус нормативного набора изменяется только штатными действиями';
CONSTRAINT (CHANGED(packCode(RegulatoryPack p)) OR CHANGED(packName(p)) OR
            CHANGED(packVersion(p)) OR CHANGED(packValidFrom(p)) OR
            CHANGED(packValidTo(p))) AND PREV(packStatus(p)) == RegulatoryPackStatus.approved
    MESSAGE 'Утверждённый нормативный набор неизменяем';

regulatoryPackByCode(STRING[50] value) = GROUP AGGR RegulatoryPack p BY packCode(p);
approvedRegulatoryPackOn(DATE date) = GROUP LAST RegulatoryPack p IF
    packStatus(p) == RegulatoryPackStatus.approved AND packValidFrom(p) <= date AND
    (NOT packValidTo(p) OR packValidTo(p) >= date)
    ORDER packValidFrom(p), p;

approveRegulatoryPack 'Утвердить' (RegulatoryPack p) {
    IF packStatus(p) AND packStatus(p) != RegulatoryPackStatus.draft THEN
        MESSAGE 'Утвердить можно только черновик';
    ELSE IF NOT packCode(p) OR NOT packName(p) OR NOT packVersion(p) OR
            NOT packValidFrom(p) OR NOT packValidTo(p) THEN
        MESSAGE 'Заполните код, наименование, версию и период';
    ELSE {
        regulatoryPackLifecycleTransition(p) <- TRUE;
        packStatus(p) <- RegulatoryPackStatus.approved;
        packApprovedAt(p) <- currentDateTime();
        packApprovedBy(p) <- currentUser() AS CustomUser;
        APPLY;
    }
}

retireRegulatoryPack 'Вывести из действия' (RegulatoryPack p) {
    IF packStatus(p) != RegulatoryPackStatus.approved THEN
        MESSAGE 'Вывести можно только утверждённый набор';
    ELSE {
        regulatoryPackLifecycleTransition(p) <- TRUE;
        packStatus(p) <- RegulatoryPackStatus.retired;
        APPLY;
    }
}

FORM regulatoryPacks 'Нормативные наборы'
    OBJECTS p = RegulatoryPack
    PROPERTIES(p) packCode, packName, packVersion, packValidFrom, packValidTo
    PROPERTIES(p) READONLY packStatus, packApprovedAt, packApprovedBy
    PROPERTIES(p) approveRegulatoryPack, retireRegulatoryPack
;

// Нормативный источник: закон, кодекс, приказ или официальное разъяснение.
CLASS LegalSource 'Нормативный источник';

code 'Код' = DATA STRING[50] (LegalSource);
title 'Наименование' = DATA STRING[250] (LegalSource);
documentNumber 'Номер документа' = DATA STRING[80] (LegalSource);
sourceUrl 'Официальная ссылка' = DATA STRING[500] (LegalSource);
adoptedDate 'Дата принятия' = DATA DATE (LegalSource);
effectiveFrom 'Действует с' = DATA DATE (LegalSource);
effectiveTo 'Действует по' = DATA DATE (LegalSource);
verifiedOn 'Проверено на дату' = DATA DATE (LegalSource);

CONSTRAINT effectiveTo(LegalSource s) < effectiveFrom(s)
    MESSAGE 'Дата окончания действия источника не может быть раньше даты начала';

// Параметр расчёта отделён от его значений во времени.
// Это позволяет обновлять ставки без изменения формул и исходного кода.
CLASS StatutoryParameter 'Параметр законодательства';

parameterCode 'Код' = DATA STRING[50] (StatutoryParameter);
parameterName 'Наименование' = DATA STRING[200] (StatutoryParameter);
unit 'Единица измерения' = DATA STRING[30] (StatutoryParameter);
description 'Описание' = DATA STRING[500] (StatutoryParameter);

CLASS StatutoryParameterValue 'Значение параметра законодательства';

statutoryValuePack 'Нормативный набор' = DATA RegulatoryPack (StatutoryParameterValue);
parameter 'Параметр' = DATA StatutoryParameter (StatutoryParameterValue);
validFrom 'Действует с' = DATA DATE (StatutoryParameterValue);
validTo 'Действует по' = DATA DATE (StatutoryParameterValue);
numericValue 'Числовое значение' = DATA NUMERIC[18,6] (StatutoryParameterValue);
textValue 'Текстовое значение' = DATA STRING[250] (StatutoryParameterValue);
legalSource 'Основание' = DATA LegalSource (StatutoryParameterValue);
note 'Примечание' = DATA STRING[500] (StatutoryParameterValue);

CONSTRAINT validTo(StatutoryParameterValue v) < validFrom(v)
    MESSAGE 'Дата окончания значения не может быть раньше даты начала';

legalSourceCodeCount(STRING[50] value) = GROUP SUM 1 IF code(LegalSource s) == value;
CONSTRAINT legalSourceCodeCount(STRING[50] value) > 1
    MESSAGE 'Код нормативного источника должен быть уникальным';
statutoryParameterCodeCount(STRING[50] value) = GROUP SUM 1 IF
    parameterCode(StatutoryParameter p) == value;
CONSTRAINT statutoryParameterCodeCount(STRING[50] value) > 1
    MESSAGE 'Код параметра законодательства должен быть уникальным';
overlappingStatutoryValueCount(StatutoryParameterValue v) = GROUP SUM 1 IF
    statutoryValuePack(StatutoryParameterValue other) == statutoryValuePack(v) AND
    parameter(other) == parameter(v) AND
    validFrom(other) <= (IF validTo(v) THEN validTo(v) ELSE 9999_12_31) AND
    (IF validTo(other) THEN validTo(other) ELSE 9999_12_31) >= validFrom(v);
CONSTRAINT parameter(StatutoryParameterValue v) AND validFrom(v) AND
           overlappingStatutoryValueCount(v) > 1
    MESSAGE 'Периоды значений одного параметра законодательства не должны пересекаться';
CONSTRAINT (CHANGED(statutoryValuePack(StatutoryParameterValue v)) OR
            CHANGED(parameter(v)) OR CHANGED(validFrom(v)) OR CHANGED(validTo(v)) OR
            CHANGED(numericValue(v)) OR CHANGED(textValue(v)) OR
            CHANGED(legalSource(v)) OR CHANGED(note(v))) AND
           (PREV(packStatus(statutoryValuePack(v))) == RegulatoryPackStatus.approved OR
            packStatus(statutoryValuePack(v)) == RegulatoryPackStatus.approved)
    MESSAGE 'Значения утверждённого нормативного набора неизменяемы';

FORM legalSources 'Нормативные источники'
    OBJECTS s = LegalSource
    PROPERTIES(s) code, title, documentNumber, sourceUrl, adoptedDate,
                  effectiveFrom, effectiveTo, verifiedOn
;

FORM statutoryParameters 'Параметры законодательства'
    OBJECTS p = StatutoryParameter
    PROPERTIES(p) parameterCode, parameterName, unit, description
;

FORM statutoryParameterValues 'Значения параметров законодательства'
    OBJECTS v = StatutoryParameterValue
    PROPERTIES(v) statutoryValuePack, parameter, validFrom, validTo, numericValue, textValue,
                  legalSource, note
;

legalSourceByCode(STRING[50] sourceCode) =
    GROUP AGGR LegalSource s BY code(s);
statutoryParameterByCode(STRING[50] code) =
    GROUP AGGR StatutoryParameter p BY parameterCode(p);
statutoryValueByPeriod(RegulatoryPack pack, StatutoryParameter parameter, DATE dateFrom) =
    GROUP AGGR StatutoryParameterValue v BY statutoryValuePack(v), parameter(v), validFrom(v);
statutoryValueOn(StatutoryParameter p, DATE date) =
    GROUP LAST StatutoryParameterValue v
    IF statutoryValuePack(v) == approvedRegulatoryPackOn(date) AND
       parameter(v) == p AND validFrom(v) <= date AND
       (NOT validTo(v) OR validTo(v) >= date)
    ORDER validFrom(v), v;
numericStatutoryValueOn(StatutoryParameter p, DATE date) =
    numericValue(statutoryValueOn(p, date));
numericStatutoryValueCountOn(STRING[50] requiredCode, DATE date) = GROUP SUM 1 IF
    statutoryValuePack(StatutoryParameterValue v) == approvedRegulatoryPackOn(date) AND
    parameterCode(parameter(v)) == requiredCode AND numericValue(v) AND
    validFrom(v) <= date AND (NOT validTo(v) OR validTo(v) >= date);
numericStatutoryParameterReady(STRING[50] requiredCode, DATE date) =
    numericStatutoryValueCountOn(requiredCode, date) == 1;

ensureRegulatoryPack() {
    IF NOT regulatoryPackByCode('KZ-2026.1') THEN NEW p = RegulatoryPack {
        packCode(p) <- 'KZ-2026.1';
        packName(p) <- 'Базовый набор законодательства РК 2026';
        packVersion(p) <- '2026.1';
        packValidFrom(p) <- 2026_01_01;
        packValidTo(p) <- 2026_12_31;
        packStatus(p) <- RegulatoryPackStatus.draft;
    }
}

ensureLegalSource(STRING[50] sourceCode, STRING[250] sourceTitle,
                  STRING[500] url, DATE dateFrom, DATE checkedOn) {
    IF NOT legalSourceByCode(sourceCode) THEN {
        NEW s = LegalSource {
            code(s) <- sourceCode;
            title(s) <- sourceTitle;
            sourceUrl(s) <- url;
            effectiveFrom(s) <- dateFrom;
            verifiedOn(s) <- checkedOn;
        }
    }
}

ensureStatutoryParameter(STRING[50] code, STRING[200] name,
                         STRING[30] parameterUnit, STRING[500] parameterDescription) {
    IF NOT statutoryParameterByCode(code) THEN {
        NEW p = StatutoryParameter {
            parameterCode(p) <- code;
            parameterName(p) <- name;
            unit(p) <- parameterUnit;
            description(p) <- parameterDescription;
        }
    }
}

ensureStatutoryValue(StatutoryParameter p, DATE dateFrom, DATE dateTo,
                     NUMERIC[18,6] value, LegalSource source, STRING[500] valueNote) {
    IF NOT statutoryValueByPeriod(regulatoryPackByCode('KZ-2026.1'), p, dateFrom) THEN {
        IF statutoryValueByPeriod(NULL, p, dateFrom) THEN
            statutoryValuePack(statutoryValueByPeriod(NULL, p, dateFrom)) <-
                regulatoryPackByCode('KZ-2026.1');
        ELSE NEW v = StatutoryParameterValue {
                statutoryValuePack(v) <- regulatoryPackByCode('KZ-2026.1');
                parameter(v) <- p;
                validFrom(v) <- dateFrom;
                validTo(v) <- dateTo;
                numericValue(v) <- value;
                legalSource(v) <- source;
                note(v) <- valueNote;
            }
    }
}

loadBaselineLegalParameters() {
    NEWSESSION {
        ensureRegulatoryPack();
        ensureLegalSource('LABOR_CODE_KZ', 'Трудовой кодекс Республики Казахстан',
            'https://adilet.zan.kz/rus/docs/K1500000414', 2016_01_01, 2026_08_31);
        ensureLegalSource('BUDGET_2026_2028', 'О республиканском бюджете на 2026–2028 годы',
            'https://www.adilet.zan.kz/rus/docs/Z2500000239', 2026_01_01, 2026_08_31);
        ensureLegalSource('AVERAGE_WAGE_RULES_908', 'Единые правила исчисления средней заработной платы',
            'https://www.adilet.zan.kz/rus/docs/V1500012533', 2016_01_01, 2026_09_03);
        ensureLegalSource('SICK_LEAVE_RULES_907', 'Правила назначения и выплаты социального пособия по временной нетрудоспособности',
            'https://www.adilet.zan.kz/rus/docs/V1500012521', 2016_01_01, 2026_09_03);
        ensureLegalSource('TAX_CODE_2026', 'Налоговый кодекс Республики Казахстан',
            'https://www.adilet.zan.kz/rus/docs/K2500000214', 2026_01_01, 2026_09_03);
        ensureLegalSource('SOCIAL_CODE_KZ', 'Социальный кодекс Республики Казахстан',
            'https://www.adilet.zan.kz/rus/docs/K2300000224', 2023_07_01, 2026_09_03);
        ensureLegalSource('OSMS_LAW', 'Об обязательном социальном медицинском страховании',
            'https://www.adilet.zan.kz/rus/docs/Z1500000405', 2017_07_01, 2026_09_03);
        ensureLegalSource('ENFORCEMENT_LAW', 'Об исполнительном производстве и статусе судебных исполнителей',
            'https://www.adilet.zan.kz/rus/docs/Z100000261_', 2010_08_09, 2026_09_03);
        ensureLegalSource('FAMILY_CODE_KZ', 'О браке (супружестве) и семье',
            'https://www.adilet.zan.kz/rus/docs/K1100000518', 2012_01_18, 2026_09_03);
        ensureLegalSource('ALIMONY_INCOME_LIST', 'Перечень доходов для удержания алиментов',
            'https://adilet.zan.kz/rus/docs/V14D0010113', 2015_02_08, 2026_09_03);

        ensureStatutoryParameter('MZP', 'Минимальная заработная плата', 'KZT',
            'Минимальный размер заработной платы на соответствующий год');
        ensureStatutoryParameter('MRP', 'Месячный расчётный показатель', 'KZT',
            'МРП на соответствующий год');
        ensureStatutoryParameter('MIN_OVERTIME_COEF', 'Минимальный коэффициент сверхурочных', 'coefficient',
            'Статья 108 Трудового кодекса РК');
        ensureStatutoryParameter('MIN_HOLIDAY_COEF', 'Минимальный коэффициент выходных и праздничных', 'coefficient',
            'Статья 109 Трудового кодекса РК');
        ensureStatutoryParameter('MIN_NIGHT_COEF', 'Минимальный коэффициент ночных часов', 'coefficient',
            'Статья 110 Трудового кодекса РК');
        ensureStatutoryParameter('SICK_LEAVE_MONTHLY_CAP_MRP', 'Лимит больничного за месяц', 'MRP',
            'Статья 133 Трудового кодекса РК: предел пособия за календарный месяц');
        ensureStatutoryParameter('OPV_RATE', 'Ставка ОПВ', 'percent', 'Обязательные пенсионные взносы работника');
        ensureStatutoryParameter('OPV_MAX_MZP', 'Максимальная база ОПВ', 'MZP', 'Предел месячного дохода для ОПВ');
        ensureStatutoryParameter('OPVR_RATE', 'Ставка ОПВР', 'percent', 'Обязательные пенсионные взносы работодателя');
        ensureStatutoryParameter('OPVR_MIN_MZP', 'Минимальная база ОПВР', 'MZP', 'Минимальная месячная база ОПВР');
        ensureStatutoryParameter('OPVR_MAX_MZP', 'Максимальная база ОПВР', 'MZP', 'Максимальная месячная база ОПВР');
        ensureStatutoryParameter('SO_RATE', 'Ставка социальных отчислений', 'percent', 'Социальные отчисления работодателя');
        ensureStatutoryParameter('SO_MIN_MZP', 'Минимальная база СО', 'MZP', 'Минимальная месячная база социальных отчислений');
        ensureStatutoryParameter('SO_MAX_MZP', 'Максимальная база СО', 'MZP', 'Максимальная месячная база социальных отчислений');
        ensureStatutoryParameter('VOSMS_RATE', 'Ставка взносов ОСМС', 'percent', 'Взносы работника на ОСМС');
        ensureStatutoryParameter('VOSMS_MAX_MZP', 'Максимальная база ВОСМС', 'MZP', 'Максимальная месячная база взносов ОСМС');
        ensureStatutoryParameter('OOSMS_RATE', 'Ставка отчислений ОСМС', 'percent', 'Отчисления работодателя на ОСМС');
        ensureStatutoryParameter('OOSMS_MAX_MZP', 'Максимальная база ООСМС', 'MZP', 'Максимальная месячная база отчислений ОСМС');
        ensureStatutoryParameter('IPN_BASE_RATE', 'Базовая ставка ИПН', 'percent', 'Ставка ИПН до годового порога');
        ensureStatutoryParameter('IPN_HIGH_RATE', 'Повышенная ставка ИПН', 'percent', 'Ставка ИПН с превышения годового порога');
        ensureStatutoryParameter('IPN_THRESHOLD_MRP', 'Годовой порог ИПН', 'MRP', 'Порог применения повышенной ставки ИПН');
        ensureStatutoryParameter('IPN_BASIC_MONTHLY_MRP', 'Базовый вычет ИПН за месяц', 'MRP', 'Базовый налоговый вычет за календарный месяц');
        ensureStatutoryParameter('IPN_BASIC_ANNUAL_MRP', 'Базовый вычет ИПН за год', 'MRP', 'Предельный базовый налоговый вычет за год');
        ensureStatutoryParameter('IPN_SOCIAL_STANDARD_MRP', 'Социальный вычет ИПН', 'MRP', 'Годовой социальный вычет для предусмотренных категорий');
        ensureStatutoryParameter('IPN_SOCIAL_DISABILITY_MRP', 'Социальный вычет ИПН для инвалидности I–II групп', 'MRP', 'Годовой социальный вычет для лиц с инвалидностью I–II групп');
        ensureStatutoryParameter('SOCIAL_TAX_RATE', 'Ставка социального налога', 'percent', 'Общая ставка социального налога');
        ensureStatutoryParameter('SOCIAL_TAX_AGRI_RATE', 'Ставка социального налога для сельхозпроизводителей', 'percent', 'Льготная ставка по соответствующим объектам');
        ensureStatutoryParameter('LIVING_MINIMUM', 'Прожиточный минимум', 'KZT', 'Величина прожиточного минимума на соответствующий год');
        ensureStatutoryParameter('ENFORCEMENT_MAX_RATE', 'Максимум удержаний по исполнительным документам', 'percent', 'Доля дохода, которая может быть удержана');
        ensureStatutoryParameter('ALIMONY_ONE_CHILD_RATE', 'Алименты на одного ребёнка', 'percent', 'Законная доля дохода при отсутствии иного размера в документе');
        ensureStatutoryParameter('ALIMONY_TWO_CHILD_RATE', 'Алименты на двух детей', 'percent', 'Законная доля дохода при отсутствии иного размера в документе');
        ensureStatutoryParameter('ALIMONY_THREE_CHILD_RATE', 'Алименты на трёх и более детей', 'percent', 'Законная доля дохода при отсутствии иного размера в документе');

        ensureStatutoryValue(statutoryParameterByCode('MZP'), 2026_01_01, 2026_12_31,
            85000.000000, legalSourceByCode('BUDGET_2026_2028'), 'Закон о республиканском бюджете');
        ensureStatutoryValue(statutoryParameterByCode('MRP'), 2026_01_01, 2026_12_31,
            4325.000000, legalSourceByCode('BUDGET_2026_2028'), 'Закон о республиканском бюджете');
        ensureStatutoryValue(statutoryParameterByCode('MIN_OVERTIME_COEF'), 2016_01_01, NULL,
            1.500000, legalSourceByCode('LABOR_CODE_KZ'), 'Не ниже полуторного размера');
        ensureStatutoryValue(statutoryParameterByCode('MIN_HOLIDAY_COEF'), 2016_01_01, NULL,
            1.500000, legalSourceByCode('LABOR_CODE_KZ'), 'Не ниже полуторного размера');
        ensureStatutoryValue(statutoryParameterByCode('MIN_NIGHT_COEF'), 2016_01_01, NULL,
            1.500000, legalSourceByCode('LABOR_CODE_KZ'), 'Не ниже полуторного размера');
        ensureStatutoryValue(statutoryParameterByCode('SICK_LEAVE_MONTHLY_CAP_MRP'), 2023_07_01, NULL,
            25.000000, legalSourceByCode('LABOR_CODE_KZ'), 'С 1 июля 2023 года — 25 МРП за месяц');
        ensureStatutoryValue(statutoryParameterByCode('OPV_RATE'), 2026_01_01, NULL,
            10.000000, legalSourceByCode('SOCIAL_CODE_KZ'), 'Статья 249 Социального кодекса');
        ensureStatutoryValue(statutoryParameterByCode('OPV_MAX_MZP'), 2026_01_01, NULL,
            50.000000, legalSourceByCode('SOCIAL_CODE_KZ'), 'Максимум 50 МЗП в месяц');
        ensureStatutoryValue(statutoryParameterByCode('OPVR_RATE'), 2026_01_01, 2026_12_31,
            3.500000, legalSourceByCode('SOCIAL_CODE_KZ'), 'Ставка ОПВР на 2026 год');
        ensureStatutoryValue(statutoryParameterByCode('OPVR_MIN_MZP'), 2026_01_01, NULL,
            1.000000, legalSourceByCode('SOCIAL_CODE_KZ'), 'Минимум 1 МЗП при наличии дохода');
        ensureStatutoryValue(statutoryParameterByCode('OPVR_MAX_MZP'), 2026_01_01, NULL,
            50.000000, legalSourceByCode('SOCIAL_CODE_KZ'), 'Максимум 50 МЗП в месяц');
        ensureStatutoryValue(statutoryParameterByCode('SO_RATE'), 2026_01_01, NULL,
            5.000000, legalSourceByCode('SOCIAL_CODE_KZ'), 'Ставка социальных отчислений');
        ensureStatutoryValue(statutoryParameterByCode('SO_MIN_MZP'), 2026_01_01, NULL,
            1.000000, legalSourceByCode('SOCIAL_CODE_KZ'), 'Минимум 1 МЗП при наличии дохода');
        ensureStatutoryValue(statutoryParameterByCode('SO_MAX_MZP'), 2026_01_01, NULL,
            7.000000, legalSourceByCode('SOCIAL_CODE_KZ'), 'Максимум 7 МЗП в месяц');
        ensureStatutoryValue(statutoryParameterByCode('VOSMS_RATE'), 2026_01_01, NULL,
            2.000000, legalSourceByCode('OSMS_LAW'), 'Ставка взносов работника');
        ensureStatutoryValue(statutoryParameterByCode('VOSMS_MAX_MZP'), 2026_01_01, NULL,
            20.000000, legalSourceByCode('OSMS_LAW'), 'Максимум 20 МЗП в месяц');
        ensureStatutoryValue(statutoryParameterByCode('OOSMS_RATE'), 2026_01_01, NULL,
            3.000000, legalSourceByCode('OSMS_LAW'), 'Ставка отчислений работодателя');
        ensureStatutoryValue(statutoryParameterByCode('OOSMS_MAX_MZP'), 2026_01_01, NULL,
            40.000000, legalSourceByCode('OSMS_LAW'), 'Максимум 40 МЗП в месяц');
        ensureStatutoryValue(statutoryParameterByCode('IPN_BASE_RATE'), 2026_01_01, NULL,
            10.000000, legalSourceByCode('TAX_CODE_2026'), 'До 8 500 МРП за календарный год включительно');
        ensureStatutoryValue(statutoryParameterByCode('IPN_HIGH_RATE'), 2026_01_01, NULL,
            15.000000, legalSourceByCode('TAX_CODE_2026'), 'С суммы превышения 8 500 МРП за календарный год');
        ensureStatutoryValue(statutoryParameterByCode('IPN_THRESHOLD_MRP'), 2026_01_01, NULL,
            8500.000000, legalSourceByCode('TAX_CODE_2026'), 'Годовой порог прогрессивной ставки');
        ensureStatutoryValue(statutoryParameterByCode('IPN_BASIC_MONTHLY_MRP'), 2026_01_01, NULL,
            30.000000, legalSourceByCode('TAX_CODE_2026'), 'Применяется по заявлению у одного налогового агента');
        ensureStatutoryValue(statutoryParameterByCode('IPN_BASIC_ANNUAL_MRP'), 2026_01_01, NULL,
            360.000000, legalSourceByCode('TAX_CODE_2026'), 'Предельный базовый вычет за календарный год');
        ensureStatutoryValue(statutoryParameterByCode('IPN_SOCIAL_STANDARD_MRP'), 2026_01_01, NULL,
            882.000000, legalSourceByCode('TAX_CODE_2026'), 'Социальный вычет для предусмотренных категорий');
        ensureStatutoryValue(statutoryParameterByCode('IPN_SOCIAL_DISABILITY_MRP'), 2026_01_01, NULL,
            5000.000000, legalSourceByCode('TAX_CODE_2026'), 'Социальный вычет для инвалидности I–II групп');
        ensureStatutoryValue(statutoryParameterByCode('SOCIAL_TAX_RATE'), 2026_01_01, NULL,
            6.000000, legalSourceByCode('TAX_CODE_2026'), 'Общая ставка без уменьшения на социальные отчисления');
        ensureStatutoryValue(statutoryParameterByCode('SOCIAL_TAX_AGRI_RATE'), 2026_01_01, NULL,
            1.800000, legalSourceByCode('TAX_CODE_2026'), 'По объектам сельскохозяйственного производства и переработки');
        ensureStatutoryValue(statutoryParameterByCode('LIVING_MINIMUM'), 2026_01_01, 2026_12_31,
            50851.000000, legalSourceByCode('BUDGET_2026_2028'), 'Величина прожиточного минимума на 2026 год');
        ensureStatutoryValue(statutoryParameterByCode('ENFORCEMENT_MAX_RATE'), 2026_01_01, NULL,
            50.000000, legalSourceByCode('ENFORCEMENT_LAW'), 'За должником сохраняется не менее 50 процентов дохода');
        ensureStatutoryValue(statutoryParameterByCode('ALIMONY_ONE_CHILD_RATE'), 2026_01_01, NULL,
            25.000000, legalSourceByCode('FAMILY_CODE_KZ'), 'Одна четверть дохода');
        ensureStatutoryValue(statutoryParameterByCode('ALIMONY_TWO_CHILD_RATE'), 2026_01_01, NULL,
            33.333333, legalSourceByCode('FAMILY_CODE_KZ'), 'Одна треть дохода');
        ensureStatutoryValue(statutoryParameterByCode('ALIMONY_THREE_CHILD_RATE'), 2026_01_01, NULL,
            50.000000, legalSourceByCode('FAMILY_CODE_KZ'), 'Половина дохода');
        // Persist the complete draft first; approval makes all its values immutable.
        APPLY;
        IF packStatus(regulatoryPackByCode('KZ-2026.1')) == RegulatoryPackStatus.draft THEN {
            regulatoryPackLifecycleTransition(regulatoryPackByCode('KZ-2026.1')) <- TRUE;
            packStatus(regulatoryPackByCode('KZ-2026.1')) <- RegulatoryPackStatus.approved;
            packApprovedAt(regulatoryPackByCode('KZ-2026.1')) <- currentDateTime();
        }
        APPLY;
    }
}

