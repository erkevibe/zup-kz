MODULE TaxesKZSocialPayments;

REQUIRE PayrollAssessmentBase;
NAMESPACE ZUPKZ;

// Освобождения хранятся с периодом действия: одна категория может влиять
// на разные платежи по-разному и изменяться со временем.
CLASS SocialPaymentProfile 'Профиль социальных платежей';

socialProfileOrganization 'Организация' = DATA Organization (SocialPaymentProfile);
socialProfileEmployee 'Сотрудник' = DATA Employee (SocialPaymentProfile);
socialProfileValidFrom 'Действует с' = DATA DATE (SocialPaymentProfile);
socialProfileValidTo 'Действует по' = DATA DATE (SocialPaymentProfile);
socialProfileOpvExempt 'Освобождён от ОПВ' = DATA BOOLEAN (SocialPaymentProfile);
socialProfileOpvrExempt 'Освобождён от ОПВР' = DATA BOOLEAN (SocialPaymentProfile);
socialProfileSoExempt 'Освобождён от СО' = DATA BOOLEAN (SocialPaymentProfile);
socialProfileVosmsExempt 'Освобождён от ВОСМС' = DATA BOOLEAN (SocialPaymentProfile);
socialProfileOosmsExempt 'Освобождён от ООСМС' = DATA BOOLEAN (SocialPaymentProfile);
socialProfileBasis 'Основание льготы' = DATA STRING[500] (SocialPaymentProfile);
socialProfileLegalSource 'Нормативное основание' = DATA LegalSource (SocialPaymentProfile);

CONSTRAINT socialProfileValidTo(SocialPaymentProfile p) < socialProfileValidFrom(p)
    MESSAGE 'Окончание профиля не может быть раньше начала';
overlappingSocialProfileCount(SocialPaymentProfile p) = GROUP SUM 1 IF
    socialProfileOrganization(SocialPaymentProfile other) == socialProfileOrganization(p) AND
    socialProfileEmployee(other) == socialProfileEmployee(p) AND
    socialProfileValidFrom(other) <=
        (IF socialProfileValidTo(p) THEN socialProfileValidTo(p) ELSE 9999_12_31) AND
    (IF socialProfileValidTo(other) THEN socialProfileValidTo(other) ELSE 9999_12_31) >=
        socialProfileValidFrom(p);
CONSTRAINT socialProfileOrganization(SocialPaymentProfile p) AND socialProfileEmployee(p) AND
           socialProfileValidFrom(p) AND overlappingSocialProfileCount(p) > 1
    MESSAGE 'Периоды профилей социальных платежей сотрудника не должны пересекаться';

socialPaymentProfileOn(Organization organization, Employee worker, DATE date) =
    GROUP LAST SocialPaymentProfile p
    IF socialProfileOrganization(p) == organization AND socialProfileEmployee(p) == worker AND
       socialProfileValidFrom(p) <= date AND
       (NOT socialProfileValidTo(p) OR socialProfileValidTo(p) >= date)
    ORDER socialProfileValidFrom(p), p;

socialCappedBase(NUMERIC[18,2] income, NUMERIC[18,2] maximum) =
    IF income > maximum THEN maximum ELSE income IF income > 0.00;
socialBoundedBase(NUMERIC[18,2] income, NUMERIC[18,2] minimum, NUMERIC[18,2] maximum) =
    IF income > maximum THEN maximum ELSE IF income < minimum THEN minimum ELSE income
    IF income > 0.00;
socialPaymentAmount(NUMERIC[18,2] base, NUMERIC[18,6] rate) =
    ROUND(base * rate / 100.000000, 2) IF base > 0.00 AND rate > 0.000000;

CLASS SocialPaymentStatus 'Статус социальных платежей' {
    draft 'Черновик',
    calculated 'Рассчитан',
    approved 'Утверждён',
    cancelled 'Отменён'
}

CLASS SocialPaymentDocument 'Расчёт социальных платежей';

socialPaymentPayrollRun 'Расчёт зарплаты' = DATA PayrollRun (SocialPaymentDocument);
socialPaymentStatus 'Статус' = DATA SocialPaymentStatus (SocialPaymentDocument);
socialPaymentCalculatedAt 'Рассчитан' = DATA DATETIME (SocialPaymentDocument);

CLASS SocialPaymentLine 'Социальные платежи сотрудника';

socialPaymentDocument 'Документ' = DATA SocialPaymentDocument (SocialPaymentLine);
socialPaymentEmployee 'Сотрудник' = DATA Employee (SocialPaymentLine);

// Все входы и результаты сохраняются снимком. Изменение ставок, состава базы
// или профиля льгот не должно менять уже рассчитанный документ.
socialPaymentMZP 'МЗП' = DATA NUMERIC[18,2] (SocialPaymentLine);
opvGrossBase 'Доход для ОПВ' = DATA NUMERIC[18,2] (SocialPaymentLine);
opvMaximum 'Предел базы ОПВ' = DATA NUMERIC[18,2] (SocialPaymentLine);
opvRate 'Ставка ОПВ' = DATA NUMERIC[18,6] (SocialPaymentLine);
opvExempt 'Освобождение от ОПВ' = DATA BOOLEAN (SocialPaymentLine);
opvBase 'База ОПВ' = DATA NUMERIC[18,2] (SocialPaymentLine);
opvAmount 'ОПВ' = DATA NUMERIC[18,2] (SocialPaymentLine);
opvrGrossBase 'Доход для ОПВР' = DATA NUMERIC[18,2] (SocialPaymentLine);
opvrMinimum 'Минимальная база ОПВР' = DATA NUMERIC[18,2] (SocialPaymentLine);
opvrMaximum 'Максимальная база ОПВР' = DATA NUMERIC[18,2] (SocialPaymentLine);
opvrRate 'Ставка ОПВР' = DATA NUMERIC[18,6] (SocialPaymentLine);
opvrExempt 'Освобождение от ОПВР' = DATA BOOLEAN (SocialPaymentLine);
opvrBase 'База ОПВР' = DATA NUMERIC[18,2] (SocialPaymentLine);
opvrAmount 'ОПВР' = DATA NUMERIC[18,2] (SocialPaymentLine);
soGrossBase 'Доход для СО' = DATA NUMERIC[18,2] (SocialPaymentLine);
soIncomeAfterOpv 'Доход после ОПВ' = DATA NUMERIC[18,2] (SocialPaymentLine);
soMinimum 'Минимальная база СО' = DATA NUMERIC[18,2] (SocialPaymentLine);
soMaximum 'Максимальная база СО' = DATA NUMERIC[18,2] (SocialPaymentLine);
soRate 'Ставка СО' = DATA NUMERIC[18,6] (SocialPaymentLine);
soExempt 'Освобождение от СО' = DATA BOOLEAN (SocialPaymentLine);
soBase 'База СО' = DATA NUMERIC[18,2] (SocialPaymentLine);
soAmount 'Социальные отчисления' = DATA NUMERIC[18,2] (SocialPaymentLine);
vosmsGrossBase 'Доход для ВОСМС' = DATA NUMERIC[18,2] (SocialPaymentLine);
vosmsMaximum 'Предел базы ВОСМС' = DATA NUMERIC[18,2] (SocialPaymentLine);
vosmsRate 'Ставка ВОСМС' = DATA NUMERIC[18,6] (SocialPaymentLine);
vosmsExempt 'Освобождение от ВОСМС' = DATA BOOLEAN (SocialPaymentLine);
vosmsBase 'База ВОСМС' = DATA NUMERIC[18,2] (SocialPaymentLine);
vosmsAmount 'ВОСМС' = DATA NUMERIC[18,2] (SocialPaymentLine);
oosmsGrossBase 'Доход для ООСМС' = DATA NUMERIC[18,2] (SocialPaymentLine);
oosmsMaximum 'Предел базы ООСМС' = DATA NUMERIC[18,2] (SocialPaymentLine);
oosmsRate 'Ставка ООСМС' = DATA NUMERIC[18,6] (SocialPaymentLine);
oosmsExempt 'Освобождение от ООСМС' = DATA BOOLEAN (SocialPaymentLine);
oosmsBase 'База ООСМС' = DATA NUMERIC[18,2] (SocialPaymentLine);
oosmsAmount 'ООСМС' = DATA NUMERIC[18,2] (SocialPaymentLine);

socialPaymentRun(SocialPaymentLine l) = socialPaymentPayrollRun(socialPaymentDocument(l));
socialPaymentDate(SocialPaymentLine l) = payrollPeriodTo(socialPaymentRun(l));
socialPaymentOrganization(SocialPaymentLine l) = payrollOrganization(socialPaymentRun(l));
socialProfile(SocialPaymentLine l) =
    socialPaymentProfileOn(socialPaymentOrganization(l), socialPaymentEmployee(l), socialPaymentDate(l));
mzpOnSocialPaymentDate(SocialPaymentLine l) =
    numericStatutoryValueOn(statutoryParameterByCode('MZP'), socialPaymentDate(l));
socialParameter(SocialPaymentLine l, STRING[50] code) =
    numericStatutoryValueOn(statutoryParameterByCode(code), socialPaymentDate(l));

calculatedOpvGrossBase(SocialPaymentLine l) =
    payrollAssessmentBase(socialPaymentRun(l), socialPaymentEmployee(l), AssessmentBaseKind.opv);
calculatedOpvBase(SocialPaymentLine l) =
    socialCappedBase(calculatedOpvGrossBase(l), mzpOnSocialPaymentDate(l) * socialParameter(l, 'OPV_MAX_MZP'));
calculatedOpvAmount(SocialPaymentLine l) =
    IF socialProfileOpvExempt(socialProfile(l)) THEN 0.00
    ELSE socialPaymentAmount(calculatedOpvBase(l), socialParameter(l, 'OPV_RATE'));

calculatedOpvrGrossBase(SocialPaymentLine l) =
    payrollAssessmentBase(socialPaymentRun(l), socialPaymentEmployee(l), AssessmentBaseKind.opvr);
opvrBirthExempt(SocialPaymentLine l) = birthDate(socialPaymentEmployee(l)) <= 1975_01_01;
calculatedOpvrExempt(SocialPaymentLine l) =
    opvrBirthExempt(l) OR socialProfileOpvrExempt(socialProfile(l));
calculatedOpvrBase(SocialPaymentLine l) =
    socialBoundedBase(calculatedOpvrGrossBase(l),
        mzpOnSocialPaymentDate(l) * socialParameter(l, 'OPVR_MIN_MZP'),
        mzpOnSocialPaymentDate(l) * socialParameter(l, 'OPVR_MAX_MZP'));
calculatedOpvrAmount(SocialPaymentLine l) =
    IF calculatedOpvrExempt(l) THEN 0.00
    ELSE socialPaymentAmount(calculatedOpvrBase(l), socialParameter(l, 'OPVR_RATE'));

calculatedSoGrossBase(SocialPaymentLine l) =
    payrollAssessmentBase(socialPaymentRun(l), socialPaymentEmployee(l),
                          AssessmentBaseKind.socialContribution);
calculatedSoIncomeAfterOpv(SocialPaymentLine l) =
    calculatedSoGrossBase(l) - calculatedOpvAmount(l);
calculatedSoBase(SocialPaymentLine l) =
    socialBoundedBase(calculatedSoIncomeAfterOpv(l),
        mzpOnSocialPaymentDate(l) * socialParameter(l, 'SO_MIN_MZP'),
        mzpOnSocialPaymentDate(l) * socialParameter(l, 'SO_MAX_MZP'));
calculatedSoAmount(SocialPaymentLine l) =
    IF socialProfileSoExempt(socialProfile(l)) THEN 0.00
    ELSE socialPaymentAmount(calculatedSoBase(l), socialParameter(l, 'SO_RATE'));

calculatedVosmsGrossBase(SocialPaymentLine l) =
    payrollAssessmentBase(socialPaymentRun(l), socialPaymentEmployee(l), AssessmentBaseKind.employeeOsms);
calculatedVosmsBase(SocialPaymentLine l) =
    socialCappedBase(calculatedVosmsGrossBase(l),
        mzpOnSocialPaymentDate(l) * socialParameter(l, 'VOSMS_MAX_MZP'));
calculatedVosmsAmount(SocialPaymentLine l) =
    IF socialProfileVosmsExempt(socialProfile(l)) THEN 0.00
    ELSE socialPaymentAmount(calculatedVosmsBase(l), socialParameter(l, 'VOSMS_RATE'));

calculatedOosmsGrossBase(SocialPaymentLine l) =
    payrollAssessmentBase(socialPaymentRun(l), socialPaymentEmployee(l), AssessmentBaseKind.employerOsms);
calculatedOosmsBase(SocialPaymentLine l) =
    socialCappedBase(calculatedOosmsGrossBase(l),
        mzpOnSocialPaymentDate(l) * socialParameter(l, 'OOSMS_MAX_MZP'));
calculatedOosmsAmount(SocialPaymentLine l) =
    IF socialProfileOosmsExempt(socialProfile(l)) THEN 0.00
    ELSE socialPaymentAmount(calculatedOosmsBase(l), socialParameter(l, 'OOSMS_RATE'));

employeeSocialWithholding 'Удержания сотрудника' (SocialPaymentLine l) =
    (IF opvAmount(l) THEN opvAmount(l) ELSE 0.00) +
    (IF vosmsAmount(l) THEN vosmsAmount(l) ELSE 0.00);
employerSocialCharge 'Платежи работодателя' (SocialPaymentLine l) =
    (IF opvrAmount(l) THEN opvrAmount(l) ELSE 0.00) +
    (IF soAmount(l) THEN soAmount(l) ELSE 0.00) +
    (IF oosmsAmount(l) THEN oosmsAmount(l) ELSE 0.00);

payrollEmployeeLineCount(PayrollRun run, Employee worker) = GROUP SUM 1
    IF linePayrollRun(PayrollLine l) == run AND
       employee(employment(linePayrollAssignment(l))) == worker;
missingSocialPaymentBirthDateCount(PayrollRun run) = GROUP SUM 1
    IF linePayrollRun(PayrollLine l) == run AND
       NOT birthDate(employee(employment(linePayrollAssignment(l))));
socialPaymentLineCount(SocialPaymentDocument d, Employee worker) = GROUP SUM 1 IF
    socialPaymentDocument(SocialPaymentLine l) == d AND socialPaymentEmployee(l) == worker;
CONSTRAINT socialPaymentLineCount(SocialPaymentDocument d, Employee worker) > 1
    MESSAGE 'В документе социальных платежей сотрудник может присутствовать только один раз';

CONSTRAINT CHANGED(socialPaymentPayrollRun(SocialPaymentDocument d)) AND
           PREV(socialPaymentStatus(d)) != SocialPaymentStatus.draft
    MESSAGE 'Нельзя изменить расчёт зарплаты проведённого документа социальных платежей';
CONSTRAINT DROPPED(SocialPaymentLine l IS SocialPaymentLine) AND
           PREV(socialPaymentStatus(socialPaymentDocument(l))) != SocialPaymentStatus.draft
    MESSAGE 'Нельзя удалить строку проведённого документа социальных платежей';
CONSTRAINT (CHANGED(socialPaymentDocument(SocialPaymentLine l)) OR
            CHANGED(socialPaymentEmployee(l)) OR CHANGED(socialPaymentMZP(l)) OR
            CHANGED(opvGrossBase(l)) OR CHANGED(opvMaximum(l)) OR CHANGED(opvRate(l)) OR
            CHANGED(opvExempt(l)) OR CHANGED(opvBase(l)) OR CHANGED(opvAmount(l)) OR
            CHANGED(opvrGrossBase(l)) OR CHANGED(opvrMinimum(l)) OR CHANGED(opvrMaximum(l)) OR
            CHANGED(opvrRate(l)) OR CHANGED(opvrExempt(l)) OR
            CHANGED(opvrBase(l)) OR CHANGED(opvrAmount(l)) OR
            CHANGED(soGrossBase(l)) OR CHANGED(soIncomeAfterOpv(l)) OR
            CHANGED(soMinimum(l)) OR CHANGED(soMaximum(l)) OR CHANGED(soRate(l)) OR
            CHANGED(soExempt(l)) OR CHANGED(soBase(l)) OR CHANGED(soAmount(l)) OR
            CHANGED(vosmsGrossBase(l)) OR CHANGED(vosmsMaximum(l)) OR CHANGED(vosmsRate(l)) OR
            CHANGED(vosmsExempt(l)) OR CHANGED(vosmsBase(l)) OR CHANGED(vosmsAmount(l)) OR
            CHANGED(oosmsGrossBase(l)) OR CHANGED(oosmsMaximum(l)) OR CHANGED(oosmsRate(l)) OR
            CHANGED(oosmsExempt(l)) OR CHANGED(oosmsBase(l)) OR CHANGED(oosmsAmount(l))) AND
           (PREV(socialPaymentStatus(socialPaymentDocument(l))) == SocialPaymentStatus.calculated OR
            PREV(socialPaymentStatus(socialPaymentDocument(l))) == SocialPaymentStatus.approved OR
            PREV(socialPaymentStatus(socialPaymentDocument(l))) == SocialPaymentStatus.cancelled)
    MESSAGE 'Нельзя изменить снимок рассчитанных социальных платежей';

calculateSocialPayments 'Рассчитать' (SocialPaymentDocument d) {
    IF socialPaymentStatus(d) AND socialPaymentStatus(d) != SocialPaymentStatus.draft THEN
        MESSAGE 'Социальные платежи уже рассчитаны';
    ELSE IF NOT socialPaymentPayrollRun(d) OR
            payrollRunStatus(socialPaymentPayrollRun(d)) != PayrollRunStatus.calculated THEN
        MESSAGE 'Выберите рассчитанную зарплату';
    ELSE IF missingSocialPaymentBirthDateCount(socialPaymentPayrollRun(d)) THEN
        MESSAGE 'Заполните даты рождения сотрудников для определения ОПВР';
    ELSE {
        FOR worker IS Employee AND payrollEmployeeLineCount(socialPaymentPayrollRun(d), worker) DO {
            NEW l = SocialPaymentLine {
                socialPaymentDocument(l) <- d;
                socialPaymentEmployee(l) <- worker;
                socialPaymentMZP(l) <- mzpOnSocialPaymentDate(l);
                opvGrossBase(l) <- calculatedOpvGrossBase(l);
                opvMaximum(l) <- mzpOnSocialPaymentDate(l) * socialParameter(l, 'OPV_MAX_MZP');
                opvRate(l) <- socialParameter(l, 'OPV_RATE');
                opvExempt(l) <- socialProfileOpvExempt(socialProfile(l));
                opvBase(l) <- calculatedOpvBase(l);
                opvAmount(l) <- calculatedOpvAmount(l);
                opvrGrossBase(l) <- calculatedOpvrGrossBase(l);
                opvrMinimum(l) <- mzpOnSocialPaymentDate(l) * socialParameter(l, 'OPVR_MIN_MZP');
                opvrMaximum(l) <- mzpOnSocialPaymentDate(l) * socialParameter(l, 'OPVR_MAX_MZP');
                opvrRate(l) <- socialParameter(l, 'OPVR_RATE');
                opvrExempt(l) <- calculatedOpvrExempt(l);
                opvrBase(l) <- calculatedOpvrBase(l);
                opvrAmount(l) <- calculatedOpvrAmount(l);
                soGrossBase(l) <- calculatedSoGrossBase(l);
                soIncomeAfterOpv(l) <- calculatedSoIncomeAfterOpv(l);
                soMinimum(l) <- mzpOnSocialPaymentDate(l) * socialParameter(l, 'SO_MIN_MZP');
                soMaximum(l) <- mzpOnSocialPaymentDate(l) * socialParameter(l, 'SO_MAX_MZP');
                soRate(l) <- socialParameter(l, 'SO_RATE');
                soExempt(l) <- socialProfileSoExempt(socialProfile(l));
                soBase(l) <- calculatedSoBase(l);
                soAmount(l) <- calculatedSoAmount(l);
                vosmsGrossBase(l) <- calculatedVosmsGrossBase(l);
                vosmsMaximum(l) <- mzpOnSocialPaymentDate(l) * socialParameter(l, 'VOSMS_MAX_MZP');
                vosmsRate(l) <- socialParameter(l, 'VOSMS_RATE');
                vosmsExempt(l) <- socialProfileVosmsExempt(socialProfile(l));
                vosmsBase(l) <- calculatedVosmsBase(l);
                vosmsAmount(l) <- calculatedVosmsAmount(l);
                oosmsGrossBase(l) <- calculatedOosmsGrossBase(l);
                oosmsMaximum(l) <- mzpOnSocialPaymentDate(l) * socialParameter(l, 'OOSMS_MAX_MZP');
                oosmsRate(l) <- socialParameter(l, 'OOSMS_RATE');
                oosmsExempt(l) <- socialProfileOosmsExempt(socialProfile(l));
                oosmsBase(l) <- calculatedOosmsBase(l);
                oosmsAmount(l) <- calculatedOosmsAmount(l);
            }
        }
        socialPaymentStatus(d) <- SocialPaymentStatus.calculated;
        socialPaymentCalculatedAt(d) <- currentDateTime();
        APPLY;
    }
}

cancelSocialPayments 'Отменить' (SocialPaymentDocument d) {
    IF socialPaymentStatus(d) != SocialPaymentStatus.calculated AND
       socialPaymentStatus(d) != SocialPaymentStatus.approved THEN
        MESSAGE 'Отменить можно только рассчитанный или утверждённый документ';
    ELSE IF payrollRunStatus(socialPaymentPayrollRun(d)) != PayrollRunStatus.calculated THEN
        MESSAGE 'Социальные платежи закрытого расчёта отменять нельзя';
    ELSE {
        socialPaymentStatus(d) <- SocialPaymentStatus.cancelled;
        APPLY;
    }
}

approveSocialPayments 'Утвердить' (SocialPaymentDocument d) {
    IF socialPaymentStatus(d) == SocialPaymentStatus.calculated THEN {
        socialPaymentStatus(d) <- SocialPaymentStatus.approved;
        APPLY;
    } ELSE
        MESSAGE 'Сначала рассчитайте социальные платежи';
}

totalOpv 'ОПВ' (SocialPaymentDocument d) = GROUP SUM opvAmount(SocialPaymentLine l)
    IF socialPaymentDocument(l) == d;
totalOpvr 'ОПВР' (SocialPaymentDocument d) = GROUP SUM opvrAmount(SocialPaymentLine l)
    IF socialPaymentDocument(l) == d;
totalSo 'СО' (SocialPaymentDocument d) = GROUP SUM soAmount(SocialPaymentLine l)
    IF socialPaymentDocument(l) == d;
totalVosms 'ВОСМС' (SocialPaymentDocument d) = GROUP SUM vosmsAmount(SocialPaymentLine l)
    IF socialPaymentDocument(l) == d;
totalOosms 'ООСМС' (SocialPaymentDocument d) = GROUP SUM oosmsAmount(SocialPaymentLine l)
    IF socialPaymentDocument(l) == d;
payableAfterSocialPayments 'К выплате до ИПН' (SocialPaymentDocument d) =
    totalPayable(socialPaymentPayrollRun(d)) -
    (IF totalOpv(d) THEN totalOpv(d) ELSE 0.00) -
    (IF totalVosms(d) THEN totalVosms(d) ELSE 0.00);

FORM socialPaymentProfiles 'Профили социальных платежей'
    OBJECTS p = SocialPaymentProfile
    PROPERTIES(p) socialProfileOrganization, socialProfileEmployee,
                  socialProfileValidFrom, socialProfileValidTo,
                  socialProfileOpvExempt, socialProfileOpvrExempt, socialProfileSoExempt,
                  socialProfileVosmsExempt, socialProfileOosmsExempt,
                  socialProfileBasis, socialProfileLegalSource
;

FORM socialPaymentDocuments 'Расчёт социальных платежей'
    OBJECTS d = SocialPaymentDocument
    PROPERTIES(d) socialPaymentPayrollRun, socialPaymentStatus, socialPaymentCalculatedAt,
                  totalOpv, totalOpvr, totalSo, totalVosms, totalOosms,
                  payableAfterSocialPayments
    PROPERTIES(d) calculateSocialPayments, approveSocialPayments, cancelSocialPayments
;

FORM socialPaymentLines 'Социальные платежи сотрудников'
    OBJECTS l = SocialPaymentLine
    PROPERTIES(l) socialPaymentDocument, socialPaymentEmployee,
                  socialPaymentMZP,
                  opvGrossBase, opvMaximum, opvRate, opvExempt, opvBase, opvAmount,
                  opvrGrossBase, opvrMinimum, opvrMaximum, opvrRate, opvrExempt, opvrBase, opvrAmount,
                  soGrossBase, soIncomeAfterOpv, soMinimum, soMaximum, soRate, soExempt, soBase, soAmount,
                  vosmsGrossBase, vosmsMaximum, vosmsRate, vosmsExempt, vosmsBase, vosmsAmount,
                  oosmsGrossBase, oosmsMaximum, oosmsRate, oosmsExempt, oosmsBase, oosmsAmount,
                  employeeSocialWithholding, employerSocialCharge
;
