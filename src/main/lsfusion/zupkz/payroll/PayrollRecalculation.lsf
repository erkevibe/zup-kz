MODULE PayrollRecalculation;

REQUIRE PayrollCore;
NAMESPACE ZUPKZ;

CLASS PayrollRecalculationStatus 'Статус перерасчёта' {
    draft 'Черновик',
    calculated 'Рассчитан',
    approved 'Утверждён'
}

CLASS PayrollRecalculation 'Перерасчёт зарплаты';

recalculationNumber 'Номер' = DATA STRING[50] (PayrollRecalculation);
recalculationDate 'Дата' = DATA DATE (PayrollRecalculation);
recalculationOriginalRun 'Исходный расчёт' = DATA PayrollRun (PayrollRecalculation);
recalculationTargetRun 'Расчёт регистрации' = DATA PayrollRun (PayrollRecalculation);
recalculationReason 'Причина' = DATA STRING[500] (PayrollRecalculation);
recalculationStatus 'Статус' = DATA PayrollRecalculationStatus (PayrollRecalculation);
recalculationCalculatedAt 'Рассчитан' = DATA DATETIME (PayrollRecalculation);
recalculationLifecycleTransition = DATA LOCAL BOOLEAN (PayrollRecalculation);

CONSTRAINT CHANGED(recalculationStatus(PayrollRecalculation d)) AND
           PREV(recalculationStatus(d)) AND NOT recalculationLifecycleTransition(d)
    MESSAGE 'Статус перерасчёта изменяется только штатными действиями';

CLASS PayrollRecalculationLine 'Строка перерасчёта';

lineRecalculation 'Перерасчёт' = DATA PayrollRecalculation (PayrollRecalculationLine);
lineOriginalPayrollLine 'Исходная строка' = DATA PayrollLine (PayrollRecalculationLine);
lineOriginalAmount 'Исходная сумма' = DATA NUMERIC[18,2] (PayrollRecalculationLine);
lineCorrectedAmount 'Исправленная сумма' = DATA NUMERIC[18,2] (PayrollRecalculationLine);
lineRecalculationNote 'Комментарий' = DATA STRING[500] (PayrollRecalculationLine);
lineRecalculationInput 'Строка регистрации' = DATA PayrollInput (PayrollRecalculationLine);
registeredRecalculationLine(PayrollInput i) = GROUP LAST PayrollRecalculationLine l
    IF lineRecalculationInput(l) == i ORDER l;

payrollRecalculationDelta(NUMERIC[18,2] originalAmount, NUMERIC[18,2] correctedAmount) =
    ROUND(correctedAmount - originalAmount, 2) IF originalAmount AND correctedAmount;
lineRecalculationDelta 'Разница' (PayrollRecalculationLine l) =
    payrollRecalculationDelta(lineOriginalAmount(l), lineCorrectedAmount(l));
totalRecalculationDelta 'Итого перерасчёта' (PayrollRecalculation d) =
    GROUP SUM lineRecalculationDelta(PayrollRecalculationLine l) IF lineRecalculation(l) == d;
recalculationLineCount(PayrollRecalculation d) = GROUP SUM 1
    IF lineRecalculation(PayrollRecalculationLine l) == d;
invalidRecalculationLineCount(PayrollRecalculation d) = GROUP SUM 1
    IF lineRecalculation(PayrollRecalculationLine l) == d AND
       (NOT lineOriginalAmount(l) OR NOT lineCorrectedAmount(l) OR
        lineOriginalAmount(l) == lineCorrectedAmount(l));

CONSTRAINT lineOriginalPayrollLine(PayrollRecalculationLine l) AND
           linePayrollRun(lineOriginalPayrollLine(l)) !=
           recalculationOriginalRun(lineRecalculation(l))
    MESSAGE 'Исходная строка должна принадлежать выбранному расчёту';
CONSTRAINT recalculationOriginalRun(PayrollRecalculation d) AND recalculationTargetRun(d) AND
           payrollOrganization(recalculationOriginalRun(d)) != payrollOrganization(recalculationTargetRun(d))
    MESSAGE 'Исходный и регистрирующий расчёты должны принадлежать одной организации';
CONSTRAINT recalculationOriginalRun(PayrollRecalculation d) == recalculationTargetRun(d)
    MESSAGE 'Перерасчёт должен регистрироваться в другом расчётном периоде';
CONSTRAINT recalculationOriginalRun(PayrollRecalculation d) AND recalculationTargetRun(d) AND
           payrollPeriodFrom(recalculationTargetRun(d)) <= payrollPeriodTo(recalculationOriginalRun(d))
    MESSAGE 'Перерасчёт должен регистрироваться в более позднем расчётном периоде';
CONSTRAINT (CHANGED(recalculationDate(PayrollRecalculation d)) OR
            CHANGED(recalculationOriginalRun(d)) OR CHANGED(recalculationTargetRun(d)) OR
            CHANGED(recalculationReason(d))) AND
           PREV(recalculationStatus(d)) != PayrollRecalculationStatus.draft
    MESSAGE 'Нельзя изменить рассчитанный документ перерасчёта';
CONSTRAINT (CHANGED(lineRecalculation(PayrollRecalculationLine l)) OR
            CHANGED(lineOriginalPayrollLine(l)) OR CHANGED(lineOriginalAmount(l)) OR
            CHANGED(lineCorrectedAmount(l)) OR CHANGED(lineRecalculationNote(l))) AND
           PREV(recalculationStatus(lineRecalculation(l))) != PayrollRecalculationStatus.draft
    MESSAGE 'Нельзя изменить строку рассчитанного перерасчёта';
CONSTRAINT DROPPED(PayrollRecalculationLine l IS PayrollRecalculationLine) AND
           PREV(recalculationStatus(lineRecalculation(l))) != PayrollRecalculationStatus.draft
    MESSAGE 'Нельзя удалить строку рассчитанного перерасчёта';
CONSTRAINT CHANGED(lineRecalculationInput(PayrollRecalculationLine l)) AND
           PREV(lineRecalculation(l)) AND
           NOT recalculationLifecycleTransition(lineRecalculation(l))
    MESSAGE 'Строка регистрации создаётся только штатным действием перерасчёта';
CONSTRAINT (CHANGED(inputPayrollRun(PayrollInput i)) OR CHANGED(inputAssignment(i)) OR
            CHANGED(inputCalculationType(i)) OR CHANGED(inputBase(i)) OR
            CHANGED(inputPercent(i)) OR CHANGED(inputManualAmount(i)) OR
            CHANGED(inputBasis(i))) AND PREV(registeredRecalculationLine(i))
    MESSAGE 'Нельзя изменить зарегистрированную строку перерасчёта';
CONSTRAINT DROPPED(PayrollInput i IS PayrollInput) AND PREV(registeredRecalculationLine(i))
    MESSAGE 'Нельзя удалить зарегистрированную строку перерасчёта';

captureOriginalAmount 'Заполнить исходную сумму' (PayrollRecalculationLine l) {
    IF lineOriginalPayrollLine(l) THEN
        lineOriginalAmount(l) <- calculationAmount(lineOriginalPayrollLine(l));
}

calculateRecalculation 'Рассчитать перерасчёт' (PayrollRecalculation d) {
    IF recalculationStatus(d) != PayrollRecalculationStatus.draft THEN
        MESSAGE 'Документ уже рассчитан';
    ELSE IF NOT recalculationOriginalRun(d) OR NOT recalculationTargetRun(d) OR
            NOT recalculationDate(d) OR NOT recalculationReason(d) THEN
        MESSAGE 'Заполните исходный расчёт, расчёт регистрации, дату и причину';
    ELSE IF payrollRunStatus(recalculationOriginalRun(d)) != PayrollRunStatus.approved AND
            payrollRunStatus(recalculationOriginalRun(d)) != PayrollRunStatus.paid THEN
        MESSAGE 'Перерасчитывать можно только закрытый расчёт зарплаты';
    ELSE IF payrollRunStatus(recalculationTargetRun(d)) != PayrollRunStatus.draft AND
            payrollRunStatus(recalculationTargetRun(d)) != PayrollRunStatus.timeCollected THEN
        MESSAGE 'Расчёт регистрации уже рассчитан';
    ELSE IF payrollPeriodFrom(recalculationTargetRun(d)) <=
            payrollPeriodTo(recalculationOriginalRun(d)) THEN
        MESSAGE 'Выберите более поздний расчётный период для регистрации';
    ELSE IF NOT recalculationLineCount(d) OR invalidRecalculationLineCount(d) THEN
        MESSAGE 'Заполните исходные и исправленные суммы';
    ELSE {
        recalculationLifecycleTransition(d) <- TRUE;
        recalculationStatus(d) <- PayrollRecalculationStatus.calculated;
        recalculationCalculatedAt(d) <- currentDateTime();
        APPLY;
    }
}

postRecalculation 'Зарегистрировать в зарплате' (PayrollRecalculation d) {
    IF recalculationStatus(d) != PayrollRecalculationStatus.calculated THEN
        MESSAGE 'Сначала рассчитайте перерасчёт';
    ELSE IF payrollRunStatus(recalculationTargetRun(d)) != PayrollRunStatus.draft AND
            payrollRunStatus(recalculationTargetRun(d)) != PayrollRunStatus.timeCollected THEN
        MESSAGE 'Расчёт регистрации уже рассчитан';
    ELSE {
        recalculationLifecycleTransition(d) <- TRUE;
        FOR lineRecalculation(PayrollRecalculationLine l) == d AND
            lineRecalculationDelta(l) != 0.00 AND NOT lineRecalculationInput(l) DO {
            NEW i = PayrollInput {
                inputPayrollRun(i) <- recalculationTargetRun(d);
                inputAssignment(i) <- linePayrollAssignment(lineOriginalPayrollLine(l));
                inputCalculationType(i) <-
                    IF lineRecalculationDelta(l) > 0.00 THEN calculationTypeByCode('RECALC_ACCRUAL')
                    ELSE calculationTypeByCode('RECALC_DEDUCTION');
                inputManualAmount(i) <- IF lineRecalculationDelta(l) > 0.00 THEN
                    lineRecalculationDelta(l) ELSE -lineRecalculationDelta(l);
                inputBasis(i) <- recalculationReason(d);
                lineRecalculationInput(l) <- i;
            }
        }
        recalculationStatus(d) <- PayrollRecalculationStatus.approved;
        APPLY;
    }
}

FORM payrollRecalculations 'Перерасчёты зарплаты'
    OBJECTS d = PayrollRecalculation
    PROPERTIES(d) recalculationNumber, recalculationDate, recalculationOriginalRun,
                  recalculationTargetRun,
                  recalculationReason, totalRecalculationDelta
    PROPERTIES(d) READONLY recalculationStatus, recalculationCalculatedAt
    PROPERTIES(d) calculateRecalculation, postRecalculation
;

FORM payrollRecalculationLines 'Строки перерасчёта'
    OBJECTS l = PayrollRecalculationLine
    PROPERTIES(l) lineRecalculation, lineOriginalPayrollLine, lineOriginalAmount,
                  lineCorrectedAmount, lineRecalculationDelta, lineRecalculationNote,
                  lineRecalculationInput
    PROPERTIES(l) captureOriginalAmount
;
