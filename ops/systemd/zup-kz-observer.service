[Unit]
Description=ZUP-KZ loss-aware log observer
After=network-online.target zup-kz.service zup-kz-web.service postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=zupobserver
Group=zupobserver
SupplementaryGroups=systemd-journal adm zupdev
EnvironmentFile=/etc/default/zup-observer
ExecStart=/usr/bin/python3 /opt/zup-observer/zup_observer.py run --config ${ZUP_OBSERVER_CONFIG}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077
ReadWritePaths=/var/lib/zup-observer

[Install]
WantedBy=multi-user.target
