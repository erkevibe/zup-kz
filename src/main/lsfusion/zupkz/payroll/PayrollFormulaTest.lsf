MODULE PayrollFormulaTest;

REQUIRE ZUPKZ;
NAMESPACE ZUPKZ;

// Headless smoke-test endpoint. The production top module does not require this module.
payrollFormulaTest() {
    NEW org = Organization {
        NEW worker = Employee {
            birthDate(worker) <- 1990_01_01;
            NEW contract = Employment {
                employee(contract) <- worker;
                organization(contract) <- org;
                salary(contract) <- 100000.00;
                NEW assignment = EmploymentAssignment {
                    employment(assignment) <- contract;
                    assignmentFrom(assignment) <- 2026_01_01;
                    assignmentSalary(assignment) <- 100000.00;
                    NEW run = PayrollRun {
                        payrollOrganization(run) <- org;
                        payrollPeriodFrom(run) <- 2026_01_01;
                        payrollPeriodTo(run) <- 2026_01_31;
                        payrollPaymentDueDate(run) <- 2026_02_10;
                        payrollRunStatus(run) <- PayrollRunStatus.timeCollected;
                        NEW summary = PayrollTimeSummary {
                            summaryPayrollRun(summary) <- run;
                            summaryAssignment(summary) <- assignment;
                            summaryPlannedHours(summary) <- 168.00;
                            summaryWorkedHours(summary) <- 186.00;
                            summaryWorkedDays(summary) <- 23.00;
                            summaryNightHours(summary) <- 8.00;
                            summaryOvertimeHours(summary) <- 10.00;
                            summaryHolidayHours(summary) <- 8.00;
                            NEW bonusInput = PayrollInput {
                                inputPayrollRun(bonusInput) <- run;
                                inputAssignment(bonusInput) <- assignment;
                                inputCalculationType(bonusInput) <- calculationTypeByCode('FIXED_BONUS');
                                inputManualAmount(bonusInput) <- 20000.00;
                                inputBasis(bonusInput) <- 'Тестовая премия';
                                NEW allowanceInput = PayrollInput {
                                    inputPayrollRun(allowanceInput) <- run;
                                    inputAssignment(allowanceInput) <- assignment;
                                    inputCalculationType(allowanceInput) <- calculationTypeByCode('PERCENT_ALLOWANCE');
                                    inputBase(allowanceInput) <- 100000.00;
                                    inputPercent(allowanceInput) <- 10.000000;
                                    inputBasis(allowanceInput) <- 'Тестовая надбавка';
                                    NEW deductionInput = PayrollInput {
                                        inputPayrollRun(deductionInput) <- run;
                                        inputAssignment(deductionInput) <- assignment;
                                        inputCalculationType(deductionInput) <- calculationTypeByCode('OTHER_DEDUCTION');
                                        inputManualAmount(deductionInput) <- 5000.00;
                                        inputBasis(deductionInput) <- 'Тестовое удержание';
                                        NEW unclassifiedInput = PayrollInput {
                                            inputPayrollRun(unclassifiedInput) <- run;
                                            inputAssignment(unclassifiedInput) <- assignment;
                                            inputCalculationType(unclassifiedInput) <- calculationTypeByCode('OTHER_ACCRUAL');
                                            inputManualAmount(unclassifiedInput) <- 7000.00;
                                            inputBasis(unclassifiedInput) <- 'Неклассифицированное начисление';
                                            calculatePayroll(run);

                                            NEW taxProfile = EmployeeTaxProfile {
                                                taxProfileOrganization(taxProfile) <- org;
                                                taxProfileEmployee(taxProfile) <- worker;
                                                taxProfileValidFrom(taxProfile) <- 2026_01_01;
                                                taxProfileResident(taxProfile) <- TRUE;
                                                taxProfileBasicDeduction(taxProfile) <- TRUE;
                                                taxProfileSocialDeduction(taxProfile) <- IpnSocialDeductionKind.none;

                                                NEW socialPayments = SocialPaymentDocument {
                                                    socialPaymentPayrollRun(socialPayments) <- run;
                                                    calculateSocialPayments(socialPayments);

                                                    NEW taxes = TaxCalculationDocument {
                                                        taxCalculationPayrollRun(taxes) <- run;
                                                        taxCalculationSocialPayments(taxes) <- socialPayments;
                                                        calculateTaxes(taxes);

                                                        NEW alimonyOrder = EnforcementOrder {
                                                            enforcementOrganization(alimonyOrder) <- org;
                                                            enforcementEmployee(alimonyOrder) <- worker;
                                                            enforcementKind(alimonyOrder) <- EnforcementOrderKind.alimony;
                                                            enforcementCalculationKind(alimonyOrder) <- EnforcementCalculationKind.incomeShare;
                                                            enforcementStatus(alimonyOrder) <- EnforcementOrderStatus.active;
                                                            enforcementValidFrom(alimonyOrder) <- 2026_01_01;
                                                            enforcementPriority(alimonyOrder) <- 1;
                                                            enforcementChildCount(alimonyOrder) <- 1;

                                                            NEW damageOrder = EnforcementOrder {
                                                                enforcementOrganization(damageOrder) <- org;
                                                                enforcementEmployee(damageOrder) <- worker;
                                                                enforcementKind(damageOrder) <- EnforcementOrderKind.healthOrSurvivorDamage;
                                                                enforcementCalculationKind(damageOrder) <- EnforcementCalculationKind.fixedAmount;
                                                                enforcementStatus(damageOrder) <- EnforcementOrderStatus.active;
                                                                enforcementValidFrom(damageOrder) <- 2026_01_01;
                                                                enforcementPriority(damageOrder) <- 1;
                                                                enforcementFixedAmount(damageOrder) <- 50000.00;

                                                                NEW otherOrder = EnforcementOrder {
                                                                    enforcementOrganization(otherOrder) <- org;
                                                                    enforcementEmployee(otherOrder) <- worker;
                                                                    enforcementKind(otherOrder) <- EnforcementOrderKind.other;
                                                                    enforcementCalculationKind(otherOrder) <- EnforcementCalculationKind.fixedAmount;
                                                                    enforcementStatus(otherOrder) <- EnforcementOrderStatus.active;
                                                                    enforcementValidFrom(otherOrder) <- 2026_01_01;
                                                                    enforcementPriority(otherOrder) <- 5;
                                                                    enforcementFixedAmount(otherOrder) <- 10000.00;

                                                                    NEW enforcement = EnforcementCalculationDocument {
                                                                        enforcementTaxCalculation(enforcement) <- taxes;
                                                                        calculateEnforcement(enforcement);
                                                                        approveSocialPayments(socialPayments);
                                                                        approveTaxes(taxes);
                                                                        approveEnforcement(enforcement);
                                                                        closePayroll(run);

                                                                        NEW payment = PaymentStatement {
                                                                            paymentStatementPayrollRun(payment) <- run;
                                                                            paymentStatementNumber(payment) <- 'PAY-2026-01';
                                                                            paymentStatementDate(payment) <- 2026_02_11;
                                                                            paymentStatementMethod(payment) <- PaymentMethod.bankTransfer;
                                                                            calculatePaymentStatement(payment);
                                                                            approvePaymentStatement(payment);
                                                                            markPaymentStatementPaid(payment);

                            NEW sickAverage = AverageEarningsDocument {
                                averageAssignment(sickAverage) <- assignment;
                                averageEventKind(sickAverage) <- AverageEarningsEventKind.sickLeave;
                                averageMode(sickAverage) <- AverageEarningsMode.daily;
                                averageStatus(sickAverage) <- AverageEarningsStatus.calculated;
                                NEW sickAverageBase = AverageEarningsBaseLine {
                                    baseAverageDocument(sickAverageBase) <- sickAverage;
                                    baseEarnings(sickAverageBase) <- 1230000.00;
                                    baseWorkedDays(sickAverageBase) <- 246.00;
                                    baseIncreaseCoefficient(sickAverageBase) <- 1.000000;
                                    baseIncluded(sickAverageBase) <- TRUE;

                                    NEW ordinarySick = SickLeaveDocument {
                                        sickLeaveAssignment(ordinarySick) <- assignment;
                                        sickLeaveFrom(ordinarySick) <- 2026_01_15;
                                        sickLeaveTo(ordinarySick) <- 2026_02_10;
                                        sickLeaveReason(ordinarySick) <- SickLeaveReason.illness;
                                        sickLeaveAverage(ordinarySick) <- sickAverage;
                                        NEW januarySick = SickLeaveBenefitLine {
                                            sickBenefitDocument(januarySick) <- ordinarySick;
                                            sickBenefitMonth(januarySick) <- 2026_01_15;
                                            sickBenefitWorkDays(januarySick) <- 30.00;
                                            NEW februarySick = SickLeaveBenefitLine {
                                                sickBenefitDocument(februarySick) <- ordinarySick;
                                                sickBenefitMonth(februarySick) <- 2026_02_01;
                                                sickBenefitWorkDays(februarySick) <- 10.00;

                                                NEW injurySick = SickLeaveDocument {
                                                    sickLeaveAssignment(injurySick) <- assignment;
                                                    sickLeaveFrom(injurySick) <- 2026_01_15;
                                                    sickLeaveTo(injurySick) <- 2026_01_31;
                                                    sickLeaveReason(injurySick) <- SickLeaveReason.workInjury;
                                                    sickLeaveProductionActNumber(injurySick) <- 'N-1';
                                                    sickLeaveAverage(injurySick) <- sickAverage;
                                                    NEW injuryLine = SickLeaveBenefitLine {
                                                        sickBenefitDocument(injuryLine) <- injurySick;
                                                        sickBenefitMonth(injuryLine) <- 2026_01_15;
                                                        sickBenefitWorkDays(injuryLine) <- 30.00;

                                                        NEW excludedSick = SickLeaveDocument {
                                                            sickLeaveAssignment(excludedSick) <- assignment;
                                                            sickLeaveFrom(excludedSick) <- 2026_01_15;
                                                            sickLeaveTo(excludedSick) <- 2026_01_31;
                                                            sickLeaveReason(excludedSick) <- SickLeaveReason.illness;
                                                            sickLeaveExclusionReason(excludedSick) <-
                                                                SickLeaveExclusionReason.unpaidLeave;
                                                            sickLeaveAverage(excludedSick) <- sickAverage;
                                                            NEW excludedLine = SickLeaveBenefitLine {
                                                                sickBenefitDocument(excludedLine) <- excludedSick;
                                                                sickBenefitMonth(excludedLine) <- 2026_01_15;
                                                                sickBenefitWorkDays(excludedLine) <- 30.00;

                            EXPORT JSON FROM
                                fullMonth = salaryForWorkedHours(100000.00, 168.00, 168.00),
                                halfMonth = salaryForWorkedHours(100000.00, 168.00, 84.00),
                                nightAdditional = specialHoursAdditionalPay(100000.00, 168.00, 8.00, 1.500000),
                                overtimeAdditional = specialHoursAdditionalPay(100000.00, 168.00, 10.00, 1.500000),
                                holidayAdditional = specialHoursAdditionalPay(100000.00, 168.00, 8.00, 1.500000),
                                overtimeTotal = salaryForWorkedHours(100000.00, 168.00, 178.00) +
                                                specialHoursAdditionalPay(100000.00, 168.00, 10.00, 1.500000),
                                documentLineCount = payrollLineCount(run),
                                documentAccrued = totalAccrued(run),
                                documentDeducted = totalDeducted(run),
                                documentPayable = totalPayable(run),
                                fixedBonusAmount = inputAmount(bonusInput),
                                percentAllowanceAmount = inputAmount(allowanceInput),
                                manualDeductionAmount = inputAmount(deductionInput),
                                unclassifiedAccrualAmount = inputAmount(unclassifiedInput),
                                ipnAssessmentBase = payrollAssessmentBase(run, AssessmentBaseKind.ipn),
                                opvAssessmentBase = payrollAssessmentBase(run, AssessmentBaseKind.opv),
                                osmsAssessmentBase = payrollAssessmentBase(run, AssessmentBaseKind.employeeOsms),
                                opv2026 = totalOpv(socialPayments),
                                opvr2026 = totalOpvr(socialPayments),
                                socialContribution2026 = totalSo(socialPayments),
                                employeeOsms2026 = totalVosms(socialPayments),
                                employerOsms2026 = totalOosms(socialPayments),
                                payableBeforeIpn = payableAfterSocialPayments(socialPayments),
                                maximumOpv2026 = socialPaymentAmount(socialCappedBase(5000000.00, 4250000.00),
                                                                     10.000000),
                                maximumOpvr2026 = socialPaymentAmount(socialBoundedBase(5000000.00,
                                                                                        85000.00, 4250000.00),
                                                                      3.500000),
                                minimumOpvr2026 = socialPaymentAmount(socialBoundedBase(50000.00,
                                                                                        85000.00, 4250000.00),
                                                                      3.500000),
                                maximumSocialContribution2026 = socialPaymentAmount(
                                    socialBoundedBase(4575000.00, 85000.00, 595000.00), 5.000000),
                                minimumSocialContribution2026 = socialPaymentAmount(
                                    socialBoundedBase(45000.00, 85000.00, 595000.00), 5.000000),
                                maximumEmployeeOsms2026 = socialPaymentAmount(
                                    socialCappedBase(5000000.00, 1700000.00), 2.000000),
                                maximumEmployerOsms2026 = socialPaymentAmount(
                                    socialCappedBase(5000000.00, 3400000.00), 3.000000),
                                ipnBasicDeduction2026 = totalIpnBasicDeduction(taxes),
                                ipnTaxableIncome2026 = totalIpnTaxableIncome(taxes),
                                ipn2026 = totalIpn(taxes),
                                socialTax2026 = totalSocialTax(taxes),
                                finalPayable2026 = payableAfterTaxes(taxes),
                                progressiveIpnAboveThreshold = progressiveIpn(40000000.00, 36762500.00,
                                                                              10.000000, 15.000000),
                                progressiveIpnCrossingThreshold = progressiveIpn(36800000.00, 36762500.00,
                                                                                 10.000000, 15.000000) -
                                                                          progressiveIpn(36700000.00, 36762500.00,
                                                                                         10.000000, 15.000000),
                                annualBasicDeductionRemainder = taxMinimum(100000.00,
                                    taxPositive(1557000.00 - 1550000.00)),
                                agriculturalSocialTax = socialPaymentAmount(130638.09, 1.800000),
                                enforcementIncomeAfterTaxes2026 = enforcementIncomeAfterTaxes(
                                    enforcementLineByOrder(enforcement, alimonyOrder)),
                                defaultOneChildAlimonyPercent = effectiveEnforcementPercent(
                                    enforcementLineByOrder(enforcement, alimonyOrder)),
                                alimonyWithheld2026 = enforcementWithheldByOrder(enforcement, alimonyOrder),
                                damageWithheld2026 = enforcementWithheldByOrder(enforcement, damageOrder),
                                lowerPriorityWithheld2026 = enforcementWithheldByOrder(enforcement, otherOrder),
                                totalEnforcementWithheld2026 = totalEnforcementWithheld(enforcement),
                                payableAfterEnforcement2026 = payableAfterEnforcement(enforcement),
                                payslipAccrued2026 = settlementAccrued(
                                    settlementLineByEmployee(run, worker)),
                                payslipOpv2026 = settlementOpv(
                                    settlementLineByEmployee(run, worker)),
                                payslipVosms2026 = settlementVosms(
                                    settlementLineByEmployee(run, worker)),
                                payslipIpn2026 = settlementIpn(
                                    settlementLineByEmployee(run, worker)),
                                payslipEnforcement2026 = settlementEnforcement(
                                    settlementLineByEmployee(run, worker)),
                                payslipPayable2026 = settlementPayable(
                                    settlementLineByEmployee(run, worker)),
                                paymentStatementAmount2026 = totalPaymentStatementAmount(payment),
                                remainingAfterPayment2026 = remainingPayrollAmount(run),
                                unpaidAfterPayment2026 = unpaidPayrollAmount(run),
                                payrollMarkedPaid2026 = payrollRunStatus(run) == PayrollRunStatus.paid,
                                latePaymentDetected2026 = paymentStatementOverdue(payment),
                                latestPayrollPaymentDate2026 = latestPayrollPaymentDate(run),
                                ordinaryLowIncomeEnforcementCap = taxMinimum(
                                    socialPaymentAmount(80000.00, 50.000000),
                                    taxPositive(80000.00 - 50851.00)),
                                protectedLowIncomeEnforcementCap = taxMinimum(
                                    socialPaymentAmount(80000.00, 50.000000), 80000.00),
                                averageDaily = averageDailyEarnings(1200000.00, 246.00),
                                averageHourly = averageHourlyEarnings(1200000.00, 1968.00),
                                averagePayDays = averagePayByDays(1200000.00, 246.00, 10.00),
                                averagePayHours = averagePayByHours(1200000.00, 1968.00, 80.00),
                                averagePaySummarized = averagePaySummarized(1200000.00, 1968.00,
                                                                           7.876000, 10.00),
                                positiveRecalculation = payrollRecalculationDelta(100000.00, 110000.00),
                                negativeRecalculation = payrollRecalculationDelta(100000.00, 95000.00),
                                annualLeaveWithHoliday = annualLeaveDays(calendarByYear(2026),
                                                                         2026_03_13, 2026_03_18),
                                annualLeaveWithReligiousDay = annualLeaveDays(calendarByYear(2026),
                                                                              2026_01_06, 2026_01_08),
                                vacationInterimPayment = interimGrossAmount(InterimPaymentKind.vacation,
                                                                             48780.49, NULL, NULL),
                                advanceInterimPayment = interimGrossAmount(InterimPaymentKind.advance,
                                                                            NULL, NULL, 50000.00),
                                sickLeaveMonthlyCap2026 = sickLeaveMonthlyCap(2026_01_15),
                                sickLeaveBelowCap = sickBenefitWithCap(80000.00,
                                                                      sickLeaveMonthlyCap(2026_01_15)),
                                sickLeaveAtCap = sickBenefitWithCap(150000.00,
                                                                   sickLeaveMonthlyCap(2026_01_15)),
                                sickLeaveCapExempt = sickLeaveGrossAmount(injurySick),
                                sickLeaveAcrossMonths = sickLeaveGrossAmount(ordinarySick),
                                sickLeaveExcluded = sickLeaveGrossAmount(excludedSick),
                                sickLeaveInterimPayment = interimGrossAmount(InterimPaymentKind.sickLeave,
                                                                             NULL,
                                                                             sickLeaveGrossAmount(ordinarySick),
                                                                             NULL),
                                scheduledLeavePaymentDue = thirdPreviousWorkDate(calendarByYear(2026),
                                                                                 LeaveWorkWeek.fiveDay,
                                                                                 2026_07_13),
                                outsideSchedulePaymentDue = thirdNextWorkDate(calendarByYear(2026),
                                                                              LeaveWorkWeek.fiveDay,
                                                                              2026_07_13);
                                                                            }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                            }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
