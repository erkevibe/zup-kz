MODULE AccessWorkflowTest;

REQUIRE SickLeaveWorkflowTest;
NAMESPACE ZUPKZ;

accessAssignedOrganization() = organizationByBin('333333333333');
accessHiddenOrganization() = organizationByBin('222222222222');
accessHiddenTimesheet() = GROUP LAST Timesheet t IF
    timesheetNumber(t) == 'ACCESS-HIDDEN-1' ORDER t;
accessHiddenDepartment() = GROUP LAST Department d IF code(d) == 'ACCESS-HIDDEN-DEPT' ORDER d;
accessHiddenDeleteDepartment() = GROUP LAST Department d IF
    code(d) == 'ACCESS-HIDDEN-DELETE' ORDER d;
accessHiddenPayrollRun() = GROUP LAST PayrollRun r IF
    payrollNumber(r) == 'ACCESS-HIDDEN-PAYROLL' ORDER r;
accessHiddenArchiveCase() = GROUP LAST ArchiveCase c IF
    archiveCaseIndex(c) == 'ACCESS-HIDDEN-ARCHIVE' ORDER c;
accessHiddenArchiveDocument() = GROUP LAST ArchiveDocument d IF
    archiveDocumentNumber(d) == 'ACCESS-HIDDEN-FILE' ORDER d;
accessHiddenNotice() = GROUP LAST PersonnelNotice n IF
    personnelNoticeNumber(n) == 'ACCESS-HIDDEN-NOTICE' ORDER n;
accessHiddenEnforcement() = GROUP LAST EnforcementOrder o IF
    enforcementNumber(o) == 'ACCESS-HIDDEN-ENFORCEMENT' ORDER o;
accessHiddenPaymentStatement() = GROUP LAST PaymentStatement d IF
    paymentStatementNumber(d) == 'ACCESS-HIDDEN-PAYMENT' ORDER d;
accessHiddenForm200() = GROUP LAST Form200Declaration d IF
    form200Version(d) == 'ACCESS-HIDDEN-FORM-200' ORDER d;
uiRoleTestUser(STRING[100] value) = GROUP LAST CustomUser u IF login(u) == value ORDER u;

createUiRoleTestUser(STRING[100] loginValue, STRING[50] roleSid, Organization org) {
    IF NOT uiRoleTestUser(loginValue) THEN
        NEW user = CustomUser {
            login(user) <- loginValue;
            calculateBase64Hash('SHA-256', 'zup-ui-test-only');
            sha256Password(user) <- calculatedHash();
            in(user, userRoleSID(roleSid)) <- TRUE;
            NEW access = UserOrganizationAccess {
                accessUser(access) <- user;
                accessOrganization(access) <- org;
                accessActive(access) <- TRUE;
            }
        }
}

uiRoleSetupTest() {
    loadZupRoles();
    IF NOT organizationByBin('555555555555') THEN
        NEW org = Organization {
            name(org) <- 'UI Test Organization';
            bin(org) <- '555555555555';
        }
    APPLY;

    createUiRoleTestUser('ui-hr', 'zup_hr', organizationByBin('555555555555'));
    createUiRoleTestUser('ui-time', 'zup_timekeeper', organizationByBin('555555555555'));
    createUiRoleTestUser('ui-payroll', 'zup_payroll', organizationByBin('555555555555'));
    createUiRoleTestUser('ui-chief', 'zup_chief_accountant', organizationByBin('555555555555'));
    createUiRoleTestUser('ui-auditor', 'zup_auditor', organizationByBin('555555555555'));
    IF NOT uiRoleTestUser('ui-employee') THEN
        NEW employeeAccount = CustomUser {
            login(employeeAccount) <- 'ui-employee';
            calculateBase64Hash('SHA-256', 'zup-ui-test-only');
            sha256Password(employeeAccount) <- calculatedHash();
            in(employeeAccount, userRoleSID('zup_employee')) <- TRUE;
        }
    APPLY;

    EXPORT JSON FROM
        hrReady = has(uiRoleTestUser('ui-hr'), userRoleSID('zup_hr')),
        timeReady = has(uiRoleTestUser('ui-time'), userRoleSID('zup_timekeeper')),
        payrollReady = has(uiRoleTestUser('ui-payroll'), userRoleSID('zup_payroll')),
        chiefReady = has(uiRoleTestUser('ui-chief'), userRoleSID('zup_chief_accountant')),
        auditorReady = has(uiRoleTestUser('ui-auditor'), userRoleSID('zup_auditor')),
        employeeReady = has(uiRoleTestUser('ui-employee'), userRoleSID('zup_employee'));
}

initialRolePermissionsTest() {
    EXPORT JSON FROM
        hrPersonnelPermitted = dataPermission(userRoleSID('zup_hr'),
            navigatorElementCanonicalName('ZUPKZ.personnel')) == Permission.permit,
        hrPayrollForbidden = dataPermission(userRoleSID('zup_hr'),
            navigatorElementCanonicalName('ZUPKZ.payroll')) == Permission.forbid,
        timeWorkingTimePermitted = dataPermission(userRoleSID('zup_timekeeper'),
            navigatorElementCanonicalName('ZUPKZ.workingTime')) == Permission.permit,
        payrollPayrollPermitted = dataPermission(userRoleSID('zup_payroll'),
            navigatorElementCanonicalName('ZUPKZ.payroll')) == Permission.permit,
        chiefReportsPermitted = dataPermission(userRoleSID('zup_chief_accountant'),
            navigatorElementCanonicalName('ZUPKZ.reportsKz')) == Permission.permit,
        hrUiTestForbidden = dataPermission(userRoleSID('zup_hr'),
            navigatorElementCanonicalName('ZUPKZ.uiTestInternalForms')) == Permission.forbid,
        chiefUiTestForbidden = dataPermission(userRoleSID('zup_chief_accountant'),
            navigatorElementCanonicalName('ZUPKZ.uiTestInternalForms')) == Permission.forbid,
        chiefAdministrationForbidden = dataPermission(userRoleSID('zup_chief_accountant'),
            navigatorElementCanonicalName('System.administration')) == Permission.forbid,
        auditorAdministrationForbidden = dataPermission(userRoleSID('zup_auditor'),
            navigatorElementCanonicalName('System.administration')) == Permission.forbid,
        chiefDesignForbidden = dataPermission(userRoleSID('zup_chief_accountant'),
            navigatorElementCanonicalName('SystemEvents.showDesign')) == Permission.forbid,
        auditorReadOnly = dataPermissionChange(userRoleSID('zup_auditor'),
            propertyGroup('System_root')) == Permission.forbid,
        employeeCabinetPermitted = dataPermission(userRoleSID('zup_employee'),
            navigatorElementCanonicalName('ZUPKZ.employeeSelfService')) == Permission.permit,
        employeePayrollForbidden = dataPermission(userRoleSID('zup_employee'),
            navigatorElementCanonicalName('ZUPKZ.payroll')) == Permission.forbid,
        employeeReadOnly = dataPermissionChange(userRoleSID('zup_employee'),
            propertyGroup('System_root')) == Permission.forbid;
}

employeeCabinetOwnEmployee() = GROUP LAST Employee e IF iin(e) == '901010400010' ORDER e;
employeeCabinetForeignEmployee() = GROUP LAST Employee e IF iin(e) == '911111400011' ORDER e;
employeeCabinetRun() = GROUP LAST PayrollRun r IF payrollNumber(r) == 'CABINET-2026-08' ORDER r;
employeeCabinetOwnSettlement() = settlementLineByEmployee(
    employeeCabinetRun(), employeeCabinetOwnEmployee());
employeeCabinetForeignSettlement() = settlementLineByEmployee(
    employeeCabinetRun(), employeeCabinetForeignEmployee());

employeeCabinetSetupTest() {
    IF NOT employeeCabinetRun() THEN NEW own = Employee {
        iin(own) <- '901010400010';
        lastName(own) <- 'Кабинетов';
        firstName(own) <- 'Сотрудник';
        employeeUser(own) <- uiRoleTestUser('ui-employee');
        NEW foreign = Employee {
            iin(foreign) <- '911111400011';
            lastName(foreign) <- 'Чужой';
            firstName(foreign) <- 'Сотрудник';
            NEW run = PayrollRun {
                payrollOrganization(run) <- organizationByBin('555555555555');
                payrollNumber(run) <- 'CABINET-2026-08';
                payrollPeriodFrom(run) <- 2026_08_01;
                payrollPeriodTo(run) <- 2026_08_31;
                payrollRunStatus(run) <- PayrollRunStatus.approved;
                NEW ownLine = PayrollSettlementLine {
                    settlementPayrollRun(ownLine) <- run;
                    settlementEmployee(ownLine) <- own;
                    settlementAccrued(ownLine) <- 400000.00;
                    settlementPayable(ownLine) <- 320000.00;
                    settlementClosedAt(ownLine) <- currentDateTime();
                }
                NEW foreignLine = PayrollSettlementLine {
                    settlementPayrollRun(foreignLine) <- run;
                    settlementEmployee(foreignLine) <- foreign;
                    settlementAccrued(foreignLine) <- 500000.00;
                    settlementPayable(foreignLine) <- 400000.00;
                    settlementClosedAt(foreignLine) <- currentDateTime();
                }
            }
        }
    }
    IF employeeCabinetOwnEmployee() AND uiRoleTestUser('ui-employee') THEN
        employeeUser(employeeCabinetOwnEmployee()) <- uiRoleTestUser('ui-employee');
    APPLY;
    EXPORT JSON FROM
        employeeMapped = employeeByUser(uiRoleTestUser('ui-employee')) ==
            employeeCabinetOwnEmployee(),
        ownSettlementCreated = settlementPayable(employeeCabinetOwnSettlement()) == 320000.00,
        foreignSettlementCreated = settlementPayable(employeeCabinetForeignSettlement()) == 400000.00;
}

employeeCabinetAccessTest() {
    EXPORT JSON FROM
        ownSettlementAllowed = settlementViewAllowedFor(uiRoleTestUser('ui-employee'),
            employeeCabinetOwnSettlement()),
        foreignSettlementDenied = NOT settlementViewAllowedFor(uiRoleTestUser('ui-employee'),
            employeeCabinetForeignSettlement()),
        employeeHasNoOrganizationAccess = NOT userOrganizationAllowed(
            uiRoleTestUser('ui-employee'), organizationByBin('555555555555')),
        employeeCannotChangeBinding = NOT employeeUserAdministrationAllowed(
            uiRoleTestUser('ui-employee')),
        administratorCanChangeBinding = employeeUserAdministrationAllowed(
            currentUser() AS CustomUser),
        employeeCabinetPermitted = dataPermission(userRoleSID('zup_employee'),
            navigatorElementCanonicalName('ZUPKZ.employeeSelfService')) == Permission.permit,
        employeePayrollForbidden = dataPermission(userRoleSID('zup_employee'),
            navigatorElementCanonicalName('ZUPKZ.payroll')) == Permission.forbid,
        employeeReadOnly = dataPermissionChange(userRoleSID('zup_employee'),
            propertyGroup('System_root')) == Permission.forbid;
}

accessWorkflowTest() {
    loadZupRoles();
    NEW assignedOrg = Organization {
        name(assignedOrg) <- 'Доступ A';
        bin(assignedOrg) <- '333333333333';
        NEW hiddenOrg = Organization {
            name(hiddenOrg) <- 'Доступ B';
            bin(hiddenOrg) <- '222222222222';
            NEW user = CustomUser {
                login(user) <- 'zup-access-test';
                calculateBase64Hash('SHA-256', 'zup-access-ci-only');
                sha256Password(user) <- calculatedHash();
                in(user, userRoleSID('zup_hr')) <- TRUE;
                NEW access = UserOrganizationAccess {
                    accessUser(access) <- user;
                    accessOrganization(access) <- assignedOrg;
                    accessActive(access) <- TRUE;

                    createUiRoleTestUser('zup-access-hr', 'zup_hr', assignedOrg);
                    createUiRoleTestUser('zup-access-time', 'zup_timekeeper', assignedOrg);
                    createUiRoleTestUser('zup-access-payroll', 'zup_payroll', assignedOrg);
                    createUiRoleTestUser('zup-access-chief', 'zup_chief_accountant', assignedOrg);

                    NEW hiddenDepartment = Department {
                        organization(hiddenDepartment) <- hiddenOrg;
                        code(hiddenDepartment) <- 'ACCESS-HIDDEN-DEPT';
                        name(hiddenDepartment) <- 'Скрытое подразделение';
                    }
                    NEW hiddenDeleteDepartment = Department {
                        organization(hiddenDeleteDepartment) <- hiddenOrg;
                        code(hiddenDeleteDepartment) <- 'ACCESS-HIDDEN-DELETE';
                        name(hiddenDeleteDepartment) <- 'Скрытое подразделение для удаления';
                    }
                    NEW hiddenPayroll = PayrollRun {
                        payrollOrganization(hiddenPayroll) <- hiddenOrg;
                        payrollNumber(hiddenPayroll) <- 'ACCESS-HIDDEN-PAYROLL';
                        payrollPeriodFrom(hiddenPayroll) <- 2026_01_01;
                        payrollPeriodTo(hiddenPayroll) <- 2026_01_31;
                        payrollRunStatus(hiddenPayroll) <- PayrollRunStatus.draft;

                        NEW hiddenArchive = ArchiveCase {
                            archiveCaseOrganization(hiddenArchive) <- hiddenOrg;
                            archiveCaseIndex(hiddenArchive) <- 'ACCESS-HIDDEN-ARCHIVE';
                            archiveCaseYear(hiddenArchive) <- 2026;
                            archiveCaseTitle(hiddenArchive) <- 'Скрытое архивное дело';
                            archiveCaseStatus(hiddenArchive) <- ArchiveCaseStatus.open;

                            NEW hiddenArchiveDocument = ArchiveDocument {
                                archiveDocumentCase(hiddenArchiveDocument) <- hiddenArchive;
                                archiveDocumentNumber(hiddenArchiveDocument) <- 'ACCESS-HIDDEN-FILE';
                                archiveDocumentTitle(hiddenArchiveDocument) <- 'Скрытый архивный документ';
                            }
                        }

                        NEW hiddenNotice = PersonnelNotice {
                            personnelNoticeOrganization(hiddenNotice) <- hiddenOrg;
                            personnelNoticeNumber(hiddenNotice) <- 'ACCESS-HIDDEN-NOTICE';
                            personnelNoticeStatus(hiddenNotice) <- PersonnelNoticeStatus.draft;
                        }

                        NEW hiddenEnforcement = EnforcementOrder {
                            enforcementOrganization(hiddenEnforcement) <- hiddenOrg;
                            enforcementNumber(hiddenEnforcement) <- 'ACCESS-HIDDEN-ENFORCEMENT';
                            enforcementStatus(hiddenEnforcement) <- EnforcementOrderStatus.active;
                        }

                        NEW hiddenPayment = PaymentStatement {
                            paymentStatementPayrollRun(hiddenPayment) <- hiddenPayroll;
                            paymentStatementNumber(hiddenPayment) <- 'ACCESS-HIDDEN-PAYMENT';
                            paymentStatementStatus(hiddenPayment) <- PaymentStatementStatus.draft;
                        }

                        NEW hiddenDeclaration = Form200Declaration {
                            form200Organization(hiddenDeclaration) <- hiddenOrg;
                            form200PeriodStart(hiddenDeclaration) <- 2026_01_01;
                            form200Kind(hiddenDeclaration) <- Form200Kind.initial;
                            form200Version(hiddenDeclaration) <- 'ACCESS-HIDDEN-FORM-200';
                            form200Status(hiddenDeclaration) <- Form200Status.draft;
                        }
                    }

                    NEW hiddenTimesheet = Timesheet {
                        timesheetOrganization(hiddenTimesheet) <- hiddenOrg;
                        timesheetNumber(hiddenTimesheet) <- 'ACCESS-HIDDEN-1';
                        timesheetPeriodFrom(hiddenTimesheet) <- 2026_01_01;
                        timesheetPeriodTo(hiddenTimesheet) <- 2026_01_31;
                        timesheetStatus(hiddenTimesheet) <- TimesheetStatus.draft;

                        APPLY;

                        EXPORT JSON FROM
                            allRolesCreated = userRoleSID('zup_hr') AND
                                userRoleSID('zup_timekeeper') AND userRoleSID('zup_payroll') AND
                                userRoleSID('zup_chief_accountant') AND userRoleSID('zup_auditor') AND
                                userRoleSID('zup_employee'),
                            userHasHrRole = has(user, userRoleSID('zup_hr')),
                            assignedOrganizationAllowed = userOrganizationAllowed(user, assignedOrg),
                            hiddenOrganizationRejected = NOT userOrganizationAllowed(user, hiddenOrg),
                            hrPersonnelPermitted = dataPermission(userRoleSID('zup_hr'),
                                navigatorElementCanonicalName('ZUPKZ.personnel')) == Permission.permit,
                            hrPayrollForbidden = dataPermission(userRoleSID('zup_hr'),
                                navigatorElementCanonicalName('ZUPKZ.payroll')) == Permission.forbid,
                            hrUiTestForbidden = dataPermission(userRoleSID('zup_hr'),
                                navigatorElementCanonicalName('ZUPKZ.uiTestInternalForms')) == Permission.forbid,
                            chiefUiTestForbidden = dataPermission(userRoleSID('zup_chief_accountant'),
                                navigatorElementCanonicalName('ZUPKZ.uiTestInternalForms')) == Permission.forbid,
                            chiefAdministrationForbidden = dataPermission(userRoleSID('zup_chief_accountant'),
                                navigatorElementCanonicalName('System.administration')) == Permission.forbid,
                            auditorAdministrationForbidden = dataPermission(userRoleSID('zup_auditor'),
                                navigatorElementCanonicalName('System.administration')) == Permission.forbid,
                            chiefDesignForbidden = dataPermission(userRoleSID('zup_chief_accountant'),
                                navigatorElementCanonicalName('SystemEvents.showDesign')) == Permission.forbid,
                            selfRegistrationDisabled = disableRole('selfRegister'),
                            auditorReadOnly = dataPermissionChange(userRoleSID('zup_auditor'),
                                propertyGroup('System_root')) == Permission.forbid;
                    }
                }
            }
        }
    }
}

crossOrganizationPolicyTest() {
    changeOrganizationName(accessHiddenOrganization(), 'УТЕЧК');
    changeOrganizationName(accessAssignedOrganization(), 'Доступ A изменён');

    EXPORT JSON FROM
        authenticatedAsRestrictedUser = login(currentUser() AS CustomUser) == 'zup-access-test',
        assignedReadAllowed = allowedOrganizationName(accessAssignedOrganization()) ==
            'Доступ A изменён',
        hiddenReadBlocked = NOT allowedOrganizationName(accessHiddenOrganization()),
        assignedWriteAllowed = name(accessAssignedOrganization()) == 'Доступ A изменён',
        hiddenWriteBlocked = name(accessHiddenOrganization()) == 'Доступ B',
        hiddenActionBlocked = NOT organizationActionAllowed(accessHiddenOrganization());
}

crossOrganizationStatusAttackTest() {
    // Имитируем злонамеренное action: даже внутренний lifecycle-token
    // не должен обойти границу организации.
    timesheetLifecycleTransition(accessHiddenTimesheet()) <- TRUE;
    timesheetStatus(accessHiddenTimesheet()) <- TimesheetStatus.approved;
    APPLY;
}

crossOrganizationMasterDataAttackTest() {
    name(accessHiddenDepartment()) <- 'УТЕЧКА HR';
    APPLY;
}

crossOrganizationDraftAttackTest() {
    timesheetNumber(accessHiddenTimesheet()) <- 'ACCESS-ATTACK-TIME';
    APPLY;
}

crossOrganizationPayrollAttackTest() {
    payrollNumber(accessHiddenPayrollRun()) <- 'ACCESS-ATTACK-PAYROLL';
    APPLY;
}

crossOrganizationOwnershipAttackTest() {
    organization(accessHiddenDepartment()) <- accessAssignedOrganization();
    APPLY;
}

crossOrganizationDeleteAttackTest() {
    DELETE Department d WHERE d == accessHiddenDeleteDepartment();
    APPLY;
}

crossOrganizationSecondaryHrAttackTest() {
    archiveDocumentTitle(accessHiddenArchiveDocument()) <- 'УТЕЧКА АРХИВА';
    APPLY;
}

crossOrganizationSecondaryPayrollAttackTest() {
    enforcementNumber(accessHiddenEnforcement()) <- 'ACCESS-ATTACK-ENFORCEMENT';
    paymentStatementNumber(accessHiddenPaymentStatement()) <- 'ACCESS-ATTACK-PAYMENT';
    APPLY;
}

crossOrganizationSecondaryReportAttackTest() {
    form200CorrectionNumber(accessHiddenForm200()) <- 99;
    APPLY;
}

crossOrganizationSecondaryOwnershipAttackTest() {
    archiveCaseOrganization(accessHiddenArchiveCase()) <- accessAssignedOrganization();
    APPLY;
}

crossOrganizationSecondaryDeleteAttackTest() {
    DELETE PersonnelNotice n WHERE n == accessHiddenNotice();
    APPLY;
}

crossOrganizationVerificationTest() {
    EXPORT JSON FROM
        hiddenStatusPreserved = timesheetStatus(accessHiddenTimesheet()) == TimesheetStatus.draft,
        hiddenNamePreserved = name(accessHiddenOrganization()) == 'Доступ B',
        hiddenDepartmentPreserved = name(accessHiddenDepartment()) == 'Скрытое подразделение',
        hiddenDepartmentOwnerPreserved = organization(accessHiddenDepartment()) ==
            accessHiddenOrganization(),
        hiddenDraftPreserved = timesheetNumber(accessHiddenTimesheet()) == 'ACCESS-HIDDEN-1',
        hiddenPayrollPreserved = payrollNumber(accessHiddenPayrollRun()) ==
            'ACCESS-HIDDEN-PAYROLL',
        hiddenDeletePreserved = name(accessHiddenDeleteDepartment()) ==
            'Скрытое подразделение для удаления',
        hiddenArchiveDocumentPreserved = archiveDocumentTitle(accessHiddenArchiveDocument()) ==
            'Скрытый архивный документ',
        hiddenArchiveOwnerPreserved = archiveCaseOrganization(accessHiddenArchiveCase()) ==
            accessHiddenOrganization(),
        hiddenNoticeDeletePreserved = personnelNoticeNumber(accessHiddenNotice()) ==
            'ACCESS-HIDDEN-NOTICE',
        hiddenEnforcementPreserved = enforcementNumber(accessHiddenEnforcement()) ==
            'ACCESS-HIDDEN-ENFORCEMENT',
        hiddenPaymentPreserved = paymentStatementNumber(accessHiddenPaymentStatement()) ==
            'ACCESS-HIDDEN-PAYMENT',
        hiddenReportPreserved = NOT form200CorrectionNumber(accessHiddenForm200());
}

employeeIinFormatGuardTest() {
    NEW worker = Employee {
        iin(worker) <- 'A40404300009';
        lastName(worker) <- 'Некорректный';
        firstName(worker) <- 'ИИН';
    }
    APPLY;
    EXPORT JSON FROM employeeIinFormatRejected = canceled();
}

organizationBinFormatGuardTest() {
    NEW org = Organization {
        bin(org) <- 'B66666666675';
        name(org) <- 'Некорректный БИН';
    }
    APPLY;
    EXPORT JSON FROM organizationBinFormatRejected = canceled();
}

bankDetailsFormatGuardTest() {
    NEW worker = Employee {
        iin(worker) <- '940404300009';
        lastName(worker) <- 'Некорректный';
        firstName(worker) <- 'IBAN';
        salaryBankBic(worker) <- 'TESTKZKX';
        salaryIban(worker) <- 'KZ00invalid000000001';
    }
    APPLY;
    EXPORT JSON FROM bankDetailsFormatRejected = canceled();
}

NAVIGATOR {
    NEW FOLDER uiTestInternalForms 'UI-тест внутренних форм' WINDOW toolbar {
        NEW archiveCaseInventory;
        NEW businessTripOrder;
        NEW employeePersonalCard;
        NEW employmentAssignments;
        NEW employments;
        NEW form20005Xml;
        NEW leaveOrder;
        NEW personnelEventCard;
        NEW personnelEventOrder;
        NEW personnelEvents;
        NEW vacationSchedulePrint;
        NEW workAccidentAct;
    }
}
