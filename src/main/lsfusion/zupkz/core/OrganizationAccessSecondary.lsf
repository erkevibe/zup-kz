MODULE KZOrganizationAccessSecondary;

REQUIRE KZAccessControl;
NAMESPACE ZUPKZ;

// Серверная граница для вторичных документов и строк. UI-фильтры отвечают
// только за удобство: эти constraints также действуют для Action API и APPLY.
META protectSecondaryOrganizationObject(code, objectClass, organizationProperty, rolePredicate)
    CONSTRAINT code##SecondaryContentChanged(objectClass o) AND
               (NOT rolePredicate() OR
                organizationChangeDenied(organizationProperty(o)) OR
                organizationChangeDenied(PREV(organizationProperty(o))))
        MESSAGE 'Нет доступа к изменению данных этой организации';
    CONSTRAINT DROPPED(objectClass o IS objectClass) AND
               (NOT rolePredicate() OR
                organizationChangeDenied(PREV(organizationProperty(o))))
        MESSAGE 'Нет доступа к удалению данных этой организации';
END

leaveEntitlementAccessOrganization(LeaveEntitlement o) = organization(employment(entitlementAssignment(o)));
leaveEntitlementSecondaryContentChanged(LeaveEntitlement o) =
    CHANGED(entitlementAssignment(o)) OR
    CHANGED(entitlementWorkYearFrom(o)) OR
    CHANGED(entitlementWorkYearTo(o)) OR
    CHANGED(entitlementBasicDays(o)) OR
    CHANGED(entitlementAdditionalDays(o)) OR
    CHANGED(entitlementNote(o));
@protectSecondaryOrganizationObject(leaveEntitlement, LeaveEntitlement, leaveEntitlementAccessOrganization, personnelChangeRoleAllowed);

